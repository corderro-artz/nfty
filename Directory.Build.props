<Project>

  <!--
    Settings every project shares, in one place.

    They were duplicated across seven csproj files and had already drifted: Microsoft.NET.Test.Sdk
    sat at 17.14.1 in two test projects and 17.12.0 in the third, and xunit.runner.visualstudio at
    3.1.4 and 3.1.5. Nothing was wrong with either version — the point is that nobody chose the
    difference, and a setting duplicated seven times is a setting nobody owns.
  -->
  <PropertyGroup>
    <!--
      THE PRODUCT VERSION, in one place. Every assembly in the solution carries it, so a binary can
      always be asked what it is - a released file that cannot identify itself is a support problem
      the first time somebody reports a bug against "the download".
    -->
    <Version>2.1.1</Version>

    <!--
      WHO MADE THIS, stamped into every assembly. Windows reads these for the file's Details tab and
      the UAC prompt, and a binary that cannot say who published it or under what licence is a
      binary a person is right to be wary of downloading.

      Copyright is a plain year rather than a build date: it is a legal claim about the work, not a
      timestamp, and a value that changed every build would make two identical binaries differ.
    -->
    <Product>nfty</Product>
    <Company>Vaporsoft</Company>
    <Authors>Vaporsoft</Authors>
    <Copyright>Copyright (c) 2026 Vaporsoft</Copyright>
    <Description>Generates NFT-style asset collections by stacking layered pixel art, with grayscale value-maps colorized at generation time.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/corderro-artz/nfty</PackageProjectUrl>
    <RepositoryUrl>https://github.com/corderro-artz/nfty</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      Turn missing XML documentation into a build warning.

      Without this the compiler never emits CS1591, so "every public member is documented" was an
      aspiration nothing measured — and 622 members across the solution had no <summary> at all,
      including Generator, Validator, Dna and every Model record. The bar is now enforced by the
      thing that compiles the code rather than by whoever reviews it.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      The documentation diagnostics, named so the bar survives a change to WarningLevel or an
      over-eager NoWarn. TreatWarningsAsErrors already turns each into an error; listing them in
      WarningsAsErrors as well means a later "WarningsNotAsErrors" or a project-level
      TreatWarningsAsErrors=false cannot quietly demote them. (CS1573 is a level-4 warning, and
      Roslyn's default WarningLevel for net10.0 is 9999, so all of them are live.)

        CS1591  public or protected member without a comment
        CS1571  duplicate <param> tag       CS1572  <param> names no parameter
        CS1573  some parameters documented, others not
        CS1574  cref that resolves to nothing    CS1580  cref with a bad parameter type
        CS1584  cref with bad syntax        CS1587  XML comment in a place it documents nothing
        CS1710  duplicate <typeparam>       CS1711  <typeparam> names no type parameter
        CS1712  type parameters partly documented
        CS1734  <paramref> / <typeparamref> naming nothing
        CS1658  a warning reporting a malformed XML comment

      What these cannot see - a blank summary, a missing <returns>, an undescribed type parameter,
      an unresolved cref in a position the compiler ignores - is checked by
      the lint mode of tools/api-docs/build.py, which CI runs.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1571;CS1572;CS1573;CS1574;CS1580;CS1584;CS1587;CS1658;CS1710;CS1711;CS1712;CS1734</WarningsAsErrors>

    <!--
      And warnings are errors, so the bar cannot quietly erode. The build has been at zero warnings
      throughout; this makes that a property of the build rather than a habit.

      NU1901-NU1904 are NuGet advisory warnings about *transitive* packages, which a new advisory can
      introduce overnight without a line of code changing. Those must not break an unrelated build —
      they are surfaced by the audit below and by CI's dedicated step instead.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- Audit the whole graph, not just direct references: a vulnerability reaches you through a
         dependency you never named far more often than through one you did. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!--
    Test projects document nothing public and ship nowhere, so the doc requirement is lifted for
    them. Leaving it on would mean writing a <summary> for every fixture builder to satisfy a rule
    that exists to serve consumers of a library, and these have none.

    Detected by convention rather than listed, so a new test project inherits it automatically.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>

    <!--
      xUnit1051 asks that every call taking a CancellationToken be passed
      TestContext.Current.CancellationToken, so the runner can cancel a hung test promptly. Waived
      here for a specific reason: a large share of this suite's async calls are the SUBJECT of the
      test rather than incidental to it — the archive readers' cancellation paths, the
      disposal-on-cancel sweep — and those must pass the token the test constructed, not the
      runner's. Blanket-applying the rule would mean editing assertions to satisfy an analyzer.
      The tests are also fast; there is no hang for the runner to rescue.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!--
    PUBLISH HYGIENE. A plain `dotnet publish` of the desktop app produced 567 MB, and almost none of
    it was this program:

      - 101 MB of NATIVE debug symbols. SkiaSharp and HarfBuzzSharp ship .pdb files beside their
        .dll, and publish copies them; libSkiaSharp.pdb alone is 81 MB of symbols for someone
        else's C++, useless to anyone downloading a release.
      - The .xml documentation files, which exist because GenerateDocumentationFile is on to enforce
        the doc bar at compile time. They are a build-time check, not a shipped artifact.

    Both are stripped from RELEASE publishes only, so a Debug publish still has everything a
    debugger wants. What remains for win-x64 is 33 MB. Choosing a RuntimeIdentifier is the other
    half and belongs on the publish command, not here: without one, publish copies the natives for
    every platform Avalonia supports - win-x86, win-arm64, five Linux flavours, macOS - which was
    the other 500 MB.
  -->
  <Target Name="TrimPublishOfBuildArtifacts" AfterTargets="ComputeFilesToPublish"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
