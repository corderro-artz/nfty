flowchart LR
    R["roll a Recipe<br/>by cookbook weight"]
    L["roll each layer<br/>a variant by weight,<br/>or absent by chance;<br/>color rolled here"]
    RULES{"rules<br/>violated?"}
    D["hash the DNA<br/>selection + colors"]
    DUP{"already<br/>generated?<br/>(unique DNA on)"}
    REN["render<br/>colorize, then<br/>composite in depth order"]
    E(["emit"])

    R --> L --> RULES
    RULES -->|no| D --> DUP
    DUP -->|no| REN --> E
    RULES -->|"re-roll"| R
    DUP -->|"re-roll"| R
