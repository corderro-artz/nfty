<Project Sdk="Microsoft.NET.Sdk">

  <!--
    THE ROLL, AND NOTHING ELSE. This assembly decides what an asset IS and never draws one, so it
    carries no imaging library and no package reference of any kind. That is the point of it: a host
    that only needs to roll — a game server, an engine, a tool — takes this and nothing else.

    It is also the ONLY definition of every decision an asset is made of. Nfty.Core's Generator calls
    into here rather than keeping a second copy of the roll, because two copies is how "the server
    and the client agree" stops being true.

    TWO TARGETS, ONE CODE PATH. netstandard2.1 is for a game engine loading this as a managed plugin.
    Whatever net10.0 has and netstandard2.1 lacks is replaced UNCONDITIONALLY (Guard, Hashing,
    MenuJson) — never behind #if — so the assembly an engine embeds and the one the desktop app loads
    run the same code to compute a DNA. The only conditional file is Compat/NetStandardShims.cs, which
    declares compiler-support types (no logic) the older framework lacks.
  -->
  <!-- Directory.Build.props sets TargetFramework, Nullable, ImplicitUsings, LangVersion, the version
       stamp and the documentation settings; only the target list is overridden here. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Guard and Hashing (Compat/) are internal helpers every namespace here uses. -->
    <Using Include="Nfty.Ticket" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <Compile Remove="Compat/NetStandardShims.cs" />
  </ItemGroup>

</Project>
