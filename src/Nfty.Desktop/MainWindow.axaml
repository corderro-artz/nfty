<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nfty.App.ViewModels"
        xmlns:views="using:Nfty.App.Views"
        x:Class="Nfty.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        MinWidth="{x:Static vm:ShellViewModel.MinWindowWidth}"
        MinHeight="{x:Static vm:ShellViewModel.MinWindowHeight}" Title="nfty"
        Background="Transparent" TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True" WindowDecorations="None">
  <!-- The application opens at its 1280x720 DIP minimum. CenterScreen uses the native opening
       display, falling back to the primary display, and centers in its working area at its DPI. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding ShowHelpCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}" />
    <!-- The keyboard route complements the titlebar's theme control. -->
    <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}" />
    <!-- Close the open CookBook or Set and return to Landing. The brand block in the titlebar does
         the same thing on click; this is the keyboard route, and Ctrl+W is what "close the thing
         I am looking at" means almost everywhere. -->
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
    <!-- Escape closes the open modal. It has to live here rather than on each dialog: the dialog
         layer hosts its content in a ContentControl that never takes focus, so a UserControl-level
         KeyBinding inside a dialog never fires. The command refuses when nothing is open, so the key
         still falls through to the page (the editor drops its selection marquee on it). -->
    <KeyBinding Gesture="Escape" Command="{Binding CloseDialogCommand}" />
  </Window.KeyBindings>

  <!-- The shell chrome itself is head-agnostic UI and lives in Nfty.App so the visual-capture tests
       can render the real thing; this head supplies only the window behavior it needs a Window for. -->
  <views:ShellChromeView x:Name="Chrome" />
</Window>
