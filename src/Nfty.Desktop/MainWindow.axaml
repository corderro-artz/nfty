<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Nfty.App.ViewModels"
        xmlns:views="using:Nfty.App.Views"
        x:Class="Nfty.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1416" Height="864" MinWidth="1080" MinHeight="696" Title="nfty"
        Background="Transparent" TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True" WindowDecorations="None">
  <!-- The size above is the mockups' own 1180x720 (min 900x580) times ShellViewModel.BaseScale. The
       shell now renders 20% larger, so keeping the old window size would have shown 20% LESS of the
       layout rather than the same layout bigger - the Explorer's pane track alone needs 1014px. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+OemQuestion" Command="{Binding ShowHelpCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}" />
    <!-- Light/dark had no way in at all: both theme dictionaries are built and tested, and
         ToggleThemeCommand was bound by nothing, so a user could not switch. Keyboard only, and
         deliberately so - the mockups carry a "Theme" button in their own .pitch scaffolding,
         OUTSIDE the app window, as a preview control for viewing the mockup both ways. There is no
         theme control in the locked chrome, and inventing one would be design drift. -->
    <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleThemeCommand}" />
    <!-- Close the open CookBook or Set and return to Landing. The brand block in the titlebar does
         the same thing on click; this is the keyboard route, and Ctrl+W is what "close the thing
         I am looking at" means almost everywhere. -->
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- A maximized window has no desktop around it to float in: the 12px shadow gutter would show
         as a transparent gap on all four edges and the rounded corners would cut the screen edge.
         Fill the screen instead, the way every OS-decorated window does. -->
    <Style Selector="Window[WindowState=Maximized] Border.frame">
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BoxShadow" Value="none" />
    </Style>
    <!-- The inner clip has to square off too, or maximizing leaves rounded content corners inside a
         square window and the desktop shows through four small notches. -->
    <Style Selector="Window[WindowState=Maximized] Border.frame-clip">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </Window.Styles>
  <!-- The shell chrome itself is head-agnostic UI and lives in Nfty.App so the visual-capture tests
       can render the real thing; this head supplies only the window behaviour it needs a Window for. -->
  <views:ShellChromeView x:Name="Chrome" />
</Window>
