<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource SansFontFamily}" />
    <!-- The page's default ink, set ONCE at the root and inherited from there - the same shape as the
         mockups' `body{color:…}` cascade. Foreground is an inherited property, and an inherited value
         is the lowest priority there is, so anything that deliberately chooses a different ink (an
         accent button, a chip, a selected row) still wins for its own subtree.

         This must NOT be a blanket `TextBlock` setter. A Style setter outranks inheritance, so
         re-asserting the color at every TextBlock overrode every ancestor that had chosen otherwise:
         a `Button.accent` set OnAccent on its ContentPresenter, the label ignored it and painted
         FgBrush, and in light mode "Add ingredient" rendered near-black on carmine (2.43:1) next to a
         `+` icon that looked right because a Path has no such rule and does inherit. Dark mode hid it
         entirely - FgBrush there is near-white, so the wrong value happened to look correct. -->
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource SansFontFamily}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>
  <Style Selector="TextBlock.wordmark">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LetterSpacing" Value="-0.15" />
  </Style>
  <Style Selector="TextBlock.cseg">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cseg.active">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.kind-txt">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.kind-txt.kdyn"><Setter Property="Foreground" Value="{DynamicResource KindDynamicBrush}" /></Style>
  <Style Selector="TextBlock.kind-txt.kstat"><Setter Property="Foreground" Value="{DynamicResource KindStaticBrush}" /></Style>
  <Style Selector="TextBlock.kind-txt.kcust"><Setter Property="Foreground" Value="{DynamicResource KindCustomBrush}" /></Style>
  <Style Selector="Button.tbtn">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <!-- Centered, like every other button in the app. Left only ever looked right because these
         buttons are content-sized in most rows, where the two are indistinguishable; the moment one
         is stretched - the variant sidebar, a modal footer - the label slid to one edge. -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Fluent's ^:pointerover template style sets Background/BorderBrush/Foreground together
       on PART_ContentPresenter at StyleTrigger priority, so a hover BorderBrush set on the
       outer Button (not the template part) is ignored. Target the template part instead. -->
  <Style Selector="Button.tbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.tbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>

  <!-- Disabled: the mockup disables by OPACITY only, keeping the panel surface underneath
       (explorer.html `.tbtn:disabled{opacity:.38}`) — but Fluent's own ":disabled" template style
       repaints PART_ContentPresenter's Background/BorderBrush/Foreground from its own
       (gray) disabled resources at Style priority, same mechanism as :pointerover/:pressed above,
       so a disabled Button.tbtn/.accent rendered as an opaque gray slab (audit finding: the entire
       ingredient-editor tool column when CanPaint is false). Reset the three properties back to
       each variant's normal-state brushes so the Opacity rule below dims the *real* colors instead
       of Fluent's substituted ones. -->
  <Style Selector="Button.tbtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <!-- The disabled fix above was Button-only, leaving Fluent's opaque gray slab on the editor's
       NumericUpDown/TextBox (the audit's #c7c3be / #3c3d40). Dim inputs the same way: opacity over
       the real surface, never a gray fill. -->
  <!-- Fluent paints a disabled RepeatButton's wash on the presenter INSIDE it, not on the button,
       and it is lighter than the button's normal ground - so a spinner arrow at its limit (the New
       CookBook wizard's target supply, which opens at 0) was the one control in the app that got
       BRIGHTER when it became unavailable, reading as hovered.

       This has to be a top-level Style. Setting Background on the RepeatButton itself changes
       nothing (verified off a rendered control: button Transparent, presenter still #33ffffff), and
       the presenter is a second /template/ hop from the ButtonSpinner theme, which Avalonia rejects
       - while a type-keyed ControlTheme never applies at all, because ButtonSpinner's template hands
       its buttons an explicit Theme. From here the presenter is one hop and the rule lands.

       Unscoped on purpose: every RepeatButton in this app is chrome someone else owns - two spinner
       arrows, a Slider's two track halves, a ScrollBar's arrows - and "lighter means unavailable" is
       backwards in all of them. A Slider is unaffected either way; its track buttons have no
       ContentPresenter to match. Dimming a disabled input as a whole is the rule right below. -->
  <Style Selector="RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- And transparent at REST too, which is what unclips the corner. A spinner's buttons are square
       rectangles reaching to within a pixel of a control whose border is rounded, and their presenter
       paints an opaque ground - the same color as the control behind it, so it is invisible
       everywhere except over the corner arc, where it covers the curve and leaves a notch. That is
       the notch on the WEIGHT field's bottom-right. Nothing is lost by not painting it: the ground
       underneath is the same color. Pseudo-class-qualified so it beats the Template-priority
       assignment Fluent makes on that presenter - the same trick the Slider thumb needs - and
       :pointerover is excluded so hover feedback still lands. -->
  <Style Selector="RepeatButton:not(:pointerover):not(:pressed) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="NumericUpDown:disabled, TextBox:disabled, Slider:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <!-- .flat: the borderless paint for a working button that sits inside a dashed Rectangle, which
       Avalonia needs because Border/Button draw a solid edge only. It replaces a former `.soon`
       class that meant "this feature does not exist yet" and paired with CanExecute=Never.
       Everything that wore `.soon` has since been built, and the class is gone rather than left
       lying around: it existed to be applied, and each time a feature shipped without it being
       removed, the app went on telling users a working feature was unavailable — three times. If a
       genuinely unbuilt action ever needs marking again, the mockup's own recipe is one line:
       .tbtn.soon sets border-style dashed, color to the muted-foreground custom property, and a
       transparent background. -->
  <!-- .bare: a Button that contributes nothing visually — no fill, no edge, no padding, no minimum
       size, and Fluent's hover/pressed/focus states neutralized by being set EXPLICITLY to
       Transparent rather than simply left unpainted (not painting hands the state back to Fluent's
       stock blue). It exists so an element the locked design already draws — the brand block, a
       breadcrumb segment — can become clickable and keyboard-reachable without changing a pixel or
       adding chrome the mockups do not have. -->
  <Style Selector="Button.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.bare /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.bare:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- Disabled must not dim it either: the brand is still the brand on the Landing screen, where
       there is simply nothing open to close. The blanket Button:disabled opacity would fade the
       wordmark to 0.38 and make the app look broken at rest. -->
  <Style Selector="Button.bare:disabled">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="Button.flat /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <!-- The same size as Button.tbtn, which it always sits beside. Without this it inherited
         Fluent's 14 while every outline button next to it was 12.5, so "Add recipe" measured 37px
         tall against Delete and Import at 35 and read as a size larger - a difference of two pixels
         that the eye reads as a mistake because the three are in one row. -->
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- FluentTheme's ControlTheme for Button defines its own nested "^.accent" style that paints
       PART_ContentPresenter's Background/BorderBrush/Foreground from AccentButtonBackground (blue)
       at rest — that nested style wins over the plain Button.accent setters above because it
       targets the actual template part. Override all three rest-state properties explicitly so
       our crimson always wins over Fluent's built-in accent palette. -->
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
  </Style>

  <!-- Icon system (audit Critical #1): the mockups draw glyphs as 24-unit stroked SVG paths, so an
       icon is a Path stroked with the current text color, never a font glyph — emoji injected
       off-palette color and missing glyphs rendered as tofu. Stretch=Uniform maps the 24-unit
       geometry into the box below. -->
  <!--
    Icons are authored in the mockups' 24x24 SVG viewBox (see Icons.axaml) and must be scaled the way
    an <svg viewBox> scales them: by that shared 24-unit box, NOT by each glyph's own bounds.

    Stretch="Uniform" does the latter, which is wrong twice over. Cosmetically it sizes every glyph to
    fill 14px regardless of how much of the 24-box it actually occupies, so a wide-and-short glyph
    renders larger than a square one and the set loses its common rhythm. Fatally, it divides by the
    geometry's height: a single-axis glyph such as IconMinimise/IconZoomOut ("M6 12h12") has zero-height
    bounds, so the scale degenerates and the icon collapsed to a dot - minimise and zoom-out rendered
    as an empty button.

    So: draw at raw 24-unit coordinates (Stretch=None) and scale by exactly size/24 about the top-left
    corner, which maps the 24-box onto the icon box the way the viewBox does. StrokeThickness is in
    pre-transform units, so it is the mockup's own stroke-width and scales down with the glyph.
  -->
  <Style Selector="Path.ico">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
    <Setter Property="RenderTransform" Value="scale(0.5833)" />   <!-- 14/24 -->
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The edit lock must read as ON at a glance: accent ink on an accent wash, matching the
       mockup's active-affordance treatment. Without this the toggle was invisible.
       The wash is NOT set here. A `Button.icon.unlocked { Background }` setter used to live at this
       spot and was dead twice over: `Button.icon` sets Background="Transparent" and is declared
       further down (last-one-wins at equal specificity), and the rest-state rule sets it on
       PART_ContentPresenter directly, which beats any control-level setter regardless of ordering.
       The wash therefore lives with the other template-part rules; see Button.icon.unlocked
       /template/ ContentPresenter below. Only the icon's stroke is a control-level concern. -->
  <Style Selector="Button.icon.unlocked Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Path.ico.xs">
    <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
    <Setter Property="RenderTransform" Value="scale(0.5)" />      <!-- 12/24 -->
  </Style>
  <!-- explorer.html .ti — the 18px tree type mark -->
  <Style Selector="Path.ico.ti">
    <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" />
    <Setter Property="RenderTransform" Value="scale(0.75)" />     <!-- 18/24 -->
    <Setter Property="StrokeThickness" Value="1.3" />             <!-- the mockup's own .ti stroke -->
  </Style>
  <!-- help.html `.sheet .ti` — the quick-reference sheet draws the same type marks as the tree, at
       16px rather than 18px. Declared after Path.ico.ti so it wins the Width/Height/scale tie. -->
  <Style Selector="Path.ico.ti-sh">
    <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
    <Setter Property="RenderTransform" Value="scale(0.6667)" />   <!-- 16/24 -->
    <Setter Property="StrokeThickness" Value="1.3" />             <!-- the mockup's own .ti stroke -->
  </Style>
  <Style Selector="Path.ico.sm">
    <Setter Property="Width" Value="13" /><Setter Property="Height" Value="13" />
    <Setter Property="RenderTransform" Value="scale(0.5417)" />   <!-- 13/24 -->
  </Style>
  <!-- On an accent fill the icon must switch to the on-accent ink, like the label does. -->
  <Style Selector="Button.accent Path.ico"><Setter Property="Stroke" Value="{DynamicResource OnAccentBrush}" /></Style>
  <!-- Strong-ink icons (window chrome, primary affordances) -->

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Explicit rest-state override so Fluent's default ButtonBackground/ButtonBorderBrush never
       shows through PART_ContentPresenter — Button.icon must be a clean, borderless hit target. -->
  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <!-- The unlocked wash has to be set on the template part too. Setting it on the Button (the
       Button.icon.unlocked rule above) is silently clobbered by the rest-state rule, which targets
       PART_ContentPresenter directly and therefore wins whatever classes the Button carries — so
       only the icon's stroke was changing and the toggle's "editing" wash never rendered at all.
       Declared after the rest-state rule so it wins at equal specificity. -->
  <Style Selector="Button.icon.unlocked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
  </Style>

  <!-- Close window-control: danger hover beats the neutral Button.icon hover above (mockup
       .wc.close:hover = accent bg + on-accent fg) since both selectors have equal specificity
       and this style is declared later in document order. -->
  <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.icon.danger:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.dice">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Width" Value="27" />
    <Setter Property="Height" Value="27" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.dice:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.dice:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>

  <!-- Landing action buttons: uniform full-width, label left + hotkey right, slightly larger. -->
  <!-- landing.html .lwordmark -->
  <Style Selector="TextBlock.lwordmark">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.6" />
  </Style>
  <Style Selector="Button.landing">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Button.landing TextBlock.lbl">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- landing.html .subrow .tbtn: the secondary Create tier is two SMALLER side-by-side buttons,
       not two more full-width rows. Declared after Button.landing so it wins on the shared
       properties. -->
  <Style Selector="Button.landing.sub">
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Button.landing.sub TextBlock.lbl">
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <!-- landing.html .learn: a bare text link, not a bordered button. -->
  <Style Selector="Button.learn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,22,0,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.learn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- landing.html .rrow: a borderless recents row that only gains chrome on hover. -->
  <Style Selector="Button.rrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.rrow /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.rrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <!-- .rico: the 22px accent-wash type tile leading each row. -->
  <Style Selector="Border.rico">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A loose Kitchen ingredient gets a NEUTRAL tile, not the accent wash every other recent row
       carries - landing.html overrides that row's .rico inline with
       "background:tile; border-color:line-strong; color:fg-muted". It is the visual distinction
       between "this collects into a CookBook" and "this is a loose item in the Kitchen". -->
  <Style Selector="Border.rico.loose">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>
  <Style Selector="TextBlock.rname">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="TextBlock.rmeta">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Margin" Value="0,1,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <!-- landing.html gives .rpath the muted-foreground custom property AND opacity .7, and
       FgMutedBrush is ALREADY 72% alpha, so the two multiply to ~50% and the path measured
       3.44:1 — under WCAG AA. Raised to
       0.85 rather than removed: a file path is genuinely secondary and should still recede, but it is
       real information a user reads, not decoration, so it has to clear 4.5. This is a deliberate,
       measured divergence from the mockup's number, not a transcription slip. -->
  <Style Selector="TextBlock.rpath">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Opacity" Value="0.85" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The placeholder was never tokenised: nothing set it, so Fluent's own default painted it and
       the search read 2.09:1 in light and 2.62:1 in dark. explorer.html's .search sets color to the
       muted-foreground custom property with NO extra opacity, so this is drift rather than a design
       choice — adopting the token restores the mockup and clears AA in the same move. -->
  <!-- .rzero first-run empty state. The dashed stroke is a Rectangle, not the Border's own
       BorderBrush: Avalonia's Border draws a solid edge only and has no dash array. -->
  <Style Selector="Rectangle.dashed">
    <Setter Property="Stroke" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeDashArray" Value="4,3" />
    <Setter Property="RadiusX" Value="8" />
    <Setter Property="RadiusY" Value="8" />
  </Style>
  <Style Selector="Rectangle.dashed.btn">
    <Setter Property="RadiusX" Value="6" />   <!-- RadiusMd, matching Button.tbtn -->
    <Setter Property="RadiusY" Value="6" />
  </Style>
  <Style Selector="TextBlock.zh">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.zp">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="19.2" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,5,0,0" />
  </Style>
  <!-- The label is a literal Grid>TextBlock (not the ContentPresenter's implicit content
       TextBlock), so it never inherits the Button's own Foreground: the global "TextBlock" style
       above sets Foreground unconditionally at Style priority, which beats Inherited regardless of
       what the ancestor Button.Foreground is (Avalonia priority order Style > Inherited) — the same
       reason TextBlock.hk needed its own on-accent override below rather than relying on
       inheritance. Left unfixed, "New CookBook"'s label rendered near-black FgBrush text on the
       accent maroon fill — illegible. -->
  <!-- Mint-distribution series paint. One class per series, resolved from Tokens so it follows the
       theme; the ViewModel supplies only which series a recipe is. A Color computed in the
       ViewModel — which is what this replaced — cannot re-resolve when the theme flips, and escaped
       the raw-hex sweep entirely because that sweep reads markup. -->
  <Style Selector="Border.series.s1"><Setter Property="Background" Value="{DynamicResource Series1Brush}" /></Style>
  <Style Selector="Border.series.s2"><Setter Property="Background" Value="{DynamicResource Series2Brush}" /></Style>
  <Style Selector="Border.series.s3"><Setter Property="Background" Value="{DynamicResource Series3Brush}" /></Style>
  <Style Selector="Border.series.s4"><Setter Property="Background" Value="{DynamicResource Series4Brush}" /></Style>
  <Style Selector="Border.series.s5"><Setter Property="Background" Value="{DynamicResource Series5Brush}" /></Style>
  <Style Selector="Border.series.s6"><Setter Property="Background" Value="{DynamicResource Series6Brush}" /></Style>

  <Style Selector="Button.landing.accent TextBlock.lbl">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <Style Selector="Button.landing TextBlock.hk">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="Button.landing TextBlock.hk.on-accent">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- Small-label type scale (audit finding: this scale did not exist, so every section heading
       rendered at Avalonia's default ~14px with zero tracking instead of the mockups' 10-11.5px
       uppercase-tracked look — landing.html/ingredient-editor.html/wizard-recipe.html/explorer.html
       token values, ported verbatim below). Where mockup text is uppercase, Avalonia has no
       text-transform: the sizing/letter-spacing/color is set here, and the consuming view supplies
       already-uppercased text where that matters (see TextBlock.data-h above for the existing
       convention this follows). -->
  <Style Selector="TextBlock.slbl">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.4" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.pane-h">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="1.47" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <!-- explorer.html .pane-h: a 41px header row opening each pane, closed by a hairline. The panes
       themselves are full-bleed regions on the page background divided by 1px line rules; there is
       no floating card. -->
  <Style Selector="Border.pane">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.pane.last">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.pane-hrow">
    <Setter Property="Height" Value="41" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- .vtag: the detail header's right-aligned type chip. Text is written already-uppercased in the
       ViewModel because Avalonia has no text-transform. -->
  <Style Selector="Border.vtag">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.vtag > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.0" />   <!-- .1em at 10px -->
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <!-- .hcount: the right-aligned count that trails a pane header. -->
  <Style Selector="TextBlock.hcount">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- explorer.html .search: a flexing pill, not a fixed-width box - magnifier, watermark, then a
       right-aligned shortcut chip. -->
  <Style Selector="Border.search">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="MaxWidth" Value="360" />
  </Style>
  <!-- .search kbd -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- The TextBox that sits INSIDE Border.search: the pill already draws the chrome, so this must
       draw none of its own. Fluent paints the border on the TextBox's own template parts, hence the
       part-level selectors rather than a bare TextBox setter. -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ===================== Wizard / modal form grammar =====================
       All three New* wizards share this skeleton (wizard-{cookbook,recipe,ingredient}.html):
       kicker, heading, sub, labeled fields, a derived-identifier strip, and a footer band with
       keyboard hints. Before this the wizards were a bare stack of watermarked TextBoxes. -->
  <Style Selector="Border.modal">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />   <!-- so the foot band respects the radius -->
    <!-- Wide enough for the footer to carry all three key hints AND both actions without them
         overlapping; the mockup's footer spans a full-window wizard screen, ours is a dialog card.
         Widened from 560 when these views moved to mono: at 560 the hint row and the Cancel button
         met with zero gap. Mono is wider than sans at the same size, and the footer is the tightest
         row in the card, so it sets the card's minimum width. -->
    <Setter Property="Width" Value="620" />
    <!-- Hug the content. Without this the card stretches to whatever hosts it and the form floats in
         a tall empty panel. -->
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <!-- The tallest wizard (New Ingredient, with both color ranges open) is taller than a small
         window: without a ceiling the card overflowed and took the footer - and therefore Create -
         off screen entirely. The body scrolls inside this instead. -->
    <Setter Property="MaxHeight" Value="620" />
  </Style>
  <!-- New Ingredient only. Declared AFTER Border.modal so it wins at equal specificity. 632 is what
       the page area between the titlebar and the status bar actually allows at MainWindow's 720. -->
  <Style Selector="Border.modal.tall">
    <Setter Property="MaxHeight" Value="632" />
  </Style>
  <!-- .body's accent glow: a soft radial wash from the top edge. -->
  <Style Selector="Border.modal-body">
    <Setter Property="Padding" Value="24,30" />
    <Setter Property="Background" Value="{DynamicResource ModalGlowBrush}" />
  </Style>
  <!-- Declared AFTER Border.modal-body: Avalonia is last-one-wins at equal specificity, so a
       narrower opt-out placed above the blanket rule silently loses. New Ingredient only. -->
  <Style Selector="Border.modal-body.tight">
    <Setter Property="Padding" Value="24,18" />
  </Style>
  <Style Selector="Border.modal-foot">
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,8" />
  </Style>
  <!-- The bar was 58px because its two buttons disagreed: the ghost measured 29 and the accent 37,
       since the accent carries an icon row and both were padded 12,8. Pinning one height makes the
       bar the height of a button plus its padding, and stops the two reading as different sizes. -->
  <Style Selector="Border.modal-foot Button">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- .kicker dot. The mockup's .kicker is a flex row with align-items:center, but centering the dot
       on the TextBlock's LINE BOX puts it low: the label is all-caps, so its glyphs sit high in a box
       that still reserves descender space below the baseline. Measured off a rendered frame the dot
       landed 4.5px under the optical center of "CREATE". The bottom margin lifts it by half its own
       value, so 9 corrects the full 4.5. Only the three wizard kickers use this class, all at the
       same label size, so the correction is safe to carry on the style itself. -->
  <Style Selector="Ellipse.kdot">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,9" />
  </Style>

  <!-- .kind / .dopt choice cards. The wizards' Kind and Destination pickers are bordered cards with
       a dot indicator, a label and a muted subtext line - not bare radio buttons. Retemplating a
       RadioButton rather than hand-rolling toggles keeps single-select and keyboard behavior for
       free. The dot's filled pip is a real Ellipse because the mockup draws it with ::after, which
       has no XAML equivalent. -->
  <Style Selector="RadioButton.choice">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <!-- The mockup's .kinds/.dest are flex rows, whose default align-items:stretch gives every card
         the height of the tallest. Without this the cards size to their own text and a two-line
         subtitle leaves its neighbours visibly short. -->
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Card" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}" Padding="10,9">
          <Grid ColumnDefinitions="13,8,*">
            <Border Name="Dot" Grid.Column="0" Width="13" Height="13" CornerRadius="7"
                    BorderThickness="1" BorderBrush="{DynamicResource LineStrongBrush}"
                    VerticalAlignment="Top" Margin="0,1,0,0">
              <Ellipse Name="Pip" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                       IsVisible="False" />
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Grid.Column="2"
                              Content="{TemplateBinding Content}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ Border#Card">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ Border#Dot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="RadioButton.choice:checked /template/ Ellipse#Pip">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="RadioButton.choice:pointerover /template/ Border#Card">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <!-- Card title / subtitle. These live in the RadioButton's Content, so they are matched by a
       plain descendant selector - no /template/ hop, which would be a second one and throw. -->
  <Style Selector="RadioButton.choice TextBlock.ct">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="RadioButton.choice:checked TextBlock.ct">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.choice TextBlock.csub">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="LineHeight" Value="13.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- .q — the 13px help badge beside a wizard field label. The mockup reveals a wide left-aligned
       popover on hover; Avalonia's stock ToolTip is narrower and follows the pointer, so the
       affordance and the copy are faithful but the popover's shape is not. Copy is verbatim from the
       wizard mockups, which is the point: these explain domain rules (weights are relative, not
       percentages; a color spec is never guessed) that the form alone does not convey. -->
  <!-- ONE tooltip delay for the whole app, on every control that can carry a tip.
       Avalonia's default is 400ms, which means moving the pointer across a toolbar pops a tip on
       every button it crosses - the app talks over you while you are just navigating. 2.2s is long
       enough that only a deliberate rest triggers one, and the tip itself then fades in over 140ms
       (see the ToolTip theme in Controls.axaml).

       ":is(Control)" rather than "Control": an Avalonia type selector matches that exact type, so
       the bare form would apply to nothing. -->
  <Style Selector=":is(Control)">
    <Setter Property="ToolTip.ShowDelay" Value="2200" />
  </Style>

  <Style Selector="Border.qmark">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <!-- The exception to the 2.2s rule above, and the only one: a "?" badge is never crossed by
         accident on the way somewhere - it is hovered on purpose, and waiting two seconds for the
         thing you deliberately pointed at reads as broken. Still slower than Fluent's default. -->
    <Setter Property="ToolTip.ShowDelay" Value="600" />
  </Style>
  <Style Selector="Border.qmark:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Border.qmark > TextBlock">
    <Setter Property="Text" Value="?" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.qmark:pointerover > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <!-- Label + badge sit on one row; the label keeps its own bottom margin off this wrapper. -->
  <Style Selector="StackPanel.plabel-row">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="StackPanel.plabel-row > TextBlock.plabel">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.m-h">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.29" />   <!-- -.015em at 19px -->
    <Setter Property="Margin" Value="0,7,0,0" />
  </Style>
  <Style Selector="TextBlock.m-sub">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <!-- .derived: dashed rule above, then "Identifier <code>" -->
  <Style Selector="TextBlock.derived">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- .keys kbd - the footer hint chips. Distinct from Border.kbd (the search pill's shortcut chip):
       the mockup gives these a panel fill and the stronger line. -->
  <Style Selector="Border.kbd.keys">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>
  <Style Selector="Border.kbd.keys > TextBlock">
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="TextBlock.keyhint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.plabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.0" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <!-- Mockup .ctl-h .plabel { margin-bottom: 0 }: a label that shares a ROW with its value must not
       keep the stacked-label bottom margin, or it floats above the number it is labeling. -->
  <Style Selector="Grid.ctlh > TextBlock.plabel">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TextBlock.tagline">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.sub-h">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="1.26" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="BoxShadow" Value="{DynamicResource WinShadow}" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>
  <!-- Set-browser grid tile: the selected tile is its GROUND plus its accent caption, and nothing
       else. It used to carry a 2px accent border too; at 76px any added edge reads as a frame around
       the art rather than a marker on it, so the border went and the wash stayed.

       The grid is a plain ItemsControl over rows (see SetBrowserView.axaml's note on ListBox
       virtualization) rather than a real ListBox/ListBoxItem, so there is no native :selected
       pseudo-class - selection is a bound "sel" class per SetItemRow.IsSelected. -->
  <Style Selector="Border.tile.sel">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.frame">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <!-- Accent, not LineStrong. A deliberate divergence from explorer.html, which paints the window
         edge with the line-strong token: this is the one border that separates the app from the
         desktop rather than one region from another, so it reads as the app's own color. Requested
         directly during the smoke test. -->
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusWin}" />
    <Setter Property="BoxShadow" Value="{DynamicResource WinShadow}" />
    <!-- The shadow gutter: room for WinShadow's blur to render inside the transparent window surface
         instead of being clipped at the OS window edge. It MUST be a Setter and not an inline Margin
         on the element - a local value outranks every Style, which silently killed the maximized
         override that zeroes it. -->
    <Setter Property="Margin" Value="12" />
  </Style>
  <!-- Clips the frame's children to the rounded corner. One pixel tighter than the frame's radius so
       it hugs the inside of the 1px stroke instead of sitting under it and eating the arc. -->
  <Style Selector="Border.frame-clip">
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Border.idchip">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="7,3" />
  </Style>
  <!-- The mockup's idchips are "muted label + bold value" (`symbol <b>VPET</b>`), not one flat run.
       The label carries the meaning, so it must not read at the same weight as the value. -->
  <Style Selector="Border.idchip TextBlock.ck">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="Border.idchip TextBlock.cvl">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>

  <!-- Explorer tree: kind-colored glyph (D/S/C) on ingredient nodes (mockup .kmark, explorer.html:123-127). -->
  <Style Selector="TextBlock.kmark">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Width" Value="13" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.kmark.kdyn"><Setter Property="Foreground" Value="{DynamicResource KindDynamicBrush}" /></Style>
  <Style Selector="TextBlock.kmark.kstat"><Setter Property="Foreground" Value="{DynamicResource KindStaticBrush}" /></Style>
  <Style Selector="TextBlock.kmark.kcust"><Setter Property="Foreground" Value="{DynamicResource KindCustomBrush}" /></Style>

  <!-- Explorer tree: branch guide line (mockup .branch border-left, explorer.html:186-190). Fluent's
       TreeViewItem template (confirmed against the Fluent source at 11.2.3) wraps children in a bare
       ItemsPresenter with no bordered container to style, so this is realised as a leading Border
       in the node's own DataTemplate (ExplorerView.axaml) instead of a template-part override —
       one guide segment per non-root row rather than a recursive per-depth stack, which is enough
       for this tree's two-level (Recipe/Ingredient) nesting. The "TreeViewItem:pointerover" prefix
       is a plain descendant selector (not "/template/"), so it reaches into the row's own
       DataTemplate content the same way any "Parent:state Child" selector would. -->
  <!-- explorer.html .node: the actual highlightable row box, which sits to the RIGHT of the branch
       guide. It carries the hover wash, the selected accent wash and the inset 2px accent bar. -->
  <Style Selector="Border.node">
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.node:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
  </Style>
  <Style Selector="Border.node.sel">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AccentBarShadow}" />
  </Style>

  <Style Selector="Border.guide">
    <Setter Property="Width" Value="1" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource GuideBrush}" />
  </Style>
  <Style Selector="TreeViewItem:pointerover Border.guide">
    <Setter Property="Background" Value="{DynamicResource GuideHiBrush}" />
  </Style>

  <!-- Explorer tree: root (CookBook) node label (mockup .node.root .nlabel, explorer.html:200). -->
  <Style Selector="TextBlock.root">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ====================================================================
       Task 4: shared detail-body styles, consumed by the recipe/ingredient/
       cookbook detail views (tasks 5-7). This task only adds the styles
       plus a style-load guard (ThemeResourceTests); there is no view yet.

       LetterSpacing values below are computed as em * font-size, the same
       conversion already used above for TextBlock.wordmark (mockup "-.01em"
       at 15px maps to -0.15): Avalonia's LetterSpacing is an absolute
       (device pixel) value, not an em multiplier.

       Two mockup approximations, both consistent with this file already
       omitting a per-surface box-shadow on Border.panel/.card/.frame:
         - .metric/.rules-panel/.cw-panel/.rhero/.vhero skip the mockup's
           "box-shadow: inset 0 1px 0 color-mix(in srgb, fg 5% percent, transparent)"
           top highlight; there is no color-mix equivalent/token for it.
         - .rhero/.vhero use a flat PanelBrush background rather than the
           mockup's linear-gradient from bg-alt2 to panel; no
           LinearGradientBrush resource exists for this token pair, and the
           two colors are close enough that a flat fill reads the same at
           this tile's size.
       Where mockup text is uppercase (.ml, .data-h, .rcl, .ax), Avalonia has
       no text-transform: the sizing/letter-spacing/color is set here, and
       the consuming view is expected to supply already-uppercased text. -->

  <!-- metric band tile (explorer.html:210-216) -->
  <Style Selector="Border.metric">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,11" />
  </Style>
  <Style Selector="TextBlock.mv">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-0.19" />
  </Style>
  <Style Selector="TextBlock.ml">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.0" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>
  <Style Selector="Border.metric.accent">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
  </Style>
  <Style Selector="Border.metric.accent TextBlock.mv">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- distribution bar + legend (explorer.html:219-225) -->
  <Style Selector="Border.distbar">
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.sw">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="TextBlock.pc">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- Reusable "table" row classes for a Grid/ItemsControl in place of DataGrid
       (explorer.html:259-267, table.data th/td). Dual-purpose class names: the
       Border selector styles a row's chrome (border/background/padding); the
       TextBlock selector styles its cell text. Apply the same class to both the
       row container and its cell TextBlocks. -->
  <Style Selector="Border.data-h">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="TextBlock.data-h">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="1.05" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.data-h.num">
    <Setter Property="TextAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.data-row">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,12" />
  </Style>
  <Style Selector="Border.data-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
  </Style>
  <Style Selector="Border.data-row.sel">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
  </Style>
  <Style Selector="TextBlock.data-row">
    <Setter Property="FontSize" Value="13" />
    <!-- A TextBlock in a Grid cell stretches and draws its line at the TOP, which put every one of
         these a couple of pixels above the middle of the bar behind it. Nothing else in the row is
         centered either, so the whole line read as sitting slightly high. -->
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The trait NAME specifically, which is the only text in this app that sits on a tinted ground. -->
  <Style Selector="TextBlock.data-row.trait">
    <Setter Property="Foreground" Value="{DynamicResource TraitInkBrush}" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>

  <!-- explorer.html `.sub-h .hint`: a sentence-case aside sitting beside an uppercase section
       heading. It inherits .sub-h's mono/size/color and opts back OUT of the tracking, which is
       what makes it read as prose rather than as a second heading. Avalonia has no inheritance
       between class selectors, so the shared values are restated. -->
  <Style Selector="TextBlock.hint">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- ===== layer reorder (docs/design/mockups/explorations/reorder-control-variants.html, variant B)
       The drag grip, and the drop line that shows where a dragged layer will land.

       GEOMETRY IS FIXED. The spec's hard rule for this feature is that a control appearing or
       disappearing must not move, resize or reflow anything around it - and it names THIS control as
       the likely violation, because the exploration draws variant B PREPENDING its grip column on
       unlock, shifting every other column 26px right. So the column is always in the layout at the
       same width and only the ink changes: Opacity plus IsHitTestVisible (which hands the click back
       to the row button underneath) plus Focusable (or Tab would stop on invisible grips). Never
       IsVisible - that is the one property here that WOULD reflow.

       Width/Height are fixed for the same reason at one level down: the focus ring below thickens the
       Border, and a fixed box keeps that inside the grip instead of pushing the row's cells. -->
  <Style Selector="Border.grip">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="22" />
    <!-- Explicitly Transparent, not unset: a Border with a null Background is not hit-testable, so
         an unpainted grip would never receive the pointer press that starts a drag. -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <!-- Declared AFTER the blanket rule so the narrower opt-in wins at equal specificity. -->
  <Style Selector="Border.grip.on">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>
  <Style Selector="Border.grip.on:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <!-- The mockup's grip is the guide-hi token at rest and the muted foreground once its row is
       hovered; the hover rule is declared second so it wins. Both already exist - variant B
       introduced no color at all. -->
  <Style Selector="Border.grip Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource GuideHiBrush}" />
  </Style>
  <Style Selector="Border.data-row:pointerover Border.grip Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <!-- The 2px accent bar marking the insertion point during a drag. It lives in an overlay Panel
       above the rows and is toggled by Opacity, so showing it reflows nothing either. -->
  <Style Selector="Border.dropline">
    <Setter Property="Height" Value="2" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.dropline.on">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- The reference panel's stack-problem banner, held to the same rule as the grip above. It used to
       toggle IsVisible, so appearing pushed BOTH reference sections down the rail - directly under the
       pointer that had just switched a layer on, which is exactly the harm "reserve the space, toggle
       the ink" exists to prevent.

       One trimmed line rather than a wrapping block, with the whole message on the tooltip: the
       engine's text names two pixel sizes and a full-width wrap would reserve a slab big enough to
       shove the sections off the rail in the ordinary case, where there is no problem at all. The
       reserved row is the price of the rule and is deliberate. -->
  <Style Selector="Panel.stackproblem">
    <Setter Property="Height" Value="34" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- Declared AFTER the blanket rule so the narrower opt-in wins at equal specificity. -->
  <Style Selector="Panel.stackproblem.on">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>

  <!-- incompatibility-rules panel (recipe rail + ingredient inspector; explorer.html:365-381) -->
  <Style Selector="Border.rules-panel">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="13,12" />
  </Style>
  <Style Selector="Border.rop">
    <!-- explorer.html: .rrow is align-items:flex-start and .rop carries margin-top:1px, so the mark
         sits beside the FIRST chip. A fixed-size child of a horizontal StackPanel centers itself in
         Avalonia, which floated it between the two chips instead, reading as an orphan. -->
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,1,0,0" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
  </Style>
  <!-- The mark is line art (Icons.axaml IconMark*), not a text glyph, so its color is a Stroke.
       Declared after Path.ico so these win over the default muted stroke. -->
  <Style Selector="Border.rop.exclude">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Path.rop.exclude">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <!-- .require: no low-alpha "info wash" token exists (only KindDynamicBrush itself is
       defined, no tinted background/border variant of it), so this is approximated as a
       KindDynamicBrush foreground + KindDynamicBrush border on a transparent background,
       rather than the mockup's true tinted wash. -->
  <Style Selector="Border.rop.require">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource KindDynamicBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Path.rop.require">
    <Setter Property="Stroke" Value="{DynamicResource KindDynamicBrush}" />
  </Style>
  <!-- explorer.html .fchip: a tinted mono count badge, kind-colored. Used by the cookbook's
       combination-space rows and the recipe hero's factor arithmetic. -->
  <!-- explorer.html .cbk-id: the identity card the name/description/chips live in. They were
       previously orphaned at the top of the pane with no card around them. -->
  <!-- explorer.html .rtotal / .rlabel: the recipe hero's headline number and its caption. -->
  <!-- explorer.html .hueband / .cwmodel: the colorways rail's hue sweep and its model chip. -->
  <!-- explorer.html .rarity .rt: the per-variant share tracks under the ingredient hero. -->
  <Style Selector="Border.rt">
    <Setter Property="Height" Value="7" />
    <Setter Property="Width" Value="120" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.rt > Border">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- ===================== Ingredient editor ===================== -->
  <!-- .toolstrip .ttool: a 30x30 icon button, horizontal, with a real ACTIVE state. The editor
       previously showed seven full-width text buttons in a vertical column and gave no indication of
       which tool was selected. -->
  <Style Selector="Button.ttool">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ttool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.ttool.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.ttool.on Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource OnAccentBrush}" />
  </Style>
  <!-- .tsep: the hairline dividers grouping the strip -->
  <Style Selector="Border.tsep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="3,0" />
  </Style>
  <!-- .ramp: the 96x16 value gradient with its accent pin; .swatch: the resulting gray -->
  <!-- No Width: the ramp fills the Panel that hosts it, so the strip's width budget is stated once
       in the view rather than twice here and there — two numbers that can drift apart, which is how
       the shelf band lost a pixel. -->
  <Style Selector="Border.ramp">
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- .seg: a segmented tray, not two loose radio buttons -->
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Button.seg-b">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="4,7" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.seg-b /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.seg-b.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.seg-b.on">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- .vcard: a horizontal variant row, selected = accent wash + inset bar -->
  <Style Selector="Button.vcard">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.vcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>
  <Style Selector="Button.vcard.sel /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AccentBarShadow}" />
  </Style>
  <!-- .vlock: the dashed "value comes from the grayscale map" notice -->
  <Style Selector="TextBlock.vlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ====================================================================
       Reference-layer panel (ingredient editor's colorize rail), variant B of
       docs/design/mockups/explorations/reference-panel-variants.html: two labeled sections with a
       depth gutter, each row a checkable filmstrip card.

       GEOMETRY IS FIXED, and this is the control the spec names as most likely to break the rule:
       variant B GROWS its rows when a layer activates, because the over/under tag and the placement
       stepper appear. So every one of those already owns its box while absent — fixed cell widths,
       a fixed sub-line height, and Opacity/IsHitTestVisible rather than IsVisible. A row is the same
       height on and off, and the panel is the same width in every state.

       The variant introduced NO new color: every brush below already existed. -->

  <!-- the card a reference row is drawn on. A Border rather than a Button, because a Kitchen row
       carries its own stepper buttons and Avalonia's Button marks a pointer press handled on the way
       up - nesting one inside another is a fight not worth having for a row that already has an
       explicit toggle covering its whole top line. -->
  <Style Selector="Border.refrow">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="8,7" />
  </Style>
  <Style Selector="Border.refrow:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <!-- Declared after the hover rule so the switched-on treatment wins at equal specificity. -->
  <Style Selector="Border.refrow.sel">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AccentBarShadow}" />
  </Style>

  <!-- the layer being authored: the identity card's own gradient, so it reads as THE SUBJECT rather
       than as one more selected row. It carries the accent bar but no checkbox - it is pinned at its
       own depth and cannot be switched off. -->
  <Style Selector="Border.pinrow">
    <Setter Property="Background" Value="{DynamicResource CardGradientBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="BoxShadow" Value="{DynamicResource AccentBarShadow}" />
  </Style>
  <Style Selector="TextBlock.editmark">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- the row's name. Muted and lighter while switched off, so the on-rows read as the composite. -->
  <Style Selector="TextBlock.vname">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.refrow.off TextBlock.vname">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- the depth gutter. A sibling shows a real numeral; a Kitchen file shows an em dash, because it
       has no canonical depth in this recipe at all. Fixed width in both cases. -->
  <Style Selector="TextBlock.dpt">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Width" Value="15" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.dpt.none">
    <Setter Property="Foreground" Value="{DynamicResource GuideHiBrush}" />
  </Style>
  <!-- Declared after the rule above so the narrower case wins. The exploration draws the empty gutter
       in the guide-hi token, which it only ever sits on the page ground: on a SWITCHED-ON row that
       ground becomes the accent wash, where the same token measures 1.97:1 in dark mode - under even
       the receded floor, and found by DarkModeContrastTests rather than by looking. Lifted to the muted
       ink there and only there; the "no canonical depth" signal is the em dash itself, and the fainter
       treatment is kept for the resting row it was designed on. -->
  <Style Selector="Border.refrow.sel TextBlock.dpt.none">
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- the leading checkbox. Ink only: the whole top line is the toggle. -->
  <Style Selector="Border.cbx">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.cbx Path.ico">
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="Border.cbx.on">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.cbx.on Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- the over/under tag. Not derivable from where the row sits: rows 1 and 2 are ABOVE row 3 on
       screen while compositing BENEATH it, which is the one contradiction variant B has to undo in
       words. -->
  <Style Selector="Border.tagx">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="Border.tagx.over">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Border.tagx > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="Border.tagx.over > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- the at-rest caption a row shows instead of its tag: a sibling's variant count, a Kitchen
       file's file name. Shares its box with the tag, which is what keeps the row one height. -->
  <Style Selector="TextBlock.tlabel">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Kitchen provenance chip: the titlebar .kroot chip's exact recipe at chip scale, on a PANEL
       ground rather than the accent wash so it stays legible on a switched-on row. -->
  <Style Selector="Border.kchip">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kchip TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="Border.kchip Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- the placement stepper. Only a Kitchen file gets one, because only a Kitchen file can move: a
       sibling's depth belongs to the Recipe, not to this preview. -->
  <Style Selector="Button.sbtn">
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sbtn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>
  <Style Selector="Button.sbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.sbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <!-- the gap a Kitchen file sits in, written out ("over Ears"). A gap, never a depth - which is
       what lets a placement leave every sibling's numbering exactly where it was. -->
  <Style Selector="TextBlock.sv">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- .nin: the mono end-inputs on a range control -->
  <Style Selector="TextBox.nin">
    <Setter Property="Width" Value="58" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <!-- .nin on a NumericUpDown: the same mono numeric cell as the range inputs above, so the
       toolstrip's brush-size field reads as one of them rather than a full-height Fluent input.
       Width stays in the markup, where the strip's width budget is explained. One /template/ hop to
       the TextBox Fluent puts inside; the spinner is switched off at the call site. -->
  <Style Selector="NumericUpDown.nin">
    <!-- 24, not Fluent's natural 32: this sits in a row with a 20px swatch and a 16px ramp, and a
         box half again their height reads as a different row rather than the same one. The height
         has to go on the INNER TextBox: that is what draws the border, and pinning only the outer
         NumericUpDown clipped the box's top and bottom edges off. The outer control still measures
         32 from its own template, but nothing paints there. -->
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- The quantize steppers. Fluent's two spinner buttons take ~64 of the control's 94, and its
       stock TextBox padding then took most of what was left: "30" rendered as "3" plus a sliver,
       clipped, with the control still reporting the width it was asked for. Trim the inner box's
       padding rather than widening the control: the row has 274px and only 16 spare, and every way
       of buying width (wider control, tighter spacing) spends all 16 and leaves the next style
       tweak nowhere to go. Padding 1 leaves 24px of text room against the 20.2px a three-digit
       value needs - hue quantize reaches 360 and saturation 100, so three digits is the real
       ceiling. One /template/ hop, which is the most a selector may cross. -->
  <Style Selector="NumericUpDown.qnt /template/ TextBox">
    <Setter Property="Padding" Value="1,0" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="NumericUpDown.nin /template/ TextBox">
    <Setter Property="TextAlignment" Value="Center" />
    <!-- Vertically centered explicitly: Fluent's TextBox tops its content, which put the digits
         against the box's upper edge. -->
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="24" />
  </Style>

  <Style Selector="TextBlock.cv">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The gradient band a dual range is drawn over. -->
  <!-- A slider laid over a band is always in one of these, and the height is the whole trick.
       Fluent puts the thumb's CENTER 25px below the Slider's own top, whatever height the Slider is
       given; Slider.overlay then lifts the control by 5. So the handle lands 20px down, and a band
       centered in a 40px row is at 20 too. Pinning the row is what makes that true everywhere
       instead of only where the Slider's natural height happened to be 40 - the dual-range rows
       measured 50, which put every one of their handles 5px ABOVE the bar. The cancelling margin was
       the fix for one row height and the bug for the other; SliderBandAlignmentTests now asserts the
       thing that actually matters, that band center == thumb center, rather than any one number.
       40 is safe: the thumb occupies 10..30 of the row, so nothing clips. -->
  <Style Selector="Panel.band">
    <Setter Property="Height" Value="40" />
  </Style>

  <Style Selector="Border.dualtrack">
    <Setter Property="Height" Value="18" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- A true dual-handle range control does not exist in Avalonia. Rather than hand-author one, the
       two existing Sliders are laid OVER the gradient band with transparent tracks, so all they
       contribute is their ring handles - which is what the mockup's .dual actually shows. -->
  <Style Selector="Slider.overlay">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="Transparent" />
    <!-- THE THUMB IS NOT CENTERED. Fluent's horizontal Slider reserves a tick lane below its track,
         so the handle renders 5px under the control's own middle - measured off a laid-out frame
         (band cy=20, thumb cy=25 in a 40px cell). Every slider in this app is laid OVER something it
         has to line up with, so the whole control is shifted up by exactly that: the margins cancel,
         leaving the height untouched and the handle on the band. SliderAlignmentTests keeps it. -->
    <Setter Property="Margin" Value="0,-5,0,5" />
    <Setter Property="MinHeight" Value="0" />
    <!-- Do NOT pin a Height here, and do not pin one on the Panel this sits in. Fluent lays a
         horizontal Slider out at roughly 40px against the mockup's ~20px range row, and both levers
         were tried: an explicit Height on the Slider and a fixed Height on the containing Panel each
         clipped the ring handles to their top arc, because the template keeps positioning the thumb
         for the taller row it wants. The natural height is the only one that draws a whole handle,
         so the extra row height is absorbed elsewhere in the form. Verified from rendered frames in
         both the ingredient editor and the New Ingredient wizard. -->
  </Style>
  <!-- .sbtn: the 19px quantize steppers -->

  <Style Selector="Border.hueband">
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.cwmodel">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.cwmodel > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.rtotal">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style Selector="TextBlock.rlabel">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <Style Selector="Border.cbk-id">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Background" Value="{DynamicResource CardGradientBrush}" />
  </Style>
  <Style Selector="TextBlock.idname">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.iddesc">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="460" />
    <!-- explorer.html's .iddesc is a block div with max-width: it starts at the card's padding edge
         and stops early. In Avalonia a MaxWidth-capped control whose alignment is the default
         Stretch is CENTERED in the slack instead — so the book's own description floated 205px in,
         under nothing, while the title above and the chips below both began at the card's edge.
         ExplorerView's tree column carries a comment about the same trap; this is the second site. -->
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- .crow: one recipe's combination-space line -->
  <Style Selector="Border.crow">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,11" />
  </Style>
  <Style Selector="Border.cdot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="rotate(45deg)" />
  </Style>
  <Style Selector="TextBlock.cname">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- .cbar: the per-recipe share track -->
  <Style Selector="Border.cbar">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="TextBlock.cshare">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.fchip">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.fchip > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="11" />
  </Style>
  <Style Selector="Border.fchip.kdyn">
    <Setter Property="Background" Value="{DynamicResource KindDynamicWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KindDynamicLineBrush}" />
  </Style>
  <Style Selector="Border.fchip.kdyn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource KindDynamicBrush}" /></Style>
  <Style Selector="Border.fchip.kstat">
    <Setter Property="Background" Value="{DynamicResource KindStaticWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KindStaticLineBrush}" />
  </Style>
  <Style Selector="Border.fchip.kstat > TextBlock"><Setter Property="Foreground" Value="{DynamicResource KindStaticBrush}" /></Style>
  <Style Selector="Border.fchip.kcust">
    <Setter Property="Background" Value="{DynamicResource KindCustomWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource KindCustomLineBrush}" />
  </Style>
  <Style Selector="Border.fchip.kcust > TextBlock"><Setter Property="Foreground" Value="{DynamicResource KindCustomBrush}" /></Style>
  <!-- the x and = that separate the factors -->
  <Style Selector="TextBlock.ftimes">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ceq">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Margin" Value="3,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cnum">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.rchip">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="9,4" />
  </Style>
  <!-- BASELINE, not top. explorer.html's .rchip is align-items:baseline; Avalonia has no baseline
       alignment, and a TextBlock in a horizontal StackPanel defaults to Stretch, which draws its
       line at the TOP of the row. A 9.5px caption beside a 12.5px name then sat 4.7px high — the
       largest text misalignment in the app, and the one that made these chips look broken.
       Bottom is the closest Avalonia has: it flushes the boxes, leaving only the descent
       difference (~0.7px at these sizes) rather than the whole size difference. -->
  <Style Selector="TextBlock.rcl">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="LetterSpacing" Value="0.38" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="TextBlock.rcv">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <!-- .share: the New Recipe wizard's live "Resulting mix" readout. -->
  <Style Selector="Border.share">
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="TextBlock.share-h">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="LetterSpacing" Value="0.95" />   <!-- .1em at 9.5px -->
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="Border.mixbar">
    <Setter Property="Height" Value="7" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- The new Recipe is the accent segment; siblings are muted. Declared before the .other opt-out
       so the narrower rule wins. -->
  <Style Selector="Border.seg-me">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.seg-me.other">
    <Setter Property="Background" Value="{DynamicResource GuideHiBrush}" />
  </Style>
  <Style Selector="Border.swatch-me">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.swatch-me.other">
    <Setter Property="Background" Value="{DynamicResource GuideHiBrush}" />
  </Style>
  <Style Selector="TextBlock.lgn">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.lgn.cur">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- .hflag: the hero's accent rule-count pill. Fully rounded, accent ink on accent wash. -->
  <!-- RadiusXs, not a pill. Every badge here is the .idchip shape; a capsule among them reads
       as a different kind of thing. The pill radius stays on the BARS (.rt, .cbar), where the
       shape means "track" and not "badge". -->
  <Style Selector="Button.hflag">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="9,3" />
  </Style>
  <Style Selector="Button.hflag /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.hflag:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
  </Style>
  <Style Selector="Button.hflag TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.hflag Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- .cwcustom: the 56px art swatch and its note, shown instead of a hue band for a Custom layer. -->
  <Style Selector="Border.cwsw">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cwnote">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="LineHeight" Value="18" />   <!-- 1.5 -->
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- colorways rail panel (ingredient inspector; explorer.html:385-400) -->
  <Style Selector="Border.cw-panel">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="13,12" />
  </Style>
  <Style Selector="Border.cwaxis">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,8" />
  </Style>
  <Style Selector="TextBlock.ax">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.1" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.av">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="TextBlock.av.der">
    <Setter Property="FontStyle" Value="Italic" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- recipe portrait hero / variant hero tiles (explorer.html:283-296, 313-321) -->
  <Style Selector="Border.rhero">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style Selector="Border.vhero">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- ====================================================================
       Application shell (titlebar + status bar), explorer.html .kroot /
       .lockflag / .statusbar / .zoomctl / .helpbtn. -->

  <!-- persistent workspace-root chip (explorer.html .kroot) -->
  <Style Selector="Border.kroot">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="7,3,9,3" />
  </Style>
  <Style Selector="Border.kroot Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="TextBlock.kroot-txt">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- edit-lock state pill (explorer.html .lockflag) -->
  <Style Selector="Border.lockflag">
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="TextBlock.lockflag-txt">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- status bar text (explorer.html .statusbar: mono 11.5px, tabular numerals) -->
  <Style Selector="TextBlock.sbar">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The validity pill. Not-valid is the WARNING color, not the accent: accent means "editing" one
       row over, and two different meanings sharing a color in the same bar is worse than either.
       .ok variants declared after the base so they win at equal specificity. -->
  <Style Selector="Ellipse.vdot">
    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Ellipse.vdot.ok">
    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.vstate">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.vstate.ok">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <!-- explorer.html: .statusbar .state.editing takes the accent color. Declared after the blanket
       .sbar rule, which sets Foreground explicitly and would otherwise win. -->
  <Style Selector="TextBlock.sbar.editing">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Path.ico.editing">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- status bar zoom controls: bordered 24x24 squares (explorer.html .zoomctl button) -->
  <Style Selector="Button.zoomctl">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.zoomctl /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>
  <Style Selector="Button.zoomctl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.zoomctl:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>

  <!-- status bar help trigger: accent-wash tile (explorer.html .helpbtn) -->
  <Style Selector="Button.helpbtn">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.helpbtn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.helpbtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.helpbtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
  </Style>
  <Style Selector="Button.helpbtn Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- ===================== Quick-reference sheet (help.html) =====================
       A fixed 780px three-column card, summoned over whatever the user is doing. Every class below
       is scoped `sh-` because the sheet re-uses several mockup class NAMES (.slbl, .t, .s, .k) at
       its own sizes; the shared ones stay whatever the rest of the app already made them. -->
  <Style Selector="Border.sheet">
    <Setter Property="Width" Value="820" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource WinShadow}" />
    <Setter Property="ClipToBounds" Value="True" />   <!-- so the footer band respects the radius -->
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.sh-h">
    <Setter Property="Padding" Value="20,15" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- .sheet .slbl is its OWN scale — mono 11px/600, not the app-wide sans 10px TextBlock.slbl.
       Declared after it so the overrides win; the margin is the column-label one (14px), which the
       header and second-in-column labels override inline, mirroring the mockup's `.slbl + .slbl`. -->
  <Style Selector="TextBlock.slbl.sh">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.54" />   <!-- .14em at 11px -->
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- .esc — a chip in the mockup, a Button here: Escape (the KeyBinding) is otherwise the sheet's
       ONLY way out, and the scrim behind it does not dismiss. Fluent's hover/pressed fills are
       neutralized explicitly rather than left unset, which would hand the states back to its blue. -->
  <Style Selector="Button.esc">
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.esc /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Button.esc:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="Button.esc:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
  </Style>
  <!-- Avalonia 12 makes LetterSpacing settable on the control (TemplatedControl.LetterSpacing, and
       inheritable via TextElement), so the tracked label no longer has to be a real TextBlock inside
       the button - a plain Content string now tracks correctly. -->
  <Style Selector="Button.esc">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.0" />   <!-- .1em at 10px -->
  </Style>

  <!-- .col / .col + .col: the reference columns, divided by a left hairline. -->
  <Style Selector="Border.sh-col">
    <Setter Property="Padding" Value="20,18,20,20" />
  </Style>
  <Style Selector="Border.sh-col.div">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <!-- .e — one strict 20px glyph gutter (its ColumnDefinitions stay in the view; a Setter would
       share one ColumnDefinitions instance across every entry). .g is the 16px-tall gutter cell:
       Path.ico sets an explicit Width, which under the default Stretch alignment would pin the
       glyph to the cell's left edge rather than centering it in the 20px column. -->
  <!-- The 10px gap between gutter and content is ColumnSpacing, set on the grid itself. It used to be
       a left margin on whatever occupied the content column, because Grid.ColumnSpacing only arrived
       in Avalonia 11.3 and this app was on 11.2.3; the app is on 12.1.1 now, so the workaround and
       the rule that carried it are gone. -->
  <Style Selector="Grid.sh-e">
    <Setter Property="Margin" Value="0,0,0,11" />
    <Setter Property="ColumnSpacing" Value="10" />
  </Style>
  <Style Selector="Grid.sh-kline">
    <Setter Property="Margin" Value="0,0,0,9" />
    <Setter Property="ColumnSpacing" Value="10" />
  </Style>
  <!-- `align-items:start`. Avalonia's ArrangeCore treats Stretch as Center once an explicit Height
       is set, so without this the 16px gutter cell floats to the middle of a two-line entry and the
       glyph sits beside the SUBTITLE rather than beside its term. -->
  <Style Selector="Panel.sh-g">
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Panel.sh-g > Path, Panel.sh-g > TextBlock, Panel.sh-g > Ellipse">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- .t / .t.plain / .s — the term, the weight-400 rules variant, and the explanatory line. -->
  <Style Selector="TextBlock.sh-t">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="15.6" />   <!-- 1.25 -->
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.sh-t.plain">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Padding" Value="0,1,0,0" />
  </Style>
  <Style Selector="TextBlock.sh-s">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="LineHeight" Value="17.25" />   <!-- 1.5 -->
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,3,0,0" />
  </Style>

  <!-- The nesting line under THE SIX WORDS. Sits tight under the label (negative top margin) so it
       reads as part of the header rather than as a first entry. -->
  <Style Selector="TextBlock.sh-chain">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="LineHeight" Value="15" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,-5,0,13" />
  </Style>

  <!-- The rule above Kitchen. Dashed, because it separates a DIFFERENT KIND of thing from the chain
       above it rather than one list item from the next; a solid hairline reads as a divider between
       peers, which is the opposite of the point. -->
  <Style Selector="Border.sh-split">
    <Setter Property="Margin" Value="0,15,0,15" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

<!-- A tile's caption is muted by default and accent when selected. Two classes rather than two
       BOUND classes: the tile is the unit this grid realizes hundreds of, so binding both
       `Classes.muted` and `Classes.accent` to complementary values cost a binding per tile for a
       state one class already carries. Declared first so .accent wins the tie at equal
       specificity. -->
  <Style Selector="TextBlock.tcap">
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <!-- The selected tile's caption — the whole selected-state marker now that the tile's accent
       border is gone. -->
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- The loading placeholder: a 13px diamond at the tile's center, fading between 10% and 26% on
       a 2.4s cycle. Deliberately the quietest thing that still says "working" — no direction and no
       travel, so a screen of them reads as texture rather than as forty separate animations.

       IsVisible is right here and not the usual Opacity: this occupies no layout at all (it shares a
       Panel cell with the image), so nothing can reflow when it goes. The geometry rule is about
       controls that take space. -->
  <Style Selector="Border.tload">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="rotate(45deg)" />
    <Setter Property="Opacity" Value="0.10" />
  </Style>
  <Style Selector="Border.tload">
    <Style.Animations>
      <Animation Duration="0:0:2.4" IterationCount="INFINITE" PlaybackDirection="Alternate"
                 Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.10" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.26" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===== Set browser: hover, the rail, and the asset inspector ===== -->

  <!-- Hover is a row AND a cell, which together read as a crosshair over the grid: the row washes,
       and the cell under the pointer washes one step further. Background only - nothing here may
       change a size, or the whole grid reflows under the pointer. -->
  <Style Selector="Border.trow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="7,6" />
  </Style>
  <!-- The tile grid is a ListBox only because ListBox is the one control here that virtualizes
       (see SetBrowserView's note). Its unit is a ROW, which is not a thing a user selects - so every
       state Fluent paints on a ListBoxItem is a second, wider indicator sitting under this app's
       own, and right-clicking added a focus ring around it as well. Three highlights for one row.

       Neutralise them EXPLICITLY rather than by omission: not painting a state hands it back to
       Fluent's stock blue. -->
  <Style Selector="ListBox.tiles > ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ListBox.tiles > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="ListBox.tiles > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tiles > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tiles > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tiles > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tiles > ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tiles > ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.trow:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>
  <Style Selector="Button.tcell">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>
  <Style Selector="Button.tcell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
  </Style>

  <!-- The recipe, as a tag rather than a gray word: it is the asset's TYPE, which is also the first
       row of the rarity table, so it should not read as a caption. -->
  <Style Selector="Border.rtag">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.rtag > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- The DNA block. Centered because both rows are exactly half of a 64-character hash and so
       exactly the same width: centering makes both edges line up instead of only the left, which is
       what turns a wrapped string into a deliberate block. -->
  <Style Selector="Border.dnabox">
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="8,9" />
  </Style>
  <Style Selector="Border.dnabox TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- Rarity percentages, banded. Rare is the reason anyone opens this rail; a flat column of gray
       numbers makes the one that matters look like the five that do not. -->
  <Style Selector="TextBlock.pct.rare">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.pct.mid">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
  </Style>
  <Style Selector="TextBlock.pct.common">
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <!-- The bar spans the ROW, not the row's content box: the negative margin cancels
       Border.data-row's 10px padding on both sides, so the bar starts before the trait name rather
       than under its first letter. Sharing an edge with the text made the text look like it was
       sitting on the bar; a 10px lead-in makes it look like it is inside it.

       A defined height rather than the row's own, so there is air above and below and the wash reads
       as a band instead of a filled row. And a minimum width, because a rounded bar at 1% would
       otherwise draw as a two-pixel sliver that reads as a rendering fault. -->
  <Style Selector="Rectangle.rarbar">
    <Setter Property="Fill" Value="{DynamicResource RarityBarBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="-10,0" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="RadiusX" Value="5" />
    <Setter Property="RadiusY" Value="5" />
  </Style>

  <!-- Save: present at the rail's foot for every asset, so the rail is one height and the rarity
       list scrolls under it rather than pushing it around. -->
  <!-- Same again, at the rail's RadiusMd. -->
  <Style Selector="Border.rail-foot">
    <Setter Property="CornerRadius" Value="0,0,6,6" />
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Button.savebtn">
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.savebtn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.savebtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.savebtn Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- ===== the inspector modal ===== -->
  <Style Selector="Border.inspect">
    <Setter Property="Width" Value="900" />
    <Setter Property="Height" Value="620" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
    <Setter Property="BoxShadow" Value="{DynamicResource WinShadow}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
<!-- The inspector's zoom slider is the one slider in this app with a track of its OWN, so it
       cannot take Slider.overlay: that class paints Background and Foreground transparent precisely
       because every other slider here is laid over a band it must not hide. It rendered as a lone
       ring floating between the two zoom buttons.

       The cancelling margin is repeated inline rather than inherited, per the same rule: Fluent's
       horizontal Slider reserves a tick lane below its track and draws the handle 5px under the
       control's own middle. -->
  <Style Selector="Slider.ins-z">
    <Setter Property="Background" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,-5,0,5" />
  </Style>

    <Style Selector="Border.ins-h">
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="TextBlock.ins-no">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ins-dna">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Same as Border.sh-f: the band has to round its own bottom corners or it squares off the
       modal's. -->
  <Style Selector="Border.ins-f">
    <Setter Property="CornerRadius" Value="0,0,8,8" />
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Button.insb">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ins-zv">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Width" Value="42" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.ins-hint">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

    <!-- .kline / .k — the keyboard rows. Border.kbd already carries the chip's border, radius and
       mono 10.5 ink; only the fill, the flatter padding and the centered glyph differ here. -->
  <Style Selector="Border.kbd.sh-k">
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="Padding" Value="0,2" />
  </Style>
  <Style Selector="Border.kbd.sh-k > TextBlock">
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.sh-kdesc">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- .cs / .fine — the color-spec rows and the note under them. -->
  <Style Selector="TextBlock.sh-cs">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.sh-cs.pre">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="TextBlock.sh-fine">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="LineHeight" Value="15.75" />   <!-- 1.5 -->
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,10,0,0" />
  </Style>

  <!-- .sh-f / .dna / .dnaeq — the footer band. -->
  <!-- The footer band carries the sheet's own bottom radius. ClipToBounds on Border.sheet clips to
       the layout RECTANGLE, not to the corner radius, so this band's square background painted over
       the rounded corner and cut the border's arc off at both bottom corners. -->
  <Style Selector="Border.sh-f">
    <Setter Property="CornerRadius" Value="0,0,8,8" />
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style Selector="TextBlock.sh-dna">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="LineHeight" Value="17.25" />   <!-- 1.5 -->
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd.sh-eq">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Margin" Value="12,0,0,0" />
  </Style>

  <!-- Mono-bodied screens. landing.html and the three wizard-*.html mockups declare only the mono
       font token (no sans token exists at all in any of those four files) and set it on the window
       container, so every descendant inherits mono. explorer.html / help.html / ingredient-editor.html
       declare BOTH tokens and use sans for body with mono as an accent - which is what the blanket
       TextBlock rule at the top of this file implements. The split is real and it is in the locked
       mockups, so it is reproduced here rather than normalized away.

       This must be declared AFTER the blanket "TextBlock" rule: that rule sets FontFamily explicitly,
       which defeats normal inheritance, so setting FontFamily on an ancestor alone would not reach
       the text. The descendant selector re-overrides it for these four views only.

       The class is carried on each view's outermost CHILD (Grid / Border), not on the UserControl
       root - a Classes attribute on a UserControl's own XAML root did not reach this selector,
       whereas anchoring on a child element matches the pattern already used throughout this file
       (Button.landing TextBlock.lbl, Border.metric.accent TextBlock.mv). -->
  <Style Selector="Grid.monoform TextBlock, Border.monoform TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>
  <Style Selector="Grid.monoform TextBox, Border.monoform TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>
  <Style Selector="Grid.monoform Button, Border.monoform Button">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>
  <Style Selector="Grid.monoform NumericUpDown, Border.monoform NumericUpDown">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>

  <!-- The stats/inspect report body. Mono and never wrapped: both reports are column-aligned, and
       rewrapping them destroys the alignment that makes them readable. -->
  <Style Selector="Border.reportbox">
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="220" />
  </Style>
  <Style Selector="SelectableTextBlock.reporttext">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- ==================== Palette strip (color mode) ====================
       A second 40px row under the toolstrip, carrying the ramp mode, the ten slots, the saved
       swatches, the alpha axis and the opacity lock. New to the app: the locked mockup set predates
       color mode, so this is built from that set's own grammar (see
       docs/design/mockups/explorations/palette-panel-variants.html, variant A).

       GEOMETRY IS FIXED. The row is one height in both modes and both lock states: the ten slots
       change fill rather than count, the saved run scrolls inside its own cell instead of pushing
       its neighbours, and the alpha control is dimmed and un-hittable while locked rather than
       absent — so unlocking moves nothing. -->
  <Style Selector="Border.pstrip">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- .sw: one palette cell. The color is painted by the CHILD Border, not by the Button's own
       Background, because Fluent repaints PART_ContentPresenter's Background on :pointerover and
       :pressed at a priority a Setter here cannot beat — a swatch would flash gray under the cursor.
       Painting the color on top of that surface sidesteps the fight entirely. -->
  <Style Selector="Button.sw">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sw /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.sw:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <Style Selector="Button.sw:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Selected: the accent ring is the button's own border plus a 2px inset on the color, so the
       ring is legible at 22px without any change to the cell's outer size. -->
  <Style Selector="Button.sw.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.sw.on Border.swfill">
    <Setter Property="Margin" Value="2" />
  </Style>
  <Style Selector="Button.sw.add">
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
  </Style>
  <Style Selector="Button.sw.add Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- .pmode: the gray/color tray. Same grammar as .seg, sized for a 40px row. -->
  <Style Selector="Border.seg.mini">
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.seg-b.mini">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
  </Style>

  <!-- The alpha axis. Reserved in the layout at all times; dimmed and inert while the lock is on,
       which is the no-reflow rule applied to a control that only sometimes does anything. -->
  <Style Selector="StackPanel.alphacell.off">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- Only the SLIDER is dimmed. Dimming the caption too put "A" at 1.64:1 in light mode
       (DarkModeContrastTests) — the app's disabled convention is 0.38 opacity, and 0.38 of an
       already-muted foreground is below any legibility floor. The control carries the inactive
       state; its label only has to say which control it is. -->
  <Style Selector="StackPanel.alphacell.off > Slider">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <!-- ==================== Pixel-perfect scaling ====================
       EVERY image this app shows is generated pixel art: a variant raster, a composited preview, a
       set thumbnail. All of it is displayed at a size that has nothing to do with its pixel count —
       an 8x8 variant fills a 320px canvas tile, a 64x64 asset fills a 120px card — and Avalonia's
       default scaling filter blurs each of those into mush. The rule is NEAREST NEIGHBOUR
       everywhere: a 32x32 sprite shown at 320px must be 10x10 hard squares.

       It is NOT set here, though it belongs here. In Avalonia 12 RenderOptions is a Get/Set pair
       rather than an AvaloniaProperty, so `<Setter Property="RenderOptions.BitmapInterpolationMode">`
       does not compile ("Unable to find BitmapInterpolationModeProperty field") — it is only usable
       as an attribute on an element. So it is set on each VIEW ROOT instead, where it inherits down
       to every Image in that view, and PixelPerfectRenderingTests walks every view and fails naming
       any that forgot. That test is the rule; these lines only say why it could not live here.

       This governs DISPLAY only. Nothing in Nfty.Core resamples, blurs or anti-aliases a variant:
       every edit command writes whole pixels, import refuses an image that is not exactly the canvas
       size rather than scaling it, and colorization is per-pixel. -->

  <!-- ==================== Kitchen shelf (Landing) ====================
       The workspace's own contents, as one row of cards paged by kind. See
       docs/design/mockups/explorations/kitchen-shelf.html.

       GEOMETRY IS FIXED, in its strictest form: the band is ALWAYS present at ALWAYS the same
       height — a Kitchen open, no Kitchen, an empty Kitchen — so opening or closing a workspace
       swaps the ink inside a box that never moves. That permanence is also the argument the design
       makes: the Kitchen is not something a CookBook has, it is a shelf the app always carries.

       The band deliberately holds NO Open-Kitchen or New-CookBook button of its own. Those already
       sit in the Create and Open groups a few inches to the left, and two controls for one action a
       few inches apart is worse than one; the band names them in prose instead. -->
  <!-- No explicit Height: the band's rows are fixed (20 head / 9 gap / 52 row) and its padding is
       fixed, so its height already is. A second declaration of the same number is a number that can
       come to disagree with the first — and it did, by a pixel. What has to be true is that all
       three STATES are the same height, which is what KitchenShelfLayoutTests measures. -->
  <Style Selector="Border.kshelf">
    <Setter Property="Padding" Value="38,11,38,13" />
    <Setter Property="Background" Value="{DynamicResource BgAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- One card. Equal-width and filling the row, so a wider window shows more per page rather than
       leaving a gap; a short final page keeps its empty slots so the row never re-spaces itself. -->
  <Style Selector="Button.kcard">
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.kcard /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
  </Style>
  <Style Selector="Button.kcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>
  <!-- An empty slot holds the space and shows nothing: the row's shape is the point of it. -->
  <Style Selector="Button.kcard.slot">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The card's kind tile, matching the Recent list's: accent for a CookBook, muted for a loose part. -->
  <Style Selector="Border.ktile">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.ktile.loose">
    <Setter Property="Background" Value="{DynamicResource TileBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>
  <Style Selector="Border.ktile Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Border.ktile.loose Path.ico">
    <Setter Property="Stroke" Value="{DynamicResource FgMutedBrush}" />
  </Style>

  <!-- The pager's chevrons keep their boxes at both ends and lose only their ink, so nothing beside
       them moves when you reach the first or last page. Same rule as the editor's alpha control. -->
  <Style Selector="Button.kchev">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.kchev /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
  </Style>
  <Style Selector="Button.kchev:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
  </Style>

  <!-- The two non-list states carry NO style of their own: they sit in the shelf grid's own 52px
       row alongside the card row, so all three states are the same height by construction rather
       than by three declarations agreeing. A style here would be a fourth place to change. -->

  <!-- ==================== Ends of lists ====================
       Three rules the locked mockups state and the app had not carried over: a separator belongs
       BETWEEN rows, not after the last one or before the first. explorer.html says so three times —
       `.crow:last-of-type`, `.rrow:last-child`, `.cwaxis:first-child` — and each showed as a rule
       with nothing on the other side of it.

       Expressed with :nth-child / :nth-last-child on the generated ContentPresenter, which is what
       the CSS pseudo-classes actually mean, rather than by threading an IsFirst/IsLast flag through
       three record types and their construction sites. A row still cannot know its own position; the
       selector asks its container, which can. -->
  <Style Selector="ItemsControl > ContentPresenter:nth-last-child(1) > Border.crow">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,11,0,3" />
  </Style>

  <Style Selector="Border.rulerow">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,9" />
  </Style>
  <Style Selector="ItemsControl > ContentPresenter:nth-last-child(1) > Border.rulerow">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,9,0,2" />
  </Style>

  <Style Selector="ItemsControl > ContentPresenter:nth-child(1) > Border.cwaxis">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4,0,8" />
  </Style>
</Styles>
