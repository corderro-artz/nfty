<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Input ControlThemes: each is BasedOn the built-in Fluent theme for that control (looked up via
    the self-referencing "{StaticResource {x:Type X}}" pattern — a StaticResource lookup from
    inside a dictionary entry skips the entry currently being defined, so it resolves to Fluent's
    own registration of that key instead of looping back to this one; confirmed against the
    Avalonia 11.2 docs' "restyle a built-in control" and "make all Buttons round" ControlTheme
    examples). Being keyed by "{x:Type X}" (not an arbitrary name) makes each theme apply to every
    instance of that control automatically — no Classes needed on call sites.

    Colors pull from Tokens.axaml via DynamicResource so both ThemeVariants stay correct.

    Mechanism notes (from reading the actual Fluent theme XAML at 11.2.3, the version current when
    these were written; the app is on 12.1.1 now — see task-5-report.md for
    the full doc-pull):
      - TextBox / NumericUpDown / ButtonSpinner: Background/BorderBrush are TemplateBound straight
        through from the control's own properties to the visible Border, so a plain property Setter
        reaches the fill at rest. Fluent's own ":pointerover"/":focus" states repaint
        Border#PART_BorderElement directly (bypassing the TemplateBinding) at Style priority, so
        reaching those states needs a same-selector nested Style here, declared after the inherited
        one so it wins on equal specificity (the same technique already used for Button.tbtn's hover
        border in Styles.axaml).
      - Slider: Foreground/Background TemplateBind through to the PART_DecreaseButton (filled track)
        and PART_IncreaseButton (track) at rest, but the Thumb's Background and every hover/pressed
        track color are hardcoded DynamicResource references baked directly into Fluent's shared
        ControlTemplate (not TemplateBound) — reached the same way, via same-selector nested Styles.
      - CheckBox / RadioButton: the actual check glyph/box (Border#NormalRectangle,
        Ellipse#CheckOuterEllipse, Path#CheckGlyph, Ellipse#CheckGlyph) are hardcoded DynamicResource
        fills on shared template elements, not TemplateBound to the control's Background/Foreground
        at all — a plain top-level Setter genuinely cannot reach them. These are the controls where
        hand-authoring a full template would otherwise be tempting; nested Styles matching Fluent's
        own selectors avoid that.
  -->

  <!-- ================= TextBox ================= -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox"
                BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}" />
    <!-- The mockups' .in: a uniform 32px field at 12.5px. Fluent's default is ~40px at 14px, which
         made every form read a size too large. MinHeight (not Height) so a multi-line Description
         box can still grow. -->
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentWashBrush}" />

    <!-- PointerOver: accent-tinted border, panel background unchanged (mirrors Button.tbtn hover). -->
    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>

    <!-- Focused: full accent border. -->
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= NumericUpDown ================= -->
  <!-- Background/BorderBrush/CornerRadius TemplateBind through NumericUpDown -> ButtonSpinner
       (PART_Spinner) -> the spinner's own Border, so property Setters are enough; the inner
       PART_TextBox is hardcoded Background="Transparent" BorderBrush="Transparent" in Fluent's own
       template (a local value, so it always wins over any Style/ControlTheme setter), which is what
       keeps NumericUpDown from showing a double border. -->
  <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown"
                BasedOn="{StaticResource {x:Type NumericUpDown}}">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource FieldHeight}" />
    <Setter Property="FontSize" Value="12.5" />

    <!-- The spinner must not carry a floor of its own: it is the thing that draws, so a
         NumericUpDown asked for the compact height would keep the form height here and clip. It
         inherits whatever the outer control was given instead. -->
    <Style Selector="^ /template/ ButtonSpinner">
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </ControlTheme>

  <!-- ================= ButtonSpinner ================= -->
  <!-- HAND-AUTHORED TEMPLATE, and the reason is the one thing a Style setter could not buy.
       Fluent's ButtonSpinner draws two side-by-side buttons roughly 32px wide apiece, so a
       NumericUpDown spent ~64 of its width on chevrons and the field beside them read as an
       afterthought: at Width="94" the quantize steppers had about 8px of text room and rendered
       "30" as "3" plus a sliver. Both the button width and the panel that lays them out are fixed
       inside Fluent's own template at a priority a Style setter does not beat - Width setters were
       tried against a rendered frame (bare "RepeatButton" and the named PART_ parts) and changed
       nothing. The note that used to sit here called closing that gap "out of proportion to the
       gap"; it is not, once the gap is every numeric input in the app.
       What this template is: the mockups' .stepr, a narrow COLUMN of two chevrons on the field's
       trailing edge, at StepperWidth (17). PART_IncreaseButton / PART_DecreaseButton are the two
       names ButtonSpinner.OnApplyTemplate looks up; it hooks their Click and drives their IsEnabled
       from ValidSpinDirections itself, so limit behavior is template-independent and survives this.
       ButtonSpinnerLocation="Left" is NOT supported here (nothing in this app asks for it) - the
       steppers are always trailing. -->
  <ControlTheme x:Key="SpinnerChevron" TargetType="RepeatButton">
    <!-- Fluent's RepeatButton is templated too, and every one of its states would have to be
         neutralized one at a time. Authoring the two-element template instead is shorter than the
         list of things to switch off, and leaves no state that can hand itself back to Fluent. -->
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ChevronWash"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#ChevronWash">
      <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#ChevronWash">
      <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
    </Style>
    <!-- A stepper at its limit must read as unavailable, never as hovered. Fluent's disabled wash
         was the one control in the app that got BRIGHTER when it stopped working; here nothing
         paints a disabled state at all, so the whole treatment is this one opacity. -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.32" />
    </Style>
    <Style Selector="^:disabled /template/ Border#ChevronWash">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="MinHeight" Value="{DynamicResource FieldHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_BorderElement"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                MinHeight="{TemplateBinding MinHeight}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Grid.Column="0" Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <!-- The whole column is 17 wide and inset 2 from the field's border, so the two
                 chevrons stack inside the rounded corner rather than over it. Reserved by the
                 Grid's Auto column, so the text cell it leaves behind is exact at any width. -->
            <Grid Grid.Column="1" Name="PART_Steppers" RowDefinitions="*,*"
                  Width="{DynamicResource StepperWidth}" Margin="0,2,3,2"
                  IsVisible="{TemplateBinding ShowButtonSpinner}">
              <RepeatButton Grid.Row="0" Name="PART_IncreaseButton"
                            Theme="{StaticResource SpinnerChevron}">
                <Path Classes="ico st" Data="{StaticResource IconChevronUp}" />
              </RepeatButton>
              <RepeatButton Grid.Row="1" Name="PART_DecreaseButton"
                            Theme="{StaticResource SpinnerChevron}">
                <Path Classes="ico st" Data="{StaticResource IconChevronDown}" />
              </RepeatButton>
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- Fluent repaints PART_BorderElement directly on these states, bypassing the TemplateBinding;
         this template has no such rule, so the two states are stated here and nowhere else. -->
    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>
    <Style Selector="^:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>



  <!-- ================= Slider ================= -->
  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider"
                BasedOn="{StaticResource {x:Type Slider}}">
    <!-- Foreground drives PART_DecreaseButton (the filled/value side of the track); Background
         drives PART_IncreaseButton (the unfilled side) — both via TemplateBinding chains in
         Fluent's own Slider template. -->
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />

    <!-- Thumb background is hardcoded DynamicResource in Fluent's shared template, not
         TemplateBound to Slider's own properties — it's assigned at Avalonia's "Template"
         BindingPriority, which beats a plain (pseudo-class-free) Style setter, so
         "^ /template/ Thumb" alone is silently no-op (confirmed — see task-5-report.md).
         Only a pseudo-class-qualified selector runs at "StyleTrigger" priority, which does beat
         Template — ":not(:disabled)" is the pseudo-class-qualified stand-in for "rest", declared
         before (so lower tie-break priority than) the ":pointerover"/":pressed" overrides below. -->
    <Style Selector="^:not(:disabled) /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <!-- Fluent's own :pointerover/:pressed styles repaint the track RepeatButtons with its own
         (blue-tinted) resources at Style priority, bypassing the TemplateBinding above — override
         with the same selectors so our accent (not Fluent's) wins in every state. -->
    <Style Selector="^:pointerover /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="^:pointerover /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    </Style>
    <Style Selector="^:pressed /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
    </Style>

    <!-- The mockup's handle is a 14px RING (panel fill, 2px accent stroke), not Fluent's solid dot.
         Retemplating the Thumb reaches it.

         KNOWN GAP (the ButtonSpinner one above is now closed, by hand-authoring its template — the
         same move would close this): the mockup's TRACK is a 6px rounded bar
         with a hairline border, and ours stays Fluent's ~2px line. Height/CornerRadius setters aimed
         at both Border#TrackBackground and the two track RepeatButtons were tried and verified
         against a rendered frame - Fluent's Slider template fixes the track geometry at a priority a
         Style setter does not beat. Closing it means hand-authoring the Slider template. -->
    <Style Selector="^ /template/ Thumb">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Template">
        <ControlTemplate>
          <!-- OnAccentBrush, not PanelBrush: this knob sits on a saturated band, which is exactly
               what that token means. PanelBrush is near-black in dark mode, so the handle read as a
               HOLE punched through the hue bar rather than a control resting on it - correct in
               light, wrong in dark, and invisible to any single-theme check. -->
          <Ellipse Width="14" Height="14"
                   Fill="{DynamicResource OnAccentBrush}"
                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <!-- ================= CheckBox ================= -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox"
                BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />

    <!-- Unchecked box: panel fill, line-strong stroke. NormalRectangle's colors are hardcoded
         DynamicResource in Fluent's shared template (Avalonia "Template" priority), not
         TemplateBound, so a plain (pseudo-class-free) Style setter is silently a no-op here
         (confirmed — see task-5-report.md); ":not(:disabled)" is pseudo-class-qualified so it
         runs at the higher "StyleTrigger" priority that does win over Template, same technique
         used for the Slider Thumb above. Declared before ":checked"/":indeterminate" below so
         those still win on tie-break declaration order when active. -->
    <Style Selector="^:not(:disabled) /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    </Style>

    <!-- Checked box: accent fill, white glyph. -->
    <Style Selector="^:checked /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}" />
    </Style>

    <!-- Indeterminate box: same accent treatment as checked. -->
    <Style Selector="^:indeterminate /template/ Border#NormalRectangle">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Path#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource OnAccentBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= RadioButton ================= -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton"
                BasedOn="{StaticResource {x:Type RadioButton}}">
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />

    <!-- Unchecked ring: panel fill, line-strong stroke. Same "Template priority beats a plain
         Style setter" issue as CheckBox's NormalRectangle above — ":not(:disabled)" gets the
         StyleTrigger priority needed to win; declared before ":checked" below so that still wins
         on tie-break declaration order when active. -->
    <Style Selector="^:not(:disabled) /template/ Ellipse#OuterEllipse">
      <Setter Property="Fill" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource LineStrongBrush}" />
    </Style>

    <!-- Checked ring + inner dot: accent. -->
    <Style Selector="^:checked /template/ Ellipse#CheckOuterEllipse">
      <Setter Property="Fill" Value="{DynamicResource PanelBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= ToggleButton ================= -->
  <!-- ToggleButton is a ButtonBase (same lineage as Button), and Fluent's own default ToggleButton
       template follows the same ContentPresenter#PART_ContentPresenter idiom as Button (confirmed
       against the Avalonia docs' own restyle walkthroughs — a plain ContentPresenter#PART_ContentPresenter
       is the template's content host for every ButtonBase-derived control). Left un-themed, a bare
       ToggleButton falls through to Fluent's SystemAccentColor (stock #0078d7 blue) for its checked
       state — the aspect-lock toggle in NewCookBookView is the one place this app uses a raw
       ToggleButton, and it painted Fluent blue in both themes (audit finding: wizard-cookbook-*.png).
       Sized 22x22 to match the mockup's `.link .lk` (wizard-cookbook.html:91-93). -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton"
                BasedOn="{StaticResource {x:Type ToggleButton}}">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />

    <!-- Checked: accent wash/line/text, mirroring the mockup's `.link.on .lk` rule. -->
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentWashBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
  </ControlTheme>

  <!-- ================= ProgressBar ================= -->
  <!-- ProgressBar's PART_Indicator Border is TemplateBound to Foreground (the filled portion) and
       the track to Background, so plain property Setters reach both without needing a template
       part override (confirmed against the Avalonia docs' ProgressBar styling page: "Set Foreground
       and Background properties directly to change the indicator and track colors"). Left
       un-themed, ProgressBar falls through to Fluent's SystemAccentColor — the recipe wizard's
       weight-preview bar painted Fluent blue in both themes (audit finding: wizard-recipe-*.png).
       This is the finding's simpler fallback fix (a ControlTheme) rather than replacing the control
       with a segmented bar + legend, which belongs to the later wizard-restructure slice. -->
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar"
                BasedOn="{StaticResource {x:Type ProgressBar}}">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource BgAlt2Brush}" />
  </ControlTheme>

  <!-- ================= TreeViewItem ================= -->
  <!-- Mechanism confirmed by reading the actual Fluent source at 11.2.3 (not just the generic
       treeview-how-to.md doc example), pulled from
       github.com/AvaloniaUI/Avalonia/blob/11.2.3/src/Avalonia.Themes.Fluent/Controls/TreeViewItem.xaml:
       the template is
         StackPanel > { Border#PART_LayoutRoot > Grid#PART_Header { Panel#PART_ExpandCollapseChevronContainer
           > ToggleButton#PART_ExpandCollapseChevron, ContentPresenter#PART_HeaderPresenter },
           ItemsPresenter#PART_ItemsPresenter }
       Background/BorderBrush/CornerRadius are TemplateBound onto Border#PART_LayoutRoot at rest,
       but Fluent's own nested Styles repaint that same Border's Background/BorderBrush at Style
       priority for :pointerover/:selected/:pressed/:disabled (PART_HeaderPresenter only ever gets
       a Foreground change) — so, exactly like Button's PART_ContentPresenter elsewhere in this
       file, our state overrides must target Border#PART_LayoutRoot, not a bare
       "TreeViewItem:selected" selector (which would be silently beaten by Fluent's own part-level
       style).

       Both the highlight and the branch guide are drawn by the ITEM TEMPLATE (Border.node and
       Border.guide in Styles.axaml) rather than by this theme, because PART_LayoutRoot spans the
       row's whole width — indent included — and Fluent's PART_ItemsPresenter has no bordered wrapper
       to hang a guide off. The rules below only neutralize Fluent's own state paints so the two do
       not stack; the 2px accent bar rides along on Border.node as an inset BoxShadow (Avalonia's
       BoxShadow grammar accepts a leading "inset" keyword, the same technique the mockup uses with
       its own "box-shadow: inset 2px 0 0").

       Indentation is left to Fluent (PART_Header's Margin, bound to Level via its own
       MarginMultiplierConverter); the caret IS overridden, because Fluent's default is around half
       again the mockup's 13px box and reads as the loudest thing in the row. -->
  <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem"
                BasedOn="{StaticResource {x:Type TreeViewItem}}">
    <!-- Horizontal padding only. The mockup's guide (.branch border-left) is one continuous line down
         a whole branch, but ours is drawn per row inside the item template, so any VERTICAL padding
         here becomes a gap between one row's segment and the next - which is exactly how the guide
         came to render as disconnected stubs. The 6px of vertical breathing room moves into the row
         content instead (see ExplorerView.axaml), leaving the row's full height to the guide, so
         consecutive segments abut into a single line. -->
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />

    <!-- The mockup's caret (.tw) is a 13px box holding a 9px glyph; Fluent's default chevron is
         roughly half again that and reads as the loudest thing in the row. -->
    <Style Selector="^ /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- Hover and selection are painted by Border.node in the item template, NOT here. PART_LayoutRoot
         spans the row's whole width, indent included, so a wash on it sat behind the indent and put
         the 2px accent bar against the pane's left edge instead of against the node. The mockup nests
         .node inside .branch, so the highlight begins after the guide - which only the item template
         can express.

         These overrides are load-bearing rather than redundant: simply NOT painting the container
         hands the state back to Fluent's own :pointerover/:selected styles, which repaint
         PART_LayoutRoot with its stock blue. Each state is pinned to Transparent so the node box is
         the only thing that lights up. -->
    <Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </ControlTheme>

  <!-- ================= ToolTip ================= -->
  <!-- The app had no ToolTip theme at all, so every tip in it - and they are everywhere: the kind
       chips, the DNA derivation, the wizard help badges, every icon button - drew Fluent's stock
       gray slab in a system font. It was the one surface that never spoke the palette.

       Uses the popover shape the rest of the app uses for a floating card: panel ground, a strong
       hairline and the small radius. No drop shadow: a popup surface sizes to its content, so a
       BoxShadow would be clipped at the edge it is supposed to fall outside. MaxWidth so a sentence
       wraps instead of running
       past the pointer, and the body size is the app's own small-copy size rather than Fluent's 14.

       The fade is 140ms from 0.  It is short on purpose: the DELAY is what stops tips from
       bombarding you (see the ShowDelay rule in Styles.axaml), and a slow fade on top of a long
       delay just makes the app feel unresponsive once you have decided to wait for it. -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip"
                BasedOn="{StaticResource {x:Type ToolTip}}">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MaxWidth" Value="280" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <!-- Attached on the ToolTip itself rather than on a template part: it inherits down to whatever
         the tip's content turns out to be, so a plain string and a hand-built panel both wrap. -->
    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    <Setter Property="TextBlock.LineHeight" Value="15" />

    <Style Selector="^">
      <Style.Animations>
        <Animation Duration="0:0:0.14" FillMode="Forward" Easing="SineEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
