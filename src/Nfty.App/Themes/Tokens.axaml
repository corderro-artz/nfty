<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Locked color tokens, ported verbatim from the mockups' shared token block
    (docs/design/mockups/explorer.html, the `.nfty-scope`/`:root` light block and the
    `prefers-color-scheme: dark` block). The mockup is the source of truth for these
    values — do not edit a hex here without first updating the mockup's token block.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BgBrush" Color="#f4efe8" />
      <SolidColorBrush x:Key="BgAltBrush" Color="#f1ece4" />
      <SolidColorBrush x:Key="BgAlt2Brush" Color="#ede7df" />
      <SolidColorBrush x:Key="PanelBrush" Color="#f8f3ed" />
      <!-- Modal scrim: a 52% veil of the page background (mockup `.scrim`), so a light-theme dialog
           sits on a lightened wash rather than a heavy black veil. Avalonia is #AARRGGBB. -->
      <SolidColorBrush x:Key="ScrimBrush" Color="#85f4efe8" />
      <SolidColorBrush x:Key="TileBrush" Color="#ece5db" />
      <SolidColorBrush x:Key="FgBrush" Color="#121318" />
      <!--
        NOTE on 8-digit hex below: the mockup's CSS custom properties write alpha last
        (#RRGGBBAA, CSS Color Module 4), but Avalonia's Color/BoxShadows hex grammar reads
        8-digit hex alpha-first (#AARRGGBB, the .NET/WPF convention) — so every translucent
        value here is the mockup's #RRGGBBAA with its last byte (alpha) rotated to the front.
        E.g. mockup "#121418b8" (RGB 121418, alpha b8) is written here as "#b8121418". Do not
        "restore" these to the mockup's literal digit order — that reintroduces the bug
        (verified by ThemeResourceTests.Translucent_brush_channels_match_mockup_css_rgba_not_misparsed_argb
        and .WinShadow_colors_match_mockup_css_rgba_not_misparsed_argb).
      -->
      <SolidColorBrush x:Key="FgMutedBrush" Color="#b8121418" />
      <SolidColorBrush x:Key="LineBrush" Color="#1f121418" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#33121418" />
      <SolidColorBrush x:Key="AccentBrush" Color="#a11f31" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#97192a" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#f7f2ec" />
      <SolidColorBrush x:Key="AccentWashBrush" Color="#14a11f31" />
      <SolidColorBrush x:Key="AccentLineBrush" Color="#40a11f31" />
      <SolidColorBrush x:Key="KindDynamicBrush" Color="#3b5b6f" />
      <SolidColorBrush x:Key="KindStaticBrush" Color="#6a4a25" />
      <SolidColorBrush x:Key="KindCustomBrush" Color="#6d4f9c" />
      <!-- .fchip wash/border: the same kind color at the mockup's 12-13% / 26-28% alpha
           (color-mix in the CSS; Avalonia alpha leads, so #1F.. is 12% of the hue below). -->
      <SolidColorBrush x:Key="KindDynamicWashBrush" Color="#1f3b5b6f" />
      <SolidColorBrush x:Key="KindStaticWashBrush" Color="#216a4a25" />
      <SolidColorBrush x:Key="KindCustomWashBrush" Color="#216d4f9c" />
      <!-- Mint-distribution series. Categorical, so they only have to be distinguishable from each
           other and at home beside the kind colors above; they carry no meaning individually.
           These replace a runtime HSV derived from a hash of the recipe id, which produced whatever
           hue the id happened to land on - off-palette by construction, and invisible to the
           raw-hex sweep because it lived in C# rather than markup. Darker set for light mode. -->
      <SolidColorBrush x:Key="Series1Brush" Color="#3b5b6f" />
      <SolidColorBrush x:Key="Series2Brush" Color="#6d4f9c" />
      <SolidColorBrush x:Key="Series3Brush" Color="#6a4a25" />
      <SolidColorBrush x:Key="Series4Brush" Color="#3d6b52" />
      <SolidColorBrush x:Key="Series5Brush" Color="#97192a" />
      <SolidColorBrush x:Key="Series6Brush" Color="#4a4a6b" />
      <SolidColorBrush x:Key="KindDynamicLineBrush" Color="#423b5b6f" />
      <SolidColorBrush x:Key="KindStaticLineBrush" Color="#476a4a25" />
      <SolidColorBrush x:Key="KindCustomLineBrush" Color="#476d4f9c" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#b92f44" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#3d6b52" />
      <!-- The mockups' warning custom property, and the other half of the validity pair. Referenced by
           TextBlock.vstate / Ellipse.vdot but defined in NEITHER dictionary, and a DynamicResource
           that resolves to nothing leaves Foreground at Avalonia's default - Black. So an invalid
           CookBook painted "1 problem" as black text and a black dot, which in dark mode is black on
           #12141c: 1.14:1, unreadable. It survived every audit because every test fixture and every
           captured frame used a VALID book, and the valid branch resolves SuccessBrush, which exists. -->
      <SolidColorBrush x:Key="WarningBrush" Color="#6a4a25" />
      <!-- Fluent's own placeholder key, aliased to our muted token rather than left at its default.
           Nothing set it, so Fluent painted the search and the description box at 2.09:1 in light and
           2.62:1 in dark - unreadable, and not what the design asked for either: explorer.html's
           .search is the muted-foreground custom property with no extra dimming. An alias, not a
           copied hex, so it cannot drift from the token it is meant to equal. -->
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FgMutedBrush" />
      <SolidColorBrush x:Key="GuideBrush" Color="#2b121418" />
      <SolidColorBrush x:Key="GuideHiBrush" Color="#59121418" />
      <BoxShadows x:Key="WinShadow">0 1 2 0 #10121418, 0 18 48 -24 #33121418</BoxShadows>
      <!-- Tree selection's 2px left accent bar (mockup: box-shadow: inset 2px 0 0, accent color). -->
      <BoxShadows x:Key="AccentBarShadow">inset 2 0 0 0 #a11f31</BoxShadows>
      <!-- Titlebar top inset highlight (mockup .titlebar box-shadow: inset 0 1px 0 color-mix(fg 6%, transparent)). -->
      <BoxShadows x:Key="TitlebarHighlightShadow">inset 0 1 0 0 #0f121318</BoxShadows>
      <!-- Raw Color (not Brush) pair backing the titlebar's LinearGradientBrush — GradientStop.Color
           needs a Color resource, and PanelBrush/BgAltBrush are opaque so these simply mirror them. -->
      <Color x:Key="PanelColor">#f8f3ed</Color>
      <Color x:Key="BgAltColor">#f1ece4</Color>
      <!-- Gradient stops take a Color, not a Brush, so the wizard's accent glow needs these two.
           The fade stop is the SAME rgb at zero alpha rather than Transparent: interpolating toward
           #00000000 walks the color through black and leaves a gray halo. -->
      <Color x:Key="BgAlt2Color">#ede7df</Color>
      <Color x:Key="AccentWashColor">#14a11f31</Color>
      <Color x:Key="AccentWashFadeColor">#00a11f31</Color>
      <!-- Whole brushes, per theme. A gradient built inside a Style Setter with DynamicResource
           GradientStops does NOT re-resolve when the theme flips - it is constructed once and shared,
           and its stops keep the values they had when the Style was first applied. That shipped the
           CookBook identity card with a light-theme gradient in dark mode, i.e. near-white text on
           cream. Swapping the entire brush per dictionary is the mechanism every other brush here
           already uses, and it cannot fail the same way. -->
      <!-- The rarity share bar. A whole brush per dictionary, per the rule above CardGradientBrush:
           a gradient built inside a Style Setter with DynamicResource stops is constructed once and
           shared, so its stops never re-resolve on a theme change.

           It FADES because a flat block does not read as a bar - it reads as a selected row, which
           is exactly how the first cut looked: six hard-edged rectangles behind six trait names,
           each ending mid-word. The fade gives the bar a direction, so the eye takes the length as
           a quantity rather than the fill as a state. -->
      <LinearGradientBrush x:Key="RarityBarBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#1fa11f31" Offset="0" />
        <GradientStop Color="#14a11f31" Offset="0.55" />
        <GradientStop Color="#00a11f31" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#ede7df" Offset="0" />
        <GradientStop Color="#f8f3ed" Offset="1" />
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="ModalGlowBrush" Center="50%,0%" GradientOrigin="50%,0%"
                           RadiusX="120%" RadiusY="90%">
        <GradientStop Color="#14a11f31" Offset="0" />
        <GradientStop Color="#00a11f31" Offset="0.55" />
      </RadialGradientBrush>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BgBrush" Color="#07080b" />
      <SolidColorBrush x:Key="BgAltBrush" Color="#0a0b10" />
      <SolidColorBrush x:Key="BgAlt2Brush" Color="#0f1118" />
      <SolidColorBrush x:Key="PanelBrush" Color="#0b0c10" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#8507080b" />
      <SolidColorBrush x:Key="TileBrush" Color="#12141c" />
      <SolidColorBrush x:Key="FgBrush" Color="#f2ede6" />
      <!-- See the Light dictionary's note above: 8-digit hex here is the mockup's #RRGGBBAA
           rotated to Avalonia's #AARRGGBB. -->
      <SolidColorBrush x:Key="FgMutedBrush" Color="#c7f2ede6" />
      <SolidColorBrush x:Key="LineBrush" Color="#24f2ede6" />
      <SolidColorBrush x:Key="LineStrongBrush" Color="#33f2ede6" />
      <SolidColorBrush x:Key="AccentBrush" Color="#a11f31" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#e0788a" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#f7f2ec" />
      <SolidColorBrush x:Key="AccentWashBrush" Color="#26a11f31" />
      <SolidColorBrush x:Key="AccentLineBrush" Color="#66a11f31" />
      <SolidColorBrush x:Key="KindDynamicBrush" Color="#7fb0c4" />
      <SolidColorBrush x:Key="KindStaticBrush" Color="#e0c28c" />
      <SolidColorBrush x:Key="KindCustomBrush" Color="#c3a6ea" />
      <SolidColorBrush x:Key="KindDynamicWashBrush" Color="#1f7fb0c4" />
      <SolidColorBrush x:Key="KindStaticWashBrush" Color="#21e0c28c" />
      <SolidColorBrush x:Key="KindCustomWashBrush" Color="#21c3a6ea" />
      <!-- Mint-distribution series, lightened for dark mode the same way the kind colors are.
           The old hash-derived HSV took no theme input at all, so the distribution bar rendered
           identically bright in both - and it is the heaviest element on the dark card. -->
      <SolidColorBrush x:Key="Series1Brush" Color="#7fb0c4" />
      <SolidColorBrush x:Key="Series2Brush" Color="#c3a6ea" />
      <SolidColorBrush x:Key="Series3Brush" Color="#e0c28c" />
      <SolidColorBrush x:Key="Series4Brush" Color="#a6c08a" />
      <SolidColorBrush x:Key="Series5Brush" Color="#e0788a" />
      <SolidColorBrush x:Key="Series6Brush" Color="#a8a8d0" />
      <SolidColorBrush x:Key="KindDynamicLineBrush" Color="#427fb0c4" />
      <SolidColorBrush x:Key="KindStaticLineBrush" Color="#47e0c28c" />
      <SolidColorBrush x:Key="KindCustomLineBrush" Color="#47c3a6ea" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#ba3447" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#a6c08a" />
      <SolidColorBrush x:Key="WarningBrush" Color="#e0c28c" />
      <!-- The dark half of the placeholder alias; see the light dictionary for why. -->
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="FgMutedBrush" />
      <SolidColorBrush x:Key="GuideBrush" Color="#1ff2ede6" />
      <SolidColorBrush x:Key="GuideHiBrush" Color="#3df2ede6" />
      <BoxShadows x:Key="WinShadow">0 1 2 0 #60000000, 0 22 60 -28 #000000</BoxShadows>
      <BoxShadows x:Key="AccentBarShadow">inset 2 0 0 0 #a11f31</BoxShadows>
      <BoxShadows x:Key="TitlebarHighlightShadow">inset 0 1 0 0 #0ff2ede6</BoxShadows>
      <Color x:Key="PanelColor">#0b0c10</Color>
      <Color x:Key="BgAltColor">#0a0b10</Color>
      <Color x:Key="BgAlt2Color">#0f1118</Color>
      <Color x:Key="AccentWashColor">#26a11f31</Color>
      <Color x:Key="AccentWashFadeColor">#00a11f31</Color>
      <!-- See the light dictionary's note: these are whole brushes because a Setter-hosted gradient
           does not re-resolve DynamicResource stops on a theme change. -->
      <!-- The rarity share bar. A whole brush per dictionary, per the rule above CardGradientBrush:
           a gradient built inside a Style Setter with DynamicResource stops is constructed once and
           shared, so its stops never re-resolve on a theme change.

           It FADES because a flat block does not read as a bar - it reads as a selected row, which
           is exactly how the first cut looked: six hard-edged rectangles behind six trait names,
           each ending mid-word. The fade gives the bar a direction, so the eye takes the length as
           a quantity rather than the fill as a state. -->
      <LinearGradientBrush x:Key="RarityBarBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#3da11f31" Offset="0" />
        <GradientStop Color="#26a11f31" Offset="0.55" />
        <GradientStop Color="#00a11f31" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Color="#0f1118" Offset="0" />
        <GradientStop Color="#0b0c10" Offset="1" />
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="ModalGlowBrush" Center="50%,0%" GradientOrigin="50%,0%"
                           RadiusX="120%" RadiusY="90%">
        <GradientStop Color="#26a11f31" Offset="0" />
        <GradientStop Color="#00a11f31" Offset="0.55" />
      </RadialGradientBrush>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="SansFontFamily">-apple-system, Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFontFamily">SF Mono, JetBrains Mono, Cascadia Code, Menlo, Consolas, monospace</FontFamily>
  <CornerRadius x:Key="RadiusXs">4</CornerRadius>
  <CornerRadius x:Key="RadiusWin">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusSm">5</CornerRadius>

  <!-- Color-range track fills. These are NOT palette colors and deliberately do not vary by theme:
       a hue wheel is a hue wheel in the dark. They live here rather than inline in a view so the two
       screens that show a color range (the ingredient editor and the New Ingredient wizard) paint
       the same ramp, and so the views stay free of raw hex per the house rule. -->
  <LinearGradientBrush x:Key="HueSpectrumBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="#FFFF0000" Offset="0" />
    <GradientStop Color="#FFFFFF00" Offset="0.167" />
    <GradientStop Color="#FF00FF00" Offset="0.333" />
    <GradientStop Color="#FF00FFFF" Offset="0.5" />
    <GradientStop Color="#FF0000FF" Offset="0.667" />
    <GradientStop Color="#FFFF00FF" Offset="0.833" />
    <GradientStop Color="#FFFF0000" Offset="1" />
  </LinearGradientBrush>
  <!-- Gray to full chroma. The end stop is the mockups' own worked example, hex:d6249f. -->
  <LinearGradientBrush x:Key="SaturationRampBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="#FF9E9E9E" Offset="0" />
    <GradientStop Color="#FFD6249F" Offset="1" />
  </LinearGradientBrush>
  <!-- The value ramp the paint brush samples. Black to white is the value-map's own domain, not a
       palette choice, so it does not vary by theme either. -->
  <LinearGradientBrush x:Key="ValueRampBrush" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="#FF000000" Offset="0" />
    <GradientStop Color="#FFFFFFFF" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
