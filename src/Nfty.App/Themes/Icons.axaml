<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Icon geometry, traced from the locked mockups' inline SVG. The mockups draw every glyph as a
    24x24 stroked path (stroke-linecap/linejoin round, ~2px), and the app previously substituted
    Unicode/emoji characters — which rendered as colour emoji injecting off-palette hues (the toolbar
    padlock sampled #f6cd6a, the edit pencil #ff822d) and, where the shipped fonts lacked the glyph,
    as literal tofu boxes.

    The `d` strings below are copied from the mockups verbatim where the source was a <path>. Where
    the source used <rect>/<circle> (which StreamGeometry cannot express), the equivalent path is
    written out here and noted per icon. Paths stay in the original 24-unit coordinate space and are
    scaled by Path.Stretch="Uniform" into the 13/14/18px box (see Styles.axaml `Path.ico`).
  -->

  <!-- landing.html: "+" leading glyph on the Create actions -->
  <StreamGeometry x:Key="IconPlus">M12 5v14M5 12h14</StreamGeometry>

  <!-- landing.html: arrow-out-of-box, the Open actions -->
  <StreamGeometry x:Key="IconOpen">M13.5 5.5H18.5V10.5M18.5 5.5 11 13M17 14.5v3.2a.8.8 0 0 1-.8.8H6.3a.8.8 0 0 1-.8-.8V7.8a.8.8 0 0 1 .8-.8h3.2</StreamGeometry>

  <!-- explorer.html: download-tray, Import -->
  <StreamGeometry x:Key="IconImport">M12 4v10M8.2 10.4 12 14.2l3.8-3.8M5 16.5v2a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2</StreamGeometry>

  <!-- explorer.html: magnifier (mockup uses <circle cx=11 cy=11 r=7> + the handle path) -->
  <StreamGeometry x:Key="IconSearch">M18 11a7 7 0 1 1-14 0 7 7 0 0 1 14 0zm3 10-4-4</StreamGeometry>

  <!-- explorer.html: padlock. Shackle path is verbatim; the body <rect x=5 y=11 w=14 h=9 rx=2> is
       written as the rounded-rect path below. -->
  <StreamGeometry x:Key="IconLock">M8 11V8a4 4 0 0 1 8 0v3M7 11h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2z</StreamGeometry>

  <!-- explorer.html: the unlocked variant (open shackle) -->
  <StreamGeometry x:Key="IconUnlock">M8 11V8a4 4 0 0 1 7.5-1.9M7 11h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2z</StreamGeometry>

  <!-- ingredient-editor.html: pencil (the mockup's Brush/Edit mark) -->
  <StreamGeometry x:Key="IconPencil">M15 5l4 4M4 20l4-1L19 8a2 2 0 0 0-3-3L5 16z</StreamGeometry>

  <!-- ingredient-editor.html: undo / redo -->
  <StreamGeometry x:Key="IconUndo">M9 7L4 12l5 5M4 12h11a5 5 0 0 1 0 10h-1</StreamGeometry>
  <StreamGeometry x:Key="IconRedo">M15 7l5 5-5 5M20 12H9a5 5 0 0 0 0 10h1</StreamGeometry>

  <!-- ingredient-editor.html: "Reroll sampled colour" — also the recipe portrait's reroll -->
  <StreamGeometry x:Key="IconReroll">M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6</StreamGeometry>

  <!-- ingredient-editor.html: enlarge preview / fill pane with preview -->
  <StreamGeometry x:Key="IconEnlarge">M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7</StreamGeometry>
  <StreamGeometry x:Key="IconFillPane">M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M3 16v3a2 2 0 0 0 2 2h3</StreamGeometry>

  <!-- wizard-cookbook.html: aspect-ratio link (two chain links) -->
  <StreamGeometry x:Key="IconLink">M10 14a4 4 0 0 1 0-5.7l2-2a4 4 0 0 1 5.7 5.7l-1 1M14 10a4 4 0 0 1 0 5.7l-2 2a4 4 0 0 1-5.7-5.7l1-1</StreamGeometry>

  <!-- window chrome (explorer.html titlebar): minimise, maximise (<rect x=6 y=6 w=12 h=12>), close -->
  <StreamGeometry x:Key="IconMinimise">M6 12h12</StreamGeometry>
  <StreamGeometry x:Key="IconMaximise">M6 6h12v12H6z</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M7 7l10 10M17 7 7 17</StreamGeometry>

  <!-- status bar: zoom out / in, and help (<circle cx=12 cy=12 r=9> + the query stroke + dot) -->
  <StreamGeometry x:Key="IconZoomOut">M6 12h12</StreamGeometry>
  <StreamGeometry x:Key="IconZoomIn">M12 5v14M5 12h14</StreamGeometry>
  <StreamGeometry x:Key="IconHelp">M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0zM9.6 9.4a2.5 2.5 0 1 1 3.1 2.4c-.5.2-.8.7-.8 1.2v.6M12 16.6v.4</StreamGeometry>
</ResourceDictionary>
