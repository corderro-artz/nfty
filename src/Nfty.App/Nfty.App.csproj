<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TEMPORARY: this project's public surface is not documented yet. Removed project by project
         as the docs land; see Directory.Build.props for why the rule exists. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- IImageBridge converts an ImageSharp frame to an Avalonia Bitmap through a pinned span. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nfty.Core\Nfty.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nfty.App.Tests" />
  </ItemGroup>
</Project>
