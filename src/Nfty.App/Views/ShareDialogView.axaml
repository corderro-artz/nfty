<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:ctl="using:Nfty.App.Controls"
             x:Class="Nfty.App.Views.ShareDialogView"
             x:DataType="vm:ShareDialogViewModel"
             RenderOptions.BitmapInterpolationMode="None"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <!-- A split card like the wizards, but it does NOT scroll: its height is a property of the design
       (every state of the one reserved block is the same height). Only that block's row list may
       scroll, rows only, with Remove these... outside it. Left = what leaves the machine and what
       the gallery will make of it; right = the listing, and the one reserved block. -->
  <Border Classes="modal monoform split share">
    <Grid RowDefinitions="*,Auto">
      <Border Grid.Row="0" Classes="modal-body">
        <Panel>
        <!-- THE FORM: stays laid out in every state, inked out and unreachable once a run has started, so the card is
             the same size while it runs, finishes or fails. -->
        <StackPanel Classes.cgone="{Binding !IsEditing}" IsEnabled="{Binding IsEditing}">
          <!-- Title left, the account right (Settings' own chip: a dot and who is connected). The way to connect
               lives in the reserved block below, beside the sentence that says why it is needed. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Share with the community" Classes="m-h" Margin="0" />
              <TextBlock Classes="m-sub" Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         Text="Lists this Set in the nfty gallery, where anyone can browse and download it." />
            </StackPanel>
            <Border x:Name="AccountChip" Grid.Column="1" Classes="idchip" VerticalAlignment="Top" Margin="0,4,0,0"
                    ToolTip.Tip="The GitHub account a share goes through. Connected and disconnected in Settings, PUBLISHING.">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Classes="vdot"
                         Classes.ok="{Binding IsSignedIn}" Classes.idle="{Binding IsSignedOut}" />
                <TextBlock Classes="ck" Text="GITHUB" />
                <TextBlock Classes="cvl" Text="{Binding GitHubChip}" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Classes="wizcols" ColumnDefinitions="*,25,1,25,*" Margin="0,14,0,0">
            <Rectangle Grid.Column="2" Classes="wizrule" />

            <!-- WHAT LEAVES THE MACHINE, AND WHAT THE GALLERY WILL MAKE OF IT -->
            <StackPanel Grid.Column="0" Spacing="12">
              <StackPanel Spacing="2">
                <TextBlock Text="WHAT LEAVES THIS MACHINE" Classes="plabel" Margin="0,0,0,4" />
                <CheckBox Content="3D models" IsChecked="{Binding Models}" IsEnabled="{Binding ModelsEnabled}"
                          ToolTip.Tip="3D models of every asset, as cooked. Dimmed on a Set cooked without them." />
                <TextBlock Classes="sline" Margin="30,-4,0,0" Text="{Binding ModelsNote}" Height="14" />
                <CheckBox Content="Include source CookBook" IsChecked="{Binding IncludeCookBook}"
                          IsEnabled="{Binding IncludeCookBookEnabled}"
                          ToolTip.Tip="Lets anyone regenerate the collection and cook their own. Offered only for the CookBook that made this Set: the gallery refuses any other." />
                <TextBlock Classes="sline" Margin="30,-4,0,0" Text="{Binding CookBookNote}" Height="14" />
              </StackPanel>

              <!-- THE MANIFEST: SetExporter.Plan, the list the share writes, in the Export card's own block. -->
              <ctl:PackageCard Title="{Binding Slug, StringFormat={}{0}.set}" Size="{Binding PlanSize}" Parts="{Binding PlanParts}"
                               MinTileWidth="150" MaxRows="2" SizeTip="The files as they sit on disk. The gallery's limit is on the packed .set, under GALLERY LIMITS." />

              <!-- THE GALLERY'S LIMITS: a table, one row each - a mark (within, past, not known yet), what is measured,
                   the figure and what to do about it, the limit. Every row always laid out; only ink changes. -->
              <StackPanel>
                <TextBlock Text="GALLERY LIMITS" Classes="plabel" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding LimitRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShareLimitRow">
                      <Border Classes="slrow" ToolTip.Tip="{Binding Tip}">
                        <Grid ColumnDefinitions="16,94,*,Auto" ColumnSpacing="6">
                          <!-- The mark. Past the limit it is the hover target: the whole sentence (what is wrong and what
                               to do) is its tooltip, so nothing in the row is ever clipped mid-word. -->
                          <Panel Grid.Column="0" VerticalAlignment="Center">
                            <Path Classes="ico xs" Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}"
                                  Classes.cgone="{Binding !IsOk}" />
                            <Ellipse Width="5" Height="5" Classes="vdot idle" HorizontalAlignment="Center"
                                     Classes.cgone="{Binding !IsPending}" />
                            <Border Classes="alert" Classes.cgone="{Binding !IsOver}" ToolTip.Tip="{Binding Tip}">
                              <Path Classes="ico xs" Data="{StaticResource IconTriangle}" Stroke="{DynamicResource WarningBrush}" />
                            </Border>
                          </Panel>
                          <TextBlock Grid.Column="1" Classes="slabel" Text="{Binding Label}" />
                          <TextBlock Grid.Column="2" Classes="svalue" Classes.pending="{Binding IsPending}" Classes.over="{Binding IsOver}"
                                     Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Classes="slimit" Text="{Binding Limit}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <!-- THE LISTING -->
            <StackPanel Grid.Column="4" Spacing="8">
              <StackPanel Spacing="4">
                <TextBlock Text="NAME" Classes="plabel" Margin="0" />
                <TextBox Text="{Binding Name}" MaxLength="64" />
                <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,2,0,0">
                  <Border Classes="idchip"><TextBlock Text="{Binding Slug}" Classes="mono" FontSize="10.5" /></Border>
                  <TextBlock Text="— the identifier, derived from the collection" Classes="derived" Opacity="0.9" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="DESCRIPTION" Classes="plabel" Margin="0" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="44" MaxLength="500"
                         TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VerticalContentAlignment="Top" Padding="11,5"
                         PlaceholderText="What it is, in a sentence or two. No links." />
              </StackPanel>

              <StackPanel Spacing="4">
                <!-- The refusal note shares the label row with the counter: one line, always laid out. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="TAGS" Classes="plabel" Margin="0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="swarn" TextTrimming="CharacterEllipsis" Text="{Binding TagNote}"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding TagNote}" />
                  <TextBlock Grid.Column="2" Classes="sline" Text="{Binding TagsCount}" VerticalAlignment="Center" />
                </Grid>
                <!-- Reserved: two rows of chips, or the sentence saying there are none (or that they are coming). -->
                <Panel Height="54">
                  <ItemsControl ItemsSource="{Binding TagChips}" Classes.cgone="{Binding !HasTags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ShareTagChip">
                        <Button Classes="stag" Classes.on="{Binding IsOn}" Content="{Binding Name}"
                                Command="{Binding $parent[ItemsControl].((vm:ShareDialogViewModel)DataContext).ToggleTagCommand}"
                                CommandParameter="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="sline" Text="{Binding TagsEmptyText}" Classes.cgone="{Binding HasTags}" />
                </Panel>
              </StackPanel>

              <!-- THE ONE RESERVED BLOCK: the same height in every state, so a user at 2 of 3 and a
                   user at 3 of 3 see the same card. Rows may scroll inside it; nothing else does. -->
              <Border Classes="shareblock">
                <Panel>
                  <!-- Nothing to decide: where the share goes, or (signed out) why GitHub is needed and the way to it. -->
                  <Grid IsVisible="{Binding IsNoneBlock}" RowDefinitions="Auto,Auto,*" RowSpacing="4">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconShare}" Stroke="{DynamicResource AccentTextBrush}" />
                      <TextBlock Grid.Column="1" Classes="cname" VerticalAlignment="Center" Text="{Binding ReadyHeading}"
                                 ToolTip.Tip="{Binding ReadyHeading}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="sline" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               Text="{Binding ReadyText}" ToolTip.Tip="{Binding ReadyText}" />
                    <Button Grid.Row="2" x:Name="ConnectGitHub" Classes="tbtn shbtn" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Content="Connect GitHub…" Command="{Binding ConnectGitHubCommand}" Classes.cgone="{Binding IsSignedIn}"
                            ToolTip.Tip="Opens Settings at PUBLISHING, where you sign in on github.com. This card stays open underneath." />
                  </Grid>

                  <!-- Extras / repo trouble -->
                  <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsExtrasBlock}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Grid.Column="0" Classes="swarn" Height="30" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                 Text="{Binding BlockHeading}" ToolTip.Tip="{Binding BlockHeading}" />
                      <Button Grid.Column="1" Classes="tbtn shbtn" Content="Remove these…" VerticalAlignment="Top"
                              MinWidth="104" Command="{Binding RemoveExtrasCommand}" Classes.cgone="{Binding !CanRemoveExtras}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" x:Name="ExtrasScroll" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                      <ItemsControl ItemsSource="{Binding Extras}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ShareExtraRow">
                            <TextBlock Classes="sline" Height="18" TextTrimming="CharacterEllipsis" Text="{Binding Text}"
                                       ToolTip.Tip="{Binding Text}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>

                  <!-- Somebody has it already -->
                  <Grid IsVisible="{Binding IsDuplicateBlock}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Path Grid.Column="0" Classes="ico sm" VerticalAlignment="Top" Data="{StaticResource IconTriangle}"
                          Stroke="{DynamicResource WarningBrush}" />
                    <TextBlock Grid.Column="1" Classes="swarn" TextWrapping="Wrap" Text="{Binding BlockHeading}" />
                  </Grid>

                  <!-- One of your shares -->
                  <Grid IsVisible="{Binding IsAlreadySharedBlock}" RowDefinitions="Auto,Auto,*" RowSpacing="6">
                    <TextBlock Grid.Row="0" Classes="sline" Text="{Binding BlockHeading}" />
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10" DataContext="{Binding AlreadyShared}"
                          x:DataType="vm:ShareShareRow">
                      <Border Grid.Column="0" Classes="tile spreview">
                        <Image Source="{Binding Tile.Preview}" Stretch="Uniform" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Classes="cname" Text="{Binding Name}" />
                        <TextBlock Classes="cmeta" Text="{Binding DatesText}" />
                      </StackPanel>
                    </Grid>
                    <CheckBox Grid.Row="2" Content="Replace the shared version" IsChecked="{Binding ReplaceSharedVersion}"
                              VerticalAlignment="Top"
                              ToolTip.Tip="Sharing again makes a new version and swaps it in. The old one is removed once the gallery lists the new." />
                  </Grid>

                  <!-- At the limit -->
                  <Grid IsVisible="{Binding IsReplaceBlock}" RowDefinitions="Auto,*" RowSpacing="4">
                    <TextBlock Grid.Row="0" Classes="sline" TextTrimming="CharacterEllipsis" Height="16" Text="{Binding BlockHeading}" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ReplaceChoices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShareShareRow">
                          <Button Classes="ghost srow" Classes.on="{Binding IsSelected}" Command="{Binding ChooseCommand}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                              <Ellipse Grid.Column="0" Classes="sradio" Classes.on="{Binding IsSelected}" />
                              <Border Grid.Column="1" Classes="tile spreview sm">
                                <Image Source="{Binding Tile.Preview}" Stretch="Uniform" />
                              </Border>
                              <TextBlock Grid.Column="2" Classes="cname" VerticalAlignment="Center" Text="{Binding Name}" />
                              <TextBlock Grid.Column="3" Classes="cmeta" VerticalAlignment="Center" Text="{Binding SizeText}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Panel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- THE RUN: drawn over the form, in the same space. Running, done and failed share the centered column. -->
        <StackPanel x:Name="RunPanel" Classes.cgone="{Binding IsEditing}" VerticalAlignment="Center" Spacing="12"
                    HorizontalAlignment="Center" Width="520">
          <StackPanel Spacing="10" IsVisible="{Binding IsRunning}">
            <TextBlock Classes="m-h" Margin="0" Text="Sharing…" />
            <TextBlock Classes="cname" Text="{Binding StageText}" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction}" />
            <TextBlock Classes="sline" TextWrapping="Wrap"
                       Text="Stopping takes back what this share made on GitHub. Nothing already in the gallery changes." />
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsDone}">
            <TextBlock Classes="m-h" Margin="0" Text="Sent to the gallery" />
            <TextBlock Classes="cname" TextWrapping="Wrap" Text="{x:Static vm:ShareDialogViewModel.DoneText}" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <SelectableTextBlock Grid.Column="0" Classes="uri" Text="{Binding PullText}" ToolTip.Tip="{Binding PullText}" />
              <Button Grid.Column="1" Classes="tbtn cellbtn" Content="Copy" Command="{Binding CopyPullCommand}"
                      ToolTip.Tip="Copy the pull request's address." />
              <Button Grid.Column="2" Classes="tbtn cellbtn" Content="Open" Command="{Binding OpenPullCommand}"
                      ToolTip.Tip="Open the pull request on GitHub." />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsFailed}">
            <TextBlock Classes="m-h" Margin="0" Text="Not shared" />
            <TextBlock Classes="swarn" TextWrapping="Wrap" Text="{Binding Failure}" />
            <TextBlock Classes="sline" TextWrapping="Wrap" Text="Nothing was left on GitHub by this attempt." />
            <Button Classes="tbtn" HorizontalAlignment="Left" Content="Back to the form" Command="{Binding TryAgainCommand}" />
          </StackPanel>
        </StackPanel>
        </Panel>
      </Border>

      <Border Grid.Row="1" Classes="modal-foot">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <!-- The reason Share waits, always laid out; ink only. -->
          <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="7" Classes.cgone="{Binding !IsEditing}"
                ToolTip.Tip="{Binding ShareReason}">
            <Border Grid.Column="0" Classes="alert" Classes.cgone="{Binding CanShare}" VerticalAlignment="Center">
              <Path Classes="ico xs" Data="{StaticResource IconTriangle}" Stroke="{DynamicResource WarningBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Classes="swarn" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="{Binding ShareReason}" />
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Classes="tbtn" MinWidth="64" />
            <Button Command="{Binding ShareCommand}" Classes="accent" ToolTip.Tip="{Binding ShareButtonTip}" MinWidth="96"
                    Classes.cgone="{Binding !IsEditing}">
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Path Classes="ico sm" Data="{StaticResource IconShare}" />
                <TextBlock Text="Share" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
