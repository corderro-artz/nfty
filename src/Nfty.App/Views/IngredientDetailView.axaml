<!-- RenderOptions.BitmapInterpolationMode=None on the root: pixel art scales with nearest
     neighbour, never a filter. It inherits to every Image below, and
     PixelPerfectRenderingTests fails naming any view that drops it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:img="using:Avalonia.Media.Imaging"
             xmlns:conv="using:Nfty.App.Converters"
             x:Class="Nfty.App.Views.IngredientDetailView"
             x:DataType="vm:IngredientDetailViewModel"
             RenderOptions.BitmapInterpolationMode="None">
  <!-- Ingredient detail body: 2-column layout (explorer.html .ing-main / .ing-rail).
       Main column: variant hero (.vhero, explorer.html:313-321) + variant table (table.data vtable, explorer.html:881-885).
       Rail column: colorways panel (.cw-panel/.cwaxis, explorer.html:385-400). -->
  <!-- Rail column: Auto+MinWidth(208) rather than a fixed 280 (mirrors explorer.html's
       `.ing-grid{grid-template-columns:minmax(0,2fr) minmax(208px,1fr)}`) — a fixed 280 rail plus
       the table's 328px of fixed columns below overflowed the ~300px main column this pane gets
       inside ExplorerView's 260+* split at 900px (audit finding: OVERALL sliced off, colorways
       axis value colliding with the row rule). -->
  <Grid Margin="16">
    <!-- Mockup .ing-grid: minmax(0, 2fr) / minmax(208px, 1fr). The rail used to be Auto, which sizes
         to its CONTENT - so a long line in the rail (the Custom branch's note) grew the rail and
         squeezed the main column until the hero subtitle clipped to "no colorize · compo…" and the
         variant table's header truncated to "VAR…". Proportional columns keep the split fixed
         regardless of what the rail happens to contain. -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" MinWidth="0" />
      <ColumnDefinition Width="*" MinWidth="208" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,16,0">
      <Border Classes="vhero">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <Border Grid.Column="0" Width="84" Height="84" CornerRadius="{DynamicResource RadiusMd}"
                  Background="{DynamicResource TileBrush}" ClipToBounds="True" Margin="0,0,16,0">
            <Image Source="{Binding Hero}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="mono" FontSize="17" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <!-- .hsub is ONE line - "custom · no colorize · composited as-is" - with only the kind
                 word carrying the kind color. It used to be two stacked neutral lines, which lost
                 the color-coding the tree and the layer table both apply. -->
            <!-- Bottom on each run, not on the panel: children of a horizontal StackPanel default to
                 Stretch and draw their line at the top of the row, so the 12px kind word sat 4px
                 above the 14px description it reads as one sentence with. -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="kind-txt" VerticalAlignment="Bottom"
                         Classes.kdyn="{Binding IsDynamic}"
                         Classes.kstat="{Binding IsStatic}"
                         Classes.kcust="{Binding IsCustom}"
                         Text="{Binding KindText}" />
              <TextBlock Classes="muted" Text="·" VerticalAlignment="Bottom" />
              <TextBlock Classes="muted" Text="{Binding ColorwaysText}" VerticalAlignment="Bottom"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- .hflag: shown ONLY when this layer is named in a rule, which is the question it
                 exists to answer. It replaces a permanently-visible "Jump to rules" button whose
                 command was an empty body - a control that looked available and did nothing. -->
            <Button Classes="hflag" Command="{Binding JumpToRulesCommand}" IsVisible="{Binding HasRules}"
                    HorizontalAlignment="Left" Margin="0,4,0,0" ToolTip.Tip="See rules in the recipe">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="ico xs" Data="{StaticResource IconMarkFlag}" />
                <TextBlock Text="{Binding RuleFlagText}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Grid.Column="2" Command="{Binding EditIngredientCommand}" Classes="accent" VerticalAlignment="Top" ToolTip.Tip="Edit ingredient"><Path Classes="ico" Data="{StaticResource IconPencil}" /></Button>

          <!-- .rarity: how the layer's weight actually splits, at a glance. The table below carries
               the same numbers, but a column of percentages does not show the SHAPE of the split. -->
          <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding Variants}"
                        Margin="0,13,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:VariantRow">
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,30,11" VerticalAlignment="Center">
                  <TextBlock Classes="cshare" Text="{Binding Name}" MinWidth="52" TextTrimming="CharacterEllipsis" />
                  <Border Classes="rt">
                    <Border Width="{Binding OverallPercent, Converter={x:Static conv:PercentToWidthConverter.ForBarWidth120}}" />
                  </Border>
                  <TextBlock Classes="cshare" Text="{Binding OverallPercent, StringFormat='{}{0}%'}" MinWidth="34" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <StackPanel Spacing="0">
        <!-- FIXED columns, not Auto. The header and the rows are separate Grids, so an Auto column
             sizes on the header's word in one and on the widest number in the other: "WEIGHT" is
             wider than "30", which put the weight column's numbers 10px right of the header naming
             them, and every value in that column moved as soon as a weight gained a digit. The
             widths are the header words (the binding constraint at every realistic value) plus the
             8px gutter each cell carries: 48+8, 70+8, 56+8. -->
        <Border Classes="data-h">
          <Grid ColumnDefinitions="40,*,56,78,64">
            <TextBlock Grid.Column="0" Classes="data-h" Text="" />
            <Button Grid.Column="1" Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Command="{Binding SortByCommand}" CommandParameter="Variant">
              <TextBlock Classes="data-h" Text="VARIANT" TextTrimming="CharacterEllipsis" />
            </Button>
            <Button Grid.Column="2" Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="Weight">
              <TextBlock Classes="data-h num" Text="WEIGHT" Margin="8,0,0,0" />
            </Button>
            <TextBlock Grid.Column="3" Classes="data-h num" Text="IN RECIPE" Margin="8,0,0,0" />
            <TextBlock Grid.Column="4" Classes="data-h num" Text="OVERALL" Margin="8,0,0,0" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Variants}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VariantRow">
              <Border Classes="data-row">
                <Grid ColumnDefinitions="40,*,56,78,64">
                  <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="32" Height="32" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="data-row" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="data-row num" Text="{Binding Weight}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="3" Classes="data-row num" Text="{Binding WithinPercent, StringFormat='{}{0}%'}" Margin="8,0,0,0" />
                  <TextBlock Grid.Column="4" Classes="data-row num" Text="{Binding OverallPercent, StringFormat='{}{0}%'}" Margin="8,0,0,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Delete variant" Command="{Binding DeleteVariantCommand}" Classes="tbtn" />
        <!-- The CLI's preview: writes this variant as generation would render it. The GUI could not
             get a rendered PNG out at all short of cooking a whole Set. -->
        <Button Command="{Binding ExportPreviewCommand}" Classes="tbtn"
                ToolTip.Tip="Write a PNG of this variant exactly as generation would render it">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="ico sm" Data="{StaticResource IconImport}" />
            <TextBlock Text="Export preview…" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <Border Grid.Column="1" Classes="cw-panel" VerticalAlignment="Stretch">
      <StackPanel Spacing="10">
        <TextBlock Classes="sub-h" Text="COLORWAYS" />

        <!-- .cwtop: what the layer's color model IS, before the band that shows its span. -->
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock Classes="kind-txt"
                     Classes.kdyn="{Binding IsDynamic}"
                     Classes.kstat="{Binding IsStatic}"
                     Classes.kcust="{Binding IsCustom}"
                     Text="{Binding KindText}" VerticalAlignment="Center" />
          <Border Classes="cwmodel"><TextBlock Text="{Binding ColorwaysModelText}" /></Border>
        </StackPanel>

        <!-- .hueband: the hue sweep this layer rolls within. Shown only for a dynamic layer - the
             others roll no hue, and the thumbnails that used to sit here showed the SOURCE art
             rather than the color space, which is the one thing this rail exists to convey. -->
        <Border Classes="hueband" IsVisible="{Binding HasHueBand}">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
              <GradientStops>
                <GradientStop Color="{Binding HueBandStops[0]}" Offset="0" />
                <GradientStop Color="{Binding HueBandStops[3]}" Offset="0.27" />
                <GradientStop Color="{Binding HueBandStops[6]}" Offset="0.55" />
                <GradientStop Color="{Binding HueBandStops[9]}" Offset="0.82" />
                <GradientStop Color="{Binding HueBandStops[11]}" Offset="1" />
              </GradientStops>
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- .cwcustom: a Custom layer gets its own branch, not the axis-row grammar. It rolls no
             hue and no saturation, so an "axis" row with a sentence in the value column was
             borrowing a shape that does not describe it. The mockup pairs a 56px swatch of the
             selected variant with a plain-language note. -->
        <!-- Grid, not a horizontal StackPanel: a StackPanel hands its child unbounded width, so the
             note laid itself out on one line and ran past the rail instead of wrapping beside the
             swatch. The star column is what makes TextWrapping mean anything here. -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" IsVisible="{Binding IsCustom}">
          <Border Grid.Column="0" Classes="cwsw">
            <Image Source="{Binding SelectedThumb}" Stretch="UniformToFill" />
          </Border>
          <TextBlock Grid.Column="1" Classes="cwnote" VerticalAlignment="Center"><Run Text="Full-color image, " /><Run
            Text="composited as-is" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}" /><Run
            Text=". Value-map colorization does not apply to this layer." /></TextBlock>
        </Grid>

        <ItemsControl ItemsSource="{Binding ColorwayAxes}" IsVisible="{Binding !IsCustom}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ColorwayAxis">
              <Border Classes="cwaxis">
                <!-- Auto,* (not *,Auto): the label ("Hue"/"Color"/…) is always short, while a
                     custom-kind Value can be a full sentence ("no colorize · composited as-is") —
                     giving Value the star column plus wrap lets it flow onto extra lines instead
                     of forcing the label column to near-zero width and overlapping it (a real
                     overlap seen when this row was rendered with *,Auto). -->
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Classes="ax" Text="{Binding Label}" VerticalAlignment="Center"
                             Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Classes="av" Classes.der="{Binding Derived}" Text="{Binding Value}"
                             VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
