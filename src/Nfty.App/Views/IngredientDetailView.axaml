<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:img="using:Avalonia.Media.Imaging"
             x:Class="Nfty.App.Views.IngredientDetailView"
             x:DataType="vm:IngredientDetailViewModel">
  <StackPanel Spacing="12" Margin="16">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Image Grid.Column="0" Source="{Binding Hero}" Width="84" Height="84" Margin="0,0,12,0"
             VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" />
        <TextBlock Classes="muted" Text="{Binding KindText}" />
        <TextBlock Classes="muted" Text="{Binding ColorwaysText}" />
      </StackPanel>
      <Button Grid.Column="2" Content="✏" Command="{Binding EditIngredientCommand}" Classes="accent" VerticalAlignment="Top" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Variant" Command="{Binding SortByCommand}" CommandParameter="Variant" Classes="tbtn" />
      <Button Content="Weight" Command="{Binding SortByCommand}" CommandParameter="Weight" Classes="tbtn" />
    </StackPanel>
    <TextBlock Text="{Binding SortColumn, StringFormat='Sorted by {0}'}" Classes="muted" />

    <ItemsControl ItemsSource="{Binding Variants}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:VariantRow">
          <Grid ColumnDefinitions="38,*,80,100,100">
            <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="32" Height="32" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" />
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Weight}" />
            <TextBlock Grid.Column="3" Classes="muted" Text="{Binding WithinPercent, StringFormat='{}{0}% in recipe'}" />
            <TextBlock Grid.Column="4" Classes="muted" Text="{Binding OverallPercent, StringFormat='{}{0}% overall'}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="Colorways" Classes="muted" Margin="0,8,0,0" />
    <ItemsControl ItemsSource="{Binding Colorways}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="img:Bitmap"><Image Source="{Binding}" Width="40" Height="40" /></DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Delete variant" Command="{Binding DeleteVariantCommand}" Classes="tbtn" />
      <Button Content="Jump to rules" Command="{Binding JumpToRulesCommand}" Classes="tbtn" />
    </StackPanel>
  </StackPanel>
</UserControl>
