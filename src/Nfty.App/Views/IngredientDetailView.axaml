<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.IngredientDetailView"
             x:DataType="vm:IngredientDetailViewModel">
  <StackPanel Spacing="12" Margin="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" />
        <TextBlock Classes="muted" Text="{Binding KindText}" />
        <TextBlock Classes="muted" Text="{Binding ColorwaysText}" />
      </StackPanel>
      <Button Grid.Column="1" Content="✏" Command="{Binding EditIngredientCommand}" Classes="accent" VerticalAlignment="Top" />
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Variant" Command="{Binding SortByCommand}" CommandParameter="Variant" Classes="tbtn" />
      <Button Content="Weight" Command="{Binding SortByCommand}" CommandParameter="Weight" Classes="tbtn" />
    </StackPanel>
    <TextBlock Text="{Binding SortColumn, StringFormat='Sorted by {0}'}" Classes="muted" />

    <ItemsControl ItemsSource="{Binding Variants}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:VariantRow">
          <Grid ColumnDefinitions="*,80,100,100">
            <TextBlock Grid.Column="0" Text="{Binding Name}" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Weight}" />
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding WithinPercent, StringFormat='{}{0}% in recipe'}" />
            <TextBlock Grid.Column="3" Classes="muted" Text="{Binding OverallPercent, StringFormat='{}{0}% overall'}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Delete variant" Command="{Binding DeleteVariantCommand}" Classes="tbtn" />
      <Button Content="Jump to rules" Command="{Binding JumpToRulesCommand}" Classes="tbtn" />
    </StackPanel>
  </StackPanel>
</UserControl>
