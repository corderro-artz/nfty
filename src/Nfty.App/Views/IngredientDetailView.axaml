<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:img="using:Avalonia.Media.Imaging"
             x:Class="Nfty.App.Views.IngredientDetailView"
             x:DataType="vm:IngredientDetailViewModel">
  <!-- Ingredient detail body: 2-column layout (explorer.html .ing-main / .ing-rail).
       Main column: variant hero (.vhero, explorer.html:313-321) + variant table (table.data vtable, explorer.html:881-885).
       Rail column: colorways panel (.cw-panel/.cwaxis, explorer.html:385-400). -->
  <!-- Rail column: Auto+MinWidth(208) rather than a fixed 280 (mirrors explorer.html's
       `.ing-grid{grid-template-columns:minmax(0,2fr) minmax(208px,1fr)}`) — a fixed 280 rail plus
       the table's 328px of fixed columns below overflowed the ~300px main column this pane gets
       inside ExplorerView's 260+* split at 900px (audit finding: OVERALL sliced off, colorways
       axis value colliding with the row rule). -->
  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" MinWidth="208" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,16,0">
      <Border Classes="vhero">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Grid.Column="0" Width="84" Height="84" CornerRadius="{DynamicResource RadiusMd}"
                  Background="{DynamicResource TileBrush}" ClipToBounds="True" Margin="0,0,16,0">
            <Image Source="{Binding Hero}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="mono" FontSize="17" FontWeight="Bold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" Text="{Binding KindText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" Text="{Binding ColorwaysText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="2" Content="✏" Command="{Binding EditIngredientCommand}" Classes="accent" VerticalAlignment="Top" />
        </Grid>
      </Border>

      <StackPanel Spacing="0">
        <Border Classes="data-h">
          <Grid ColumnDefinitions="48,*,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Classes="data-h" Text="" />
            <Button Grid.Column="1" Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Command="{Binding SortByCommand}" CommandParameter="Variant">
              <TextBlock Classes="data-h" Text="VARIANT" />
            </Button>
            <Button Grid.Column="2" Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Right" Command="{Binding SortByCommand}" CommandParameter="Weight">
              <TextBlock Classes="data-h num" Text="WEIGHT" MinWidth="80" />
            </Button>
            <TextBlock Grid.Column="3" Classes="data-h num" Text="IN RECIPE" MinWidth="100" />
            <TextBlock Grid.Column="4" Classes="data-h num" Text="OVERALL" MinWidth="100" />
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding Variants}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:VariantRow">
              <Border Classes="data-row">
                <Grid ColumnDefinitions="48,*,Auto,Auto,Auto">
                  <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="32" Height="32" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="data-row" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="data-row num" Text="{Binding Weight}" VerticalAlignment="Center" MinWidth="80" />
                  <TextBlock Grid.Column="3" Classes="data-row num" Text="{Binding WithinPercent, StringFormat='{}{0}%'}" VerticalAlignment="Center" MinWidth="100" />
                  <TextBlock Grid.Column="4" Classes="data-row num" Text="{Binding OverallPercent, StringFormat='{}{0}%'}" VerticalAlignment="Center" MinWidth="100" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Delete variant" Command="{Binding DeleteVariantCommand}" Classes="tbtn" />
        <Button Content="Jump to rules" Command="{Binding JumpToRulesCommand}" Classes="tbtn" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Column="1" Classes="cw-panel" VerticalAlignment="Stretch">
      <StackPanel Spacing="10">
        <TextBlock Classes="sub-h" Text="COLORWAYS" />

        <ItemsControl ItemsSource="{Binding Colorways}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="img:Bitmap">
              <Border Width="40" Height="40" CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource TileBrush}" ClipToBounds="True" Margin="0,0,6,6">
                <Image Source="{Binding}" Stretch="UniformToFill" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding ColorwayAxes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ColorwayAxis">
              <Border Classes="cwaxis">
                <!-- Auto,* (not *,Auto): the label ("Hue"/"Colour"/…) is always short, while a
                     custom-kind Value can be a full sentence ("no colorize · composited as-is") —
                     giving Value the star column plus wrap lets it flow onto extra lines instead
                     of forcing the label column to near-zero width and overlapping it (a real
                     overlap seen when this row was rendered with *,Auto). -->
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Classes="ax" Text="{Binding Label}" VerticalAlignment="Center"
                             Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Classes="av" Classes.der="{Binding Derived}" Text="{Binding Value}"
                             VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
