<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels" xmlns:conv="using:Nfty.App.Converters"
             x:Class="Nfty.App.Views.CookBookDetailView"
             x:DataType="vm:CookBookDetailViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20">
    <!-- .cbk-id: the identity card. The chips used to float here with no card around them. -->
    <Border Classes="cbk-id">
      <StackPanel Spacing="9">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Path Classes="ico ti" Data="{StaticResource IconTypeCookBook}" VerticalAlignment="Center" />
          <TextBlock Classes="idname" Text="{Binding Name}" />
        </StackPanel>
        <TextBlock Classes="iddesc" Text="{Binding Description}"
                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- id-chips: explorer.html .cbk-id .idchips. Each is a muted label plus a bold value. The
             book's own Name is deliberately NOT a chip - the mockup has no such chip, and the
             heading directly above already says it. "target supply" is the one mockup chip still
             missing: nothing in the model carries a target yet. -->
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Border Classes="idchip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="symbol" />
              <TextBlock Classes="cvl" Text="{Binding Symbol}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="canvas" />
              <TextBlock Classes="cvl" Text="{Binding CanvasText}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip" ToolTip.Tip="Color model used to colorize grayscale value-maps">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="colorize" />
              <TextBlock Classes="cvl" Text="{Binding ColorizeText}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip" IsVisible="{Binding HasTargetSupply}"
                  ToolTip.Tip="How many assets this collection intends to mint">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="target supply" />
              <TextBlock Classes="cvl" Text="{Binding TargetSupplyText}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip" ToolTip.Tip="{Binding StatusTip}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="status" />
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Classes="vdot" Classes.ok="{Binding IsValid}" />
              <TextBlock Classes="cvl vstate" Classes.ok="{Binding IsValid}" Text="{Binding StatusText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- .cbk-cols: metrics left, combination space right - and the mint distribution UNDER BOTH.
         It used to live inside the left column, where "full width" meant full width of that column
         and the bar stopped halfway across a panel whose other sections run edge to edge. A share of
         the whole collection is not a fact about the left-hand metrics, so it gets the whole width
         rather than a share of it. -->
    <Grid ColumnDefinitions="0.82*,24,1.18*" RowDefinitions="Auto,Auto" Margin="0,17,0,0">
      <StackPanel Grid.Row="0" Grid.Column="0">
        <!-- metric band: statband two2 -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <Border Grid.Row="0" Grid.Column="0" Classes="metric" Margin="0,0,5,5">
            <StackPanel><TextBlock Classes="mv" Text="{Binding RecipeCount}" /><TextBlock Classes="ml" Text="RECIPES" /></StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Classes="metric" Margin="5,0,0,5">
            <StackPanel><TextBlock Classes="mv" Text="{Binding LayerCount}" /><TextBlock Classes="ml" Text="LAYERS" /></StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Classes="metric" Margin="0,5,5,0">
            <StackPanel><TextBlock Classes="mv" Text="{Binding VariantCount}" /><TextBlock Classes="ml" Text="VARIANTS" /></StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Classes="metric accent" Margin="5,5,0,0">
            <StackPanel><TextBlock Classes="mv" Text="{Binding UniqueDnaText}" /><TextBlock Classes="ml" Text="UNIQUE DNA" /></StackPanel>
          </Border>
        </Grid>

      </StackPanel>

      <!-- .cspace: how each recipe's combination count is arrived at, layer by layer. -->
      <StackPanel Grid.Row="0" Grid.Column="2">
        <!-- "DNA space" is what explorer.html renders; "combination space" appears only in a CSS
             comment there, never as visible text. -->
        <TextBlock Classes="sub-h" Text="DNA SPACE" Margin="0,0,0,2" />
        <ItemsControl ItemsSource="{Binding Recipes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipeShareRow">
              <Border Classes="crow">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Grid.Column="0" Classes="cdot series" Margin="0,0,10,0"
                            Classes.s1="{Binding IsSeries1}" Classes.s2="{Binding IsSeries2}"
                            Classes.s3="{Binding IsSeries3}" Classes.s4="{Binding IsSeries4}"
                            Classes.s5="{Binding IsSeries5}" Classes.s6="{Binding IsSeries6}" />
                    <TextBlock Grid.Column="1" Classes="cname" Text="{Binding Name}" />
                    <!-- factors x factors = total -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                      <ItemsControl ItemsSource="{Binding Factors}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FactorChip">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Classes="ftimes" Text="×" IsVisible="{Binding ShowTimes}" />
                              <Border Classes="fchip"
                                      Classes.kdyn="{Binding IsDynamic}"
                                      Classes.kstat="{Binding IsStatic}"
                                      Classes.kcust="{Binding IsCustom}"
                                      ToolTip.Tip="{Binding Tip}">
                                <TextBlock Text="{Binding VariantCount}" />
                              </Border>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <!-- "→", not "=". The chips are the layer stack; the figure is unique DNA,
                           which is the LEGAL combinations (this recipe's rules remove some) times
                           each dynamic layer's quantized color buckets. So the chips' product is
                           not the figure and no extra factor can make it one — Cat reads
                           2x3x2x3x3 = 108 while its DNA space is 90 legal combinations x 7776
                           colors. An equals sign there was arithmetic the panel could not back up.
                           The tooltip carries the derivation the arrow leaves implicit. -->
                      <TextBlock Classes="ceq" Text="→" VerticalAlignment="Bottom" />
                      <TextBlock Classes="cnum" Text="{Binding DnaSpaceText}" VerticalAlignment="Bottom"
                                 ToolTip.Tip="Legal variant combinations (this recipe's rules applied), times each dynamic layer's quantized colors" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,12,Auto">
                    <!-- Unlike the three other bars in this app, THIS track has no fixed width — it
                         is a star column, so it is wider than the 310px a constant multiplier
                         assumed, and a recipe holding 100% of mints drew about four fifths of a bar.
                         Measure the track instead. -->
                    <Border Grid.Column="0" Classes="cbar">
                      <Border HorizontalAlignment="Left" CornerRadius="999" Classes="series"
                              Classes.s1="{Binding IsSeries1}" Classes.s2="{Binding IsSeries2}"
                              Classes.s3="{Binding IsSeries3}" Classes.s4="{Binding IsSeries4}"
                              Classes.s5="{Binding IsSeries5}" Classes.s6="{Binding IsSeries6}">
                        <Border.Width>
                          <MultiBinding Converter="{x:Static conv:ShareWidthConverter.Instance}">
                            <Binding Path="SharePercent" />
                            <Binding Path="$parent[Border].Bounds.Width" />
                          </MultiBinding>
                        </Border.Width>
                      </Border>
                    </Border>
                    <TextBlock Grid.Column="2" Classes="cshare" Text="{Binding SharePercent, StringFormat='{}{0}% of mints'}" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
      <TextBlock Classes="sub-h" Text="MINT DISTRIBUTION" Margin="0,16,0,9" />

      <!-- FULL WIDTH, and therefore multi-bound. This was a 310px track with each segment sized
           by SharePercent * 3.1 - a constant that is only exact while the track is exactly 310,
           and it left the bar stopping a third of the way across a panel whose other two sections
           already run edge to edge. Stretched, the constant stops being exact, so the segments
           take their share of the track's OWN measured width through ShareWidthConverter - which
           is precisely the rule the recipe mix bar (.cbar) already follows and the one CLAUDE.md
           records for a bar in a flexible track. -->
      <Border Classes="distbar" HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding Recipes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipeShareRow">
              <!-- Color comes from a token via the series class, not from a Color on the row:
                   a brush picked in the ViewModel cannot re-resolve when the theme flips. -->
              <Border Height="16" Classes="series"
                      Classes.s1="{Binding IsSeries1}" Classes.s2="{Binding IsSeries2}"
                      Classes.s3="{Binding IsSeries3}" Classes.s4="{Binding IsSeries4}"
                      Classes.s5="{Binding IsSeries5}" Classes.s6="{Binding IsSeries6}">
                <Border.Width>
                  <MultiBinding Converter="{x:Static conv:ShareWidthConverter.Instance}">
                    <Binding Path="SharePercent" />
                    <Binding Path="$parent[ItemsControl].Bounds.Width" />
                  </MultiBinding>
                </Border.Width>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <ItemsControl ItemsSource="{Binding Recipes}" Margin="0,10,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecipeShareRow">
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,14,4" VerticalAlignment="Center">
              <Border Classes="sw series"
                      Classes.s1="{Binding IsSeries1}" Classes.s2="{Binding IsSeries2}"
                      Classes.s3="{Binding IsSeries3}" Classes.s4="{Binding IsSeries4}"
                      Classes.s5="{Binding IsSeries5}" Classes.s6="{Binding IsSeries6}" />
              <!-- Same size, different faces: .pc is mono and the name is not, and two faces at
                   one size still have different line boxes. Top-aligned that put the percentage
                   1.8px above the name it belongs to. -->
              <TextBlock FontSize="12" Text="{Binding Name}" VerticalAlignment="Bottom" />
              <TextBlock Classes="pc" FontSize="12" VerticalAlignment="Bottom"
                         Text="{Binding SharePercent, StringFormat='{}{0}%'}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>
    </Grid>

    <!-- .cookbar: the footer that states what cooking will produce, then the action. -->
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
            Margin="0,18,0,0" Padding="0,15,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="cshare" VerticalAlignment="Center"
                   Text="{Binding CookBarText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <!-- The CLI's stats and inspect, rendered by Core so the text matches byte for byte.
               Beside Cook because both answer "is this book ready" before committing to a run. -->
          <Button Command="{Binding ShowReportsCommand}" Classes="tbtn"
                  ToolTip.Tip="Stats and ids — the CLI's stats and inspect">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ico sm" Data="{StaticResource IconTypeRecipe}" />
              <TextBlock Text="Reports" />
            </StackPanel>
          </Button>
          <Button Command="{Binding CookCommand}" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ico sm" Data="{StaticResource IconArrowRight}" />
              <TextBlock Text="Cook Set" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
