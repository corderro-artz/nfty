<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels" xmlns:conv="using:Nfty.App.Converters"
             x:Class="Nfty.App.Views.CookBookDetailView"
             x:DataType="vm:CookBookDetailViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20">
    <!-- .cbk-id: the identity card. The chips used to float here with no card around them. -->
    <Border Classes="cbk-id">
      <StackPanel Spacing="9">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Path Classes="ico ti" Data="{StaticResource IconTypeCookBook}" VerticalAlignment="Center" />
          <TextBlock Classes="idname" Text="{Binding Name}" />
        </StackPanel>
        <TextBlock Classes="iddesc" Text="{Binding Description}"
                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- id-chips: explorer.html .cbk-id .idchips. Each is a muted label plus a bold value. The
             book's own Name is deliberately NOT a chip - the mockup has no such chip, and the
             heading directly above already says it. "target supply" is the one mockup chip still
             missing: nothing in the model carries a target yet. -->
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Border Classes="idchip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="symbol" />
              <TextBlock Classes="cvl" Text="{Binding Symbol}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="canvas" />
              <TextBlock Classes="cvl" Text="{Binding CanvasText}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip" ToolTip.Tip="Colour model used to colorize grayscale value-maps">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="colorize" />
              <TextBlock Classes="cvl" Text="{Binding ColorizeText}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip" ToolTip.Tip="{Binding StatusTip}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="status" />
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Classes="vdot" Classes.ok="{Binding IsValid}" />
              <TextBlock Classes="cvl vstate" Classes.ok="{Binding IsValid}" Text="{Binding StatusText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- .cbk-cols: metrics + distribution left, combination space right. -->
    <Grid ColumnDefinitions="0.82*,24,1.18*" Margin="0,17,0,0">
      <StackPanel Grid.Column="0">
        <!-- metric band: statband two2 -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <Border Grid.Row="0" Grid.Column="0" Classes="metric" Margin="0,0,5,5">
            <StackPanel><TextBlock Classes="mv" Text="{Binding RecipeCount}" /><TextBlock Classes="ml" Text="RECIPES" /></StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Classes="metric" Margin="5,0,0,5">
            <StackPanel><TextBlock Classes="mv" Text="{Binding LayerCount}" /><TextBlock Classes="ml" Text="LAYERS" /></StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="0" Classes="metric" Margin="0,5,5,0">
            <StackPanel><TextBlock Classes="mv" Text="{Binding VariantCount}" /><TextBlock Classes="ml" Text="VARIANTS" /></StackPanel>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Classes="metric accent" Margin="5,5,0,0">
            <StackPanel><TextBlock Classes="mv" Text="{Binding UniqueDnaText}" /><TextBlock Classes="ml" Text="UNIQUE DNA" /></StackPanel>
          </Border>
        </Grid>

        <TextBlock Classes="sub-h" Text="MINT DISTRIBUTION" Margin="0,16,0,9" />

        <!-- PROPORTIONAL WIDTHS: each segment's Width is bound through PercentToWidthConverter
             (SharePercent * 3.1) inside a fixed-width Border.distbar, so segment widths stay
             proportional to SharePercent without a Grid built from a variable number of star
             columns (Recipes.Count isn't known until runtime). -->
        <Border Classes="distbar" Width="310" HorizontalAlignment="Left">
          <ItemsControl ItemsSource="{Binding Recipes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecipeShareRow">
                <Border Height="16" Width="{Binding SharePercent, Converter={x:Static conv:PercentToWidthConverter.ForBarWidth310}}">
                  <Border.Background><SolidColorBrush Color="{Binding SegmentColor}" /></Border.Background>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <ItemsControl ItemsSource="{Binding Recipes}" Margin="0,10,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipeShareRow">
              <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,14,4" VerticalAlignment="Center">
                <Border Classes="sw"><Border.Background><SolidColorBrush Color="{Binding SegmentColor}" /></Border.Background></Border>
                <TextBlock FontSize="12" Text="{Binding Name}" />
                <TextBlock Classes="pc" FontSize="12" Text="{Binding SharePercent, StringFormat='{}{0}%'}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- .cspace: how each recipe's combination count is arrived at, layer by layer. -->
      <StackPanel Grid.Column="2">
        <!-- "DNA space" is what explorer.html renders; "combination space" appears only in a CSS
             comment there, never as visible text. -->
        <TextBlock Classes="sub-h" Text="DNA SPACE" Margin="0,0,0,2" />
        <ItemsControl ItemsSource="{Binding Recipes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipeShareRow">
              <Border Classes="crow">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <Border Grid.Column="0" Classes="cdot" Margin="0,0,10,0">
                      <Border.Background><SolidColorBrush Color="{Binding SegmentColor}" /></Border.Background>
                    </Border>
                    <TextBlock Grid.Column="1" Classes="cname" Text="{Binding Name}" />
                    <!-- factors x factors = total -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                      <ItemsControl ItemsSource="{Binding Factors}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FactorChip">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                              <TextBlock Classes="ftimes" Text="×" IsVisible="{Binding ShowTimes}" />
                              <Border Classes="fchip"
                                      Classes.kdyn="{Binding IsDynamic}"
                                      Classes.kstat="{Binding IsStatic}"
                                      Classes.kcust="{Binding IsCustom}"
                                      ToolTip.Tip="{Binding Tip}">
                                <TextBlock Text="{Binding VariantCount}" />
                              </Border>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Classes="ceq" Text="=" />
                      <TextBlock Classes="cnum" Text="{Binding DnaSpaceText}" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,12,Auto">
                    <Border Grid.Column="0" Classes="cbar">
                      <Border HorizontalAlignment="Left" CornerRadius="999"
                              Width="{Binding SharePercent, Converter={x:Static conv:PercentToWidthConverter.ForBarWidth310}}">
                        <Border.Background><SolidColorBrush Color="{Binding SegmentColor}" /></Border.Background>
                      </Border>
                    </Border>
                    <TextBlock Grid.Column="2" Classes="cshare" Text="{Binding SharePercent, StringFormat='{}{0}% of mints'}" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <!-- .cookbar: the footer that states what cooking will produce, then the action. -->
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
            Margin="0,18,0,0" Padding="0,15,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="cshare" VerticalAlignment="Center"
                   Text="{Binding UniqueDnaText, StringFormat='{}{0} unique DNA available'}" />
        <Button Grid.Column="1" Command="{Binding CookCommand}" Classes="accent">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="ico sm" Data="{StaticResource IconArrowRight}" />
            <TextBlock Text="Cook Set" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
