<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels" xmlns:conv="using:Nfty.App.Converters"
             x:Class="Nfty.App.Views.CookBookDetailView"
             x:DataType="vm:CookBookDetailViewModel">
  <!-- NO SCROLLER. The one thing on this card without a bound size is the recipe list, and it pages
       instead of growing - so the card fits the pane at every window the app allows, and the mint
       bar and the actions cannot be scrolled away from. `DnaSpaceLayoutTests` measures that at the
       smallest window rather than trusting it. -->
  <!-- Margin 16 and not 20: the Recipe and Ingredient panes beside this one both say 16, and this
       card was the only one that did not - so the content shifted by four pixels every time the
       selection moved between a book and a recipe. The eight pixels it returns are also most of
       what the table needed: at the smallest window the app opens the rows host measured 26px
       against a 35px row, so the one row it claimed to be showing was sliced in half by the mint
       bar. `DnaSpaceLayoutTests` asserts whole rows now rather than assuming them. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16" RowSpacing="10">

    <!-- .cbk-id: the identity card. The chips used to float here with no card around them.
         There is deliberately no "target supply" chip any more: that number is on the supply rail
         below, beside the figure it is a fraction of, and it was being stated in three places. -->
    <Border Grid.Row="0" Classes="cbk-id">
      <StackPanel Spacing="9">
        <!-- THE TITLE IS THE BOOK'S NAME; the suffix beside it is what the ASSETS are called.
             They are two fields - Manifest.Name and Manifest.Collection.Name - and this card read
             the first while taking its symbol and description from the second, so three of its four
             values came from one object and the title from another with nothing saying so. The
             collection name is what every metadata/NNNN.json publishes as "{name} #{n}" and what an
             export is named after, and it appeared on no screen in the app.
             It goes on this line because this line is the only one on the card with room: the chip
             row below is already four chips and ~471px of the ~660 the card gets at the smallest
             window, and a fifth would either overrun it or wrap the row and eat the DNA table's one
             remaining row. The name takes what it needs up to a cap and the suffix trims, so a long
             pair degrades instead of pushing the other off. -->
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
          <Path Grid.Column="0" Classes="ico ti" Data="{StaticResource IconTypeCookBook}" VerticalAlignment="Center" />
          <!-- BOTH runs are Bottom, not one Bottom and one Center: Avalonia has no baseline
               alignment, so an 18px title and a 10.5px suffix aligned differently sat 2.5px apart
               and TextBaselineTests said so. Bottom flushes the two boxes and leaves only the
               descent difference. -->
          <TextBlock Grid.Column="1" Classes="idname" Text="{Binding Name}"
                     VerticalAlignment="Bottom"
                     MaxWidth="330" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Classes="mintname" Text="{Binding MintName}"
                     VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="The collection name every cooked asset is published under. It is a separate field from the book's own name — the CLI and a hand-edited manifest can set them differently." />
        </Grid>
        <TextBlock Classes="iddesc" Text="{Binding Description}"
                   IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Border Classes="idchip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="symbol" />
              <TextBlock Classes="cvl" Text="{Binding Symbol}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="canvas" />
              <TextBlock Classes="cvl" Text="{Binding CanvasText}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip" ToolTip.Tip="Color model used to colorize grayscale value-maps">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="colorize" />
              <TextBlock Classes="cvl" Text="{Binding ColorizeText}" />
            </StackPanel>
          </Border>
          <Border Classes="idchip" ToolTip.Tip="{Binding StatusTip}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="ck" Text="status" />
              <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                       Classes="vdot" Classes.ok="{Binding IsValid}" />
              <TextBlock Classes="cvl vstate" Classes.ok="{Binding IsValid}" Text="{Binding StatusText}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The band: three counts and the figure, then the supply rail.
         The counts are CAPPED and the figure cell takes every pixel the window adds - a count is two
         or three digits at any size, so width does nothing for it, while this figure's width is what
         lets it print in full. Measured, the figure has 266px at the smallest window the app opens
         and the widest a long can hold inks at 255, which is why there is no compact form and no
         tooltip on it.
         All four cells hold the same two lines at the same sizes and CENTER them, so the values
         share one line and the labels share another by construction rather than by four paddings
         agreeing. They used to be spread top-and-bottom, which left a void through every cell. -->
    <StackPanel Grid.Row="1" Spacing="9">
      <!-- The three counts share ONE stated width so the band reads as three of a kind rather than
             three cells that happen to hold short words; Auto sized each to its own label and came
             out 74/74/88. The figure takes the rest, which is what lets it print in full - the
             number is checked at the smallest window the app opens by DnaSpaceLayoutTests. -->
      <Grid ColumnDefinitions="88,88,88,*" ColumnSpacing="8">
        <Border Grid.Column="0" Classes="metric">
          <StackPanel Spacing="4">
            <TextBlock Classes="mv" Text="{Binding RecipeCount}" /><TextBlock Classes="ml" Text="RECIPES" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="metric">
          <StackPanel Spacing="4">
            <TextBlock Classes="mv" Text="{Binding LayerCount}" /><TextBlock Classes="ml" Text="LAYERS" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="metric">
          <StackPanel Spacing="4">
            <TextBlock Classes="mv" Text="{Binding VariantCount}" /><TextBlock Classes="ml" Text="VARIANTS" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="metric accent">
          <StackPanel Spacing="4">
            <TextBlock Classes="mv" Text="{Binding UniqueDnaText}" /><TextBlock Classes="ml" Text="UNIQUE DNA" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- The supply rail: does the intended supply fit in the space? Sized and cornered like the
           mint bar below, because they are the same kind of object - a track read as a proportion.
           It was a 3px line on a cell's bottom edge and read as a rule rather than a measurement. -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="{Binding HasSupplyRail}">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock Classes="raill" Text="TARGET SUPPLY" />
          <TextBlock Classes="raill strong" Text="{Binding TargetSupplyText}" />
        </StackPanel>
        <Border Grid.Column="1" Classes="meter">
          <!-- A 0.05% fill rounds to nothing, so the fill carries a minimum width: "almost none of
               it" is a real answer, and an empty track reads as a broken control. -->
          <Border HorizontalAlignment="Left" MinWidth="4" Classes="meterfill"
                  Classes.over="{Binding SupplyExceedsSpace}">
            <Border.Width>
              <MultiBinding Converter="{x:Static conv:ShareWidthConverter.Instance}">
                <Binding Path="SupplyPercent" />
                <Binding Path="$parent[Border].Bounds.Width" />
              </MultiBinding>
            </Border.Width>
          </Border>
        </Border>
        <TextBlock Grid.Column="2" Classes="railpct" VerticalAlignment="Center"
                   Classes.over="{Binding SupplyExceedsSpace}" Text="{Binding SupplyPercentText}" />
      </Grid>
    </StackPanel>

    <!-- The DNA-space table. One row per recipe, on one line, paged rather than scrolled. -->
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="0">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,7">
        <TextBlock Grid.Column="0" Classes="sub-h" Text="DNA SPACE" VerticalAlignment="Center" />
        <!-- The pager is present at one page as well as ten - disabled, never absent - so a resize
             that changes the page count does not move anything beside it. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="pglabel" Text="{Binding PageLabel}" VerticalAlignment="Center" />
          <Button Classes="pgbtn" Command="{Binding PreviousPageCommand}" Content="‹"
                  ToolTip.Tip="Previous page" />
          <Button Classes="pgbtn" Command="{Binding NextPageCommand}" Content="›"
                  ToolTip.Tip="Next page" />
          <ItemsControl ItemsSource="{Binding Dots}" VerticalAlignment="Center" Margin="2,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PageDot">
                <Border Classes="pgdot" Classes.on="{Binding IsCurrent}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <!-- THE HEADER AND EVERY ROW STATE THE SAME COLUMNS. Avalonia has no SharedSizeGroup, so
           across separate grids a stated pixel column is the only thing that aligns - the same rule
           the recipe layer table follows. Only the name and the share track flex. -->
      <Border Grid.Row="1" Classes="thead">
        <Grid ColumnDefinitions="7,*,46,234,14,118" ColumnSpacing="10">
          <TextBlock Grid.Column="1" Classes="th" Text="RECIPE" />
          <TextBlock Grid.Column="2" Classes="th r" Text="SHARE" />
          <TextBlock Grid.Column="3" Classes="th r" Text="LAYERS" />
          <TextBlock Grid.Column="5" Classes="th r" Text="UNIQUE DNA" />
        </Grid>
      </Border>

      <!-- The host exists to be MEASURED, and it is a ScrollViewer for one reason: a Panel reports
           its content's desired height, so the star row grew with the rows, which let more rows fit,
           which grew the row again — Avalonia calls that an infinite layout loop and it is exactly
           what the harness caught. A ScrollViewer reports the CONSTRAINT it was given instead, so
           the height the page size is computed from cannot depend on the page size.
           It cannot actually scroll: both bars are disabled, and the table pages so that its content
           never exceeds the viewport. `DnaSpaceLayoutTests` asserts that rather than trusting it. -->
      <ScrollViewer Grid.Row="2" x:Name="RowsHost"
                    VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding VisibleRecipes}" VerticalAlignment="Top">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecipeShareRow">
            <Border Classes="crow">
              <Grid ColumnDefinitions="7,*,46,234,14,118" ColumnSpacing="10">
                <Border Grid.Column="0" Classes="cdot series" />

                <!-- Name and share track share the elastic column: the name takes what it needs up
                     to a cap and trims, and the TRACK takes the rest. At full screen that column is
                     ~800px, and the one element here whose meaning improves with length is a bar -
                     laid out any other way it was an 800px void between a five-letter name and the
                     numbers. -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Classes="cname" Text="{Binding Name}"
                             MaxWidth="190" HorizontalAlignment="Left"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Classes="cbar" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" CornerRadius="999" Classes="series">
                      <Border.Width>
                        <MultiBinding Converter="{x:Static conv:ShareWidthConverter.Instance}">
                          <Binding Path="SharePercent" />
                          <Binding Path="$parent[Border].Bounds.Width" />
                        </MultiBinding>
                      </Border.Width>
                    </Border>
                  </Border>
                </Grid>

                <TextBlock Grid.Column="2" Classes="cshare" VerticalAlignment="Center"
                           Text="{Binding SharePercent, StringFormat='{}{0}%'}" />

                <!-- 234 AND NOT 204, WHICH IS SIX SLOTS OF 39 FOR CONTENT THAT NEEDS 35.
                     At 204 each slot was 34 for a separator (7), its gap (4) and a badge (24) - one
                     pixel short - so every right-aligned slot overflowed its LEADING edge and each
                     x started 1px INSIDE the badge to its left, while the last badge ran 1px past
                     the strip into the arrow column. The gaps alternated 0 and 4, which is what made
                     the row read as unevenly spaced: the separator hugged the badge on its left
                     instead of sitting between the two it separates. At 39 the slack is 4, so every
                     gap in the strip is 4 and an x sits centred between its neighbours.
                     A GRID OF FIXED SLOTS, not a run. Laid out as a run, a five-layer recipe put its
                     first badge where a six-layer one put its second and nothing lined up down the
                     table. One slot per column means badge n sits at the same x on every row, and a
                     stack too deep spends the LAST slot on a +N - so every +N lines up with every
                     other, and with the final badge of the rows that need none. Each slot carries
                     its own separator, reserved on the first and merely not inked. -->
                <ItemsControl Grid.Column="3" ItemsSource="{Binding Factors}" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FactorChip">
                      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <TextBlock Classes="ftimes" Text="×" IsVisible="{Binding ShowTimes}" />
                        <Border Classes="fchip"
                                Classes.kdyn="{Binding IsDynamic}"
                                Classes.kstat="{Binding IsStatic}"
                                Classes.kcust="{Binding IsCustom}"
                                Classes.more="{Binding IsMore}"
                                ToolTip.Tip="{Binding Tip}">
                          <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- "→", not "=". The badges are the layer stack; the figure is unique DNA, which is
                     the LEGAL combinations (this recipe's rules remove some) times each dynamic
                     layer's quantized colors. So the badges' product is not the figure and no extra
                     badge could make it one. The tooltip carries the derivation. -->
                <TextBlock Grid.Column="4" Classes="ceq" Text="→" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Classes="cnum" VerticalAlignment="Center"
                           Text="{Binding DnaSpaceText}" ToolTip.Tip="{Binding DnaSpaceTip}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Pinned. The mint bar describes the WHOLE book, so it binds Recipes and not the page: a
         paged view narrows what you are reading, never what the collection is. -->
    <StackPanel Grid.Row="3" Spacing="10">
      <Border Classes="distbar" HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding Recipes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecipeShareRow">
              <!-- Paint comes from the series class, which turns the row's HueShift around the
                   palette's anchor token — not from a Color on the row, which could not re-resolve
                   when the theme flips. -->
              <Border Height="16" Classes="series">
                <Border.Width>
                  <MultiBinding Converter="{x:Static conv:ShareWidthConverter.Instance}">
                    <Binding Path="SharePercent" />
                    <Binding Path="$parent[ItemsControl].Bounds.Width" />
                  </MultiBinding>
                </Border.Width>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="sub-h" VerticalAlignment="Center" Text="MINT DISTRIBUTION" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <!-- The CLI's stats and inspect, rendered by Core so the text matches byte for byte.
               Beside Cook because both answer "is this book ready" before committing to a run. -->
          <Button Command="{Binding ShowReportsCommand}" Classes="tbtn"
                  ToolTip.Tip="Stats and ids — the CLI's stats and inspect">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ico sm" Data="{StaticResource IconTypeRecipe}" />
              <TextBlock Text="Reports" />
            </StackPanel>
          </Button>
          <Button Command="{Binding CookCommand}" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ico sm" Data="{StaticResource IconArrowRight}" />
              <TextBlock Text="Cook Set" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>
