<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.CookDialogView"
             x:DataType="vm:CookDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24" Width="380"
          BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
    <StackPanel Spacing="10">
      <TextBlock Text="Cook" FontWeight="Bold" />

      <StackPanel Spacing="10" IsVisible="{Binding ShowForm}" IsEnabled="{Binding ShowForm}">
        <!-- Both fields carry a real label. The seed used to be labeled by PlaceholderText alone,
             and the ViewModel pre-fills a random seed - so the one thing that named the field was
             showing exactly when the field was empty, which it never is. The user met an unexplained
             box of hex. A Grid rather than two StackPanels so the two labels share one column and
             stay aligned by construction. -->
        <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Count" VerticalAlignment="Center" Classes="muted" />
          <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Count}" Minimum="1"
                         Width="140" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Seed" VerticalAlignment="Center" Classes="muted" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Seed}"
                   ToolTip.Tip="Any word. The same book and the same seed always cook the same collection." />
        </Grid>
        <CheckBox Content="Pack into a single .set" IsChecked="{Binding Pack}" />
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding IsRunning}">
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
        <TextBlock Text="{Binding PhaseText}" Classes="muted" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="tbtn" HorizontalAlignment="Right" />
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding IsDone}">
        <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Classes="muted" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Reveal" Command="{Binding RevealCommand}" Classes="tbtn" />
          <Button Content="Close" Command="{Binding CloseCommand}" Classes="tbtn" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                  IsVisible="{Binding ShowForm}">
        <Button Content="Close" Command="{Binding CloseCommand}" Classes="tbtn" />
        <Button Content="Cook" Command="{Binding CookCommand}" Classes="accent" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
