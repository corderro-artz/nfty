<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:conv="using:Nfty.App.Converters"
             x:Class="Nfty.App.Views.CookDialogView"
             x:DataType="vm:CookDialogViewModel">
  <UserControl.Styles>
    <!-- Reserve space, toggle ink: the disclosure button is laid out in the box row whether or not
         the box is ticked, so ticking it cannot grow the row and shove everything below. -->
    <Style Selector="Button.absent">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style Selector="StackPanel.hide, Grid.hide">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="TextBlock.absent">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <!-- Open state: the same hairline hover draws, held while the options are showing. -->
    <Style Selector="Button.tbtn.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}" />
    </Style>
  </UserControl.Styles>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <Border Classes="modal small">
    <Grid RowDefinitions="Auto,Auto">
      <Border Grid.Row="0" Classes="modal-body tight" Padding="24,18,24,12">
        <StackPanel Spacing="11">
          <StackPanel Classes="plabel-row">
            <Ellipse Classes="kdot" />
            <TextBlock Text="COOK" Classes="slbl" />
          </StackPanel>
          <TextBlock Text="Cook a Set" Classes="m-h" />

          <!-- The three states of the card (form, running, done) share ONE cell, and only the current
               one is inked: the card is the height of the tallest, so it is one height in every state
               and the footer never jumps when Cook is pressed. The others are disabled as well as
               transparent, so they are neither hit-testable nor reachable by Tab. -->
          <Panel>
          <StackPanel Spacing="8" Classes.hide="{Binding !ShowForm}" IsEnabled="{Binding ShowForm}">
            <!-- Both fields carry a real label. The seed used to be labeled by PlaceholderText alone,
                 and the ViewModel pre-fills a random seed - so the one thing that named the field was
                 showing exactly when the field was empty, which it never is. The user met an unexplained
                 box of hex. A Grid rather than two StackPanels so the two labels share one column and
                 stay aligned by construction. -->
            <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="COUNT" VerticalAlignment="Center" Classes="plabel" Margin="0" />
              <!-- "How many more", with the total an extend reaches beside it. The total's slot is
                   always laid out and only its ink comes and goes, so finding out the folder holds a
                   Set moves nothing. -->
              <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="190,*" ColumnSpacing="10">
                <NumericUpDown Grid.Column="0" Value="{Binding Count}" Minimum="1"
                               HorizontalAlignment="Stretch" />
                <TextBlock Grid.Column="1" x:Name="TotalText" Classes="m-sub" VerticalAlignment="Center" Margin="0"
                           Text="{Binding ResultingTotalText}" />
              </Grid>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="SEED" VerticalAlignment="Center" Classes="plabel" Margin="0" />
              <!-- The seed: type any word, or roll a fresh one with the die. Same 190 column as Count and
                   Recipe above and below it, so the three fields share one edge; the die sits in the
                   gutter the other rows give their notes. What a seed means is the footer's line already. -->
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="190,Auto,*" ColumnSpacing="8">
                <TextBox Grid.Column="0" x:Name="SeedBox" FontFamily="{DynamicResource MonoFontFamily}" VerticalAlignment="Center" Text="{Binding Seed}"
                         ToolTip.Tip="Any word. The same book and the same seed always cook the same collection." />
                <Button Grid.Column="1" x:Name="SeedDie" Classes="sampleroll seeddie" Command="{Binding RerollSeedCommand}"
                        ToolTip.Tip="Roll a new random seed. Or type your own in the box.">
                  <Panel Classes="dieroll">
                    <Path Classes="ico ti"
                          Data="{Binding SeedDieFace, Converter={x:Static conv:DieFaceConverter.Instance}}" />
                    <Path Classes="ico ti pip1"
                          Data="{Binding SeedDieFace, Converter={x:Static conv:DieFaceConverter.AccentPip}}" />
                  </Panel>
                </Button>
              </Grid>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="RECIPE" VerticalAlignment="Center" Classes="plabel" Margin="0" />
              <!-- The reason sits OUTSIDE the combo (a disabled control is dimmed to 0.38) and shares its
                   row, so it costs no height; the slot is always laid out and only the ink toggles. -->
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="190,*" ColumnSpacing="10">
                <ComboBox Grid.Column="0" x:Name="RecipeCombo" ItemsSource="{Binding RecipeChoices}"
                          SelectedItem="{Binding SelectedRecipe}" IsEnabled="{Binding RecipeChoiceEnabled}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecipeChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="1" x:Name="RecipeReason" Classes="m-sub" VerticalAlignment="Center"
                           Margin="0" Classes.absent="{Binding RecipeChoiceEnabled}"
                           Text="{x:Static vm:CookDialogViewModel.RecipeLockedReason}" />
              </Grid>
            </Grid>
            <!-- Four options share two rows. Keep the previous options area's height: naming,
                 model disclosure, scan answers and DNA hints never move the card or footer. -->
            <StackPanel Height="143">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <CheckBox Grid.Column="0" Content="Pack into a single .set" IsChecked="{Binding Pack}" />
                <CheckBox Grid.Column="1" Content="Allow repeats" IsChecked="{Binding Unlimited}"
                          ToolTip.Tip="With repeats allowed, identity is the token number, as ERC-721 defines it. Weights still decide how common each variant is, so a rare variant stays rare and a layer with a low appearance chance is rarer still." />
              </Grid>
              <TextBlock Text="{Binding UniqueHint}" Classes="m-sub" Height="16"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding UniqueHint}" Margin="24,2,0,0" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <CheckBox Grid.Column="0" x:Name="NamedFolderCheck" Content="Name after CookBook"
                          IsChecked="{Binding NameFolderAfterCookBook}" ToolTip.Tip="{Binding NamedFolderHint}" />
                <Grid Grid.Column="1" ColumnDefinitions="*,28" ColumnSpacing="2">
                  <CheckBox Grid.Column="0" Content="Include 3D models" IsChecked="{Binding IncludeModels}"
                            IsEnabled="{Binding !BookIsTwoDOnly}" ToolTip.Tip="{Binding ModelsNote}" />
                  <Button Grid.Column="1" Classes="tbtn" Width="28" Height="28" MinWidth="0" MinHeight="28" Padding="0"
                          Command="{Binding ToggleModelOptionsCommand}" VerticalAlignment="Center"
                          AutomationProperties.Name="Model options" ToolTip.Tip="Model options"
                          Classes.absent="{Binding !ShowModelOptionsToggle}"
                          Classes.on="{Binding ShowModelOptions}">
                    <!-- Down and up chevrons swap ink inside one reserved slot. -->
                    <Panel Width="14" Height="14" VerticalAlignment="Center">
                      <Path Classes="ico xs" Data="{StaticResource IconChevronDown}"
                            IsVisible="{Binding !ShowModelOptions}" />
                      <Path Classes="ico xs" Data="{StaticResource IconChevronUp}"
                            IsVisible="{Binding ShowModelOptions}" />
                    </Panel>
                  </Button>
                </Grid>
              </Grid>
              <Panel Height="48" Margin="0,2,0,0">
                <!-- The scan answer and model fields occupy the same detail slot. A 2D-only reason
                     stays outside its disabled checkbox; open fields keep the note on its tooltip. -->
                <TextBlock x:Name="ModelsNoteText" Text="{Binding ModelsNote}" Classes="m-sub" TextWrapping="Wrap"
                           Classes.absent="{Binding !ModelsNoteShown}" Margin="24,0,0,0" VerticalAlignment="Center" />
                <Grid ColumnDefinitions="*,*,76" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4"
                      Classes.hide="{Binding !ShowModelOptionsSection}" IsEnabled="{Binding ShowModelOptionsSection}"
                      VerticalAlignment="Center">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="FORMAT" Classes="plabel" Margin="0" />
                  <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding FormatChoices}"
                            SelectedValueBinding="{Binding Value}" SelectedValue="{Binding ModelFormat}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModelFormatChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="PIVOT" Classes="plabel" Margin="0" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PivotChoices}"
                            SelectedValueBinding="{Binding Value}" SelectedValue="{Binding ModelPivot}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModelPivotChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="VOXEL SIZE" Classes="plabel" Margin="0" />
                  <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding VoxelSize}" Minimum="{Binding VoxelSizeMin, Mode=OneTime}" Maximum="{Binding VoxelSizeMax, Mode=OneTime}"
                                 FormatString="0.###" Increment="0.1" MinWidth="0" Width="76" />
                </Grid>
              </Panel>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="9" VerticalAlignment="Top" Classes.hide="{Binding !IsRunning}" IsEnabled="{Binding IsRunning}">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
            <TextBlock Text="{Binding PhaseText}" Classes="m-sub" />
          </StackPanel>

          <StackPanel Spacing="10" VerticalAlignment="Top" Classes.hide="{Binding !IsDone}" IsEnabled="{Binding IsDone}">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Classes="m-sub" />
            <!-- The whole strip is the button. One control for one action: a path beside a separate
                 "Reveal" button is two things to press for the same intent, and the path was the
                 thing being pointed at anyway. -->
            <Button Classes="pathstrip" Command="{Binding RevealCommand}"
                    ToolTip.Tip="{Binding OutputPath}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconOpen}"
                      VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Classes="leaf" Text="{Binding OutputLeaf}" />
                  <TextBlock Classes="parent" Text="{Binding OutputParent}" />
                </StackPanel>
              </Grid>
            </Button>
            <!-- Said in the CLI's own words (SetProvenance.Warning), after the folder it is about.
                 Last in the stack so nothing above moves when it has something to say; a warning,
                 never a refusal - the Set was extended. -->
            <TextBlock x:Name="ProvenanceText" Classes="caveat" Text="{Binding ProvenanceHeadline}"
                       ToolTip.Tip="{Binding ProvenanceWarning}"
                       Classes.absent="{Binding !ProvenanceShown}" />
          </StackPanel>
          </Panel>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="modal-foot">
        <Grid ColumnDefinitions="*,70,96" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="keyhint" VerticalAlignment="Center"
                     Text="{Binding FootHint}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FootHint}" />
          <Panel Grid.Column="1">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="tbtn"
                    Classes.absent="{Binding !IsRunning}" HorizontalAlignment="Stretch" />
            <Button Content="Close" Command="{Binding CloseCommand}" Classes="tbtn"
                    Classes.absent="{Binding IsRunning}" HorizontalAlignment="Stretch" />
          </Panel>
          <Panel Grid.Column="2">
            <!-- Both accent actions share one reserved target. Before the run it is Cook; afterward
                 Open Set leads directly to browsing/export. While running the slot keeps its space. -->
            <Button Content="Open Set" Command="{Binding OpenSetCommand}" Classes="accent"
                    Classes.absent="{Binding !IsDone}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Browse the assets, and export - the art, either metadata set, the source CookBook, sealed or not." />
            <Button Command="{Binding CookCommand}" Classes="accent"
                    Classes.absent="{Binding !ShowForm}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="ico sm" Data="{StaticResource IconFlame}" /><TextBlock Text="Cook" /></StackPanel></Button>
          </Panel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
