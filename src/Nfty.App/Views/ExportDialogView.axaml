<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.ExportDialogView"
             x:DataType="vm:ExportDialogViewModel"
             RenderOptions.BitmapInterpolationMode="None">
  <Border Classes="modal export">
    <Grid RowDefinitions="Auto,*,Auto,Auto">

      <!-- THE TITLE AND THE TABS SHARE ONE ROW, AND THERE IS NO EYEBROW. Stacked, they were three
           rows for one idea: a "• EXPORT" kicker over a title reading "Export this Set" over the
           tabs - 98px of a 470px card, with the category label saying the same word as the heading
           directly under it. A kicker earns its line where the title is a noun that needs a category
           ("Cat" under RECIPE); here it only repeats. Title left, controls right is the grammar the
           Set browser's own header already uses, and the hairline the tab underlines land on now
           doubles as the head's bottom rule. -->
      <Border Grid.Row="0" Classes="exporthead" Margin="24,12,24,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <TextBlock Grid.Column="0" Text="Export this Set" Classes="m-h"
                     VerticalAlignment="Bottom" />

          <!-- Underline tabs, the vocabulary the Ingredient editor's rail already uses. Each carries
               its 2px underline in BOTH states - transparent when off - so switching moves nothing.
               Bottom-aligned so the underlines sit on the head's rule rather than floating above
               it: Avalonia has no baseline alignment, so the flush edge has to be asked for. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18"
                      VerticalAlignment="Bottom" IsVisible="{Binding ShowForm}">
            <Button Classes="railtab" Classes.on="{Binding IsContentsTab}" Content="CONTENTS"
                    Command="{Binding ShowTabCommand}"
                    CommandParameter="{x:Static vm:ExportTab.Contents}" />
            <Button Classes="railtab" Classes.on="{Binding IsMarketplaceTab}" Content="MARKETPLACE"
                    Command="{Binding ShowTabCommand}"
                    CommandParameter="{x:Static vm:ExportTab.Marketplace}" />
            <Button Classes="railtab" Classes.on="{Binding IsImagesTab}" Content="IMAGES"
                    Command="{Binding ShowTabCommand}"
                    CommandParameter="{x:Static vm:ExportTab.Images}" />
            <Button Classes="railtab" Classes.on="{Binding IsSealTab}" Content="SEAL"
                    Command="{Binding ShowTabCommand}"
                    CommandParameter="{x:Static vm:ExportTab.Seal}" />
            <Button Classes="railtab" Classes.on="{Binding IsUploadTab}" Content="UPLOAD"
                    Command="{Binding ShowTabCommand}"
                    CommandParameter="{x:Static vm:ExportTab.Upload}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Classes="modal-body tight">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="11" Classes="exportpages">

            <!-- ============================ CONTENTS ============================ -->
            <StackPanel Spacing="12" IsVisible="{Binding IsContentsTab}"
                        IsEnabled="{Binding ShowForm}">

              <!-- Four starting points. Which one is lit comes from the OPTIONS, not from the click
                   that set them, so a tile goes out the moment a box below it disagrees. -->
              <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,-6,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExportPresetTile">
                    <Button Classes="preset" Classes.sel="{Binding IsSelected}"
                            Margin="0,0,6,0"
                            Command="{Binding $parent[ItemsControl].((vm:ExportDialogViewModel)DataContext).ApplyPresetCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="pn" Text="{Binding Title}" />
                        <TextBlock Classes="pd" Text="{Binding Summary}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,150" ColumnSpacing="20">
                <StackPanel Grid.Column="0" Spacing="0">
                  <TextBlock Text="CONTENTS" Classes="slbl" />
                  <CheckBox Content="Generated art" IsChecked="{Binding Images}"
                            ToolTip.Tip="images/ — the finished PNGs." />
                  <CheckBox Content="Marketplace metadata" IsChecked="{Binding OpenSeaMetadata}"
                            ToolTip.Tip="metadata/ — name, description and traits: the standard ERC-721 fields." />
                  <CheckBox Content="nfty metadata" IsChecked="{Binding NftyMetadata}"
                            ToolTip.Tip="nfty/ — per-asset DNA, the seed, and the color rolled on every layer. What a buyer wants and a public listing has no use for." />
                  <!-- ALWAYS LAID OUT, disabled with its reason when the Set has no models/: a row
                       that came and went with the Set would move everything under it. -->
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" Content="3D models" IsChecked="{Binding ModelsShown, Mode=OneWay}"
                              IsEnabled="{Binding SetHasModels}"
                              ToolTip.Tip="{Binding ModelsTip}" />
                    <!-- The reason, in ink beside the dim box: a disabled row that only says why on
                         hover is a row the reader has to guess at. Empty when the Set has models. -->
                    <TextBlock Grid.Column="1" Classes="m-sub" VerticalAlignment="Center"
                               Text="{Binding ModelsNote}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" Content="Source CookBook"
                              IsChecked="{Binding IncludeCookBook}"
                              ToolTip.Tip="A Set records its book's hash, never the book — so the book is looked for among the ones this app knows and accepted only if its hash matches. Choose the file if it is somewhere else." />
                    <!-- The leaf name says WHICH book; whether it is the right one is in the
                         manifest's consequences below, where every other thing worth stopping for
                         is already stated. -->
                    <TextBlock Grid.Column="1" Classes="m-sub" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="{Binding CookBookLeaf}" />
                    <Button Grid.Column="2" Classes="tbtn" Content="Choose…"
                            Command="{Binding PickCookBookCommand}" />
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="SHAPE" Classes="slbl" />
                  <RadioButton GroupName="shape" Content="Single file" IsChecked="{Binding Packed}" />
                  <!-- Disabled rather than silently corrected on Export: a sealed export is one
                       authenticated stream, so there is no folder form of it, and the shape shown
                       has to be the shape that gets written. -->
                  <RadioButton GroupName="shape" Content="Folder" IsChecked="{Binding !Packed}"
                               IsEnabled="{Binding CanChooseFolder}"
                               ToolTip.Tip="A sealed export is always one file." />
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- ============================= IMAGES ============================= -->
            <StackPanel Spacing="14" IsVisible="{Binding IsImagesTab}"
                        IsEnabled="{Binding ShowForm}">

              <!-- SPRITESHEET. The grid boxes open on the squarest layout that holds this
                   collection, filled in - a box showing nothing is a form asking a question the
                   reader has no opinion about. The size beside them is the answer those two numbers
                   produce, so the control explains itself without a sentence. -->
              <StackPanel Spacing="7">
                <TextBlock Text="SPRITESHEET" Classes="slbl" />
                <CheckBox Content="Stitch every asset into one sheet"
                          IsChecked="{Binding MakeSpriteSheet}"
                          ToolTip.Tip="spritesheet.png, laid out left to right and top to bottom in the Set's own numbering — so cell n is asset n+1." />
                <Grid ColumnDefinitions="Auto,86,Auto,86,*" ColumnSpacing="9"
                      IsEnabled="{Binding MakeSpriteSheet}" Margin="24,2,0,0">
                  <TextBlock Grid.Column="0" Text="Columns" Classes="m-sub" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Classes="nin" Minimum="1" Maximum="4096"
                                 FormatString="0" Value="{Binding SheetColumns}" />
                  <TextBlock Grid.Column="2" Text="Rows" Classes="m-sub" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="3" Classes="nin" Minimum="1" Maximum="4096"
                                 FormatString="0" Value="{Binding SheetRows}" />
                  <TextBlock Grid.Column="4" Classes="m-sub" VerticalAlignment="Center"
                             Margin="6,0,0,0" Text="{Binding SheetSizeText}" />
                </Grid>
              </StackPanel>

              <Border Classes="optsplit" />

              <!-- WATERMARK. The corner picker is a 2x2 of corners drawn as the corners they are:
                   the one control on this card where the SHAPE says what it does, and four radio
                   labels reading "Top left / Top right / …" would be the worse answer. -->
              <StackPanel Spacing="7">
                <TextBlock Text="DEBUG MARK" Classes="slbl" />
                <CheckBox Content="Stamp each asset's set number in a corner"
                          IsChecked="{Binding NumberWatermark}"
                          ToolTip.Tip="Painted into the pixels of the exported copy — never into your Set. A folder of loose sprites is unsortable without it; a stamped export is for working with, not for minting." />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"
                      IsEnabled="{Binding NumberWatermark}" Margin="24,2,0,0">
                  <ItemsControl Grid.Column="0" ItemsSource="{Binding Corners}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CornerOption">
                        <Button Classes="cornerpick" Classes.on="{Binding IsSelected}"
                                Command="{Binding $parent[ItemsControl].((vm:ExportDialogViewModel)DataContext).PickCornerCommand}"
                                CommandParameter="{Binding}">
                          <Border Classes="cornerdot"
                                  HorizontalAlignment="{Binding Dot}"
                                  VerticalAlignment="{Binding DotV}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="m-sub" TextWrapping="Wrap"
                               Text="The number is painted into the exported copy. Your Set is untouched." />
                    <!-- Inked only when the Set has models AND the mark is armed; always laid out,
                         so arming the mark moves nothing. -->
                    <TextBlock x:Name="ModelsMarkNote" Classes="m-sub" TextWrapping="Wrap"
                               Opacity="{Binding ModelsMarkNoteOpacity}"
                               Text="The mark is drawn on exported images only — models/ is never stamped." />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>

            <!-- ============================ MARKETPLACE ============================
                 What a marketplace needs written INTO the files. Every value is export-only: the
                 cooked Set is never touched. Each field's reason sits on its own label line, in
                 warning ink and reserved, so a mistyped URI says why without the page growing a row;
                 the same sentence is in the footer, which is what stops Export. -->
            <StackPanel Spacing="12" IsVisible="{Binding IsMarketplaceTab}"
                        IsEnabled="{Binding ShowForm}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="22">
                <StackPanel Grid.Column="0" Spacing="9">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="IMAGE BASE URI" Classes="slbl" />
                      <TextBlock Grid.Column="1" Classes="caveat" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 Text="{Binding ImageBaseUriProblem}" ToolTip.Tip="{Binding ImageBaseUriProblem}" />
                    </Grid>
                    <TextBox x:Name="ImageBaseUriBox" Text="{Binding ImageBaseUri}" IsEnabled="{Binding ImageBaseUriEnabled}"
                             PlaceholderText="ipfs://CID/"
                             ToolTip.Tip="Where you uploaded the images/ folder. Each image link becomes this followed by the file name: ipfs://CID/ gives ipfs://CID/1.png (an uploaded folder's address is its contents, so no images/ in the link). Absolute, ipfs / https / http / ar, ending in a slash." />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="MODEL BASE URI" Classes="slbl" />
                      <TextBlock Grid.Column="1" Classes="caveat" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 Text="{Binding ModelBaseUriProblem}" ToolTip.Tip="{Binding ModelBaseUriProblem}" />
                    </Grid>
                    <TextBox x:Name="ModelBaseUriBox" Text="{Binding ModelBaseUri}" IsEnabled="{Binding ModelBaseUriEnabled}"
                             PlaceholderText="ipfs://CID/"
                             ToolTip.Tip="Where you uploaded the models/ folder. Each animation_url becomes this followed by the file name (ipfs://CID/1.glb). Only for a Set with glb models, with the metadata on." />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="EXTERNAL URL" Classes="slbl" />
                      <TextBlock Grid.Column="1" Classes="caveat" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 Text="{Binding ExternalUrlProblem}" ToolTip.Tip="{Binding ExternalUrlProblem}" />
                    </Grid>
                    <TextBox x:Name="ExternalUrlBox" Text="{Binding ExternalUrlBase}"
                             IsEnabled="{Binding ExternalUrlEnabled}"
                             PlaceholderText="https://example.com/token/"
                             ToolTip.Tip="Each item links out to this address followed by its token id." />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Text="FILE NAMES" Classes="slbl" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton GroupName="names" Content="Padded" IsChecked="{Binding !TokenIdNames}"
                                     ToolTip.Tip="The Set's own names: 0001.json, 0001.png." />
                        <RadioButton GroupName="names" Content="Token id" IsChecked="{Binding TokenIdNames}"
                                     ToolTip.Tip="What a contract's baseURI + tokenId resolves: metadata/1 (no extension), images/1.png, models/1.glb. The #n in each name follows." />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="FIRST ID" Classes="slbl" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton GroupName="firstid" Content="1" IsChecked="{Binding !StartAtZero}"
                                     ToolTip.Tip="The first asset is token 1." />
                        <RadioButton GroupName="firstid" Content="0" IsChecked="{Binding StartAtZero}"
                                     ToolTip.Tip="The first asset is token 0, as many contracts count." />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="9">
                  <!-- The two files the export writes beside the items, on one row: they are one kind of
                       thing, and the row they free is what lets the two base URIs fit the page. -->
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" Content="collection.json" IsChecked="{Binding IncludeCollectionMetadata}"
                              ToolTip.Tip="The contract-level metadata (OpenSea's contractURI): name, description, image, link, royalty." />
                    <CheckBox Grid.Column="1" Content="set.json" IsChecked="{Binding IncludeSetManifest}"
                              ToolTip.Tip="The Set's own record: the seed, the source book's hash, the rarity table. Leave it out of a public drop; nfty cannot reopen an export without it." />
                  </Grid>
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="EXTERNAL LINK" Classes="slbl" />
                      <TextBlock Grid.Column="1" Classes="caveat" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 Text="{Binding ExternalLinkProblem}" ToolTip.Tip="{Binding ExternalLinkProblem}" />
                    </Grid>
                    <TextBox x:Name="ExternalLinkBox" Text="{Binding ExternalLink}"
                             IsEnabled="{Binding CollectionFieldsEnabled}"
                             PlaceholderText="https://example.com/" />
                  </StackPanel>
                  <Grid ColumnDefinitions="84,*" ColumnSpacing="9" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ROYALTY %" Classes="slbl"
                               ToolTip.Tip="{Binding RoyaltyProblem}" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="FEE RECIPIENT" Classes="slbl" />
                      <TextBlock Grid.Column="1" Classes="caveat" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                 Text="{Binding FeeRecipientProblem}" ToolTip.Tip="{Binding FeeRecipientProblem}" />
                    </Grid>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="RoyaltyBox" Text="{Binding Royalty}"
                             IsEnabled="{Binding CollectionFieldsEnabled}" PlaceholderText="2.5"
                             ToolTip.Tip="Percentage, at most 2 decimals. Written as seller_fee_basis_points (2.5 becomes 250)." />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="FeeRecipientBox" Text="{Binding FeeRecipient}"
                             IsEnabled="{Binding CollectionFieldsEnabled}" PlaceholderText="0x…" />
                  </Grid>
                  <TextBlock Classes="caveat" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding RoyaltyProblem}"
                             ToolTip.Tip="{Binding RoyaltyProblem}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Classes="m-sub" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="Two steps: export the art only and upload it, then export again with its address here." />
                    <Button Grid.Column="1" x:Name="ArtOnlyButton" Classes="tbtn" Content="Art only"
                            Command="{Binding ArtOnlyCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Step one: export just the images (and models), no metadata. Upload them, then come back with the address." />
                  </Grid>
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- ============================== UPLOAD ==============================
                 The two-step drop done in one: the art pinned, the metadata written with its
                 address and pinned, the export written here with the same addresses. Where it goes
                 is a Settings choice, named on the first row with its live connection, so the reader
                 never uploads blind. Before a run the page explains; after, the same space holds the
                 addresses a contract needs, each copyable. -->
            <StackPanel Spacing="10" IsVisible="{Binding IsUploadTab}">
              <!-- Before a run: where it goes, whether it can, and what will happen. After, the
                   addresses take the whole page - the done line below already names the provider,
                   and the card has no height to spare for both. -->
              <StackPanel Spacing="10" IsVisible="{Binding !HasUploadResult}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="seglbl" Text="UPLOAD TO" />
                <Border Grid.Column="1" x:Name="UploadChip" Classes="idchip" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Classes="vdot"
                             Classes.ok="{Binding IsUploadConnected}" Classes.idle="{Binding IsUploadChecking}" />
                    <TextBlock Classes="cvl" Text="{Binding UploadStatusSummary}" />
                  </StackPanel>
                </Border>
                <TextBlock Grid.Column="2" Classes="m-sub" Margin="0" VerticalAlignment="Center" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Text="{Binding UploadProviderLabel}"
                           ToolTip.Tip="Change where uploads go in Settings, under Publishing." />
                <Button Grid.Column="3" Classes="tbtn" Content="Recheck" Command="{Binding RecheckUploadCommand}"
                        IsEnabled="{Binding ShowForm}" />
              </Grid>
              <!-- Two lines reserved: the longest "not reachable" sentence wraps once. -->
              <TextBlock Classes="m-sub" Margin="0" MinHeight="32" Text="{Binding UploadStatusDetail}" />

              <StackPanel Spacing="8">
                <TextBlock Classes="m-sub" Margin="0"
                           Text="One step instead of two: uploads images/ (and models/), writes the metadata with their ipfs:// addresses, uploads metadata/ with collection.json beside it, then exports to the folder you choose with the same addresses." />
                <TextBlock Classes="m-sub" Margin="0"
                           Text="Uses this export's choices on CONTENTS and MARKETPLACE. The provider and its key are in Settings, under Publishing." />
              </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6" IsVisible="{Binding HasUploadResult}">
                <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="seglbl" Text="BASE URI" />
                    <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="uri" Text="{Binding UploadBaseUri}"
                                         ToolTip.Tip="{Binding UploadBaseUri}" />
                    <Button Grid.Row="0" Grid.Column="2" Classes="tbtn cellbtn" Content="Copy"
                            Command="{Binding CopyCommand}" CommandParameter="{Binding UploadBaseUri}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="seglbl" Text="CONTRACT URI" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="uri" Text="{Binding UploadContractUri}"
                                         ToolTip.Tip="{Binding UploadContractUri}" />
                    <Button Grid.Row="1" Grid.Column="2" Classes="tbtn cellbtn" Content="Copy"
                            Command="{Binding CopyCommand}" CommandParameter="{Binding UploadContractUri}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="seglbl" Text="IMAGES" />
                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="uri" Text="{Binding UploadImagesUri}"
                                         ToolTip.Tip="{Binding UploadImagesUri}" />
                    <Button Grid.Row="2" Grid.Column="2" Classes="tbtn cellbtn" Content="Copy"
                            Command="{Binding CopyCommand}" CommandParameter="{Binding UploadImagesUri}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Classes="seglbl" Text="MODELS" />
                    <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="uri" Text="{Binding UploadModelsUri}"
                                         ToolTip.Tip="{Binding UploadModelsUri}" />
                    <Button Grid.Row="3" Grid.Column="2" Classes="tbtn cellbtn" Content="Copy"
                            Command="{Binding CopyCommand}" CommandParameter="{Binding UploadModelsUri}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="seglbl" Text="METADATA" />
                    <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="uri" Text="{Binding UploadMetadataUri}"
                                         ToolTip.Tip="{Binding UploadMetadataUri}" />
                    <Button Grid.Row="4" Grid.Column="2" Classes="tbtn cellbtn" Content="Copy"
                            Command="{Binding CopyCommand}" CommandParameter="{Binding UploadMetadataUri}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding UploadWarnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="caveat" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <!-- ============================== SEAL ============================== -->
            <StackPanel Spacing="11" IsVisible="{Binding IsSealTab}" IsEnabled="{Binding ShowForm}">
              <Border Classes="sealbox" Classes.on="{Binding IsSealed}">
                <StackPanel Spacing="10">
                  <!-- Disabled, not hidden, where the platform has no AES-GCM: a control that
                       vanishes teaches nothing, and the footer says why it is off. -->
                  <CheckBox Content="Seal this export" IsChecked="{Binding IsSealed}"
                            IsEnabled="{Binding CanSeal}"
                            ToolTip.Tip="Encrypt it under a passphrase and mark it view-only." />

                  <!-- IsVisible rather than reserved space, under the REVEAL exception: nothing
                       appears under the pointer that just acted (the checkbox stays exactly where it
                       was, and this opens below it), and the alternative is a permanent 130px hole
                       in every export that will never be sealed. Same argument the Recipe layer
                       table's ABSENT column won on. -->
                  <StackPanel Spacing="9" IsVisible="{Binding IsSealed}">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="9" RowDefinitions="Auto,Auto"
                          RowSpacing="4">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="PASSPHRASE" Classes="plabel" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="CONFIRM" Classes="plabel" />
                      <TextBox Grid.Row="1" Grid.Column="0" x:Name="PassphraseBox"
                               PasswordChar="•" Text="{Binding Passphrase}" />
                      <TextBox Grid.Row="1" Grid.Column="1" PasswordChar="•"
                               Text="{Binding PassphraseConfirm}" />
                    </Grid>
                    <StackPanel Spacing="4">
                      <TextBlock Text="NOTE TO THE RECIPIENT" Classes="plabel" />
                      <TextBox Text="{Binding Note}"
                               PlaceholderText="Draft for review — please don't redistribute" />
                    </StackPanel>
                    <!-- What sealing does and does not do is stated ONCE, in the pinned manifest
                         below, where it cannot scroll away. Repeating it here read as thorough and
                         cost about fifty pixels - which is what pushed the passphrase box, the one
                         control you have to be able to see to type into, below the fold. -->
                    <TextBlock Classes="caveat"
                               Text="Send the passphrase by a different route than the file." />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- A REAL BAR. It used to be indeterminate whatever the run was doing, which is the
                 right answer only while nothing can report - and every step of an export can now. A
                 stamped, stitched export of a large collection is minutes of work, and a barber pole
                 for minutes is indistinguishable from a hang. -->
            <StackPanel Spacing="9" IsVisible="{Binding IsRunning}">
              <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" />
              <TextBlock Text="{Binding PhaseText}" Classes="m-sub" />
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding IsDone}">
              <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Classes="m-sub" />
              <Button Classes="pathstrip" Command="{Binding RevealCommand}"
                      ToolTip.Tip="{Binding OutputPath}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconOpen}"
                        VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="leaf" Text="{Binding OutputPath}"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- OUTSIDE the ScrollViewer and outside the tabs, on purpose. This is the one control on the
           screen that has to be read before Export is pressed, and it describes the whole request
           rather than whichever page is showing - so a sheet armed on the IMAGES page is listed
           here while the reader is back on CONTENTS. Found on a rendered frame; every ViewModel
           test passed. -->
      <Border Grid.Row="2" Classes="ship" Margin="24,0,24,12">
              <!-- The point of this screen. Every line is generated by the same SetExporter.Plan
                   call that then does the writing, so the screen cannot promise one thing and ship
                   another - which is precisely the defect this feature exists to prevent. -->
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="fn" Text="{Binding OutputName}" />
                    <TextBlock Grid.Column="1" Classes="part" VerticalAlignment="Center"
                               Text="{Binding SizeText}" />
                  </Grid>
                  <!-- THE PARTS ARE A RUN, NOT A COLUMN. One short item per line spent five lines
                       and ~80px of a pinned block on five phrases of three words each, and the
                       block's height then CHANGED with the content - 113px on CONTENTS, 145 once a
                       spritesheet joined the list - so the body's fold moved when you switched tabs.
                       A wrap reads as one sentence about one file, costs two lines whatever is in
                       it, and leaves the height to the reserve below rather than to the plan. -->
                  <ItemsControl ItemsSource="{Binding Parts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="part" Text="{Binding}" Margin="0,0,18,0" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- ONE LINE PER CONSEQUENCE, the whole sentence on its tooltip. Wrapped, two link
                       warnings (the marketplace preset with no address yet: relative links, a
                       collection.json with no image) took three lines, outgrew the reserved 96 and pushed
                       the card past the 526 a modal is given - every tab then scrolled its page at the
                       smallest window. One line each keeps the common states inside the reserve. -->
                  <ItemsControl ItemsSource="{Binding Consequences}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="caveat" Text="{Binding}" Margin="0,2,0,0" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
      </Border>

      <Border Grid.Row="3" Classes="modal-foot">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <!-- The reason Export is unavailable, in words. A control that is dim for a reason the
               screen does not give is a control the user has to guess at. -->
          <TextBlock Grid.Column="0" Classes="keyhint" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Text="{Binding Problem}" IsVisible="{Binding IsExportAction}" />
          <!-- On UPLOAD the footer speaks for the button it carries: why Upload is unavailable. -->
          <TextBlock Grid.Column="0" Classes="keyhint" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Text="{Binding UploadProblem}" IsVisible="{Binding IsUploadTab}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="tbtn"
                    IsVisible="{Binding IsRunning}" />
            <Button Content="Close" Command="{Binding CloseCommand}" Classes="tbtn"
                    IsVisible="{Binding !IsRunning}" />
            <!-- ONE primary action, named for what it does from this page: Export everywhere, Upload on
                 UPLOAD. Both state one MinWidth, so swapping them moves neither Close nor Cancel. -->
            <Button x:Name="ExportButton" Command="{Binding ExportCommand}" Classes="accent" MinWidth="96">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="ShowForm" />
                  <Binding Path="IsExportAction" />
                </MultiBinding>
              </Button.IsVisible>
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="ico sm" Data="{StaticResource IconUpload}" /><TextBlock Text="Export" /></StackPanel>
            </Button>
            <Button x:Name="UploadButton" Command="{Binding UploadCommand}" Classes="accent" MinWidth="96">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="ShowForm" />
                  <Binding Path="IsUploadTab" />
                </MultiBinding>
              </Button.IsVisible>
              <StackPanel Orientation="Horizontal" Spacing="6"><Path Classes="ico sm" Data="{StaticResource IconUpload}" /><TextBlock Text="Upload" /></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
