<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:views="using:Nfty.App.Views"
             xmlns:ctl="using:Nfty.App.Controls"
             x:Class="Nfty.App.Views.ShellChromeView"
             x:DataType="vm:ShellViewModel">
  <!--
    The application shell: the window frame and titlebar (the shared WindowFrame), this shell's
    titlebar content, the page + dialog layers, and the status bar. This lives in Nfty.App rather than
    in the desktop head so that it is ordinary, head-agnostic UI - which means the visual-capture
    harness renders THIS control, the same one the app runs. It previously lived in
    Nfty.Desktop/MainWindow.axaml, where the tests could not reach it, and was mirrored by a
    hand-written C# replica in VisualCapture; the screenshots therefore showed the replica rather
    than the shell, and nothing detected the two drifting apart.

    The frame itself - border, shadow gutter, titlebar, caption buttons, resize grip - is
    Controls/WindowFrame, which the pop-out viewer hosts too, so the two windows cannot drift. This
    file supplies only what is the SHELL's: the slots below.

    The head keeps only what needs a Window: Nfty.Desktop's ChromeWiring attaches drag-to-move and
    resize to the frame's events, and minimise/maximise/close go through ShellViewModel's commands.
  -->
  <ctl:WindowFrame x:Name="ChromeFrame" Scale="{Binding ChromeScale}"
                   MinimizeCommand="{Binding MinimizeCommand}"
                   ToggleMaximizeCommand="{Binding ToggleMaximizeCommand}"
                   ToggleFullScreenCommand="{Binding ToggleFullScreenCommand}"
                   IsFullScreen="{Binding IsFullScreen}"
                   CloseCommand="{Binding CloseCommand}">

    <ctl:WindowFrame.TitleLeft>
      <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="9">
        <!-- Back, on EVERY page above Landing: the shell owns it, so no page can ship without one.
             Present on Landing too, dimmed (reserve space, toggle ink), so the brand never shifts. -->
        <Button Classes="zoomctl" Command="{Binding GoBackCommand}" ToolTip.Tip="Back  ·  one page up">
          <Path Classes="ico sm" Data="{StaticResource IconArrowLeft}" />
        </Button>
        <!-- The brand is also the way out of an open document, the way a logo is "home" almost
             everywhere. Deliberately reusing an element the locked titlebar already has rather
             than inventing a Close button: there is no such control in explorer.html, and
             adding chrome to a locked design to fix a wiring gap is the wrong trade. The
             Button carries no paint of its own (Classes="bare"), so the titlebar renders
             identically; it is disabled on Landing, where there is nothing to close. -->
        <Button Classes="bare" Command="{Binding CloseDocumentCommand}"
                ToolTip.Tip="Home: close everything and return to the start screen  ·  Ctrl+W">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <!-- The mark is the application icon's own symbol: a stack of layers, the top
                 one live. One control, shared with the quick-reference sheet and the viewer's
                 titlebar, so the tiles cannot drift; see BrandMarkView.axaml. -->
            <views:BrandMarkView />
            <TextBlock Classes="wordmark" VerticalAlignment="Center"><Run Text="nft" /><Run Text="y" Foreground="{DynamicResource AccentTextBrush}" /></TextBlock>
          </StackPanel>
        </Button>
        <!-- Kitchen chip: the OPEN workspace, named. Hides entirely when no Kitchen is open, which
             is a normal state - a CookBook opened from anywhere on disk needs no workspace. Per
             explorer.html this is "fixed for every item below it; changes only when you close this
             Kitchen and open another", which is why it binds to the shell rather than to the
             selection. -->
        <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding HasKitchen}">
          <Border Width="1" Height="18" Background="{DynamicResource LineStrongBrush}" />
          <Border Classes="kroot" ToolTip.Tip="Open workspace — the Kitchen">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ico" Data="{StaticResource IconKitchen}" />
              <TextBlock Classes="kroot-txt" Text="{Binding KitchenName}" />
            </StackPanel>
          </Border>
          <Border Width="1" Height="18" Background="{DynamicResource LineStrongBrush}" />
        </StackPanel>
      </StackPanel>
    </ctl:WindowFrame.TitleLeft>

    <!-- Per-item breadcrumb (explorer.html .crumbs) - bound through ShellViewModel.CurrentExplorer
         since the titlebar is shared chrome outside any one page's own view-model. -->
    <ctl:WindowFrame.TitleCenter>
      <ItemsControl ItemsSource="{Binding CurrentExplorer.Crumbs}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:Crumb">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBlock Text="›" Classes="cseg" Opacity="0.45" IsVisible="{Binding Leading}" />
              <!-- A segment navigates, as it does in explorer.html where each is role="link"
                   with a tabindex and handles click and Enter/Space. Paint-free Button so the type
                   still renders exactly as the .cseg run it replaced. -->
              <Button Classes="bare"
                      Command="{Binding $parent[ItemsControl].DataContext.CurrentExplorer.SelectNodeCommand}"
                      CommandParameter="{Binding Target}"
                      IsEnabled="{Binding Target, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Text}" Classes="cseg" Classes.active="{Binding Active}" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ctl:WindowFrame.TitleCenter>

    <!-- The badge IS the switch. There used to be a lock button in the toolbar one row below as
         well - two controls for one piece of state, with the badge reporting what the button did.
         Carmine outline and ink when unlocked, so the live mode is visible from across the room.
         The right margin is not decoration: the next column opens with the window-button divider
         and carries no left inset, so a badge with no margin sits flush against that hairline and
         the two read as one control with a stripe down it. 12 matches the brand's own inset on the
         far left. -->
    <ctl:WindowFrame.TitleRight>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <!-- Other windows (pop-out viewers, galleries): a badge carrying its own count. A fixed-width
           slot, always laid out and only INKED when a window is open, so the titlebar never reflows.
           Left click (or Ctrl+`) puts every window away when one is up, else brings them all back as
           they were last arranged; right click (or Ctrl+Shift+W) lists every window to raise, put away
           or close one alone. In full screen nothing on the
           desktop can reach a window behind the shell, so this is the way back to one. -->
      <Button x:Name="ChildWindowsButton" Classes="winchip" Classes.has="{Binding HasChildWindows}"
              IsHitTestVisible="{Binding HasChildWindows}" Focusable="False"
              Command="{Binding ToggleChildWindowsCommand}"
              ToolTip.Tip="{Binding ChildWindowsTip}">
        <Button.ContextFlyout>
          <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
            <StackPanel Spacing="4" MinWidth="240" MaxWidth="360">
              <TextBlock Classes="plabel" Margin="10,4,10,2" Text="OTHER WINDOWS" />
              <ItemsControl ItemsSource="{Binding ChildWindowItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <!-- The row raises its window; the two trailing buttons put just that one away
                         or close it. Both always laid out, so every row is one width. -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                      <Button Classes="winrow" Classes.min="{Binding IsMinimized}" Command="{Binding ActivateCommand}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              ToolTip.Tip="Show this window">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                          <Path Classes="ico sm" Data="{StaticResource IconPopout}" />
                          <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="sbar" Text="{Binding Hint}" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                      <Button Grid.Column="1" Classes="winact" Command="{Binding HideCommand}"
                              IsEnabled="{Binding CanHide}" ToolTip.Tip="Minimize this window">
                        <Path Classes="ico sm" Data="{StaticResource IconMinimise}" />
                      </Button>
                      <Button Grid.Column="2" Classes="winact" Command="{Binding CloseCommand}"
                              IsEnabled="{Binding CanClose}" ToolTip.Tip="Close this window">
                        <Path Classes="ico sm" Data="{StaticResource IconClose}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Flyout>
        </Button.ContextFlyout>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Path Classes="ico sm" Data="{StaticResource IconPopout}" />
          <Border Classes="wincount">
            <TextBlock Text="{Binding ChildWindowCountText}" />
          </Border>
        </StackPanel>
      </Button>
      <Button Classes="lockflag" VerticalAlignment="Center" Margin="0,0,12,0"
              Classes.editing="{Binding CurrentExplorer.IsEditing}"
              Command="{Binding CurrentExplorer.ToggleLockCommand}"
              ToolTip.Tip="{Binding CurrentExplorer.LockTip}"
              IsVisible="{Binding CurrentExplorer, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="ico xs" Data="{StaticResource IconLock}" IsVisible="{Binding !CurrentExplorer.IsEditing}" />
          <Path Classes="ico xs" Data="{StaticResource IconUnlock}" IsVisible="{Binding CurrentExplorer.IsEditing}" />
          <TextBlock Classes="lockflag-txt" Text="{Binding CurrentExplorer.LockStateText}" />
        </StackPanel>
      </Button>
     </StackPanel>
    </ctl:WindowFrame.TitleRight>

    <!-- Page + dialog overlay: flush under the titlebar, no second bordered/shadowed frame here
         (that inner "card inside a card" look was the audit's double-chrome finding). -->
    <ctl:WindowFrame.Body>
      <Panel>
        <Border Background="{DynamicResource BgBrush}">
          <!-- Zoom used to be tracked and shown in the status bar without being applied to
               anything, so the percentage changed and the app did not.
               LayoutTransformControl, not RenderTransform: a render transform scales the finished
               pixels, which magnifies a layout still measured at 100% - text stays on the same
               line and just gets blurry, and the chrome does not reflow. A layout transform
               re-measures the content at the new scale, which is what VS Code does and what makes
               zooming out actually fit more on screen. The status bar and titlebar stay outside it
               deliberately: window chrome is not content, and scaling it would move the resize
               grip and window buttons away from the window edge. -->
          <!-- Zoomed in, the page would get less room than the smallest window gives it at 100% and
               its fixed layouts (paged tables, snapped rails, wrapped strips) would clip. So the page
               is laid out at no less than ShellViewModel.MinPageArea and THIS scroller reaches the
               rest. At 100% and below the page is sized to the viewport exactly and both bars are
               disabled, so nothing changes there. Sizes are set from the scroller's own bounds and the
               zoom, never from the content (a handler writing layout must only read inputs it cannot
               change). -->
          <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <LayoutTransformControl>
              <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
              </LayoutTransformControl.LayoutTransform>
              <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" />
            </LayoutTransformControl>
          </ScrollViewer>
        </Border>
        <Panel Name="DialogScrim"
               IsVisible="{Binding ActiveDialog, Converter={x:Static ObjectConverters.IsNotNull}}"
               Background="{DynamicResource ScrimBrush}">
          <ContentControl Content="{Binding ActiveDialog}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
        <!-- The pop-out viewer on a head with no second window: above the dialog layer, so a
             dialog it raises (a save error) is not hidden behind it. Empty on a desktop, and a
             ContentControl with no content and no background is not hit-testable. -->
        <ContentControl Name="OverlaySlot" Content="{Binding Overlay}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Panel>
    </ctl:WindowFrame.Body>

    <!-- Status bar. The frame overlays the resize grip on its bottom-right corner. -->
    <ctl:WindowFrame.Footer>
      <Border Background="{DynamicResource BgAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
        <!-- 28 + the 1px top border above = 29 drawn. Deliberately shorter than the titlebar:
             that bar carries the brand, the document name and the window buttons, and a status
             strip of equal weight makes the frame read as two footers. -->
        <Grid Name="StatusBar" ColumnDefinitions="*,Auto" Height="28" ClipToBounds="True">
          <!-- Ink only: this overlay never participates in layout or intercepts the footer. -->
          <Border Name="StatusAttentionWash" Grid.ColumnSpan="2" Opacity="0"
                  Background="{DynamicResource AccentBrush}" IsHitTestVisible="False" />
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" Margin="16,0" VerticalAlignment="Center">
            <!-- A BUTTON, because it is a count and a count owes the reader the thing it counted.
                 It opens on a valid book too: a green light nobody can interrogate is a green
                 light nobody should trust. -->
            <Button Classes="vchip" Command="{Binding CurrentExplorer.ShowValidityCommand}"
                    IsVisible="{Binding CurrentExplorer, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="{Binding CurrentExplorer.ValidityButtonTip}">
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                         Classes.ok="{Binding CurrentExplorer.IsValid}" Classes="vdot" />
                <TextBlock Classes="sbar vstate" Classes.ok="{Binding CurrentExplorer.IsValid}"
                           Text="{Binding CurrentExplorer.ValidityText}" />
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        IsVisible="{Binding CurrentExplorer, Converter={x:Static ObjectConverters.IsNotNull}}">
              <!-- explorer.html's .statusbar .state.editing switches to the accent color, so the
                   unlocked state reads as a live mode rather than another muted count. -->
              <Path Classes="ico sm" Data="{StaticResource IconLock}" IsVisible="{Binding !CurrentExplorer.IsEditing}" />
              <Path Classes="ico sm editing" Data="{StaticResource IconUnlock}" IsVisible="{Binding CurrentExplorer.IsEditing}" />
              <TextBlock Classes="sbar" Classes.editing="{Binding CurrentExplorer.IsEditing}"
                         Text="{Binding CurrentExplorer.LockStateText}" />
            </StackPanel>
            <TextBlock Classes="sbar" Text="{Binding CurrentExplorer.RecipeCountText}"
                       IsVisible="{Binding CurrentExplorer, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="sbar" Text="{Binding CurrentExplorer.IngredientCountText}"
                       IsVisible="{Binding CurrentExplorer, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="sbar" Text="{Binding CurrentExplorer.VariantCountText}"
                       IsVisible="{Binding CurrentExplorer, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- Action guidance and errors; lock state is already shown by the two badges. -->
            <TextBlock Classes="sbar" Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <!-- Right margin 24, not 8: the resize grip is a 22px square pinned to this corner, and
               at 8 the help button sat under it - the grip won the hover and the button looked
               like it was falling off the window. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,24,0" VerticalAlignment="Center" Spacing="2">
            <Button Command="{Binding ZoomOutCommand}" Classes="zoomctl" ToolTip.Tip="Zoom out"><Path Classes="ico sm" Data="{StaticResource IconZoomOut}" /></Button>
            <TextBlock Classes="sbar" VerticalAlignment="Center" Width="46" TextAlignment="Center"
                       Text="{Binding Zoom, StringFormat='{}{0}%'}" />
            <Button Command="{Binding ZoomInCommand}" Classes="zoomctl" ToolTip.Tip="Zoom in"><Path Classes="ico sm" Data="{StaticResource IconZoomIn}" /></Button>
            <Button Command="{Binding ShowSettingsCommand}" Classes="helpbtn settings-trigger" Classes.on="{Binding IsSettingsOpen}" ToolTip.Tip="Settings"><Panel Classes="footer-icon"><Path Classes="ico sm" Data="{StaticResource IconSettings}" /></Panel></Button>
            <Button Command="{Binding ShowHelpCommand}" Classes="helpbtn info-trigger" Classes.on="{Binding IsHelpOpen}" ToolTip.Tip="Help"><Panel Classes="footer-icon"><Path Classes="ico sm" Data="{StaticResource IconHelp}" /></Panel></Button>
          </StackPanel>
        </Grid>
      </Border>
    </ctl:WindowFrame.Footer>
  </ctl:WindowFrame>
</UserControl>
