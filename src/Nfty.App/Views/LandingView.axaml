<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:m="using:Nfty.App.Models"
             x:Class="Nfty.App.Views.LandingView"
             x:DataType="vm:LandingViewModel"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCookBookCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCookBookCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}" />
  </UserControl.KeyBindings>
  <!-- landing.html .land: two equal columns, 34px gutter, 34/38 padding. -->
  <Grid Classes="monoform" ColumnDefinitions="*,34,*" Margin="38,34">
    <!-- .actions is left-aligned at 272px. Stretching it inside the column centres the button
         stack, which is what made the whole screen read as a centred splash. -->
    <StackPanel Grid.Column="0" Spacing="7" MaxWidth="272" HorizontalAlignment="Left">
      <TextBlock Classes="lwordmark"><Run Text="nft" /><Run Text="y" Foreground="{DynamicResource AccentTextBrush}" /></TextBlock>
      <TextBlock Text="Asset Generator" Classes="tagline" />

      <TextBlock Text="CREATE" Classes="slbl" Margin="0,12,0,4" />
      <Button Classes="landing accent" Command="{Binding NewCookBookCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New CookBook" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk on-accent" Text="⌘N" />
        </Grid>
      </Button>
      <!-- DELIBERATE DEVIATION from landing.html, which renders this `.tbtn.soon` — dashed edge,
           muted ink, transparent fill — and says so in its own prose: "Kitchen is dashed — reserved,
           next task." That mockup was authored before the Kitchen existed. It has since shipped
           (docs/superpowers/specs/2026-08-04-kitchen-design.md), NewKitchenCommand.CanExecute is
           true, and the command creates a real workspace.
           Keeping the `.soon` treatment would mean the app telling the user a working feature is
           unavailable — which is what happened: it rendered grey beside black siblings, so nobody
           clicked it. This is the third time that exact defect has landed here; the `.set` button
           below carries a comment warning against it. Rendered as the ordinary secondary action it
           now is, matching its Recipe/Ingredient siblings. -->
      <Button Classes="landing tbtn" Command="{Binding NewKitchenCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New Kitchen…" /></StackPanel></Grid>
      </Button>

      <!-- .subrow: the two smaller creatables sit side by side under the primary tier. -->
      <Grid ColumnDefinitions="*,7,*">
        <Button Grid.Column="0" Classes="landing sub tbtn" Command="{Binding NewRecipeCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="Recipe" /></StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="landing sub tbtn" Command="{Binding NewIngredientCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="Ingredient" /></StackPanel>
        </Button>
      </Grid>

      <TextBlock Text="OPEN" Classes="slbl" Margin="0,20,0,4" />
      <Button Classes="landing tbtn" Command="{Binding OpenCookBookCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconOpen}" /><TextBlock Classes="lbl" Text="Open CookBook…" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk" Text="⌘O" />
        </Grid>
      </Button>
      <Button Classes="landing tbtn" Command="{Binding ImportCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconImport}" /><TextBlock Classes="lbl" Text="Import…" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk" Text="⌘I" />
        </Grid>
      </Button>
      <Panel>
        <Rectangle Classes="dashed btn" />
        <!-- NOT .soon. landing.html marks this "The Set browser is not built yet" — but it since has
             been: SetBrowserView ships, OpenSet picks a .set, reads it and navigates. The mockup is
             describing a state of implementation the app has overtaken, and rendering a working
             feature as permanently unavailable is a worse error than diverging from the reference. -->
        <Button Classes="landing tbtn" Command="{Binding OpenSetCommand}">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconOpen}" /><TextBlock Classes="lbl" Text="Open a cooked .set…" /></StackPanel></Grid>
        </Button>
      </Panel>
      <!-- Beyond landing.html, which has no Open-Kitchen row because it predates the Kitchen. Without
           one, IKitchenSession.Open was called only by the CREATE flow, so a workspace was reachable
           for exactly the session that made it and never again. -->
      <Button Classes="landing tbtn" Command="{Binding OpenKitchenCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconKitchen}" /><TextBlock Classes="lbl" Text="Open Kitchen…" /></StackPanel></Grid>
      </Button>

      <!-- Which workspace loose saves will default into. The titlebar chip reports this too, but only
           once a CookBook is open — on Landing there was no way to tell, and no way back out. -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0" IsVisible="{Binding HasKitchen}">
        <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconKitchen}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="ftimes" Margin="9,0,0,0" VerticalAlignment="Center"
                   Text="{Binding KitchenName, StringFormat='Kitchen: {0}'}" />
        <Button Grid.Column="2" Classes="bare" Command="{Binding CloseKitchenCommand}"
                ToolTip.Tip="Leave this Kitchen">
          <TextBlock Classes="ftimes" Text="close" />
        </Button>
      </Grid>

      <Button Classes="learn" Command="{Binding ShowHelpCommand}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock><Run Text="New to nfty? " /><Run Text="The cooking metaphor" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
          <Path Classes="ico sm" Data="{StaticResource IconArrowRight}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Spacing="2">
      <TextBlock Text="RECENT" Classes="slbl" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding Recents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:RecentItem">
            <Button Classes="rrow"
                    Command="{Binding $parent[ItemsControl].((vm:LandingViewModel)DataContext).OpenRecentCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding Path}">
              <Grid ColumnDefinitions="22,*,Auto" >
                <Border Grid.Column="0" Classes="rico" Classes.loose="{Binding Loose}">
                  <Panel>
                    <Path Classes="ico sm" Stroke="{DynamicResource FgMutedBrush}"
                          Data="{StaticResource IconTypeIngredient}" IsVisible="{Binding Loose}" />
                    <Path Classes="ico sm" Stroke="{DynamicResource AccentTextBrush}"
                          Data="{StaticResource IconTypeCookBook}" IsVisible="{Binding !Loose}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Classes="rname" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Meta}" Classes="rmeta" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Path}" Classes="rpath" TextTrimming="CharacterEllipsis" MaxWidth="150" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- .rzero: first run has no recents, and an unexplained blank half-screen reads as broken. -->
      <Panel IsVisible="{Binding HasNoRecents}" Margin="0,4,0,0">
        <Rectangle Classes="dashed" />
        <StackPanel Margin="20,28" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Nothing here yet" Classes="zh" />
          <TextBlock Classes="zp"><Run Text="Cookbooks you open will collect here. Start with " /><Run Text="New CookBook" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /><Run Text="." /></TextBlock>
        </StackPanel>
      </Panel>
    </StackPanel>
  </Grid>
</UserControl>
