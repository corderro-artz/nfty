<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:m="using:Nfty.App.Models"
             x:Class="Nfty.App.Views.LandingView"
             x:DataType="vm:LandingViewModel"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCookBookCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCookBookCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}" />
  </UserControl.KeyBindings>
  <Grid ColumnDefinitions="*,*" Margin="38,34">
    <StackPanel Grid.Column="0" Spacing="7" MaxWidth="300">
      <TextBlock Text="nfty" FontSize="30" FontWeight="Bold" />
      <TextBlock Text="Asset Generator" Classes="tagline" />

      <TextBlock Text="CREATE" Classes="slbl" Margin="0,12,0,4" />
      <Button Classes="landing accent" Command="{Binding NewCookBookCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New CookBook" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk on-accent" Text="⌘N" />
        </Grid>
      </Button>
      <Button Classes="landing tbtn soon" Command="{Binding NewKitchenCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New Kitchen…" /></StackPanel></Grid>
      </Button>
      <Button Classes="landing tbtn" Command="{Binding NewRecipeCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New Recipe" /></StackPanel></Grid>
      </Button>
      <Button Classes="landing tbtn" Command="{Binding NewIngredientCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New Ingredient" /></StackPanel></Grid>
      </Button>

      <TextBlock Text="OPEN" Classes="slbl" Margin="0,12,0,4" />
      <Button Classes="landing tbtn" Command="{Binding OpenCookBookCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconOpen}" /><TextBlock Classes="lbl" Text="Open CookBook…" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk" Text="⌘O" />
        </Grid>
      </Button>
      <Button Classes="landing tbtn" Command="{Binding ImportCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconImport}" /><TextBlock Classes="lbl" Text="Import…" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk" Text="⌘I" />
        </Grid>
      </Button>
      <Button Classes="landing tbtn soon" Command="{Binding OpenSetCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconOpen}" /><TextBlock Classes="lbl" Text="Open a cooked .set…" /></StackPanel></Grid>
      </Button>
      <Button Classes="landing tbtn" Command="{Binding ShowHelpCommand}">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Grid.Column="0" Classes="lbl" Text="New to nfty? The cooking metaphor  →" /></Grid>
      </Button>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="2">
      <TextBlock Text="RECENT" Classes="slbl" />
      <ItemsControl ItemsSource="{Binding Recents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:RecentItem">
            <Button Classes="tbtn" HorizontalAlignment="Stretch"
                    Command="{Binding $parent[ItemsControl].((vm:LandingViewModel)DataContext).OpenRecentCommand}"
                    CommandParameter="{Binding}">
              <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Meta}" Classes="muted" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</UserControl>
