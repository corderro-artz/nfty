<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:svc="using:Nfty.App.Services"
             xmlns:m="using:Nfty.App.Models"
             x:Class="Nfty.App.Views.LandingView"
             x:DataType="vm:LandingViewModel"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCookBookCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCookBookCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}" />
  </UserControl.KeyBindings>
  <!-- The screen is the two landing.html columns PLUS a fixed workspace band beneath them. The band
       is a row of its own so the columns keep landing.html's own geometry exactly. -->
  <Grid Classes="monoform" RowDefinitions="*,Auto">

  <!-- landing.html .land: two equal columns, 34px gutter, 34/38 padding. -->
  <Grid Grid.Row="0" ColumnDefinitions="*,34,*" Margin="38,34">
    <!-- .actions is left-aligned at 272px. Stretching it inside the column centers the button
         stack, which is what made the whole screen read as a centered splash. -->
    <StackPanel Grid.Column="0" Spacing="7" MaxWidth="272" HorizontalAlignment="Left">
      <TextBlock Classes="lwordmark"><Run Text="nft" /><Run Text="y" Foreground="{DynamicResource AccentTextBrush}" /></TextBlock>
      <TextBlock Text="Asset Generator" Classes="tagline" />

      <TextBlock Text="CREATE" Classes="slbl" Margin="0,12,0,4" />
      <Button Classes="landing accent" Command="{Binding NewCookBookCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New CookBook" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk on-accent" Text="{x:Static svc:KeyHints.NewCookBook}" />
        </Grid>
      </Button>
      <!-- DELIBERATE DEVIATION from landing.html, which renders this `.tbtn.soon` — dashed edge,
           muted ink, transparent fill — and says so in its own prose: "Kitchen is dashed — reserved,
           next task." That mockup was authored before the Kitchen existed. It has since shipped
           (docs/superpowers/specs/2026-08-04-kitchen-design.md), NewKitchenCommand.CanExecute is
           true, and the command creates a real workspace.
           Keeping the `.soon` treatment would mean the app telling the user a working feature is
           unavailable — which is what happened: it rendered gray beside black siblings, so nobody
           clicked it. This is the third time that exact defect has landed here; the `.set` button
           below carries a comment warning against it. Rendered as the ordinary secondary action it
           now is, matching its Recipe/Ingredient siblings. -->
      <Button Classes="landing tbtn" Command="{Binding NewKitchenCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="New Kitchen…" /></StackPanel></Grid>
      </Button>

      <!-- .subrow: the two smaller creatables sit side by side under the primary tier. -->
      <Grid ColumnDefinitions="*,7,*">
        <Button Grid.Column="0" Classes="landing sub tbtn" Command="{Binding NewRecipeCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="Recipe" /></StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="landing sub tbtn" Command="{Binding NewIngredientCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconPlus}" /><TextBlock Classes="lbl" Text="Ingredient" /></StackPanel>
        </Button>
      </Grid>

      <TextBlock Text="OPEN" Classes="slbl" Margin="0,20,0,4" />
      <Button Classes="landing tbtn" Command="{Binding OpenCookBookCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconOpen}" /><TextBlock Classes="lbl" Text="Open CookBook…" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk" Text="{x:Static svc:KeyHints.Open}" />
        </Grid>
      </Button>
      <Button Classes="landing tbtn" Command="{Binding ImportCommand}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconImport}" /><TextBlock Classes="lbl" Text="Import…" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk" Text="{x:Static svc:KeyHints.Import}" />
        </Grid>
      </Button>
      <Panel>
        <Rectangle Classes="dashed btn" />
        <!-- NOT .soon. landing.html marks this "The Set browser is not built yet" — but it since has
             been: SetBrowserView ships, OpenSet picks a .set, reads it and navigates. The mockup is
             describing a state of implementation the app has overtaken, and rendering a working
             feature as permanently unavailable is a worse error than diverging from the reference. -->
        <Button Classes="landing tbtn" Command="{Binding OpenSetCommand}">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconOpen}" /><TextBlock Classes="lbl" Text="Open a cooked .set…" /></StackPanel></Grid>
        </Button>
      </Panel>
      <!-- The built-in sample. It is in OPEN rather than CREATE because that is what it does — the
           archive is embedded in the program and this unpacks a real .cbk beside the app and opens
           it, so nothing about the screen after this click is a special case. Nothing else on this
           screen works on a fresh install without a file dialog first, which made "nfty" and "an
           empty window" the same thing for anyone who had not built a collection yet. -->
      <Button Classes="landing tbtn" Command="{Binding OpenDemoCommand}"
              ToolTip.Tip="Unpacks a sample CookBook of layered chests beside the app and opens it. Edit it freely — reopening keeps your changes.">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconTypeCookBook}" /><TextBlock Classes="lbl" Text="Open the demo CookBook" /></StackPanel>
          <TextBlock Grid.Column="1" Classes="hk" Text="DEMO" />
        </Grid>
      </Button>

      <!-- Beyond landing.html, which has no Open-Kitchen row because it predates the Kitchen. Without
           one, IKitchenSession.Open was called only by the CREATE flow, so a workspace was reachable
           for exactly the session that made it and never again. -->
      <Button Classes="landing tbtn" Command="{Binding OpenKitchenCommand}">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"><Path Classes="ico sm" Data="{StaticResource IconKitchen}" /><TextBlock Classes="lbl" Text="Open Kitchen…" /></StackPanel></Grid>
      </Button>

      <!-- Which workspace loose saves will default into. The titlebar chip reports this too, but only
           once a CookBook is open — on Landing there was no way to tell, and no way back out. -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0" IsVisible="{Binding HasKitchen}">
        <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconKitchen}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="ftimes" Margin="9,0,0,0" VerticalAlignment="Center"
                   Text="{Binding KitchenName, StringFormat='Kitchen: {0}'}" />
        <Button Grid.Column="2" Classes="bare" Command="{Binding CloseKitchenCommand}"
                ToolTip.Tip="Leave this Kitchen">
          <TextBlock Classes="ftimes" Text="close" />
        </Button>
      </Grid>

      <Button Classes="learn" Command="{Binding ShowHelpCommand}">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <TextBlock><Run Text="New to nfty? " /><Run Text="The cooking metaphor" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /></TextBlock>
          <Path Classes="ico sm" Data="{StaticResource IconArrowRight}" />
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Spacing="2">
      <TextBlock Text="RECENT" Classes="slbl" Margin="0,0,0,8" />
      <ItemsControl ItemsSource="{Binding Recents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:RecentItem">
            <Button Classes="rrow"
                    Command="{Binding $parent[ItemsControl].((vm:LandingViewModel)DataContext).OpenRecentCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding Path}">
              <Grid ColumnDefinitions="22,*,Auto" >
                <Border Grid.Column="0" Classes="rico" Classes.loose="{Binding Loose}">
                  <Panel>
                    <!-- One glyph per kind, chosen by the file's own extension. This used to be a
                         boolean over four kinds, so a cooked .set drew the CookBook icon and a
                         loose .rcp drew the Ingredient one. -->
                    <Path Classes="ico sm" Stroke="{DynamicResource AccentTextBrush}"
                          Data="{StaticResource IconTypeCookBook}" IsVisible="{Binding IsCookBook}" />
                    <Path Classes="ico sm" Stroke="{DynamicResource FgMutedBrush}"
                          Data="{StaticResource IconTypeRecipe}" IsVisible="{Binding IsRecipe}" />
                    <Path Classes="ico sm" Stroke="{DynamicResource FgMutedBrush}"
                          Data="{StaticResource IconTypeIngredient}" IsVisible="{Binding IsIngredient}" />
                    <Path Classes="ico sm" Stroke="{DynamicResource AccentTextBrush}"
                          Data="{StaticResource IconTypeSet}" IsVisible="{Binding IsSet}" />
                    <Path Classes="ico sm" Stroke="{DynamicResource FgMutedBrush}"
                          Data="{StaticResource IconTypeVariant}" IsVisible="{Binding IsUnknownKind}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Classes="rname" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Meta}" Classes="rmeta" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Folder + file, not the whole path: see RecentItem.DisplayPath. 260 rather than
                     150 because the row has ~150px of empty gutter between the meta line and this
                     column, and the shorter string was still being cut at the file name. -->
                <TextBlock Grid.Column="2" Text="{Binding DisplayPath}" Classes="rpath"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- .rzero: first run has no recents, and an unexplained blank half-screen reads as broken. -->
      <Panel IsVisible="{Binding HasNoRecents}" Margin="0,4,0,0">
        <Rectangle Classes="dashed" />
        <StackPanel Margin="20,28" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="Nothing here yet" Classes="zh" />
          <!-- Names the demo, not New CookBook. On a first run the honest next step is the one that
               needs nothing from the user: the wizard asks for a name, a canvas and a save location
               before showing anything at all, which is a poor first look at a tool whose whole
               argument is visual. -->
          <TextBlock Classes="zp"><Run Text="Cookbooks you open will collect here. Start with " /><Run Text="Open the demo CookBook" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /><Run Text="." /></TextBlock>
        </StackPanel>
      </Panel>
    </StackPanel>
  </Grid>

  <!-- ==================== Kitchen shelf ====================
       Always present, always 104px — see Styles.axaml for why that is the whole argument. Wheel,
       chevrons and keyboard all page it; a pointer-only control would be the incomplete version of
       this, the same way pointer-only reorder was. -->
  <Border Grid.Row="1" Classes="kshelf" Name="KitchenShelf" Focusable="True">
    <Grid RowDefinitions="20,9,52">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
        <TextBlock Grid.Column="0" Text="KITCHEN" Classes="slbl" Margin="0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding KitchenShelf.WhereText}" Classes="rmeta"
                   Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3" Text="{Binding KitchenShelf.PageText}" Classes="rmeta"
                   VerticalAlignment="Center" MinWidth="86" TextAlignment="Right" />
        <Button Grid.Column="4" Classes="kchev" Command="{Binding KitchenShelf.PrevCommand}"
                IsEnabled="{Binding KitchenShelf.CanPrev}" ToolTip.Tip="Previous page">
          <Path Classes="ico xs" Data="{StaticResource IconChevronUp}" />
        </Button>
        <Button Grid.Column="5" Classes="kchev" Command="{Binding KitchenShelf.NextCommand}"
                IsEnabled="{Binding KitchenShelf.CanNext}" ToolTip.Tip="Next page">
          <Path Classes="ico xs" Data="{StaticResource IconChevronDown}" />
        </Button>
      </Grid>

      <!-- the row of cards -->
      <ItemsControl Grid.Row="2" Name="ShelfRow" ItemsSource="{Binding KitchenShelf.Row}"
                    IsVisible="{Binding KitchenShelf.HasCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KitchenCard">
            <Button Classes="kcard" Classes.slot="{Binding Converter={x:Static ObjectConverters.IsNull}}"
                    Margin="0,0,9,0" ToolTip.Tip="{Binding FileName}"
                    Command="{Binding $parent[ItemsControl].((vm:LandingViewModel)DataContext).KitchenShelf.OpenCardCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="26,9,*">
                <!-- One tile, three glyphs, one inked: the app already has a per-kind icon and
                     using a single one would throw that away. -->
                <Border Grid.Column="0" Classes="ktile" Classes.loose="{Binding IsLoose}">
                  <Panel>
                    <Path Classes="ico xs" Data="{StaticResource IconTypeCookBook}" IsVisible="{Binding IsCookBook}" />
                    <Path Classes="ico xs" Data="{StaticResource IconTypeRecipe}" IsVisible="{Binding IsRecipe}" />
                    <Path Classes="ico xs" Data="{StaticResource IconTypeIngredient}" IsVisible="{Binding IsIngredient}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding Name}" Classes="rname" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Meta}" Classes="rmeta" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- No Kitchen open. NO BUTTONS: Open Kitchen… and New Kitchen… are already in the Open and
           Create groups to the left, so this names them rather than repeating them. -->
      <Panel Grid.Row="2" IsVisible="{Binding KitchenShelf.ShowNoKitchen}">
        <Rectangle Classes="dashed btn" />
        <StackPanel Margin="12,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="No Kitchen open" Classes="zh" FontSize="12" HorizontalAlignment="Left" />
          <TextBlock Classes="zp" FontSize="10.5" TextAlignment="Left" Margin="0"><Run Text="A Kitchen is your shelf of loose parts — Ingredients and Recipes that belong to no one CookBook. Open one with " /><Run Text="Open Kitchen…" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /><Run Text=" and everything in its folder appears here." /></TextBlock>
        </StackPanel>
      </Panel>

      <!-- Open, but nothing in it yet. A fresh workspace is not a broken one. -->
      <Panel Grid.Row="2" IsVisible="{Binding KitchenShelf.ShowEmptyKitchen}">
        <Rectangle Classes="dashed btn" />
        <StackPanel Margin="12,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="This Kitchen is empty" Classes="zh" FontSize="12" HorizontalAlignment="Left" />
          <TextBlock Classes="zp" FontSize="10.5" TextAlignment="Left" Margin="0"><Run Text="Anything you save into this Kitchen appears here, ready to pull into any project — start with " /><Run Text="New CookBook" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" /><Run Text="." /></TextBlock>
        </StackPanel>
      </Panel>
    </Grid>
  </Border>
  </Grid>
</UserControl>
