<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:svc="using:Nfty.App.Services"
             xmlns:views="using:Nfty.App.Views"
             xmlns:ctl="using:Nfty.App.Controls"
             x:Name="Root"
             x:Class="Nfty.App.Views.HelpView"
             x:DataType="vm:HelpViewModel">
  <!--
    The quick-reference sheet (docs/design/archive/mockups/help.html, then four tabs and a search): a
    card summoned over whatever the user is doing.

    EVERYTHING ON THE PAGES COMES FROM vm:HelpCatalog. The pages draw the catalog by column and
    section; the search filters the same list. There is no second copy of a sentence in this file, so
    a result can never say something its page does not, nor a page carry something search cannot find.

    Things that diverge from the locked mockup, all approved:

      1. KITCHEN is below a dashed rule: the sixth word, but NOT a link in the CookBook > Recipe >
         Ingredient > Variant chain. The copy says what it holds ("pull them into any project").
      2. The chain is stated once, under the six-words label, so the five read as a sequence.
      3. KEYS are split by where they work, and the editor's, Rise's and the inspector's live on
         their own tabs instead of crowding the basics.
      4. The modifier follows the platform (svc:KeyHints). The mockup draws Command because it was
         authored on a Mac.
      5. TABS are a segmented tray (the app's own `seg` vocabulary), and the SEARCH replaces the pages
         in the same reserved cell, so nothing moves when you type.

    Where the mockup relies on CSS `text-transform` the catalog already holds the uppercased text.
    Every surface color comes from Styles.axaml/Tokens.axaml; nothing here carries a raw hex.
  -->
  <UserControl.DataTemplates>
    <!-- A term: optional 20px glyph gutter, the word (with its extension), a sentence. -->
    <DataTemplate DataType="vm:HelpTerm">
      <Grid Classes="sh-e" ColumnDefinitions="Auto,*" ColumnSpacing="0">
        <ctl:HelpGlyph Grid.Column="0" Classes="sh-g" Width="20" Margin="0,0,10,0"
                       Glyph="{Binding Glyph}" IsVisible="{Binding HasGlyph}" />
        <StackPanel Grid.Column="1">
          <TextBlock Classes="sh-t" Classes.plain="{Binding IsPlain}"><Run Text="{Binding Term}" /><Run Text="{Binding ExtText}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="9.5" FontWeight="Normal" Foreground="{DynamicResource AccentTextBrush}" /></TextBlock>
          <ctl:RichText Classes="sh-s" Markup="{Binding Description}" IsVisible="{Binding HasDescription}" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- A key: a cap as wide as its section's widest, then the action. -->
    <DataTemplate DataType="vm:HelpKey">
      <Grid Classes="sh-kline" ColumnDefinitions="Auto,*">
        <Panel Grid.Column="0" Width="{Binding KeyWidth}"><ctl:KeyChord Chord="{Binding Key}" Compact="True" HorizontalAlignment="Left" /></Panel>
        <TextBlock Grid.Column="1" Classes="sh-kdesc" Text="{Binding Term}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="vm:HelpSpec">
      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,0,7">
        <TextBlock Classes="sh-cs pre" Text="{Binding Term}" /><TextBlock Classes="sh-cs" Text="{Binding Description}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:HelpNote">
      <Panel>
        <ctl:RichText Classes="sh-chain" Margin="0,0,0,10" Markup="{Binding Description}" IsVisible="{Binding Chain}" />
        <ctl:RichText Classes="sh-fine" Markup="{Binding Description}" IsVisible="{Binding IsFine}" />
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="vm:HelpCommand">
      <StackPanel Margin="0,0,0,12">
        <TextBlock Classes="sh-cs" Text="{Binding Term}" Margin="0,0,0,2" />
        <TextBlock Classes="sh-fine" Text="{Binding Description}" Margin="0" />
      </StackPanel>
    </DataTemplate>

    <!-- A section: a label, or a dashed rule instead of one. -->
    <DataTemplate DataType="vm:HelpSection">
      <StackPanel>
        <!-- Avalonia's Border cannot dash, and a Height="1" Rectangle still strokes BOTH long edges
             so the gaps land in each other's dashes and the line renders solid. A 3px rectangle
             whose top edge is the only one inside a 1px clip draws it. -->
        <Border Classes="sh-split" Height="1" ClipToBounds="True" Margin="{Binding RuleMargin}" IsVisible="{Binding Dashed}">
          <Rectangle Height="3" VerticalAlignment="Top" Stroke="{DynamicResource LineStrongBrush}"
                     StrokeThickness="1" StrokeDashArray="3,3" />
        </Border>
        <TextBlock Classes="slbl sh" Text="{Binding Title}" Margin="{Binding TitleMargin}" IsVisible="{Binding HasTitle}" />
        <ItemsControl ItemsSource="{Binding Entries}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:HelpColumn">
      <ItemsControl ItemsSource="{Binding Sections}" />
    </DataTemplate>

    <!-- One tab's page: four columns, the hairline between the two PAIRS only. -->
    <DataTemplate DataType="vm:HelpPage">
      <Grid Classes="helppage" Classes.off="{Binding !IsActive}" ColumnDefinitions="1.08*,1.0*,1.0*,1.0*">
        <Border Grid.Column="0" Classes="sh-col"><ContentControl Content="{Binding Column0}" /></Border>
        <Border Grid.Column="1" Classes="sh-col"><ContentControl Content="{Binding Column1}" /></Border>
        <Border Grid.Column="2" Classes="sh-col div"><ContentControl Content="{Binding Column2}" /></Border>
        <Border Grid.Column="3" Classes="sh-col div"><ContentControl Content="{Binding Column3}" /></Border>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <!-- A card that fits and never scrolls at the smallest window (ModalFitTests owns the number); the
       scroller is only the safety net for a window smaller than the app allows. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Border x:Name="Sheet" Classes="sheet">
    <Grid RowDefinitions="Auto,Auto,Auto">

      <!-- ===== .sh-h: brand, tabs, search, Esc ===== -->
      <Border Grid.Row="0" Classes="sh-h">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Height="48">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
            <views:BrandMarkView />
            <TextBlock Classes="wordmark" VerticalAlignment="Center"><Run Text="nft" /><Run Text="y" Foreground="{DynamicResource AccentTextBrush}" /></TextBlock>
            <Border Width="1" Height="18" Background="{DynamicResource LineStrongBrush}" />
            <TextBlock Classes="slbl sh" Text="REFERENCE" Margin="0" ToolTip.Tip="Quick Reference" />
          </StackPanel>

          <!-- The tabs are the app's own segmented tray (`seg`, as the Set browser's rarity unit and
               the editor's Dynamic/Static): the chosen segment is FILLED, so which page you are on
               reads at a glance, where a 2px underline did not. Every segment states its width, so
               the bold of the chosen one cannot move its neighbours. -->
          <Border Grid.Column="1" Classes="seg tiny" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="TabTray">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="seg-b tiny hl" Classes.on="{Binding IsBasicsTab}" Width="86"
                      Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:HelpTab.Basics}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Path Classes="ico sm" Data="{StaticResource IconTypeCookBook}" Stroke="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="BASICS" />
                </StackPanel>
              </Button>
              <Button Classes="seg-b tiny hl" Classes.on="{Binding IsEditorTab}" Width="86"
                      Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:HelpTab.Editor}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Path Classes="ico sm" Data="{StaticResource IconPencil}" Stroke="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="EDITOR" />
                </StackPanel>
              </Button>
              <Button Classes="seg-b tiny hl" Classes.on="{Binding IsRiseTab}" Width="104"
                      Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:HelpTab.Rise}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Path Classes="ico sm" Data="{StaticResource IconRise}" Stroke="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="RISE &amp; 3D" />
                </StackPanel>
              </Button>
              <Button Classes="seg-b tiny hl" Classes.on="{Binding IsViewerTab}" Width="152"
                      Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:HelpTab.Viewer}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Path Classes="ico sm" Data="{StaticResource IconPopout}" Stroke="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="VIEWER &amp; RUNTIME" />
                </StackPanel>
              </Button>
              <Button Classes="seg-b tiny hl" Classes.on="{Binding IsCommunityTab}" Width="106"
                      Command="{Binding ShowTabCommand}" CommandParameter="{x:Static vm:HelpTab.Community}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <Path Classes="ico sm" Data="{StaticResource IconCommunity}" Stroke="{Binding $parent[Button].Foreground}" />
                  <TextBlock Text="COMMUNITY" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- The search lives in the header, always: it is a way INTO the sheet, not a page of it.
               The "/" hint and the clear button share one cell and swap by ink, so typing moves
               nothing. -->
          <Border Grid.Column="2" Classes="search help" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconSearch}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" x:Name="SearchBox" Classes="bare" Text="{Binding Query}"
                       Margin="8,0" VerticalAlignment="Center"
                       PlaceholderText="Search the sheet" ToolTip.Tip="Search this sheet" />
              <Panel Grid.Column="2" Width="22" VerticalAlignment="Center">
                <ctl:KeyChord Chord="/" Compact="True" HorizontalAlignment="Center"
                              IsVisible="{Binding ShowPages}" />
                <Button x:Name="ClearQuery" Classes="searchclear" Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding IsSearching}" ToolTip.Tip="Clear search — Esc">
                  <Path Classes="ico sm" Data="{StaticResource IconClose}" />
                </Button>
              </Panel>
            </Grid>
          </Border>

          <Button Grid.Column="3" Classes="esc" Content="ESC" Command="{Binding CloseCommand}"
                  ToolTip.Tip="Close — Esc" />
        </Grid>
      </Border>

      <!-- ===== the pages, or the search results in their place =====
           One cell. The pages stack in it and the inactive ones are inked out, never collapsed, so
           it is the tallest page's height whichever tab shows. The results layer is given EXACTLY
           that height (bound to the pages' own bounds, which it cannot change) and is inked in
           instead, so searching moves nothing. -->
      <Panel Grid.Row="1" x:Name="Pages">
        <ItemsControl x:Name="PagesHost" ItemsSource="{Binding Pages}" Classes="helppage" Classes.off="{Binding IsSearching}"
                      VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><Panel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Grid x:Name="ResultsLayer" Classes="helppage" Classes.off="{Binding ShowPages}"
              VerticalAlignment="Top" Height="{Binding #PagesHost.Bounds.Height}" RowDefinitions="Auto,*" Margin="20,12,20,0">
          <TextBlock Grid.Row="0" Classes="sh-fine" Margin="0,2,0,8" Text="{Binding ResultCountText}" />
          <ScrollViewer Grid.Row="1" x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        IsVisible="{Binding HasResults}">
            <ItemsControl x:Name="ResultsList" ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:HelpEntry">
                  <Button Classes="hrow" Command="{Binding #Root.((vm:HelpViewModel)DataContext).JumpCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="136,*,Auto" ColumnSpacing="14">
                      <ctl:KeyChord Grid.Column="0" Chord="{Binding Lead}" Compact="True" HorizontalAlignment="Left"
                                    IsVisible="{Binding LeadIsKey}" />
                      <TextBlock Grid.Column="0" Classes="sh-t rlead" Text="{Binding Lead}" IsVisible="{Binding !LeadIsKey}"
                                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      <TextBlock Grid.Column="1" Classes="sh-kdesc" Text="{Binding Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      <Border Grid.Column="2" Classes="idchip"><TextBlock Classes="ck" Text="{Binding Where}" /></Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- The empty state says WHICH emptiness, and carries the click that undoes it. -->
          <StackPanel Grid.Row="1" x:Name="EmptyState" IsVisible="{Binding NoMatch}" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Spacing="12">
            <TextBlock Classes="sh-t" Text="{Binding EmptyText}" HorizontalAlignment="Center" />
            <TextBlock Classes="sh-fine" Margin="0" HorizontalAlignment="Center" Text="Try a key, a tool, or a word like zoom, redo or Kitchen." />
            <Button x:Name="EmptyClear" Classes="tbtn" Content="Clear search" HorizontalAlignment="Center"
                    Command="{Binding ClearSearchCommand}" />
          </StackPanel>
        </Grid>
      </Panel>

      <!-- ===== .sh-f: the DNA sentence + its arithmetic chip ===== -->
      <Border Grid.Row="2" Classes="sh-f">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconDna}" Stroke="{DynamicResource AccentTextBrush}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Classes="sh-dna"><Run Text="Unique DNA" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold" /><Run Text=" — one Recipe, its rolled Variants, their colors. It's what makes an asset distinct, and what a collection is counted in." /></TextBlock>
          <Border Grid.Column="2" Classes="kbd sh-eq">
            <TextBlock><Run Text="4 × 3 × 5 × 6 " /><Run Text="=" Foreground="{DynamicResource AccentTextBrush}" /><Run Text=" 360" /></TextBlock>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
  </ScrollViewer>
</UserControl>
