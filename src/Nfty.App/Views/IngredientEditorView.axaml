<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.IngredientEditorView"
             x:DataType="vm:IngredientEditorViewModel">
  <!-- ingredient-editor.html .epanes: variants rail / canvas / colorize rail, full-bleed and divided
       by 1px rules, each opening with a 41px pane header. This screen was previously a functional
       skeleton - stacked default primitives in three fixed columns - rather than the designed one. -->
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="262,*,300">

      <!-- ============ Variants rail ============ -->
      <Border Grid.Column="0" Classes="pane">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="pane-hrow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="VARIANTS" Classes="pane-h" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="hcount" Text="{Binding Variants.Count}" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="7">
              <ItemsControl ItemsSource="{Binding Variants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EditorVariant">
                    <!-- .vcard: thumb + name + weight, horizontal, with a real selected state. -->
                    <Button Classes="vcard" Margin="0,0,0,7"
                            Classes.sel="{Binding IsSelected}"
                            Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).SelectVariantCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="38,*">
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{DynamicResource RadiusSm}"
                                Background="{DynamicResource TileBrush}" ClipToBounds="True">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Weight, StringFormat='weight {0}'}" Classes="rmeta" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- .vaddbtn: the dashed footer that adds a variant. -->
              <Panel>
                <Rectangle Classes="dashed btn" />
                <!-- .flat, not .soon: this button works. It only borrows the borderless look because
                     it sits inside the dashed Rectangle above, and "soon" elsewhere means the
                     feature does not exist yet. -->
                <Button Command="{Binding AddVariantCommand}" Classes="flat tbtn"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Classes="ico sm" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add Variant" />
                  </StackPanel>
                </Button>
              </Panel>

              <StackPanel Spacing="6" Margin="0,8,0,0"
                          IsEnabled="{Binding SelectedVariant, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="NAME" Classes="plabel" />
                <TextBox Text="{Binding SelectedName}" />
                <TextBlock Text="WEIGHT" Classes="plabel" Margin="0,6,0,0" />
                <NumericUpDown Value="{Binding SelectedWeight}" Minimum="0.01" Increment="1" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,0">
                <Button Content="Duplicate" Command="{Binding DuplicateVariantCommand}" Classes="tbtn" />
                <Button Content="Delete" Command="{Binding DeleteVariantCommand}" Classes="tbtn" />
              </StackPanel>
              <Button Command="{Binding ImportImageCommand}" Classes="tbtn" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="ico sm" Data="{StaticResource IconImport}" />
                  <TextBlock Text="Import image…" />
                </StackPanel>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ============ Canvas ============ -->
      <Border Grid.Column="1" Classes="pane">
        <Grid RowDefinitions="Auto,*">
          <!-- .toolstrip: horizontal 30px icon bar with an ACTIVE tool, a value ramp and a swatch. -->
          <Border Grid.Row="0" Classes="pane-hrow" Padding="12,0" IsEnabled="{Binding CanPaint}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="ttool" Classes.on="{Binding IsToolBrush}" ToolTip.Tip="Brush"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Brush}">
                <Path Classes="ico sm" Data="{StaticResource IconPencil}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolEraser}" ToolTip.Tip="Eraser (writes alpha)"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Eraser}">
                <Path Classes="ico sm" Data="{StaticResource IconEraser}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolFill}" ToolTip.Tip="Fill"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Fill}">
                <Path Classes="ico sm" Data="{StaticResource IconFill}" /></Button>

              <Border Classes="tsep" />

              <Button Classes="ttool" Classes.on="{Binding IsToolRectangle}" ToolTip.Tip="Rectangle"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Rectangle}">
                <Path Classes="ico sm" Data="{StaticResource IconRect}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolCircle}" ToolTip.Tip="Circle"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Circle}">
                <Path Classes="ico sm" Data="{StaticResource IconCircle}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolTriangle}" ToolTip.Tip="Triangle"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Triangle}">
                <Path Classes="ico sm" Data="{StaticResource IconTriangle}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolSelect}" ToolTip.Tip="Select region"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Select}">
                <Path Classes="ico sm" Data="{StaticResource IconSelect}" /></Button>

              <Border Classes="tsep" />

              <Button Classes="ttool" Command="{Binding UndoCommand}" ToolTip.Tip="Undo">
                <Path Classes="ico sm" Data="{StaticResource IconUndo}" /></Button>
              <Button Classes="ttool" Command="{Binding RedoCommand}" ToolTip.Tip="Redo">
                <Path Classes="ico sm" Data="{StaticResource IconRedo}" /></Button>

              <Border Classes="tsep" />

              <!-- .ramp: the value gradient the brush samples, and the grey it will lay down. -->
              <Panel Width="96" VerticalAlignment="Center">
                <Border Classes="ramp" Background="{StaticResource ValueRampBrush}" />
                <Slider Value="{Binding BrushValue}" Minimum="0" Maximum="255"
                        Classes="overlay" ToolTip.Tip="Paint value" />
              </Panel>
              <Border Classes="swatch">
                <Border.Background><SolidColorBrush Color="{Binding BrushSwatch}" /></Border.Background>
              </Border>

              <Border Classes="tsep" />
              <!-- No "SIZE" caption: the strip's full contents already exceed the canvas pane at the
                   window's default width, and a clipped stepper is worse than an implicit one. The
                   tooltip carries the meaning. -->
              <NumericUpDown Value="{Binding BrushSize}" Minimum="1" Width="96"
                             ToolTip.Tip="Brush size (px)" />
            </StackPanel>
          </Border>

          <!-- .canvas-wrap: checkerboard backdrop, 320px art tile, blip preview over the corner. -->
          <Panel Grid.Row="1">
            <Panel.Background>
              <!-- The mockup's 18px repeating-conic checkerboard. -->
              <DrawingBrush TileMode="Tile" SourceRect="0,0,36,36" DestinationRect="0,0,36,36">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource BgAltBrush}" Geometry="M0,0 H36 V36 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource BgAlt2Brush}" Geometry="M0,0 H18 V18 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource BgAlt2Brush}" Geometry="M18,18 H36 V36 H18 Z" />
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Panel.Background>

            <Border Name="CanvasHost" Width="320" Height="320" CornerRadius="10"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource WinShadow}" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Panel>
                <Image x:Name="CanvasImage" Source="{Binding Canvas}" Stretch="Uniform"
                       IsVisible="{Binding ShowPaintCanvas}" />
                <!-- "Fill pane with preview": the colorized result takes over the tile. -->
                <Image Source="{Binding Preview}" Stretch="Uniform" IsVisible="{Binding PreviewFillsPane}" />
              </Panel>
            </Border>

            <!-- .blip: the colorized preview sits ON the canvas' bottom-right corner rather than
                 stacked in the rail under the controls. -->
            <Border Width="104" Height="104" CornerRadius="10" ClipToBounds="True"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    Background="{DynamicResource TileBrush}" BoxShadow="{DynamicResource WinShadow}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26"
                    IsVisible="{Binding ShowPaintCanvas}">
              <Panel>
                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" Height="26" Background="{DynamicResource ScrimBrush}">
                  <!-- Three buttons, in the mockup's order: reroll, enlarge, fill-pane
                       (ingredient-editor.html's .ov). Enlarge was missing - the ViewModel had the
                       command and its design spec shipped, but nothing bound it, so half the
                       preview-sizing feature was unreachable. -->
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="7,0">
                    <TextBlock Grid.Column="0" Text="PREVIEW" Classes="plabel" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon" Padding="2" Command="{Binding RerollPreviewCommand}"
                            ToolTip.Tip="Reroll sampled colour">
                      <Path Classes="ico xs" Data="{StaticResource IconReroll}" /></Button>
                    <Button Grid.Column="2" Classes="icon" Padding="2" Command="{Binding EnlargePreviewCommand}"
                            ToolTip.Tip="Enlarge preview">
                      <Path Classes="ico xs" Data="{StaticResource IconEnlarge}" /></Button>
                    <Button Grid.Column="3" Classes="icon" Padding="2" Command="{Binding FillPanePreviewCommand}"
                            ToolTip.Tip="Fill pane with preview">
                      <Path Classes="ico xs" Data="{StaticResource IconFillPane}" /></Button>
                  </Grid>
                </Border>
              </Panel>
            </Border>
          </Panel>
        </Grid>
      </Border>

      <!-- ============ Colorize rail ============ -->
      <Border Grid.Column="2" Classes="pane last">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="pane-hrow">
            <TextBlock Text="COLORIZE" Classes="pane-h" VerticalAlignment="Center" />
          </Border>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14" Spacing="14">
              <!-- .seg: a segmented tray, not two loose radio buttons. -->
              <Border Classes="seg">
                <Grid ColumnDefinitions="*,3,*">
                  <Button Grid.Column="0" Classes="seg-b" Classes.on="{Binding IsModeDynamic}"
                          Content="Dynamic" Command="{Binding SetModeDynamicCommand}" />
                  <Button Grid.Column="2" Classes="seg-b" Classes.on="{Binding IsModeStatic}"
                          Content="Static" Command="{Binding SetModeStaticCommand}" />
                </Grid>
              </Border>

              <StackPanel Spacing="14" IsVisible="{Binding ShowColourRange}">
                <!-- .dual (hue): two ring handles over the hue rainbow, with a live readout. -->
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="HUE RANGE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding HueRangeText}" />
                  </Grid>
                  <Panel>
                    <Border Classes="dualtrack" Background="{StaticResource HueSpectrumBrush}" />
                    <Slider Classes="overlay" Value="{Binding HueMin}" Minimum="0" Maximum="360" />
                    <Slider Classes="overlay" Value="{Binding HueMax}" Minimum="0" Maximum="360" />
                  </Panel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBox Classes="nin" Text="{Binding HueMin}" />
                    <TextBlock Classes="ftimes" Text="—" VerticalAlignment="Center" />
                    <TextBox Classes="nin" Text="{Binding HueMax}" />
                  </StackPanel>
                </StackPanel>

                <!-- .dual (saturation): grey to full chroma -->
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="SATURATION RANGE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding SatRangeText}" />
                  </Grid>
                  <Panel>
                    <Border Classes="dualtrack" Background="{StaticResource SaturationRampBrush}" />
                    <Slider Classes="overlay" Value="{Binding SatMin}" Minimum="0" Maximum="100" />
                    <Slider Classes="overlay" Value="{Binding SatMax}" Minimum="0" Maximum="100" />
                  </Panel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBox Classes="nin" Text="{Binding SatMin}" />
                    <TextBlock Classes="ftimes" Text="—" VerticalAlignment="Center" />
                    <TextBox Classes="nin" Text="{Binding SatMax}" />
                  </StackPanel>
                </StackPanel>

                <!-- .qrow: compact steppers plus what the two bucket counts actually add up to. -->
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="QUANTIZE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding ApproxColorsText}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="Hue" Classes="cshare" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding HueQuantize}" Minimum="1" Width="112" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="Sat" Classes="cshare" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding SatQuantize}" Minimum="1" Width="112" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Static: a fixed colour, shown as a swatch rather than only as hex text. -->
              <StackPanel Spacing="7" IsVisible="{Binding ShowFixedColour}">
                <TextBlock Text="FIXED COLOUR" Classes="plabel" />
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusSm}"
                          BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                          Background="{DynamicResource TileBrush}" ClipToBounds="True">
                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                  </Border>
                  <TextBox Text="{Binding FixedColor}" PlaceholderText="hex:d6249f" Width="150" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <!-- .vlock: value is not editable here; it comes from the grayscale map. -->
              <Panel Margin="0,4,0,0">
                <Rectangle Classes="dashed btn" />
                <Grid ColumnDefinitions="Auto,*" Margin="10,9">
                  <Path Grid.Column="0" Classes="ico xs" Data="{StaticResource IconLock}"
                        VerticalAlignment="Top" Margin="0,1,8,0" />
                  <TextBlock Grid.Column="1" Classes="vlock"
                             Text="Value comes from the grayscale map — colour only sets hue and saturation." />
                </Grid>
              </Panel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer actions -->
    <Border Grid.Row="1" Classes="modal-foot">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="cshare" VerticalAlignment="Center"
                   Text="{Binding SaveBlockedReason}"
                   IsVisible="{Binding SaveBlockedReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Back" Command="{Binding BackCommand}" Classes="tbtn ghost" />
          <Button Command="{Binding SaveCommand}" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ico sm" Data="{StaticResource IconCheck}" />
              <TextBlock Text="Save" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
