<!-- RenderOptions.BitmapInterpolationMode=None on the root: pixel art scales with nearest
     neighbour, never a filter. It inherits to every Image below, and
     PixelPerfectRenderingTests fails naming any view that drops it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.IngredientEditorView"
             x:DataType="vm:IngredientEditorViewModel"
             RenderOptions.BitmapInterpolationMode="None">
  <!-- Escape drops the marquee. A selection you cannot dismiss without drawing another one is a
       mode you are stuck in, and Escape is the key everyone tries first. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding ClearSelectionCommand}" />
  </UserControl.KeyBindings>
  <!-- ingredient-editor.html .epanes: variants rail / canvas / colorize rail, full-bleed and divided
       by 1px rules, each opening with a 41px pane header. This screen was previously a functional
       skeleton - stacked default primitives in three fixed columns - rather than the designed one. -->
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="262,*,300">

      <!-- ============ Variants rail ============ -->
      <Border Grid.Column="0" Classes="pane">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="pane-hrow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="VARIANTS" Classes="pane-h" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="hcount" Text="{Binding Variants.Count}" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12" Spacing="7">
              <ItemsControl ItemsSource="{Binding Variants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EditorVariant">
                    <!-- .vcard: thumb + name + weight, horizontal, with a real selected state. -->
                    <Button Classes="vcard" Margin="0,0,0,7"
                            Classes.sel="{Binding IsSelected}"
                            Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).SelectVariantCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="38,*">
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="{DynamicResource RadiusSm}"
                                Background="{DynamicResource TileBrush}" ClipToBounds="True">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Weight, StringFormat='weight {0}'}" Classes="rmeta" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- .vaddbtn: the dashed footer that adds a variant. -->
              <Panel>
                <Rectangle Classes="dashed btn" />
                <!-- .flat, not .soon: this button works. It only borrows the borderless look because
                     it sits inside the dashed Rectangle above, and "soon" elsewhere means the
                     feature does not exist yet. -->
                <Button Command="{Binding AddVariantCommand}" Classes="flat tbtn"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Classes="ico sm" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add Variant" />
                  </StackPanel>
                </Button>
              </Panel>

              <StackPanel Spacing="6" Margin="0,8,0,0"
                          IsEnabled="{Binding SelectedVariant, Converter={x:Static ObjectConverters.IsNotNull}}">
                <!-- Margin="0" beats .plabel's 8px bottom: with the panel's own 6px spacing that
                     put NAME 14px above its box while WEIGHT, which overrides the margin, sat 6.
                     Both are 6 now, and the 6 on WEIGHT's top is the gap BETWEEN the two fields. -->
                <TextBlock Text="NAME" Classes="plabel" Margin="0" />
                <TextBox Text="{Binding SelectedName}" />
                <TextBlock Text="WEIGHT" Classes="plabel" Margin="0,6,0,0" />
                <NumericUpDown Value="{Binding SelectedWeight}" Minimum="0.01" Increment="1" />
              </StackPanel>

              <!-- One row, not a row of two over a full-width third. The old shape read as two
                   different kinds of control: Duplicate and Delete hugged their labels while Import
                   spanned the whole sidebar, so the odd one out was the one that does the least
                   destructive thing. Duplicate and Delete share the slack; Import takes only what
                   its label needs, which makes it the small one.

                   The label lost the word "image" and the glyph to fit three across 237px: with
                   both it needs 130 and the row has 82 to spare. The tooltip carries what it opens. -->
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="7" Margin="0,4,0,0">
                <Button Grid.Column="0" Content="Duplicate" Classes="tbtn" Padding="9,8"
                        HorizontalAlignment="Stretch" Command="{Binding DuplicateVariantCommand}" />
                <Button Grid.Column="1" Content="Delete" Classes="tbtn" Padding="9,8"
                        HorizontalAlignment="Stretch" Command="{Binding DeleteVariantCommand}" />
                <Button Grid.Column="2" Content="Import…" Classes="tbtn" Padding="9,8"
                        Command="{Binding ImportImageCommand}"
                        ToolTip.Tip="Replace this variant's image from a PNG on disk" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ============ Canvas ============ -->
      <Border Grid.Column="1" Classes="pane">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- .toolstrip: horizontal 30px icon bar with an ACTIVE tool, a value ramp and a swatch. -->
          <Border Grid.Row="0" Classes="pane-hrow" Padding="12,0">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="ttool" Classes.on="{Binding IsToolBrush}" ToolTip.Tip="Brush"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Brush}">
                <Path Classes="ico sm" Data="{StaticResource IconPencil}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolEraser}" ToolTip.Tip="Eraser (writes alpha)"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Eraser}">
                <Path Classes="ico sm" Data="{StaticResource IconEraser}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolFill}" ToolTip.Tip="Fill"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Fill}">
                <Path Classes="ico sm" Data="{StaticResource IconFill}" /></Button>

              <Border Classes="tsep" />

              <Button Classes="ttool" Classes.on="{Binding IsToolRectangle}" ToolTip.Tip="Rectangle"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Rectangle}">
                <Path Classes="ico sm" Data="{StaticResource IconRect}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolCircle}" ToolTip.Tip="Circle"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Circle}">
                <Path Classes="ico sm" Data="{StaticResource IconCircle}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolTriangle}" ToolTip.Tip="Triangle"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Triangle}">
                <Path Classes="ico sm" Data="{StaticResource IconTriangle}" /></Button>
              <!-- Line is not in the locked mockup, and is here on purpose: the shape group offered
                   rectangle, circle and triangle but no way to draw the single most basic mark in a
                   pixel editor, and the engine already draws one (a two-point brush stroke, joined
                   by the same Bresenham walk every freehand stroke uses). -->
              <Button Classes="ttool" Classes.on="{Binding IsToolLine}" ToolTip.Tip="Line"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Line}">
                <Path Classes="ico sm" Data="{StaticResource IconLine}" /></Button>
              <Button Classes="ttool" Classes.on="{Binding IsToolSelect}" ToolTip.Tip="Select region, then drag it to move"
                      Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Select}">
                <Path Classes="ico sm" Data="{StaticResource IconSelect}" /></Button>

              <Border Classes="tsep" />

              <Button Classes="ttool" Command="{Binding UndoCommand}" ToolTip.Tip="Undo">
                <Path Classes="ico sm" Data="{StaticResource IconUndo}" /></Button>
              <Button Classes="ttool" Command="{Binding RedoCommand}" ToolTip.Tip="Redo">
                <Path Classes="ico sm" Data="{StaticResource IconRedo}" /></Button>

              <Border Classes="tsep" />

              <!-- .ramp: the brightness axis. In grayscale mode it IS the color; in color mode it
                   is V of HSV, with H and S on the colorize rail's own tracks. One control, one
                   meaning ("how bright"), in both modes. -->
              <!-- 80, not the mockup's 96. The third deliberate chrome divergence on record (after
                   the 40px titlebar and the 7px toolbar padding): this strip carries a Line tool and
                   a brush-size field the mockup has neither of, and at the pane's minimum width
                   something had to give. A brightness slider is the one control here whose meaning
                   does not depend on its exact length. See ToolstripLayoutTests. -->
              <Panel Classes="band" Width="80" VerticalAlignment="Center">
                <Border Classes="ramp" Background="{StaticResource ValueRampBrush}" />
                <Slider Value="{Binding BrushValue}" Minimum="0" Maximum="255"
                        Classes="overlay" ToolTip.Tip="Paint value / brightness" />
              </Panel>
              <Border Classes="swatch" ToolTip.Tip="{Binding BrushSpec}">
                <Border.Background><SolidColorBrush Color="{Binding BrushSwatch}" /></Border.Background>
              </Border>

              <!-- Brush size. WIDTH IS A BUDGET, and this cell is what pays for the rest: the strip
                   has to fit the canvas pane at the app's minimum width (ToolstripLayoutTests), and
                   adding the Line tool cost 36px it did not have. So: no "SIZE" caption, no leading
                   separator, and no spinner column — Fluent's is two ~28px buttons for a number you
                   type once. What is left is the mockup's own numeric idiom (.nin, 58px), and the
                   tooltip carries the meaning the caption would have. -->
              <NumericUpDown Classes="nin" Value="{Binding BrushSize}" Minimum="1" Width="58"
                             ShowButtonSpinner="False" ToolTip.Tip="Brush size (px)" />
            </StackPanel>
          </Border>

          <!-- ============ Palette strip ============
               Ten ramp slots that change fill with the mode, the saved swatches, the alpha axis and
               the opacity lock. Always present: on a Dynamic or Static layer it simply offers the
               grays a value-map is authored in. See Styles.axaml's block for the no-reflow rules. -->
          <Border Grid.Row="1" Classes="pstrip">
            <!-- WIDTH IS A BUDGET. Everything but the saved run is fixed, and the saved run is the
                 star column: at the minimum window width the canvas pane is 594px, so the fixed
                 cells have to leave room or that column silently collapses to zero and the palette
                 is simply absent (which is exactly what shipped in the first cut of this strip).
                 Current fixed total: 128 + 207 + 18 + 94 + 30 + 42 gaps + 2 rules = 521. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">

              <!-- A Custom layer has no gray mode at all: its value-map never reaches an archive,
                   so those strokes would be invisible work. The cell is a FIXED 104px either way and
                   the ink inside it swaps — a tray with a choice, or a caption with none. It is not
                   a DISABLED tray: the app dims disabled controls to 0.38 opacity, which put "Gray"
                   at 1.41:1 (DarkModeContrastTests), and unreadable is worse than absent. -->
              <Panel Grid.Column="0" Width="128" VerticalAlignment="Center">
                <Border Classes="seg mini" IsVisible="{Binding CanPaintGrayscale}">
                  <Grid ColumnDefinitions="*,2,*">
                    <Button Grid.Column="0" Classes="seg-b mini" Content="Gray"
                            Classes.on="{Binding !IsColorMode}"
                            Command="{Binding SetPaintGrayscaleCommand}"
                            ToolTip.Tip="Paint the grayscale value-map" />
                    <Button Grid.Column="2" Classes="seg-b mini" Content="Color"
                            Classes.on="{Binding IsColorMode}"
                            Command="{Binding SetPaintColorCommand}"
                            ToolTip.Tip="Paint in full color — saves as a Custom ingredient" />
                  </Grid>
                </Border>
                <Border Classes="seg mini" IsVisible="{Binding !CanPaintGrayscale}"
                        ToolTip.Tip="Custom layers are authored in color — they composite as-is">
                  <TextBlock Text="COLOR" Classes="plabel" Margin="0,4"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Panel>

              <Border Grid.Column="1" Classes="tsep" />

              <ItemsControl Grid.Column="2" ItemsSource="{Binding Ramp}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteSwatch">
                    <Button Classes="sw" Classes.on="{Binding IsSelected}" ToolTip.Tip="{Binding Spec}"
                            Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).PickSwatchCommand}"
                            CommandParameter="{Binding}">
                      <Border Classes="swfill" CornerRadius="{DynamicResource RadiusXs}">
                        <Border.Background><SolidColorBrush Color="{Binding Color}" /></Border.Background>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Grid.Column="3" Classes="tsep" />

              <!-- The saved run scrolls inside its own cell: a palette that grew would otherwise
                   push the alpha axis and the lock off the strip. -->
              <ScrollViewer Grid.Column="4" HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"
                            HorizontalAlignment="Stretch" Height="20">
                <ItemsControl ItemsSource="{Binding SavedSwatches}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaletteSwatch">
                      <Button Classes="sw" Classes.on="{Binding IsSelected}" ToolTip.Tip="{Binding Spec}"
                              Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).PickSwatchCommand}"
                              CommandParameter="{Binding}">
                        <!-- The command comes from the CELL. A ContextMenu is not in the visual
                             tree, so $parent[ItemsControl] cannot resolve from inside one and the
                             whole item template renders empty — silently. -->
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Forget swatch" Command="{Binding ForgetCommand}"
                                      CommandParameter="{Binding}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Border Classes="swfill" CornerRadius="{DynamicResource RadiusXs}">
                          <Border.Background><SolidColorBrush Color="{Binding Color}" /></Border.Background>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <Button Grid.Column="5" Classes="sw add" Command="{Binding SaveSwatchCommand}"
                      ToolTip.Tip="Save this color to the palette">
                <Path Classes="ico xs" Data="{StaticResource IconPlus}" />
              </Button>

              <!-- Reserved whether or not the lock admits it — see Styles.axaml. -->
              <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" Width="94"
                          VerticalAlignment="Center" Classes="alphacell"
                          Classes.off="{Binding IsOpacityLocked}">
                <TextBlock Text="A" Classes="plabel" VerticalAlignment="Center" Margin="0" />
                <!-- Same canceling margin as Slider.overlay, and for the same reason: Fluent puts
                     the handle 5px below the control's middle, which left it sitting under the "A"
                     rather than beside it. This slider keeps a visible track, so it cannot simply
                     take that class. -->
                <Slider Value="{Binding BrushAlpha}" Minimum="0" Maximum="255" Width="72"
                        Margin="0,-5,0,5" VerticalAlignment="Center" ToolTip.Tip="Paint alpha" />
              </StackPanel>

              <Button Grid.Column="7" Classes="ttool" Classes.on="{Binding IsOpacityLocked}"
                      Command="{Binding ToggleOpacityLockCommand}"
                      ToolTip.Tip="Opacity lock — every painted pixel is fully opaque or fully erased">
                <Path Classes="ico sm" Data="{StaticResource IconLock}" />
              </Button>
            </Grid>
          </Border>

          <!-- .canvas-wrap: checkerboard backdrop, 320px art tile, blip preview over the corner. -->
          <Panel Grid.Row="2">
            <Panel.Background>
              <!-- The mockup's 18px repeating-conic checkerboard. -->
              <DrawingBrush TileMode="Tile" SourceRect="0,0,36,36" DestinationRect="0,0,36,36">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource BgAltBrush}" Geometry="M0,0 H36 V36 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource BgAlt2Brush}" Geometry="M0,0 H18 V18 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource BgAlt2Brush}" Geometry="M18,18 H36 V36 H18 Z" />
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Panel.Background>

            <Border Name="CanvasHost" Width="320" Height="320" CornerRadius="10"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource WinShadow}" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Panel>
                <Image x:Name="CanvasImage" Source="{Binding Canvas}" Stretch="Uniform"
                       IsVisible="{Binding ShowPaintCanvas}" />
                <!-- The rubber band and the selection marquee. Drawn in control coordinates over
                     the art rather than into it, so a shape being positioned never touches a pixel
                     until it is committed, and never hit-tests away the pointer that is drawing it. -->
                <Canvas x:Name="CanvasOverlay" IsHitTestVisible="False"
                        IsVisible="{Binding ShowPaintCanvas}" />
                <!-- "Fill pane with preview": the colorized result takes over the tile. -->
                <Image Source="{Binding Preview}" Stretch="Uniform" IsVisible="{Binding PreviewFillsPane}" />
              </Panel>
            </Border>

            <!-- .blip: the colorized preview sits ON the canvas' bottom-right corner rather than
                 stacked in the rail under the controls. -->
            <Border Width="104" Height="104" CornerRadius="10" ClipToBounds="True"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    Background="{DynamicResource TileBrush}" BoxShadow="{DynamicResource WinShadow}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26"
                    IsVisible="{Binding ShowPaintCanvas}">
              <Panel>
                <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" Height="26" Background="{DynamicResource ScrimBrush}">
                  <!-- Three buttons, in the mockup's order: reroll, enlarge, fill-pane
                       (ingredient-editor.html's .ov). Enlarge was missing - the ViewModel had the
                       command and its design spec shipped, but nothing bound it, so half the
                       preview-sizing feature was unreachable. -->
                  <!-- 7px side padding plus three 18px buttons leaves under 40px for the caption,
                       which clipped "PREVIEW" to "PREVIEV". The buttons are the working part; the
                       caption gives up the space and keeps its meaning in the tooltip. -->
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,0">
                    <TextBlock Grid.Column="0" Text="PREVIEW" Classes="plabel" VerticalAlignment="Center"
                               TextTrimming="None" ClipToBounds="False" FontSize="7.5"
                               ToolTip.Tip="The colorized result, as generation would render it" />
                    <Button Grid.Column="1" Classes="icon" Padding="2" Command="{Binding RerollPreviewCommand}"
                            ToolTip.Tip="Reroll sampled color">
                      <Path Classes="ico xs" Data="{StaticResource IconReroll}" /></Button>
                    <Button Grid.Column="2" Classes="icon" Padding="2" Command="{Binding EnlargePreviewCommand}"
                            ToolTip.Tip="Enlarge preview">
                      <Path Classes="ico xs" Data="{StaticResource IconEnlarge}" /></Button>
                    <Button Grid.Column="3" Classes="icon" Padding="2" Command="{Binding FillPanePreviewCommand}"
                            ToolTip.Tip="Fill pane with preview">
                      <Path Classes="ico xs" Data="{StaticResource IconFillPane}" /></Button>
                  </Grid>
                </Border>
              </Panel>
            </Border>
          </Panel>
        </Grid>
      </Border>

      <!-- ============ Colorize rail ============ -->
      <Border Grid.Column="2" Classes="pane last">
        <Grid RowDefinitions="Auto,*">
          <!-- Two tabs in the pane's own 41px header row, so splitting the rail costs no height.
               Underline rather than a segmented tray: a tray would land directly above the
               Dynamic/Static tray below it, and two stacked pills read as one control with four
               options. Each tab carries its 2px underline in BOTH states - transparent when off -
               so switching moves nothing. -->
          <Border Grid.Row="0" Classes="pane-hrow tabrow">
            <StackPanel Orientation="Horizontal" Spacing="18">
              <Button Classes="railtab" Classes.on="{Binding IsColorizeTab}"
                      Command="{Binding ShowColorizeTabCommand}" Content="COLORIZE" />
              <Button Classes="railtab" Classes.on="{Binding IsReferencesTab}"
                      Command="{Binding ShowReferencesTabCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="REFERENCES" VerticalAlignment="Center" />
                  <Border Classes="tabcount">
                    <TextBlock Text="{Binding ReferenceBadgeText}" />
                  </Border>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1" Name="ColorizeScroll" HorizontalScrollBarVisibility="Disabled">
            <!-- .rbody { padding: 13px 13px 16px; gap: 15px } — one gap for the whole rail. Any
                 extra Margin on a child here is a second, competing number; the two that existed
                 made those gaps 18 and 20 while every other one was 14. -->
            <StackPanel Margin="13,13,13,16" Spacing="15">
             <StackPanel Spacing="15" IsVisible="{Binding IsColorizeTab}">
              <!-- .seg: a segmented tray, not two loose radio buttons. Hidden on a Custom layer,
                   which composites as-is and rolls nothing — the choice would have no effect. -->
              <Border Classes="seg" IsVisible="{Binding ShowColorizeMode}">
                <Grid ColumnDefinitions="*,3,*">
                  <Button Grid.Column="0" Classes="seg-b" Classes.on="{Binding IsModeDynamic}"
                          Content="Dynamic" Command="{Binding SetModeDynamicCommand}" />
                  <Button Grid.Column="2" Classes="seg-b" Classes.on="{Binding IsModeStatic}"
                          Content="Static" Command="{Binding SetModeStaticCommand}" />
                </Grid>
              </Border>

              <!-- ==================== Paint color ====================
                   Color mode's H and S axes, on the rail's own hue and saturation tracks. Those
                   tracks are the Dynamic layer's RANGE controls; a Custom layer has no range to set,
                   so rather than adding a third pair of sliders the same two components take the
                   rail's free space and set ONE color. The third axis, V, is the toolstrip's value
                   ramp — unchanged in meaning from grayscale mode. -->
              <StackPanel Spacing="14" IsVisible="{Binding IsColorMode}">
                <StackPanel Spacing="7">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="PAINT HUE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding BrushHueText}" />
                  </Grid>
                  <Panel Classes="band">
                    <Border Classes="dualtrack" Background="{StaticResource HueSpectrumBrush}" />
                    <Slider Classes="overlay" Value="{Binding BrushHue}" Minimum="0" Maximum="360" />
                  </Panel>
                </StackPanel>

                <StackPanel Spacing="7">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="PAINT SATURATION" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding BrushSatText}" />
                  </Grid>
                  <Panel Classes="band">
                    <Border Classes="dualtrack" Background="{StaticResource SaturationRampBrush}" />
                    <Slider Classes="overlay" Value="{Binding BrushSat}" Minimum="0" Maximum="100" />
                  </Panel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Border Classes="swatch" Width="34" Height="34"
                          CornerRadius="{DynamicResource RadiusMd}">
                    <Border.Background><SolidColorBrush Color="{Binding BrushSwatch}" /></Border.Background>
                  </Border>
                  <TextBlock Text="{Binding BrushSpec}" Classes="cv" VerticalAlignment="Center" />
                </StackPanel>

                <Panel>
                  <Rectangle Classes="dashed btn" />
                  <Grid ColumnDefinitions="Auto,*" Margin="10,9">
                    <Path Grid.Column="0" Classes="ico xs" Data="{StaticResource IconLock}"
                          VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Grid.Column="1" Classes="vlock"
                               Text="Color art composites as-is and is never recolored at generation time." />
                  </Grid>
                </Panel>
              </StackPanel>

              <StackPanel Spacing="14" IsVisible="{Binding ShowColorRange}">
                <!-- .dual (hue): two ring handles over the hue rainbow, with a live readout. -->
                <StackPanel Spacing="7">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="HUE RANGE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding HueRangeText}" />
                  </Grid>
                  <Panel Classes="band">
                    <Border Classes="dualtrack" Background="{StaticResource HueSpectrumBrush}" />
                    <Slider Classes="overlay" Value="{Binding HueMin}" Minimum="0" Maximum="360" />
                    <Slider Classes="overlay" Value="{Binding HueMax}" Minimum="0" Maximum="360" />
                  </Panel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBox Classes="nin" Text="{Binding HueMin}" />
                    <TextBlock Classes="ftimes" Text="—" VerticalAlignment="Center" />
                    <TextBox Classes="nin" Text="{Binding HueMax}" />
                  </StackPanel>
                </StackPanel>

                <!-- .dual (saturation): gray to full chroma -->
                <StackPanel Spacing="7">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="SATURATION RANGE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding SatRangeText}" />
                  </Grid>
                  <Panel Classes="band">
                    <Border Classes="dualtrack" Background="{StaticResource SaturationRampBrush}" />
                    <Slider Classes="overlay" Value="{Binding SatMin}" Minimum="0" Maximum="100" />
                    <Slider Classes="overlay" Value="{Binding SatMax}" Minimum="0" Maximum="100" />
                  </Panel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBox Classes="nin" Text="{Binding SatMin}" />
                    <TextBlock Classes="ftimes" Text="—" VerticalAlignment="Center" />
                    <TextBox Classes="nin" Text="{Binding SatMax}" />
                  </StackPanel>
                </StackPanel>

                <!-- .qrow: compact steppers plus what the two bucket counts actually add up to. -->
                <StackPanel Spacing="7">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="QUANTIZE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding ApproxColorsText}" />
                  </Grid>
                  <!-- WIDTH IS A BUDGET here too: the rail is a fixed 300 and its body 13px in on
                       each side, so this row has 274. At 112 apiece the second stepper's chevron ran
                       off the edge. ColorizeRailLayoutTests holds the budget. -->
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="Hue" Classes="cshare" VerticalAlignment="Center" />
                      <NumericUpDown Classes="qnt" Value="{Binding HueQuantize}" Minimum="1" Width="94" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="Sat" Classes="cshare" VerticalAlignment="Center" />
                      <NumericUpDown Classes="qnt" Value="{Binding SatQuantize}" Minimum="1" Width="94" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- Static: a fixed color, shown as a swatch rather than only as hex text. -->
              <StackPanel Spacing="7" IsVisible="{Binding ShowFixedColor}">
                <TextBlock Text="FIXED COLOR" Classes="plabel" />
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusSm}"
                          BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                          Background="{DynamicResource TileBrush}" ClipToBounds="True">
                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                  </Border>
                  <TextBox Text="{Binding FixedColor}" PlaceholderText="hex:d6249f" Width="150" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <!-- .vlock: value is not editable here; it comes from the grayscale map. -->
              <Panel IsVisible="{Binding ShowColorizeMode}">
                <Rectangle Classes="dashed btn" />
                <Grid ColumnDefinitions="Auto,*" Margin="10,9">
                  <Path Grid.Column="0" Classes="ico xs" Data="{StaticResource IconLock}"
                        VerticalAlignment="Top" Margin="0,1,8,0" />
                  <TextBlock Grid.Column="1" Classes="vlock"
                             Text="Value comes from the grayscale map — color only sets hue and saturation." />
                </Grid>
              </Panel>

             </StackPanel>

             <!-- ==================== Reference layers ====================
                  Variant B of docs/design/mockups/explorations/reference-panel-variants.html: two
                  labeled sections over a depth gutter. The layer being authored is PINNED at its own
                  depth and cannot be switched off; siblings below it composite under, siblings above
                  composite over, and a loose .igt from the Kitchen is placed into a GAP for this
                  session alone — nothing here is ever written back to an archive.

                  Every cell that can appear is already in the layout while absent (see Styles.axaml's
                  block for this panel): a row is the same height on and off.

                  The rule above this used to divide the two halves inside one scroll; the tab bar
                  does that now, so it is gone rather than restated. -->
             <StackPanel Spacing="15" IsVisible="{Binding IsReferencesTab}">
              <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="REFERENCE LAYERS" Classes="plabel" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="hcount" Text="{Binding ReferenceCountText}" />
              </Grid>

              <StackPanel Spacing="14" IsVisible="{Binding ReferencesAvailable}">
                <!-- Ghost / Full. NOT optional polish: at full opacity a reference above the edited
                     layer can hide the art being painted outright (the exploration draws sunglasses
                     completely covering the eyes being drawn), so above composites dimmed by default
                     and the true composite is one click away. Below is never dimmed — it is what the
                     art sits ON. Reuses the rail's own .seg tray, so this needed no new glyph. -->
                <Border Classes="seg">
                  <Grid ColumnDefinitions="*,3,*">
                    <Button Grid.Column="0" Classes="seg-b" Classes.on="{Binding GhostAbove}"
                            Content="Ghost above" Command="{Binding ShowGhostedCommand}"
                            ToolTip.Tip="Dim the layers above this one so the art stays visible" />
                    <Button Grid.Column="2" Classes="seg-b" Classes.on="{Binding ShowsTrueComposite}"
                            Content="True color" Command="{Binding ShowTrueColorCommand}"
                            ToolTip.Tip="Show the real composite, at full opacity" />
                  </Grid>
                </Border>

                <!-- In this recipe: real siblings, at their real depths. -->
                <StackPanel Spacing="8">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="IN THIS RECIPE" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hcount" Text="{Binding Siblings.Count}" />
                  </Grid>

                  <!-- The pinned row: the subject of the preview, not a reference in it. -->
                  <Border Classes="pinrow">
                    <Grid ColumnDefinitions="15,13,*,Auto,14" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Classes="dpt" Text="{Binding PinnedDepthText}" />
                      <TextBlock Grid.Column="1" Classes="kmark"
                                 Classes.kdyn="{Binding IsPinnedDynamic}"
                                 Classes.kstat="{Binding IsPinnedStatic}"
                                 Classes.kcust="{Binding IsPinnedCustom}"
                                 Text="{Binding PinnedKindMark}" />
                      <TextBlock Grid.Column="2" Classes="vname" Text="{Binding PinnedName}" />
                      <TextBlock Grid.Column="3" Classes="editmark" Text="EDITING" />
                      <Path Grid.Column="4" Classes="ico xs" Data="{StaticResource IconLock}"
                            ToolTip.Tip="Pinned at its own depth — it cannot be removed from the stack" />
                    </Grid>
                  </Border>

                  <!-- Empty is a real state, not an error: a loose .igt belongs to no recipe. -->
                  <Panel IsVisible="{Binding !HasSiblings}">
                    <Rectangle Classes="dashed btn" />
                    <TextBlock Classes="vlock" Margin="10,9" Text="{Binding NoSiblingsText}" />
                  </Panel>

                  <ItemsControl ItemsSource="{Binding Siblings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReferenceLayer">
                        <Border Classes="refrow" Margin="0,0,0,7"
                                Classes.sel="{Binding IsOn}" Classes.off="{Binding !IsOn}"
                                ToolTip.Tip="{Binding Tip}">
                          <Button Classes="bare" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).ToggleReferenceCommand}"
                                  CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="15,15,13,*,46" ColumnSpacing="8">
                              <Border Grid.Column="0" Classes="cbx" Classes.on="{Binding IsOn}">
                                <Path Classes="ico xs" Data="{StaticResource IconCheck}" />
                              </Border>
                              <TextBlock Grid.Column="1" Classes="dpt" Text="{Binding DepthText}" />
                              <TextBlock Grid.Column="2" Classes="kmark"
                                         Classes.kdyn="{Binding IsDynamic}"
                                         Classes.kstat="{Binding IsStatic}"
                                         Classes.kcust="{Binding IsCustom}"
                                         Text="{Binding KindMark}" />
                              <TextBlock Grid.Column="3" Classes="vname" Text="{Binding Name}" />
                              <!-- Fixed-width cell holding BOTH the tag and the at-rest count, each
                                   toggled by Opacity. Neither may size the cell, or the row would
                                   change width the moment a layer is switched on. -->
                              <Panel Grid.Column="4" Width="46">
                                <TextBlock Classes="tlabel" Text="{Binding DetailText}"
                                           HorizontalAlignment="Right"
                                           Opacity="{Binding DetailOpacity}" />
                                <Border Classes="tagx" Classes.over="{Binding IsAbove}"
                                        Opacity="{Binding TagOpacity}">
                                  <TextBlock Text="{Binding TagText}" />
                                </Border>
                              </Panel>
                            </Grid>
                          </Button>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- From the Kitchen: loose .igt files, scratch only. -->
                <StackPanel Spacing="8">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="FROM THE KITCHEN" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hcount" Text="{Binding KitchenLayers.Count}" />
                  </Grid>

                  <Border Classes="kroot" HorizontalAlignment="Left" IsVisible="{Binding HasKitchen}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="ico xs" Data="{StaticResource IconKitchen}" />
                      <TextBlock Classes="kroot-txt" FontSize="11" Text="{Binding KitchenName}" />
                    </StackPanel>
                  </Border>

                  <Panel IsVisible="{Binding !HasKitchenLayers}">
                    <Rectangle Classes="dashed btn" />
                    <TextBlock Classes="vlock" Margin="10,9" Text="{Binding NoKitchenText}" />
                  </Panel>

                  <ItemsControl ItemsSource="{Binding KitchenLayers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ReferenceLayer">
                        <Border Classes="refrow" Margin="0,0,0,7"
                                Classes.sel="{Binding IsOn}" Classes.off="{Binding !IsOn}"
                                ToolTip.Tip="{Binding Tip}">
                          <!-- Two rows, both always present. The second is a FIXED 19px: it holds the
                               file name at rest and the placement stepper once switched on, and a row
                               that grew when the stepper appeared is exactly the reflow the spec
                               forbids. -->
                          <Grid RowDefinitions="Auto,19" RowSpacing="3">
                            <Button Grid.Row="0" Classes="bare" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).ToggleReferenceCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="15,15,13,*,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" Classes="cbx" Classes.on="{Binding IsOn}">
                                  <Path Classes="ico xs" Data="{StaticResource IconCheck}" />
                                </Border>
                                <!-- No numeral, ever: a loose .igt has no canonical depth here. -->
                                <TextBlock Grid.Column="1" Classes="dpt none" Text="{Binding DepthText}"
                                           ToolTip.Tip="No canonical depth — placed for this preview only" />
                                <TextBlock Grid.Column="2" Classes="kmark"
                                           Classes.kdyn="{Binding IsDynamic}"
                                           Classes.kstat="{Binding IsStatic}"
                                           Classes.kcust="{Binding IsCustom}"
                                           Text="{Binding KindMark}" />
                                <TextBlock Grid.Column="3" Classes="vname" Text="{Binding Name}" />
                                <Border Grid.Column="4" Classes="kchip">
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="ico xs" Data="{StaticResource IconKitchen}" />
                                    <TextBlock Text="KITCHEN" />
                                  </StackPanel>
                                </Border>
                              </Grid>
                            </Button>

                            <!-- Indented to the name column (15 + 8 + 15 + 8 + 13 + 8), so the sub-line
                                 hangs off the layer's name the way the exploration's .vmeta does
                                 rather than starting back under the checkbox. -->
                            <Panel Grid.Row="1" Margin="67,0,0,0">
                              <TextBlock Classes="tlabel" Text="{Binding DetailText}"
                                         Opacity="{Binding DetailOpacity}" />
                              <!-- The opacity/hit-test switch is on the GROUP, never on the two
                                   buttons: a local Opacity value beats every Style setter, so binding
                                   it per button would silently disable Button:disabled's own dimming
                                   and an unsteppable end-of-stack chevron would look live. -->
                              <Grid ColumnDefinitions="19,*,19,46" ColumnSpacing="4"
                                    Opacity="{Binding TagOpacity}" IsHitTestVisible="{Binding IsOn}">
                                <Button Grid.Column="0" Classes="sbtn" IsEnabled="{Binding CanStepDown}"
                                        ToolTip.Tip="Move down one gap"
                                        Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).PlaceDownCommand}"
                                        CommandParameter="{Binding}">
                                  <Path Classes="ico xs" Data="{StaticResource IconChevronDown}" />
                                </Button>
                                <TextBlock Grid.Column="1" Classes="sv" Text="{Binding PlacementText}" />
                                <Button Grid.Column="2" Classes="sbtn" IsEnabled="{Binding CanStepUp}"
                                        ToolTip.Tip="Move up one gap"
                                        Command="{Binding $parent[ItemsControl].((vm:IngredientEditorViewModel)DataContext).PlaceUpCommand}"
                                        CommandParameter="{Binding}">
                                  <Path Classes="ico xs" Data="{StaticResource IconChevronUp}" />
                                </Button>
                                <Border Grid.Column="3" Classes="tagx" Classes.over="{Binding IsAbove}">
                                  <TextBlock Text="{Binding TagText}" />
                                </Border>
                              </Grid>
                            </Panel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- A canvas mismatch is refused, never scaled: StackPreview.Render words it with both
                   sizes named and that message is shown verbatim.

                   LAST in the panel, and IsVisible rather than the usual reserve-the-space-toggle-
                   the-ink. It used to sit between the ghost toggle and the layer list, where an
                   always-present 34px box left a hole in the middle of the panel that read as a
                   layout mistake - which it may as well have been, since the message is absent in
                   every ordinary session. The rule it was following exists to stop a control
                   appearing UNDER the pointer that just acted and shoving the rows away; nothing
                   sits below this now, so appearing here pushes nothing, and the panel fits on
                   screen without scrolling so it is still seen. -->
              <Panel Classes="stackproblem on" Margin="0,4,0,0"
                     IsVisible="{Binding StackProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     ToolTip.Tip="{Binding StackProblem}">
                <Rectangle Classes="dashed btn" />
                <TextBlock Classes="vlock" Margin="10,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="{Binding StackProblem}" />
              </Panel>
             </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer actions -->
    <Border Grid.Row="1" Classes="modal-foot">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="cshare" VerticalAlignment="Center"
                   Text="{Binding SaveNoteText}"
                   IsVisible="{Binding SaveNoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Back" Command="{Binding BackCommand}" Classes="tbtn ghost" />
          <Button Command="{Binding SaveCommand}" Classes="accent">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="ico sm" Data="{StaticResource IconCheck}" />
              <TextBlock Text="Save" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
