<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.ReportDialogView"
             x:DataType="vm:ReportDialogViewModel"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <Border Classes="modal monoform">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- Header: the settings and export cards' grammar - the title left, the two reports as
           underline tabs right, over one hairline. It was a kicker, a title and a segmented pill
           stacked in three rows, the only tabbed card in the app that did not look like the others. -->
      <Border Grid.Row="0" Classes="exporthead" Margin="24,12,24,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="m-h" VerticalAlignment="Bottom"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Bottom">
            <Button Classes="railtab" Classes.on="{Binding !ShowingIdentity}" Content="STATS"
                    Command="{Binding ShowStatsCommand}"
                    ToolTip.Tip="The odds these weights imply — the CLI's stats" />
            <Button Classes="railtab" Classes.on="{Binding ShowingIdentity}" Content="IDENTITY"
                    Command="{Binding ShowIdentityCommand}"
                    ToolTip.Tip="Ids for --recipe and --variant — the CLI's inspect" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Selectable, so a user can take part of it without taking all of it. Mono and wrap-free:
           both reports are column-aligned and rewrapping them destroys the alignment. -->
      <Border Grid.Row="1" Classes="modal-body tight" Padding="24,14,24,12">
        <Border Classes="reportbox">
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding Text}" Classes="reporttext" />
          </ScrollViewer>
        </Border>
      </Border>

      <Border Grid.Row="2" Classes="modal-foot">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Classes="keyhint" VerticalAlignment="Center"
                     Text="Identical to what the CLI prints" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Classes="tbtn" />
            <Button Content="Close" Command="{Binding CloseCommand}" Classes="accent" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
