<!-- RenderOptions.BitmapInterpolationMode=None on the root: pixel art scales with nearest
     neighbour, never a filter. It inherits to every Image below, and
     PixelPerfectRenderingTests fails naming any view that drops it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:conv="using:Nfty.App.Converters"
             x:Class="Nfty.App.Views.RecipeDetailView"
             x:DataType="vm:RecipeDetailViewModel"
             RenderOptions.BitmapInterpolationMode="None">
  <!-- Recipe detail body: a 2-column layout — a main column carrying the portrait hero and the
       full-width layer table, beside a rules rail.
       Rail column: the incompatibility rules panel. -->
  <Grid Margin="16" ColumnDefinitions="*,300">
    <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,16,0">
      <Border Classes="rhero">
        <Grid ColumnDefinitions="Auto,*">
          <!-- Nothing sits on the portrait. The reroll die used to be pinned over its bottom-right
               corner, which put a control on top of the one thing on this card that is a picture -
               and a picture 92px square has no room to spare. It has moved into the stats row as
               the sample chip, beside the seed it changes, where it is a control among controls
               instead of a smudge on the art. -->
          <!-- The picture and the control that changes it, as one column.
               TOP-aligned, not centred: the card's text starts at the recipe's name, and a
               vertically-centred 92px square floated the art half a line above it, so neither the
               top nor the bottom of the two columns lined up with anything. Flush with the title is
               the one alignment a reader can actually see.
               And the sample chip lives HERE now rather than out at the end of the stats row, where
               it trailed three recipe facts it is not one of - a recipe has no seed. Under the
               picture it labels the thing it describes and is the button that rerolls it. -->
          <StackPanel Grid.Column="0" Margin="0,0,16,0" Spacing="7" VerticalAlignment="Top">
            <Border Width="92" Height="92" CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource TileBrush}" ClipToBounds="True">
              <Image Source="{Binding Hero}" Stretch="UniformToFill" />
            </Border>
            <Button Classes="sampleroll" Command="{Binding RerollCommand}"
                    HorizontalAlignment="Center"
                    ToolTip.Tip="The picture is ONE roll of this recipe, not a stored asset. Press to roll another. The seed is not part of the recipe.">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="ico ti" Data="{StaticResource IconDiceFace}" />
                <TextBlock Text="{Binding RollSeed, StringFormat='sample {0}'}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
            <TextBlock Classes="mono" FontSize="17" FontWeight="Bold" Text="{Binding Name}" />

            <!-- .rfactors: the same variant-count arithmetic the cookbook's combination space shows,
                 scoped to this one recipe. -->
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,4,0,0">
              <ItemsControl ItemsSource="{Binding Factors}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FactorChip">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Classes="ftimes" Text="×" IsVisible="{Binding ShowTimes}" />
                      <Border Classes="fchip"
                              Classes.kdyn="{Binding IsDynamic}"
                              Classes.kstat="{Binding IsStatic}"
                              Classes.kcust="{Binding IsCustom}"
                              ToolTip.Tip="{Binding Tip}">
                        <TextBlock Text="{Binding VariantCount}" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,0">
              <TextBlock Classes="rtotal" Text="{Binding TotalText}" />
              <TextBlock Classes="rlabel" Text="art combinations" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>

            <!-- .rstats. The figure carries the ink and the word stays muted, so the row can be
                 SCANNED rather than read - the same shape as the "108 art combinations" line above
                 it. As three finished sentences in one flat mono they read as a paragraph. -->
            <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,8,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Classes="statn" Text="{Binding LayerCount}" />
                <TextBlock Classes="statw" Text="{Binding LayerCountWord}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Classes="statn" Text="{Binding VariantCount}" />
                <TextBlock Classes="statw" Text="{Binding VariantCountWord}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Classes="statn" Text="{Binding RuleCount}" />
                <TextBlock Classes="statw" Text="{Binding RuleCountWord}" />
              </StackPanel>

            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- The hint is PERMANENT, in both lock states. The table lists depth ascending down the page
           while depth 1 paints first, so its top row is the BACK of the stack — the inverse of every
           layers panel an artist has used. The spec settles that by keeping the locked reading order
           and carrying the meaning in a label rather than in an arrow that would have to pick a
           direction to betray. Permanent also means the header never reflows on unlock. -->
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9" Margin="2,0,0,0">
        <TextBlock Grid.Column="0" Classes="sub-h" Text="LAYERS" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="hint" Text="1 → paints first, furthest back"
                   VerticalAlignment="Center" />
        <!-- The toggle sits ABOVE the table it reshapes, which is what makes the chance column
             allowed to appear and disappear: switching it re-lays the columns below rather than
             moving anything under the pointer that just clicked. It is DERIVED from the data — the
             recipe has optional layers exactly when some layer has a chance — so there is no stored
             flag that could disagree with the numbers underneath it. -->
        <Button Grid.Column="3" Classes="chip" Classes.on="{Binding ShowChanceColumn}"
                Content="OPTIONAL LAYERS" Command="{Binding ToggleOptionalLayersCommand}"
                ToolTip.Tip="Let layers be left out of an asset entirely, at a chance you set per layer. The variants' own weights still decide which one shows up when it does." />
      </Grid>

      <StackPanel Spacing="0">
        <!-- The leading 26px column is the drag grip's, and it is present in BOTH lock states at the
             same width: only the glyph's ink changes (Border.grip / .grip.on in Styles.axaml). The
             exploration draws variant B prepending this column on unlock, which shifts every other
             column 26px right — the exact reflow the spec forbids. -->
        <!-- THE ONE TABLE IN THIS APP THAT DELIBERATELY DOES NOT SORT. Its order IS layerOrder,
             which is the paint order, and Generator.RollOne walks it consuming one WeightedRoller
             draw per layer — so the same seed over a reordered stack rolls different variants. A
             sorted view would show a stack that is not the stack, directly beside a drag handle
             that writes the real one. Nothing here is missing; see TableSort's own summary. -->
        <Border Classes="data-h">
          <Grid ColumnDefinitions="26,40,*,110,90,Auto">
            <TextBlock Grid.Column="1" Classes="data-h num" Text="#" Margin="0,0,10,0" />
            <TextBlock Grid.Column="2" Classes="data-h" Text="LAYER" />
            <TextBlock Grid.Column="3" Classes="data-h" Text="KIND" />
            <TextBlock Grid.Column="4" Classes="data-h num" Text="VARIANTS" />
            <!-- AN AUTO COLUMN IN TWO GRIDS IS THE TRAP THIS APP HAS BEEN BITTEN BY TWICE — the
                 header sizes on its own content and the rows size on theirs, and the column starts
                 at a different x in each. It is safe here only because both cells are the SAME
                 styled wrapper (Panel.chancecell, one width stated once in Styles.axaml) and both
                 collapse together: hidden, the Panel does not measure, so Auto is 0 in both and the
                 column is simply not there. That collapse is why the shape can change at all
                 without a bindable ColumnDefinitions, which Avalonia does not offer. -->
            <Panel Grid.Column="5" Classes="chancecell" IsVisible="{Binding ShowChanceColumn}">
              <TextBlock Classes="data-h num" Text="ABSENT" HorizontalAlignment="Right" />
            </Panel>
          </Grid>
        </Border>
        <!-- A Panel, not a StackPanel: the drop line is an OVERLAY positioned by margin over the
             rows, so that showing it costs no layout anywhere. -->
        <Panel Name="LayerStack">
          <ItemsControl Name="LayerRows" ItemsSource="{Binding Layers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LayerRow">
                <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).OpenIngredientCommand}"
                        CommandParameter="{Binding Id}">
                  <Border Classes="data-row" Classes.sel="{Binding IsSelected}">
                    <Grid ColumnDefinitions="26,40,*,110,90,Auto">
                      <Border Grid.Column="0" Classes="grip"
                              Classes.on="{Binding $parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).CanReorder}"
                              ToolTip.Tip="Drag to reorder — or Alt+Up / Alt+Down">
                        <Path Classes="ico" Data="{StaticResource IconGrip}" />
                      </Border>
                      <TextBlock Grid.Column="1" Classes="data-row num" Text="{Binding Index}" Margin="0,0,10,0" />
                      <TextBlock Grid.Column="2" Classes="data-row" Text="{Binding Layer}" />
                      <TextBlock Grid.Column="3" Classes="data-row kind-txt" Classes.kdyn="{Binding IsDynamic}" Classes.kstat="{Binding IsStatic}" Classes.kcust="{Binding IsCustom}" Text="{Binding Kind}" />
                      <TextBlock Grid.Column="4" Classes="data-row num" Text="{Binding VariantCount}" />

                      <!-- Editable while the book is unlocked, plain text while it is not — the
                           same gate reordering and rule authoring use, because a chance is
                           structure rather than pixels. Both states occupy the same cell, so
                           flipping the lock does not move the column.
                           The field commits on LOST FOCUS and on Enter, never on every value
                           change: a save rewrites every PNG in the book, and a stepper spun from 0
                           to 85 would otherwise be eighty-five of them. RecipeDetailView.axaml.cs
                           holds that wiring. -->
                      <Panel Grid.Column="5" Classes="chancecell"
                             IsVisible="{Binding $parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).ShowChanceColumn}">
                        <TextBlock Classes="data-row num" Text="{Binding AbsentText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   IsVisible="{Binding !$parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).CanEditChances}" />
                        <NumericUpDown Name="AbsentField" Classes="qnt" Value="{Binding AbsentPercent}"
                                       Minimum="0" Maximum="100" FormatString="0.##"
                                       IsVisible="{Binding $parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).CanEditChances}"
                                       Tag="{Binding}"
                                       ToolTip.Tip="How often this layer is left out entirely. 0 always appears, 100 never does." />
                      </Panel>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Name="DropLine" Classes="dropline" />
        </Panel>
      </StackPanel>
    </StackPanel>

    <!-- RULES, as a table. The panel used to stack two bordered chips per rule with the relation
         carried only by a 20px mark in the gutter and its tooltip, which meant the reader had to
         learn a symbol vocabulary to know whether a rule forbade or demanded — and a two-target
         rule read as two separate rules, because nothing said where one ended.
         Column heads name the two sides ONCE, the mark keeps its badge but gains the word under it,
         and a rule's targets stack in the right cell where their shared row makes them obviously
         one rule. Three designs were rendered at the real 300px width before this one was picked;
         it is the only one that shows a realistic rule set without scrolling, and a rail is the
         worst place in this app to hide content behind a scrollbar.
         The heads say LAYER twice rather than WHEN/THEN because an exclude rule is SYMMETRIC —
         "these two never appear together" reads the same in both directions — and only require has
         a direction. A directional heading over a symmetric relation would be a small lie in half
         the rows. -->
    <Border Grid.Column="1" Classes="rules-panel" VerticalAlignment="Stretch">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="sub-h" Text="RULES" VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="tabcount" IsVisible="{Binding RecipeHasRules}">
            <TextBlock Text="{Binding RulesBadgeText}" />
          </Border>
          <!-- Reserved, not conditional. The lock flips while this pane is open, and a button that
               appeared and vanished would resize the header row under the pointer — the app's
               "reserve the space, toggle the ink" rule. It ghosts at 0.38 like every other
               lock-gated control. -->
          <Button Grid.Column="2" Classes="icon" Padding="3"
                  Command="{Binding AddRuleCommand}"
                  ToolTip.Tip="Add a rule. Rules decide which variants may be rolled together, and unlike the pencil they are gated by the edit lock — a rule is structure, not pixels.">
            <Path Classes="ico xs" Data="{StaticResource IconPlus}" />
          </Button>
        </Grid>

        <!-- The relation filter. Three chips rather than a dropdown: they fit across the rail,
             change in one click, and show all three states at once where a ComboBox would hide two
             thirds of them. Always present — a filter that appeared once a recipe had "enough"
             rules would move the table under the pointer. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,11,0,0"
                    IsVisible="{Binding RecipeHasRules}">
          <Button Classes="chip rfilter" Classes.on="{Binding IsFilterAll}" Content="ALL"
                  Command="{Binding FilterRulesCommand}" CommandParameter="all" />
          <Button Classes="chip rfilter" Classes.on="{Binding IsFilterExclude}" Content="NEVER"
                  Command="{Binding FilterRulesCommand}" CommandParameter="exclude" />
          <Button Classes="chip rfilter" Classes.on="{Binding IsFilterRequire}" Content="ALWAYS"
                  Command="{Binding FilterRulesCommand}" CommandParameter="require" />
        </StackPanel>

        <!-- The empty state says WHICH emptiness: a recipe with no rules and a filter that matched
             none are different situations, and one of them is undone by a click. -->
        <!-- Row 1 when the recipe has no rules at all (the chips are gone, so the row is free),
             row 2 when a filter emptied the view (the chips are still there, above it). Bound to
             the same grid row would leave a hole where the chips were on an empty recipe. -->
        <TextBlock Grid.Row="1" Classes="muted" Text="{Binding EmptyRuleText}"
                   Margin="0,12,0,0" IsVisible="{Binding !RecipeHasRules}" />
        <TextBlock Grid.Row="2" Classes="muted" Text="{Binding EmptyRuleText}"
                   Margin="0,12,0,0" IsVisible="{Binding FilterEmptied}" />

        <!-- Sortable, and the DEFAULT IS AS AUTHORED — which is not a column any header offers.
             The CLI addresses a rule by its 1-based position in the manifest, so a panel that opened
             in some other order would quietly disagree with `nfty inspect` about which rule is
             number 3. Rule order changes no roll (RulesEngine evaluates all of them), which is what
             makes sorting safe here and NOT safe on the layer table above. -->
        <!-- 38 IS NOT Auto, and the difference is the whole of a bug this panel shipped with.
             Both grids declared "*,58,*,Auto" and looked identical, but the actions column is
             EMPTY in the header and occupied in the rows - so Auto resolved to 0 up here and to
             38 down there, the two star columns divided a different remainder, and the second
             LAYER heading sat ~19px right of the values it names. The first column aligned
             perfectly, which is what made it easy to miss. 38 = two 18px icon buttons (a 12px
             ico xs plus Button.icon's overridden 3px padding each side) and the 2px between
             them. Fixed in BOTH grids, as the layer table above already does, and
             RulesPanelTests measures the two off a laid-out frame rather than trusting that
             these two strings stay equal by eye. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,58,*,38" Margin="0,12,0,6" IsVisible="{Binding HasRules}">
          <Button Grid.Column="0" Classes="sorth" HorizontalContentAlignment="Left"
                  Classes.on="{Binding RuleSort.Column, Converter={x:Static conv:SortColumnConverter.Instance}, ConverterParameter=Trigger}"
                  Command="{Binding RuleSort.ByCommand}" CommandParameter="Trigger">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="data-h" Text="LAYER" />
              <Panel Classes="sortslot">
                <Path Classes="sortarrow up" Classes.desc="{Binding RuleSort.Descending}"
                      Data="{StaticResource IconChevronUp}" />
                <Path Classes="sortarrow down" Classes.desc="{Binding RuleSort.Descending}"
                      Data="{StaticResource IconChevronDown}" />
              </Panel>
            </StackPanel>
          </Button>
          <!-- No header over the mark column, and no sort by relationship either. The arrow is the
               only thing a relation header could show, and at rest an arrow is invisible — so it
               would have been a control with no affordance, occupying the gap between the two
               labels. The ALL / NEVER / ALWAYS filter above already groups by relationship, and
               does it better: it removes the rows you are not asking about instead of moving them
               below the ones you are. -->
          <Button Grid.Column="2" Classes="sorth" HorizontalContentAlignment="Left"
                  Classes.on="{Binding RuleSort.Column, Converter={x:Static conv:SortColumnConverter.Instance}, ConverterParameter=Target}"
                  Command="{Binding RuleSort.ByCommand}" CommandParameter="Target">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="data-h" Text="LAYER" />
              <Panel Classes="sortslot">
                <Path Classes="sortarrow up" Classes.desc="{Binding RuleSort.Descending}"
                      Data="{StaticResource IconChevronUp}" />
                <Path Classes="sortarrow down" Classes.desc="{Binding RuleSort.Descending}"
                      Data="{StaticResource IconChevronDown}" />
              </Panel>
            </StackPanel>
          </Button>
        </Grid>
        <Border Grid.Row="3" Height="1" Background="{DynamicResource LineBrush}"
                IsVisible="{Binding HasRules}" />

        <!-- The ScrollViewer this panel has never had. A recipe with a dozen rules did not scroll,
             it overflowed the window: the panel Border simply grew past the bottom of the pane and
             every rule below the fold was unreachable. -->
        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RuleRow">
                <Border Classes="rulerow ract">
                  <Grid ColumnDefinitions="*,58,*,38">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Classes="rcl" Text="{Binding When.Ingredient}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="rcv" Text="{Binding When.Variant}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- The mark keeps its badge and gains the word. The badge alone was a
                         vocabulary to learn; the word alone would lose the color that tells the two
                         kinds apart down a column at a glance. -->
                    <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Center"
                                VerticalAlignment="Center" ToolTip.Tip="{Binding RelationTip}">
                      <Border Classes="rop" Classes.exclude="{Binding IsExclude}"
                              Classes.require="{Binding !IsExclude}"
                              Width="18" Height="18" Margin="0" HorizontalAlignment="Center">
                        <Panel>
                          <Path Classes="ico xs rop exclude" Data="{StaticResource IconMarkExclude}"
                                IsVisible="{Binding IsExclude}" />
                          <Path Classes="ico xs rop require" Data="{StaticResource IconMarkRequire}"
                                IsVisible="{Binding !IsExclude}" />
                        </Panel>
                      </Border>
                      <TextBlock Classes="rmark" Text="{Binding ShortText}"
                                 HorizontalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Targets}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleTargetRow">
                          <StackPanel Spacing="2" Margin="0,0,0,4">
                            <TextBlock Classes="rcl" Text="{Binding Ingredient}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="rcv" Text="{Binding Variant}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The row's own actions, revealed on hover. The column really is fixed-width
                         now — it said Auto while this comment claimed otherwise — so the three text
                         cells are the same width on every row whether the pointer is over one or
                         not, and the header above lines up with them. Opacity, never IsVisible, or
                         the columns would resize under the pointer that just arrived. -->
                    <StackPanel Grid.Column="3" Classes="ractions" Orientation="Horizontal"
                                Spacing="2" VerticalAlignment="Center">
                      <Button Classes="icon" Padding="3"
                              Command="{Binding $parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).EditRuleCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Edit this rule">
                        <Path Classes="ico xs" Data="{StaticResource IconPencil}" />
                      </Button>
                      <Button Classes="icon danger" Padding="3"
                              Command="{Binding $parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).DeleteRuleCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Delete this rule">
                        <Path Classes="ico xs" Data="{StaticResource IconTrash}" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
