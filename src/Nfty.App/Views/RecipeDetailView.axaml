<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:conv="using:Nfty.App.Converters"
             x:Class="Nfty.App.Views.RecipeDetailView"
             x:DataType="vm:RecipeDetailViewModel">
  <!-- Recipe detail body: 2-column layout (explorer.html:356-361 .recipe-grid / .recipe-main / .recipe-rules).
       Main column: portrait hero (.rhero, explorer.html:283-296) + layer table (table.data, explorer.html:833).
       Rail column: incompatibility rules panel (.rules-panel, explorer.html:365-382). -->
  <Grid Margin="16" ColumnDefinitions="*,300">
    <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,16,0">
      <Border Classes="rhero">
        <Grid ColumnDefinitions="Auto,*">
          <!-- .rport-wrap: the reroll die sits OVER the portrait's bottom-right corner, not beside
               the text - so a Panel, not a sibling. -->
          <Panel Grid.Column="0" Margin="0,0,16,0">
            <Border Width="92" Height="92" CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource TileBrush}" ClipToBounds="True">
              <Image Source="{Binding Hero}" Stretch="UniformToFill" />
            </Border>
            <Button Classes="dice" Command="{Binding RerollCommand}" ToolTip.Tip="Reroll sample"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6">
              <!-- A die face, per the mockup's .dice button. IconReroll (a circular arrow) is the
                   ingredient editor's "reroll sampled colour" glyph and was borrowed here. -->
              <Path Classes="ico sm" Data="{StaticResource IconDiceFace}" />
            </Button>
          </Panel>

          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="mono" FontSize="17" FontWeight="Bold" Text="{Binding Name}" />

            <!-- .rfactors: the same variant-count arithmetic the cookbook's combination space shows,
                 scoped to this one recipe. -->
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,4,0,0">
              <ItemsControl ItemsSource="{Binding Factors}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FactorChip">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Classes="ftimes" Text="×" IsVisible="{Binding ShowTimes}" />
                      <Border Classes="fchip"
                              Classes.kdyn="{Binding IsDynamic}"
                              Classes.kstat="{Binding IsStatic}"
                              Classes.kcust="{Binding IsCustom}"
                              ToolTip.Tip="{Binding Tip}">
                        <TextBlock Text="{Binding VariantCount}" />
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,4,0,0">
              <TextBlock Classes="rtotal" Text="{Binding TotalText}" />
              <TextBlock Classes="rlabel" Text="art combinations" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </StackPanel>

            <!-- .rstats -->
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
              <TextBlock Classes="cshare" Text="{Binding LayerCountText}" />
              <TextBlock Classes="cshare" Text="{Binding VariantCountText}" />
              <TextBlock Classes="cshare" Text="{Binding RuleCountText}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="cshare" Text="{Binding RollSeed, StringFormat='seed {0}'}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Classes="sub-h" Text="LAYERS" Margin="2,0,0,0" />

      <StackPanel Spacing="0">
        <Border Classes="data-h">
          <Grid ColumnDefinitions="40,*,110,90">
            <TextBlock Grid.Column="0" Classes="data-h num" Text="#" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="data-h" Text="LAYER" />
            <TextBlock Grid.Column="2" Classes="data-h" Text="KIND" />
            <TextBlock Grid.Column="3" Classes="data-h num" Text="VARIANTS" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Layers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LayerRow">
              <Button Classes="ghost" Padding="0" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Command="{Binding $parent[ItemsControl].((vm:RecipeDetailViewModel)DataContext).OpenIngredientCommand}"
                      CommandParameter="{Binding Id}">
                <Border Classes="data-row">
                  <Grid ColumnDefinitions="40,*,110,90">
                    <TextBlock Grid.Column="0" Classes="data-row num" Text="{Binding Index}" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Classes="data-row" Text="{Binding Layer}" />
                    <TextBlock Grid.Column="2" Classes="data-row kind-txt" Classes.kdyn="{Binding IsDynamic}" Classes.kstat="{Binding IsStatic}" Classes.kcust="{Binding IsCustom}" Text="{Binding Kind}" />
                    <TextBlock Grid.Column="3" Classes="data-row num" Text="{Binding VariantCount}" />
                  </Grid>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <Border Grid.Column="1" Classes="rules-panel" VerticalAlignment="Stretch">
      <StackPanel Spacing="10">
        <TextBlock Classes="sub-h" Text="RULES" />

        <TextBlock Classes="muted" Text="No incompatibility rules"
                   IsVisible="{Binding Rules, Converter={x:Static conv:CollectionConverters.IsEmpty}}" />

        <ItemsControl ItemsSource="{Binding Rules}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RuleRow">
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Border Classes="rop" Classes.exclude="{Binding IsExclude}" Classes.require="{Binding !IsExclude}">
                    <Panel>
                      <Path Classes="ico xs rop exclude" Data="{StaticResource IconMarkExclude}" IsVisible="{Binding IsExclude}" />
                      <Path Classes="ico xs rop require" Data="{StaticResource IconMarkRequire}" IsVisible="{Binding !IsExclude}" />
                    </Panel>
                  </Border>
                  <!-- .rpair: two stacked .rchip, each a tiny muted ingredient caption over a bold
                       variant headline. The mockup has NO "WHEN"/"THEN"/"WITH" words - which pair is
                       the condition and which the consequence is carried by stacking order plus the
                       mark's own tooltip, and the mark is already right there in the gutter. The
                       words were also competing with the variant name at the same weight, which is
                       the one thing in the chip the eye needs to land on. -->
                  <StackPanel Spacing="5">
                    <Border Classes="rchip" HorizontalAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                        <TextBlock Classes="rcl" Text="{Binding When.Ingredient}" />
                        <TextBlock Classes="rcv" Text="{Binding When.Variant}" />
                      </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Targets}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleTargetRow">
                          <Border Classes="rchip" HorizontalAlignment="Left" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                              <TextBlock Classes="rcl" Text="{Binding Ingredient}" />
                              <TextBlock Classes="rcv" Text="{Binding Variant}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
