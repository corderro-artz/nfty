<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.NewCookBookView"
             x:DataType="vm:NewCookBookViewModel"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
  </UserControl.KeyBindings>
  <Border Classes="modal monoform">
    <Grid RowDefinitions="*,Auto">
      <Border Grid.Row="0" Classes="modal-body">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="432">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Classes="kdot" />
            <TextBlock Text="CREATE" Classes="slbl" />
          </StackPanel>
          <TextBlock Text="New CookBook" Classes="m-h" />
          <TextBlock Classes="m-sub"><Run Text="Makes an empty " /><Run Text=".cbk" Foreground="{DynamicResource FgBrush}" /><Run Text=" — Recipes and layers get added in the Explorer." /></TextBlock>

          <StackPanel Spacing="14" Margin="0,19,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="NAME" Classes="plabel" />
              <TextBox Text="{Binding Name}" PlaceholderText="VaporPets" />
            </StackPanel>
            <!-- wizard-cookbook.html puts SYMBOL (a fixed 132px field) and CANVAS (flex:1) on one
                 .row rather than stacking them full width. -->
            <Grid ColumnDefinitions="132,12,*">
              <StackPanel Grid.Column="0" Spacing="6">
                <StackPanel Classes="plabel-row">
                  <TextBlock Text="SYMBOL" Classes="plabel" />
                  <Border Classes="qmark"
                          ToolTip.Tip="The collection's ticker. Convention is 3–5 uppercase characters (VPET, PUNK) — what marketplaces display well. Up to 255; may be left empty.">
                    <TextBlock />
                  </Border>
                </StackPanel>
                <TextBox Text="{Binding Symbol}" MaxLength="255" PlaceholderText="VP" />
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="6">
                <StackPanel Classes="plabel-row">
                  <TextBlock Text="CANVAS" Classes="plabel" />
                  <Border Classes="qmark"
                          ToolTip.Tip="Every Recipe and painted layer is validated against this exact size. It can't change once art is added.">
                    <TextBlock />
                  </Border>
                </StackPanel>
                <!-- Width / aspect lock / height, with the lock centered between the two fields.
                     Star-sized rather than fixed: Fluent's spinner is a wide side-by-side pair
                     (Known deviation - the mockup's .stepr is a 20px column we cannot reach from a
                     Style), so it eats most of a fixed field and clipped "1000" to "100(" in mono.
                     Letting both fields take what is left keeps the value readable. -->
                <Grid ColumnDefinitions="*,Auto,*">
                  <NumericUpDown Grid.Column="0" Value="{Binding Width}" Minimum="1" />
                  <ToggleButton Grid.Column="1" IsChecked="{Binding AspectLocked}" Margin="6,0"
                                ToolTip.Tip="Lock aspect ratio" VerticalAlignment="Center">
                    <Path Classes="ico xs" Data="{StaticResource IconLink}" />
                  </ToggleButton>
                  <NumericUpDown Grid.Column="2" Value="{Binding Height}" Minimum="1" />
                </Grid>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="6">
              <StackPanel Classes="plabel-row">
                <TextBlock Text="TARGET SUPPLY" Classes="plabel" />
                <Border Classes="qmark"
                        ToolTip.Tip="How many assets you intend to mint. Optional — leave it at 0 if you have not decided. It is declarative: it never limits a cook, which takes its count from the Cook dialog.">
                  <TextBlock />
                </Border>
              </StackPanel>
              <NumericUpDown Value="{Binding TargetSupply}" Minimum="0" Increment="100" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="DESCRIPTION" Classes="plabel" />
              <!-- Wrap, and no horizontal scrollbar. A TextBox defaults to NoWrap even with
                   AcceptsReturn set, so this two-line box ran its text off the right edge and
                   Fluent drew a horizontal scrollbar under it - which the PLACEHOLDER alone was
                   enough to trigger, so an untouched wizard opened showing a clipped sentence and
                   a scrollbar for text the user had not typed. -->
              <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="54"
                       TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VerticalContentAlignment="Top" Padding="11,7"
                       PlaceholderText="A collection of neon companions, each hatched from its own recipe…" />
            </StackPanel>
          </StackPanel>

          <!-- .derived: the id the name will be saved under. Dashed rule above it, per the mockup. -->
          <StackPanel Margin="0,15,0,0">
            <Rectangle Height="1" HorizontalAlignment="Stretch" Stroke="{DynamicResource LineStrongBrush}"
                       StrokeThickness="1" StrokeDashArray="3,3" />
            <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,11,0,0">
              <TextBlock Text="Identifier" Classes="derived" />
              <Border Classes="idchip"><TextBlock Text="{Binding DerivedIdText}" Classes="mono" FontSize="10.5" /></Border>
              <TextBlock Text="— derived from the name" Classes="derived" Opacity="0.9" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="1" Classes="modal-foot">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Classes="kbd keys"><TextBlock Text="Tab" /></Border><TextBlock Text="move fields" Classes="keyhint" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Classes="kbd keys"><TextBlock Text="Enter" /></Border><TextBlock Text="create" Classes="keyhint" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Classes="kbd keys"><TextBlock Text="Esc" /></Border><TextBlock Text="cancel" Classes="keyhint" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="tbtn ghost" />
            <Button Command="{Binding CreateCommand}" Classes="accent">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="ico sm" Data="{StaticResource IconCheck}" />
                <TextBlock Text="Create CookBook" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
