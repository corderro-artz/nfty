<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.ImportImageView"
             x:DataType="vm:ImportImageViewModel"
             RenderOptions.BitmapInterpolationMode="None"
             Focusable="True">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
  </UserControl.KeyBindings>
  <!-- .split, like the New Ingredient wizard and for a worse version of the same reason: this form
       carries those two range bands AND a preview, so as one column it wanted 590px of a 396px body
       at the smallest window - it hid a third of itself. The halves are the two things the form is
       about: the PICTURE on the left, and what nfty will do with it on the right. -->
  <Border Classes="modal monoform split">
    <Grid RowDefinitions="*,Auto,Auto">
      <Border Grid.Row="0" Classes="modal-body">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7">
                <Ellipse Classes="kdot" />
                <TextBlock Text="IMPORT" Classes="slbl" />
              </StackPanel>
              <!-- The file and its size ride the eyebrow row. They had a row of their own, which
                   cost the card 22px it does not have - see WizardFitsTests. -->
              <TextBlock Grid.Column="1" Classes="derived" Opacity="0.9" HorizontalAlignment="Right"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding SourceText}" />
            </Grid>
            <TextBlock Text="Image as Ingredient" Classes="m-h" />
            <!-- ONE LINE at this card's width. It was the longer sentence the single-column card
                 wrapped anyway, and in a card with a hard ceiling a second line of subtitle is a
                 line of form. What it dropped is spelled out by the KIND cards directly below. -->
            <TextBlock Classes="m-sub"><Run Text="The picture becomes this layer's first variant — its " /><Run Text="kind" Foreground="{DynamicResource FgBrush}" /><Run Text=" decides what nfty keeps." /></TextBlock>

            <Grid Classes="wizcols" ColumnDefinitions="*,25,1,25,*">
              <Rectangle Grid.Column="2" Classes="wizrule" />

              <!-- THE PICTURE. It had 64px of card and is the point of the form: choosing Dynamic or
                   Static discards the picture's colors on purpose, and the grayscale it becomes has
                   to be legible BEFORE the choice is agreed to rather than after it is written. A
                   64px strip of a 512px drawing is not a preview, it is a swatch. -->
              <StackPanel Grid.Column="0" Spacing="12">
                <Border Classes="impshot">
                  <Image Source="{Binding Preview}" Stretch="Uniform" />
                </Border>

                <StackPanel Spacing="6">
                  <TextBlock Text="NAME" Classes="plabel" />
                  <TextBox Text="{Binding Name}" PlaceholderText="Aura" />
                  <!-- THE DERIVED ID SITS UNDER THE NAME IT IS DERIVED FROM.
                       It used to be a full-width strip above the footer, under a dashed rule - the
                       flourish a full-window mockup could afford. In a dialog card it cost every
                       wizard about 60px of a card with a hard ceiling, and it stated its relationship
                       to the NAME field from the far end of the form. Beneath the field, the sentence
                       is shorter, the height is a line rather than a band, and the reader can see the
                       id change as they type. -->
                  <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,3,0,0">
                    <Border Classes="idchip"><TextBlock Text="{Binding DerivedIdText}" Classes="mono" FontSize="10.5" /></Border>
                    <TextBlock Text="— the identifier, derived from the name" Classes="derived"
                               Opacity="0.9" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <!-- WHAT NFTY DOES WITH IT: the kind, and the color that follows from it. Spacing 9
                   rather than the 12 the left column uses: this is the taller of the two and it is
                   what sets the card against the smallest window, so the gaps here are the cheapest
                   place to find the last few pixels. -->
              <StackPanel Grid.Column="4" Spacing="9">
                <StackPanel Spacing="6">
                  <StackPanel Classes="plabel-row">
                    <TextBlock Text="KIND" Classes="plabel" />
                    <Border Classes="qmark"
                            ToolTip.Tip="How this layer becomes pixels. Custom keeps the picture exactly as it is. Dynamic and Static keep only its lightness and take their color at generation time, which is how one drawing becomes thousands of colorways.">
                      <TextBlock />
                    </Border>
                  </StackPanel>
                  <!-- Custom FIRST here, unlike the New Ingredient wizard. That form starts from
                       nothing and a value-map is the usual answer; this one starts from a picture
                       somebody already drew, where keeping it is. -->
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <RadioButton Grid.Column="0" Classes="choice" GroupName="ImportKind" IsChecked="{Binding IsKindCustom}">
                      <StackPanel>
                        <TextBlock Text="Custom" Classes="ct" />
                        <TextBlock Text="keep the art as&#x2011;is" Classes="csub" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="1" Classes="choice" GroupName="ImportKind" IsChecked="{Binding IsKindDynamic}">
                      <StackPanel>
                        <TextBlock Text="Dynamic" Classes="ct" />
                        <TextBlock Text="color rolled per asset" Classes="csub" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton Grid.Column="2" Classes="choice" GroupName="ImportKind" IsChecked="{Binding IsKindStatic}">
                      <StackPanel>
                        <TextBlock Text="Static" Classes="ct" />
                        <TextBlock Text="one fixed color" Classes="csub" />
                      </StackPanel>
                    </RadioButton>
                  </Grid>
                </StackPanel>

                <!-- Said only when it is true. It sits directly under the KIND cards now rather than
                     last in the stack: in one column it had to go last so nothing was shoved when it
                     appeared, and in this column it is the consequence of the control directly above
                     it, with only the color block below - which the same click reveals anyway. -->
                <TextBlock Classes="m-sub" Margin="0" Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" IsVisible="{Binding LosesColor}"
                           Text="A value-map keeps lightness only — this picture's own colors will be gone. Its color is chosen at generation time." />

                <StackPanel Spacing="8" IsVisible="{Binding ShowColorRange}">
                <!-- THE TWO BANDS SIT SIDE BY SIDE. Stacked, they cost 132px of a card with a hard
                     ceiling - and the height was buying nothing: a range is dragged to a rough band
                     and refined in the editor, and 190px still puts every hue about half a degree
                     apart. It is also the honest shape for them, because they are one decision (the
                     patch of color space this layer rolls from) rather than two. -->
                <Grid ColumnDefinitions="*,14,*">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="HUE" Classes="plabel" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="cv" Text="{Binding HueRangeText}" />
                    </Grid>
                    <Panel Classes="band">
                      <Border Classes="dualtrack" Background="{StaticResource HueSpectrumBrush}" />
                      <Slider Classes="overlay" Value="{Binding HueMin}" Minimum="0" Maximum="360"
                              TickFrequency="1" IsSnapToTickEnabled="True" />
                      <Slider Classes="overlay" Value="{Binding HueMax}" Minimum="0" Maximum="360"
                              TickFrequency="1" IsSnapToTickEnabled="True" />
                    </Panel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Grid.Column="0" Text="SATURATION" Classes="plabel" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="cv" Text="{Binding SatRangeText}" />
                    </Grid>
                    <Panel Classes="band">
                      <Border Classes="dualtrack" Background="{StaticResource SaturationRampBrush}" />
                      <Slider Classes="overlay" Value="{Binding SatMin}" Minimum="0" Maximum="100"
                              TickFrequency="1" IsSnapToTickEnabled="True" />
                      <Slider Classes="overlay" Value="{Binding SatMax}" Minimum="0" Maximum="100"
                              TickFrequency="1" IsSnapToTickEnabled="True" />
                    </Panel>
                  </StackPanel>
                </Grid>
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding ShowFixedColor}">
                  <StackPanel Classes="plabel-row">
                    <TextBlock Text="FIXED COLOR" Classes="plabel" />
                    <Border Classes="qmark"
                            ToolTip.Tip="A prefixed color spec — hex:, rgb:, hsl: or hsv:. A missing prefix is refused rather than guessed at.">
                      <TextBlock />
                    </Border>
                  </StackPanel>
                  <TextBox Text="{Binding FixedColor}" PlaceholderText="hex:d6249f" />
                </StackPanel>
              </StackPanel>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- OUTSIDE THE SCROLLER. A refusal that can be scrolled away from is a disabled button with
           no reason given, which is the thing the Problem line exists to prevent. The body scrolls;
           this and the footer do not - the same split the export dialog's pinned manifest keeps. -->
      <TextBlock Grid.Row="1" Classes="m-sub" Margin="20,0,20,10"
                 Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Text="{Binding Problem}"
                 IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Grid.Row="2" Classes="modal-foot">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Classes="kbd keys"><TextBlock Text="Enter" /></Border><TextBlock Text="import &amp; paint" Classes="keyhint" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Classes="kbd keys"><TextBlock Text="Esc" /></Border><TextBlock Text="cancel" Classes="keyhint" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="tbtn ghost" />
            <Button Command="{Binding CreateCommand}" Classes="accent">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="ico sm" Data="{StaticResource IconCheck}" />
                <TextBlock Text="Import &amp; paint" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
