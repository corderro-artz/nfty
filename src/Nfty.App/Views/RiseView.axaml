<!-- RenderOptions.BitmapInterpolationMode=None on the root: pixel art scales with nearest neighbour,
     never a filter. It inherits to every Image below, and PixelPerfectRenderingTests fails naming any
     view that drops it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:svc="using:Nfty.App.Services"
             xmlns:ctl="using:Nfty.App.Controls"
             xmlns:conv="using:Nfty.App.Converters"
             xmlns:rise="using:Nfty.App.Rise"
             xmlns:views="using:Nfty.App.Views"
             x:Class="Nfty.App.Views.RiseView"
             x:Name="Root"
             x:DataType="vm:RiseViewModel"
             RenderOptions.BitmapInterpolationMode="None"
             Focusable="True" IsTabStop="False">
  <!-- Only a key routed through this control reaches these, hence the focus-on-attach in code-behind. -->
  <UserControl.KeyBindings>
    <!-- Escape, PageUp and PageDown are NOT here: a KeyBinding on the view fires while a number field
         has focus (a TextBox does not handle them), so typing in Front, Back or the brush box would
         drop or move the target. They live in OnShortcut, behind the focus guard. -->

    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </UserControl.KeyBindings>
  <!-- The Rise page: a source rail, the depth canvas with its 3D tile, and a depth / export rail,
       full-bleed and divided by 1px rules like the Ingredient editor's three panes. Every pane opens
       with the same 41px header, and the footer is the editor's.

       GEOMETRY IS FIXED. Anything that comes and goes with the source or the selection (the Save
       button, the SHAPE section, the "2D" flags, the read-only pill) keeps its box and only changes
       its ink; see Styles.axaml's .inkslot. The few IsVisible switches here are all constant for the
       life of the page (which rail, the pill, the die) or the recorded positional exception (the
       2D ONLY section, last in its rail). -->
  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="262,*,300">

      <!-- ============ SOURCE rail ============ -->
      <Border Grid.Column="0" Classes="pane">
        <Grid x:Name="SourceGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">
          <Border Grid.Row="0" Classes="pane-hrow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Source.Kicker}" Classes="pane-h"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Classes="hcount" Text="{Binding Items.Count}" />
            </Grid>
          </Border>

          <!-- What the source is, in facts; and the warning that none of it can rise. -->
          <Border Grid.Row="1" Padding="12,10,12,2">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Border Classes="idchip" Margin="0,0,6,6">
                      <TextBlock Classes="ck" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="idchip warn" Margin="0,0,0,6" HorizontalAlignment="Left"
                      IsVisible="{Binding BookIsTwoDOnly}"
                      ToolTip.Tip="This book has art with partial alpha, which cannot rise: a voxel is solid or empty.">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path Classes="ico xs" Data="{StaticResource Icon2dOnly}" />
                  <TextBlock Classes="ck" Text="2D only" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- THE GRID ROW: how a picture is cut into cells, for the two sources that are a loose PNG.
               Detection can be wrong on a sheet somebody else drew, so the cut can be typed: by
               finding it again, by columns and rows, or by a cell's size. The row is laid out for the
               life of the page or not at all (a picture becomes a sheet by being given a grid), and
               the problem line under it has its two lines reserved, so a typo never moves the list. -->
          <Border Grid.Row="2" Padding="12,2,12,0" IsVisible="{Binding HasGridRow}">
            <StackPanel Spacing="6">
              <Border Classes="seg mini" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="Auto,2,Auto,2,Auto">
                  <Button Grid.Column="0" Classes="seg-b mini" Content="Auto"
                          Classes.on="{Binding GridIsAuto}"
                          Command="{Binding SetGridModeCommand}" CommandParameter="{x:Static vm:GridMode.Auto}"
                          ToolTip.Tip="Find the cells by the transparent gutters between them" />
                  <Button Grid.Column="2" Classes="seg-b mini" Content="Columns × rows"
                          Classes.on="{Binding GridIsColumnsRows}"
                          Command="{Binding SetGridModeCommand}" CommandParameter="{x:Static vm:GridMode.ColumnsRows}"
                          ToolTip.Tip="Say how many columns and rows the sheet has" />
                  <Button Grid.Column="4" Classes="seg-b mini" Content="Cell size"
                          Classes.on="{Binding GridIsCellSize}"
                          Command="{Binding SetGridModeCommand}" CommandParameter="{x:Static vm:GridMode.CellSize}"
                          ToolTip.Tip="Say how many pixels one cell is across and down" />
                </Grid>
              </Border>
              <Grid ColumnDefinitions="62,Auto,62,*,Auto" ColumnSpacing="6" Height="26">
                <NumericUpDown Grid.Column="0" Classes="nin" Width="62" Minimum="1" Maximum="16384"
                               FormatString="0" Value="{Binding GridA}" IsEnabled="{Binding GridNumbersEnabled}"
                               ToolTip.Tip="Columns, or one cell's width in pixels" />
                <TextBlock Grid.Column="1" Classes="seglbl" Text="×" />
                <NumericUpDown Grid.Column="2" Classes="nin" Width="62" Minimum="1" Maximum="16384"
                               FormatString="0" Value="{Binding GridB}" IsEnabled="{Binding GridNumbersEnabled}"
                               ToolTip.Tip="Rows, or one cell's height in pixels" />
                <Button Grid.Column="4" Classes="tbtn cellbtn" Content="Apply"
                        Command="{Binding ApplyGridCommand}"
                        ToolTip.Tip="Cut the picture this way and record the grid in the file" />
              </Grid>
              <TextBlock Classes="caveat" Height="28" FontSize="10.5" MaxLines="2" TextTrimming="CharacterEllipsis"
                         Text="{Binding GridProblem}" />
            </StackPanel>
          </Border>

          <!-- THE LIST. Three templates, exactly one visible, and the variant and tile rails are
               virtualizing ListBoxes: a Set can hold ten thousand assets and a row's thumbnail is
               decoded the first time a view reads it, so a row that is never realized never decodes.
               ListBox.tiles neutralizes every state Fluent paints on a ListBoxItem - the unit here
               is a ROW, which nobody selects, and the app's own marks sit on top of whatever Fluent
               would add. -->
          <Panel Grid.Row="3">
            <!-- VARIANTS: one card per variant; the card selects, the box ticks. -->
            <ListBox Classes="tiles" Background="Transparent" Padding="12,12,12,5"
                     ItemsSource="{Binding Items}" IsVisible="{Binding IsVariantRail}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="rise:RiseItem">
                  <Panel Margin="0,0,0,7">
                    <Button Classes="vcard" Classes.sel="{Binding IsSelected}"
                            Command="{Binding $parent[ListBox].((vm:RiseViewModel)DataContext).SelectItemCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="24,40,*,Auto" ColumnSpacing="8">
                        <Border Grid.Column="1" Classes="rthumb" Width="40" Height="40">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Caption}" Classes="rmeta" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="3" Classes="idchip dchip inkslot"
                                Classes.on="{Binding IsChipShown}" Classes.warn="{Binding IsChipWarning}">
                          <TextBlock Classes="ck" Text="{Binding DepthChip}"
                                     HorizontalAlignment="Center" TextAlignment="Center" />
                        </Border>
                      </Grid>
                    </Button>
                    <ToggleButton Classes="cbxtog" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="6,0,0,0" IsChecked="{Binding IsChecked}"
                                  ToolTip.Tip="Include in the batch export">
                      <Border Classes="cbx" Classes.on="{Binding IsChecked}">
                        <Path Classes="ico xs" Data="{StaticResource IconCheck}" />
                      </Border>
                    </ToggleButton>
                  </Panel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- RECIPE: the layers of one roll, bottom first. On a page that writes through, a row is
                 the way to choose the layer being painted (click, or Enter on it); the chosen row wears
                 the variant card's selected mark. A row that cannot be chosen (left out of this roll, or
                 a read-only page) takes no pointer and no focus, rather than being disabled: a dimmed
                 row would be a second reason to read it as broken. -->
            <ScrollViewer x:Name="LayersScroll" IsVisible="{Binding IsRecipeRail}" VerticalAlignment="Top"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl Margin="12,12,12,5" ItemsSource="{Binding LayerRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="rise:RiseLayerRow">
                    <Button Classes="vcard" Classes.sel="{Binding IsTarget}" Margin="0,0,0,7" Padding="8,7"
                            IsHitTestVisible="{Binding IsPickable}" Focusable="{Binding IsPickable}"
                            Command="{Binding $parent[ItemsControl].((vm:RiseViewModel)DataContext).TargetLayerCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="18,32,*,13" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Classes="dpt" Width="18" Text="{Binding Depth}" />
                        <Border Grid.Column="1" Classes="rthumb" Width="32" Height="32">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Classes="vname" Text="{Binding Name}" />
                          <TextBlock Classes="rmeta" Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Classes="kmark" Text="{Binding KindMark}"
                                   Classes.kdyn="{Binding IsDynamic}" Classes.kstat="{Binding IsStatic}"
                                   Classes.kcust="{Binding IsCustom}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- SET: tiles, three to a row. The ListBox's unit is the ROW (it virtualizes one element
                 per item), so the items are chunked by RiseTileRowConverter and each row is a run of
                 three; see RowChunkConverter for why a grid is built this way in Avalonia. -->
            <ListBox x:Name="TileList" Classes="tiles" Background="Transparent" Padding="6,8,6,5"
                     VerticalAlignment="Top"
                     ItemsSource="{Binding Items, Converter={x:Static conv:RiseTileRowConverter.Instance}}"
                     IsVisible="{Binding IsTileRail}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="conv:RiseTileRow">
                  <ItemsControl ItemsSource="{Binding Tiles}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="0" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="rise:RiseItem">
                        <Panel Width="82">
                          <Button Classes="ghost tcell" Padding="4" Margin="2" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  Command="{Binding $parent[ListBox].((vm:RiseViewModel)DataContext).SelectItemCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                              <Border Classes="tile" Classes.sel="{Binding IsSelected}" Width="66" Height="66"
                                      ClipToBounds="True">
                                <Panel>
                                  <Border Classes="tload"
                                          IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Panel>
                              </Border>
                              <TextBlock Classes="mono tcap" FontSize="10.5" HorizontalAlignment="Center"
                                         Classes.accent="{Binding IsSelected}" Text="{Binding Name}" />
                            </StackPanel>
                          </Button>
                          <!-- A source that cannot batch (one loose picture) has nothing to tick: the box
                               keeps its place and loses its ink, so the tile does not change shape. -->
                          <ToggleButton Classes="cbxtog inkslot" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Classes.on="{Binding $parent[ListBox].((vm:RiseViewModel)DataContext).Source.CanBatch}"
                                        Margin="5,5,0,0" IsChecked="{Binding IsChecked}"
                                        ToolTip.Tip="Include in the batch export">
                            <Border Classes="cbx" Classes.on="{Binding IsChecked}">
                              <Path Classes="ico xs" Data="{StaticResource IconCheck}" />
                            </Border>
                          </ToggleButton>
                          <Border Classes="twodflag inkslot" Classes.on="{Binding IsChipWarning}"
                                  IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,8,9,0">
                            <TextBlock Text="2D" />
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>

          <!-- THE RAIL FOOT: exactly 47 in every source (the editor footer's own band), so the list
               above it is one height whatever the page is showing. A source that exports shows what
               is ticked and the way to tick it all; one that does not says why. -->
          <Border Grid.Row="4" Classes="modal-foot" Height="47" CornerRadius="0" Padding="12,8">
            <Panel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Source.CanBatch}">
                <TextBlock Grid.Column="0" Classes="smallmono" TextTrimming="CharacterEllipsis"
                           Text="{Binding CheckedSummary}" />
                <Button Grid.Column="1" Classes="tbtn" Padding="9,0" Content="{Binding CheckAllLabel}"
                        Command="{Binding ToggleCheckAllCommand}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                          IsVisible="{Binding !Source.CanBatch}">
                <Path Classes="ico xs inkslot" Classes.on="{Binding Source.RailFootIsLock}" Data="{StaticResource IconLock}" />
                <TextBlock Classes="vlock" Text="{Binding Source.RailFootNote}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Panel>
          </Border>
        </Grid>
      </Border>

      <!-- ============ CANVAS ============ -->
      <Border Grid.Column="1" Classes="pane">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- The toolstrip wraps by GROUP, as the editor's does (StripPanel). Five tools, the brush
               size, history, the die when the source rolls, and the mouse map. -->
          <Border Grid.Row="0" Classes="pane-hrow toolstrip">
            <ctl:StripPanel Spacing="14" LineSpacing="6" VerticalAlignment="Center">
              <!-- The tools mean nothing on a page that cannot paint (a roll, a cooked Set, a picture
                   with partial alpha), so they are disabled there - and a disabled ARMED tool is drawn
                   neutral, not as a red tool waiting to be used (Button.ttool.on:disabled). A LOCKED
                   book still paints, as a scratch surface, so it keeps them live. -->
              <StackPanel Orientation="Horizontal" Spacing="3" IsEnabled="{Binding IsPaintable}">
                <Button Classes="ttool" Classes.on="{Binding IsToolBrush}" ToolTip.Tip="{x:Static svc:KeyHints.RiseBrushTool}"
                        Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Brush}">
                  <Path Classes="ico sm" Data="{StaticResource IconPencil}" /></Button>
                <Button Classes="ttool" Classes.on="{Binding IsToolLine}" ToolTip.Tip="{x:Static svc:KeyHints.RiseLineTool}"
                        Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Line}">
                  <Path Classes="ico sm" Data="{StaticResource IconLine}" /></Button>
                <Button Classes="ttool" Classes.on="{Binding IsToolRectangle}" ToolTip.Tip="{x:Static svc:KeyHints.RiseRectangleTool}"
                        Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Rectangle}">
                  <Path Classes="ico sm" Data="{StaticResource IconRect}" /></Button>
                <Button Classes="ttool" Classes.on="{Binding IsToolFill}" ToolTip.Tip="{x:Static svc:KeyHints.RiseFillTool}"
                        Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Fill}">
                  <Path Classes="ico sm" Data="{StaticResource IconFill}" /></Button>
                <Button Classes="ttool" Classes.on="{Binding IsToolSelect}" ToolTip.Tip="{x:Static svc:KeyHints.RiseSelectTool}"
                        Command="{Binding SelectToolCommand}" CommandParameter="{x:Static vm:EditorTool.Select}">
                  <Path Classes="ico sm" Data="{StaticResource IconSelect}" /></Button>
              </StackPanel>

              <NumericUpDown Classes="nin" Value="{Binding BrushSize}" Minimum="1" Maximum="{Binding BrushSizeMax}"
                             Width="46" FormatString="0" ShowButtonSpinner="False" IsEnabled="{Binding IsPaintable}"
                             ToolTip.Tip="{x:Static svc:KeyHints.BrushSizeField}" />

              <StackPanel Orientation="Horizontal" Spacing="3">
                <Button Classes="ttool" Command="{Binding UndoCommand}" ToolTip.Tip="{x:Static svc:KeyHints.UndoTool}">
                  <Path Classes="ico sm" Data="{StaticResource IconUndo}" /></Button>
                <Button Classes="ttool" Command="{Binding RedoCommand}" ToolTip.Tip="{x:Static svc:KeyHints.RedoTool}">
                  <Path Classes="ico sm" Data="{StaticResource IconRedo}" /></Button>
              </StackPanel>

              <!-- The die: a recipe source rolls, nothing else does. Constant for the page's life. -->
              <Button Classes="sampleroll" Command="{Binding RerollCommand}" IsVisible="{Binding HasDie}"
                      ToolTip.Tip="Roll another sample of this recipe. The picture is ONE roll, not a stored asset.">
                <Panel Classes="dieroll">
                  <Path Classes="ico ti" Data="{Binding DieFace, Converter={x:Static conv:DieFaceConverter.Instance}}" />
                  <Path Classes="ico ti pip1" Data="{Binding DieFace, Converter={x:Static conv:DieFaceConverter.AccentPip}}" />
                </Panel>
              </Button>

              <!-- The mouse map. Only a source that can be painted has one to print; constant per page. -->
              <Panel IsVisible="{Binding Source.IsEditable}">
                <TextBlock Classes="smallmono" Text="{x:Static svc:KeyHints.RiseLegend}"
                           Opacity="{Binding PaintLegendOpacity}"
                           IsHitTestVisible="{Binding !IsPicking}"
                           ToolTip.Tip="{x:Static svc:KeyHints.RiseLegendTip}" />
                <TextBlock Classes="smallmono" Text="{x:Static svc:KeyHints.RiseLegendPicking}"
                           Opacity="{Binding PickLegendOpacity}"
                           IsHitTestVisible="{Binding IsPicking}"
                           ToolTip.Tip="{x:Static svc:KeyHints.RiseLegendPickingTip}" />
              </Panel>
            </ctl:StripPanel>
          </Border>

          <!-- The canvas, built exactly as the editor's: a fixed 320px host in the middle of a
               backdrop that is drawn in code-behind as a lattice of the art's OWN pixels. -->
          <Panel Grid.Row="1" x:Name="CanvasBackdrop">
            <Border x:Name="CanvasHost" Width="320" Height="320" CornerRadius="10"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    BoxShadow="{DynamicResource WinShadow}" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- The pointer talks to this untransformed panel, never to the image (which carries the
                   zoom as a render transform). Background="Transparent" so it hit-tests at all. -->
              <Panel x:Name="CanvasSurface" Background="Transparent">
                <!-- The layers around the one being painted, dimmed: under it, then it, then over it.
                     All three carry the same zoom and pan (RiseView.axaml.cs). Absent without a target. -->
                <Image x:Name="BelowImage" Classes="dimlayer" Source="{Binding BelowCanvas}" Stretch="Uniform"
                       IsVisible="{Binding ShowPaintCanvas}" />
                <Image x:Name="CanvasImage" Source="{Binding Canvas}" Stretch="Uniform"
                       IsVisible="{Binding ShowPaintCanvas}" />
                <Image x:Name="AboveImage" Classes="dimlayer" Source="{Binding AboveCanvas}" Stretch="Uniform"
                       IsVisible="{Binding ShowPaintCanvas}" />
                <!-- The thickness of each solid pixel, once a cell is big enough to hold a number. -->
                <ctl:DepthLabelLayer x:Name="DepthLabels" IsHitTestVisible="False"
                                     IsVisible="{Binding ShowPaintCanvas}" />
                <Canvas x:Name="CanvasOverlay" IsHitTestVisible="False" IsVisible="{Binding ShowPaintCanvas}" />
              </Panel>
            </Border>

            <!-- WHERE THE 3D VIEW LIVES WHEN IT HAS TAKEN THE PANE. Empty otherwise, and a Border
                 with no background is not hit-testable, so the canvas under it keeps the pointer. -->
            <Border x:Name="BigHost" />

            <!-- The same ink at the size of the pane, for a 2D-only picture while the 3D view has the
                 big slot. An overlay in a Panel cell occupies no layout, so IsVisible moves nothing. -->
            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="PreviewSwapped" />
                  <Binding Path="ShowTwoDOnly" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Path Classes="ico ti" Data="{StaticResource Icon2dOnly}" Stroke="{DynamicResource WarningBrush}"
                    HorizontalAlignment="Center" />
              <TextBlock Classes="twodink" FontSize="14" Text="2D only" />
              <TextBlock Classes="twodnote" FontSize="11" Text="partial alpha cannot rise" />
            </StackPanel>

            <!-- Read-only pill, top centre. Constant per page: a source is read-only or it is not. -->
            <Border Classes="idchip" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                    IsVisible="{Binding ShowReadOnlyPill}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="ico xs" Data="{StaticResource IconLock}" />
                <TextBlock Classes="ck" Text="{Binding ReadOnlyPill}" />
              </StackPanel>
            </Border>

            <!-- WHICH LAYER, AND HOW FAR IT REACHES. Where the read-only pill sits: a page is one or the
                 other (the pill is for pages that cannot be painted), so they never meet. Text trims
                 rather than the chip growing past a narrow pane. -->
            <Border x:Name="TargetChip" Classes="idchip" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,12,12,0"
                    IsVisible="{Binding ShowTargetHeader}" ToolTip.Tip="{Binding TargetHeaderTip}">
              <TextBlock Classes="ck" Text="{Binding TargetHeader}" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- The editor's own grid chip, verbatim. -->
            <Border x:Name="GridChip" Classes="gridchip" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="26,0,0,26">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="ttool" Classes.on="{Binding ShowPixelGrid}"
                        Command="{Binding ToggleGridCommand}" ToolTip.Tip="{Binding GridToggleTip}">
                  <Path Classes="ico sm" Data="{StaticResource IconGrid}" />
                </Button>
                <NumericUpDown Classes="nin" Value="{Binding GridSize}" Minimum="1"
                               Maximum="{Binding GridSizeMax}" Width="58" FormatString="0"
                               ShowButtonSpinner="False" IsEnabled="{Binding ShowPixelGrid}"
                               ToolTip.Tip="How many canvas pixels one grid square covers. 1 is a true pixel grid; raise it on a large canvas, where one square per pixel is finer than the screen can draw." />
                <Border Classes="tsep" />
                <Button Classes="zchip" Classes.on="{Binding IsZoomed}"
                        Command="{Binding ZoomToFitCommand}"
                        Content="{Binding ZoomText}" ToolTip.Tip="{Binding ZoomTip}" />
              </StackPanel>
            </Border>

            <!-- THE MODEL TILE. Always present, the way the editor's blip is, so the swap is a toggle
                 and not a one-way door: the small tile shows whichever of the pair the big slot is
                 NOT, so the caption names something that is on screen exactly once. The ONE
                 ModelPreviewView lives in TileHost by default and is MOVED to BigHost (never
                 duplicated) when the two trade places; RiseView.axaml.cs does the moving. -->
            <Border x:Name="ModelTile" Width="{Binding TileSize}" Height="{Binding TileSize}"
                    CornerRadius="10" ClipToBounds="True"
                    BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                    Background="{DynamicResource TileBrush}" BoxShadow="{DynamicResource WinShadow}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,26,26">
              <Panel>
                <Border x:Name="TileHost">
                  <views:ModelPreviewView x:Name="ModelView" DataContext="{Binding Preview}"
                                          Mesh="{Binding #Root.((vm:RiseViewModel)DataContext).Mesh}"
                                          Texture="{Binding #Root.((vm:RiseViewModel)DataContext).Texture}" />
                </Border>
                <Image Source="{Binding Canvas}" Stretch="Uniform" IsVisible="{Binding PreviewSwapped}" />
                <!-- A picture with partial alpha cannot rise: say so over the empty tile. An overlay in a Panel cell
                     occupies no layout, so showing it moves nothing; the big slot says the same when the 3D
                     view has traded places with the canvas. -->
                <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="3" Margin="8,0">
                  <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="!PreviewSwapped" />
                      <Binding Path="ShowTwoDOnly" />
                    </MultiBinding>
                  </StackPanel.IsVisible>
                  <Path Classes="ico sm" Data="{StaticResource Icon2dOnly}" Stroke="{DynamicResource WarningBrush}"
                        HorizontalAlignment="Center" />
                  <TextBlock Classes="twodink" Text="2D only" />
                  <TextBlock Classes="twodnote" Text="partial alpha cannot rise" />
                </StackPanel>
                <Border Classes="tilecap">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Path Classes="ico xs" Data="{StaticResource IconRise}" />
                      <TextBlock Text="{Binding TileCaption}" Classes="plabel tilecap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="icon" Padding="2" Classes.unlocked="{Binding PreviewEnlarged}"
                            Command="{Binding EnlargePreviewCommand}" ToolTip.Tip="{Binding EnlargeTip}">
                      <Path Classes="ico xs" Data="{StaticResource IconEnlarge}" /></Button>
                    <Button Grid.Column="2" Classes="icon" Padding="2" Classes.unlocked="{Binding PreviewSwapped}"
                            Command="{Binding SwapPreviewCommand}" ToolTip.Tip="{Binding SwapTip}">
                      <Path Classes="ico xs" Data="{StaticResource IconFillPane}" /></Button>
                    <Button Grid.Column="3" Classes="icon" Padding="2"
                            Command="{Binding PopOutCommand}" ToolTip.Tip="{x:Static svc:KeyHints.PopOut}">
                      <Path Classes="ico xs" Data="{StaticResource IconPopout}" /></Button>
                  </Grid>
                </Border>
              </Panel>
            </Border>
          </Panel>

          <!-- The readout: one line, reserved, so hovering a pixel moves nothing. -->
          <Border Grid.Row="2" Classes="readout">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="readtxt" Text="{Binding ReadoutText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Classes="readtxt" Text="{Binding DimensionsText}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ============ DEPTH / EXPORT rail ============ -->
      <Border Grid.Column="2" Classes="pane last">
        <Grid x:Name="RailGrid" RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Classes="pane-hrow tabrow">
            <StackPanel Orientation="Horizontal" Spacing="18">
              <Button Classes="railtab" Classes.on="{Binding IsDepthTab}"
                      Command="{Binding ShowDepthTabCommand}" Content="DEPTH" />
              <Button Classes="railtab" Classes.on="{Binding IsExportTab}"
                      Command="{Binding ShowExportTabCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="EXPORT" VerticalAlignment="Center" />
                  <Border Classes="tabcount">
                    <TextBlock Text="{Binding ExportBadge}" />
                  </Border>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <ScrollViewer x:Name="RailScroll" Grid.Row="1" VerticalAlignment="Top" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RailBody" Margin="13,13,13,16" Spacing="15">

              <!-- ==================== DEPTH ==================== -->
              <StackPanel x:Name="DepthStack" Spacing="15" IsVisible="{Binding IsDepthTab}">
                <!-- FILL ALL: one depth for every solid pixel, as one undo step. -->
                <StackPanel Spacing="8">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="FILL ALL" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding SolidHeader}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="7">
                    <TextBlock Grid.Column="0" Text="Front" Classes="cshare" TextAlignment="Left" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Classes="nin" MinWidth="0" Width="58" HorizontalAlignment="Left"
                                   Value="{Binding FillFront}" Minimum="0" Maximum="255" FormatString="0" />
                    <TextBlock Grid.Column="2" Text="Back" Classes="cshare" TextAlignment="Left" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="3" Classes="nin" MinWidth="0" Width="58" HorizontalAlignment="Left"
                                   Value="{Binding FillBack}" Minimum="0" Maximum="255" FormatString="0" />
                  </Grid>
                  <Button Classes="tbtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Content="{Binding FillAllLabel}" Command="{Binding FillAllCommand}" />
                </StackPanel>

                <!-- THICKNESS: how many pixels are how many voxels thick. -->
                <StackPanel Spacing="8">
                  <Grid Classes="ctlh" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="THICKNESS" Classes="plabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding DeepestText}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Thickness}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ThicknessRow">
                        <Grid ColumnDefinitions="62,*,44" ColumnSpacing="8" Height="20">
                          <TextBlock Grid.Column="0" Classes="rhint" Text="{Binding Label}" />
                          <Border Grid.Column="1" Classes="thtrack" x:Name="ThTrack">
                            <Border Height="7">
                              <Border.Width>
                                <MultiBinding Converter="{x:Static conv:ShareWidthConverter.FractionInstance}">
                                  <Binding Path="Share" />
                                  <Binding ElementName="ThTrack" Path="Bounds.Width" />
                                </MultiBinding>
                              </Border.Width>
                            </Border>
                          </Border>
                          <TextBlock Grid.Column="2" Classes="rhint" HorizontalAlignment="Right" TextAlignment="Right"
                                     Text="{Binding CountText}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- What the depth means, and where it comes from. -->
                <Panel>
                  <Rectangle Classes="dashed btn" />
                  <TextBlock Classes="vlock" Margin="10,9" Text="{Binding DepthNote}" />
                </Panel>

                <!-- 2D ONLY: LAST in the rail, the recorded positional exception - nothing sits below
                     it to be shoved when it appears. -->
                <StackPanel Spacing="8" IsVisible="{Binding HasPartialAlphaRows}">
                  <Grid Classes="ctlh" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                    <Path Grid.Column="0" Classes="ico xs" Data="{StaticResource Icon2dOnly}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="2D ONLY" Classes="plabel" VerticalAlignment="Center" />
                    <!-- MAKE VOXEL-READY. Always laid out, inked when the source can snap its own art (a
                         layer or a picture); a recipe or a Set keeps the box and says where the fix lives
                         at the foot of the rail. Disabled, its reason is already on the page (the footer
                         says unsaved depth, the depth note says read-only) and its tooltip says it again. -->
                    <!-- The ink slot is the panel round it, not the button: a disabled button dims
                         itself, and an ink class on the button would hold it at full strength. -->
                    <Panel Grid.Column="2" Classes="inkslot" Classes.on="{Binding ShowVoxelReadyButton}">
                      <Button Classes="tbtn cellbtn" Content="Make voxel-ready…"
                              Command="{Binding MakeVoxelReadyCommand}"
                              ToolTip.Tip="{Binding VoxelReadyTip}" ToolTip.ShowOnDisabled="True" />
                    </Panel>
                    <TextBlock Grid.Column="3" Classes="cv twodcount" Text="{Binding PartialAlphaCountText}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding PartialAlphaRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="rise:PartialAlphaRow">
                        <Border Classes="twodrow" Margin="0,0,0,4">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Classes="vname" Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Classes="twodcount" Text="{Binding CountText}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="vlock" Text="{Binding TwoDOnlyFootnote}" />
                </StackPanel>

                <!-- MAKE VOXEL-READY, second half: what is left once the button has been used (the undo
                     line) or never could be (a recipe or a Set only list the problem, and say where the
                     fix lives). LAST in the rail, the recorded positional exception, so its arrival
                     shoves nothing; it appears where the 2D ONLY rows have just gone, so the rail only
                     ever gets shorter. The button itself sits in the 2D ONLY header (above), where it
                     costs no height: the rail is within a few pixels of the smallest window's height
                     with a painted layer and two listed pictures, and a row of its own did not fit. -->
                <Panel x:Name="VoxelSlot" IsVisible="{Binding HasVoxelReadySlot}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowVoxelReadyUndo}">
                    <TextBlock Grid.Column="0" Classes="vlock" VerticalAlignment="Center"
                               Text="{Binding VoxelReadyNote}" />
                    <Button Grid.Column="1" Classes="tbtn cellbtn" Content="Undo"
                            Command="{Binding UndoVoxelReadyCommand}" ToolTip.Tip="{Binding VoxelReadyTip}"
                            ToolTip.ShowOnDisabled="True" />
                  </Grid>
                  <TextBlock Classes="vlock" IsVisible="{Binding ShowVoxelReadyHint}"
                             Text="{Binding VoxelReadyHint}" />
                </Panel>
              </StackPanel>

              <!-- ==================== EXPORT ==================== -->
              <StackPanel x:Name="ExportStack" Spacing="12" IsVisible="{Binding IsExportTab}">
                <StackPanel Spacing="5">
                  <TextBlock Text="FORMAT" Classes="plabel" Margin="0" />
                  <ItemsControl ItemsSource="{Binding FormatCards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:FormatCard">
                        <Button Classes="preset tight" Classes.sel="{Binding IsSelected}" Margin="0,0,0,2"
                                ToolTip.Tip="{Binding Summary}"
                                Command="{Binding $parent[ItemsControl].((vm:RiseViewModel)DataContext).PickFormatCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel Spacing="0">
                            <TextBlock Classes="pn" Text="{Binding Title}" />
                            <TextBlock Classes="pd" Text="{Binding Summary}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="2">
                  <TextBlock Text="PIVOT" Classes="plabel" Margin="0,0,0,2" />
                  <RadioButton Classes="rchoice" GroupName="pivot" IsChecked="{Binding IsPivotBottomCenter}">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Bottom center" />
                      <TextBlock Grid.Column="1" Classes="rhint" Text="feet on the floor" /></Grid>
                  </RadioButton>
                  <RadioButton Classes="rchoice" GroupName="pivot" IsChecked="{Binding IsPivotCenter}">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Center" />
                      <TextBlock Grid.Column="1" Classes="rhint" Text="middle of the box" /></Grid>
                  </RadioButton>
                  <RadioButton Classes="rchoice" GroupName="pivot" IsChecked="{Binding IsPivotMinCorner}">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Min corner" />
                      <TextBlock Grid.Column="1" Classes="rhint" Text="the box's origin" /></Grid>
                  </RadioButton>
                </StackPanel>

                <StackPanel Spacing="7">
                  <TextBlock Text="VOXEL SIZE" Classes="plabel" Margin="0" />
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <NumericUpDown Grid.Column="0" Classes="qnt" Width="94" Value="{Binding VoxelSize}"
                                   Minimum="0.01" Increment="0.25" FormatString="0.##"
                                   ToolTip.Tip="World units per pixel: how big one voxel is in the exported model." />
                    <TextBlock Grid.Column="1" Classes="cv" Text="{Binding ModelDimensionsText}" />
                  </Grid>
                </StackPanel>

                <!-- SHAPE only means anything for a batch, and it is ALWAYS laid out: it is inked when
                     two or more models are going, so ticking a second row moves nothing. -->
                <StackPanel Spacing="5" Classes="inkslot" Classes.on="{Binding IsBatch}">
                  <TextBlock Text="SHAPE" Classes="plabel" Margin="0,0,0,2" />
                  <RadioButton Classes="rchoice" GroupName="shape" IsChecked="{Binding IsPackedShape}">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Single file" />
                      <TextBlock Grid.Column="1" Classes="rhint" Text=".zip" /></Grid>
                  </RadioButton>
                  <RadioButton Classes="rchoice" GroupName="shape" IsChecked="{Binding IsFolderShape}">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Folder" />
                      <TextBlock Grid.Column="1" Classes="rhint" Text="one file per model" /></Grid>
                  </RadioButton>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- THE MANIFEST AND THE EXPORT BUTTON, pinned below the scroller on the EXPORT tab: what
               is going, and the one control that sends it - two things the reader must never have to
               scroll to. Bottom-anchored, so the button stays where it is whatever the manifest
               above it says. -->
          <StackPanel Grid.Row="2" Spacing="9" Margin="13,0,13,13" IsVisible="{Binding IsExportTab}">
            <Border Classes="ship" MinHeight="64" Padding="14,8,12,8">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Classes="fn" Text="{Binding ManifestTitle}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="part" Text="{Binding ManifestSize}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ManifestParts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="part" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" Text="{Binding}"
                                 ToolTip.Tip="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="caveat" Text="{Binding ExportProblem}" />
              </StackPanel>
            </Border>
            <Button Classes="accent quiet" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding ExportCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="ico sm" Data="{StaticResource IconDownload}" />
                <TextBlock Text="{Binding ExportLabel}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer: what Save would do (or why it will not), and the way out. -->
    <Border Grid.Row="1" Classes="modal-foot">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Classes="cshare" TextAlignment="Left" TextTrimming="CharacterEllipsis"
                   Text="{Binding FooterText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Back" Command="{Binding BackCommand}" Classes="tbtn ghost" />
          <!-- Always laid out: a source that cannot save keeps the button's box and loses its ink,
               so the footer is the same footer for every source. -->
          <Panel Classes="inkslot" Classes.on="{Binding ShowSave}">
            <Button Command="{Binding SaveCommand}" Classes="accent">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="ico sm" Data="{StaticResource IconCheck}" />
                <TextBlock Text="{Binding Source.SaveLabel}" />
              </StackPanel>
            </Button>
          </Panel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
