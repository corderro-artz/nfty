<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.ColorSaveDialogView"
             x:DataType="vm:ColorSaveDialogViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </UserControl.KeyBindings>
  <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="24" MaxWidth="470"
          BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1">
    <StackPanel Spacing="10">
      <TextBlock Text="Save as a Custom ingredient?" FontWeight="Bold"
                 Foreground="{DynamicResource AccentTextBrush}" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />

      <!-- The destructive option is opt-in and carries its cost inline, not in a tooltip: the
           colorization it discards cannot be rebuilt from anything left on disk. Dashed edge via a
           Rectangle, not the Border's own stroke — Avalonia's Border draws solid only. -->
      <Panel Margin="0,2,0,0">
        <Rectangle Classes="dashed btn" />
        <CheckBox IsChecked="{Binding Overwrite}" VerticalAlignment="Top" Margin="11,10">
          <TextBlock Text="{Binding OverwriteWarning}" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningBrush}" />
        </CheckBox>
      </Panel>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="ghost" />
        <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Classes="accent" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
