<!-- RenderOptions.BitmapInterpolationMode=None on the root: pixel art scales with nearest
     neighbour, never a filter. It inherits to every Image below. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             x:Class="Nfty.App.Views.CommunityView"
             x:DataType="vm:CommunityViewModel"
             RenderOptions.BitmapInterpolationMode="None"
             Focusable="True" IsTabStop="False">
  <!-- The Community page: a header (Back, title, search, sort, Refresh), the TAG ROW, then a PAGED
       grid of fixed-size tiles over the pager band (which also carries the status line), beside a
       288px rail.

       The grid pages and never scrolls: how many tiles a page holds is measured from the host the
       Grid gives it, divided by the tile pitch TOKENS (CommunityView.axaml.cs). The host is a
       ScrollViewer with both bars off for the CookBook card's reason - it reports the room it was
       GIVEN, so the tiles cannot grow the thing measured to decide how many fit.

       The page takes focus on arrival (Focusable, not a tab stop) so its keys are live: they are all
       on one focus-guarded handler in the code-behind, the editor's and viewer's pattern. -->
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,288">

    <!-- Header. Back and the title left; search, sort and Refresh right, every one a stated width so
         nothing moves. The tags used to share this line as a seg tray of 72px buttons, which truncated
         every tag name and pushed the rest into a dropdown of bare buttons; they have a row of their own
         now (below), which is also what gave Back its room. -->
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="12"
          Height="36">
      <Button Grid.Column="0" x:Name="BackButton" Classes="tbtn ghost" Command="{Binding BackCommand}"
              VerticalAlignment="Center" ToolTip.Tip="Back to the start screen  ·  Esc">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="ico sm" Data="{StaticResource IconArrowLeft}" />
          <TextBlock Text="Back" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <Path Classes="ico ti ctitle" Data="{StaticResource IconCommunity}" />
        <TextBlock Classes="mono" FontSize="17" FontWeight="Bold" Text="Community" VerticalAlignment="Center" />
      </StackPanel>

      <Border Grid.Column="3" Classes="search" Width="240" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconSearch}" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding Query}" Classes="bare" Margin="8,0,6,0"
                   VerticalAlignment="Center" PlaceholderText="#tag, @user or a name"
                   ToolTip.Tip="Search by #tag, @user or a name. Terms combine: #props @alice chest finds alice's chests tagged props." />
          <Border Grid.Column="2" Classes="kbd"><TextBlock x:Name="SearchKey" /></Border>
        </Grid>
      </Border>

      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Classes="seglbl" Text="SORT" />
        <Border Classes="seg tiny" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button Classes="seg-b tiny" Width="64" Content="Updated" Classes.on="{Binding SortIsUpdated}"
                    Command="{Binding SortByCommand}" ToolTip.Tip="Most recently changed first"
                    CommandParameter="{x:Static vm:CommunitySort.RecentlyUpdated}" />
            <Button Classes="seg-b tiny" Width="48" Content="Name" Classes.on="{Binding SortIsName}"
                    Command="{Binding SortByCommand}" ToolTip.Tip="By collection name"
                    CommandParameter="{x:Static vm:CommunitySort.Name}" />
            <Button Classes="seg-b tiny" Width="52" Content="Assets" Classes.on="{Binding SortIsAssets}"
                    Command="{Binding SortByCommand}" ToolTip.Tip="Most assets first"
                    CommandParameter="{x:Static vm:CommunitySort.Assets}" />
          </StackPanel>
        </Border>
      </StackPanel>

      <Button Grid.Column="5" x:Name="RefreshButton" Classes="tbtn" Command="{Binding RefreshCommand}"
              VerticalAlignment="Center" ToolTip.Tip="Fetch the list again  ·  R">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="ico sm" Data="{StaticResource IconRefresh}" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- THE TAG ROW. The gallery's fixed tag list, in its own order: each chip is a toggle that writes its
         #tag into the search box (accent wash while it is there) and carries how many collections wear it.
         Five chips of one stated width fit the column at the smallest window; the picker button holds the
         rest (and every tag again, with a filter). The whole row is present before the list arrives; it only
         loses its ink. -->
    <Grid Grid.Row="1" Grid.Column="0" Height="34" Margin="0,0,14,0" ColumnDefinitions="Auto,Auto,Auto,*"
          ColumnSpacing="8" Classes.cgone="{Binding !HasTags}">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
        <Path Classes="ico xs" Data="{StaticResource IconTag}" />
        <TextBlock Classes="seglbl" Text="TAGS" />
      </StackPanel>
      <ItemsControl Grid.Column="1" ItemsSource="{Binding TrayTags}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CommunityToken">
            <Button Classes="ctag" Width="100" Classes.on="{Binding IsOn}" Command="{Binding ToggleCommand}"
                    ToolTip.Tip="{Binding Token, StringFormat='Add or remove {0} in the search box'}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Classes="ctagname" Classes.on="{Binding IsOn}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Classes="ctagcount" Classes.on="{Binding IsOn}" Text="{Binding CountText}" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- The tag picker: every tag with its count, a filter, and Clear tags. Opened by this button or T. -->
      <Button Grid.Column="2" x:Name="TagPickerButton" Classes="ctag more" Width="100"
              Classes.on="{Binding MoreIsOn}" VerticalAlignment="Center"
              ToolTip.Tip="Every tag in the gallery, with a filter  ·  T">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft">
            <Grid x:Name="TagPicker" Classes="ctagpicker" Width="340" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
              <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="plabel" Margin="0" Text="ALL TAGS" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="cstatus" Text="{Binding TagSummary}" />
              </Grid>
              <Border Grid.Row="1" Classes="search" MaxWidth="1000">
                <Grid ColumnDefinitions="Auto,*">
                  <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconSearch}" />
                  <TextBox Grid.Column="1" x:Name="TagFilterBox" Classes="bare" Margin="8,0,0,0"
                           Text="{Binding TagFilter}" PlaceholderText="Filter tags" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <!-- One stated height, so the picker is one size whatever the filter leaves; the chips scroll
                   inside it when a gallery has more tags than five rows. -->
              <Panel Grid.Row="2" Height="164">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding PickerTags}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CommunityToken">
                        <Button Classes="ctag" HorizontalAlignment="Stretch" Margin="0,0,6,6"
                                Classes.on="{Binding IsOn}" Command="{Binding ToggleCommand}"
                                ToolTip.Tip="{Binding Token, StringFormat='Add or remove {0} in the search box'}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="ctagname" Classes.on="{Binding IsOn}" Text="{Binding Label}" />
                            <TextBlock Grid.Column="1" Classes="ctagcount" Classes.on="{Binding IsOn}" Text="{Binding CountText}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Classes="zp" Text="{Binding PickerEmptyText}" IsVisible="{Binding PickerIsEmpty}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Panel>
              <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="cmeta" TextWrapping="Wrap" TextTrimming="None"
                           VerticalAlignment="Center"
                           Text="Click a tag to add or drop it. Enter adds the first match." />
                <Button Grid.Column="1" Classes="tbtn cellbtn" Command="{Binding ClearTagsCommand}"
                        ToolTip.Tip="Take every #tag out of the search box">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="ico xs" Data="{StaticResource IconClose}" />
                    <TextBlock Text="Clear tags" />
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>
          </Flyout>
        </Button.Flyout>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Grid.Column="0" Classes="ctagname" Classes.on="{Binding MoreIsOn}" Text="{Binding MoreLabel}" />
          <Path Grid.Column="1" Classes="ico xs ctagchev" Classes.on="{Binding MoreIsOn}" Data="{StaticResource IconChevronDown}" />
        </Grid>
      </Button>
    </Grid>

    <!-- The grid host, with the empty state layered over it (IsVisible is right here: both share one
         Panel cell and neither takes layout of its own). -->
    <Panel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0">
      <ScrollViewer x:Name="TilesHost" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tiles}" HorizontalAlignment="Left" VerticalAlignment="Top">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CommunityTile">
              <Button Classes="ghost tcell ctile"
                      Command="{Binding $parent[UserControl].((vm:CommunityViewModel)DataContext).SelectCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Spacing="3">
                  <Border Classes="tile cpreview" Classes.sel="{Binding IsSelected}">
                    <Panel>
                      <Border Classes="tload" IsVisible="{Binding IsLoading}" />
                      <Border Classes="tmissing" IsVisible="{Binding ImageMissing}"
                              ToolTip.Tip="This preview couldn't be fetched" />
                      <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4" />
                      <!-- One badge slot, accent ink for New, Updated or Pending, never two. -->
                      <Border Classes="cbadge" Opacity="{Binding MarkOpacity}">
                        <TextBlock Text="{Binding MarkText}" />
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom" Margin="5,0,0,5">
                        <Border Classes="cchip" Width="26" Classes.cgone="{Binding !HasModels}"
                                ToolTip.Tip="Includes 3D models"><TextBlock Text="3D" /></Border>
                        <Border Classes="cchip" Width="38" Classes.cgone="{Binding !HasBook}"
                                ToolTip.Tip="Includes the CookBook"><TextBlock Text="BOOK" /></Border>
                      </StackPanel>
                    </Panel>
                  </Border>
                  <TextBlock Classes="cname" Text="{Binding Name}" />
                  <!-- ONE reserved line: the owner, then the first two tags, each a link that writes its
                       token into the search box. Clipped, never wrapped; the rail lists every tag. -->
                  <Grid ColumnDefinitions="Auto,*" Height="14" ClipToBounds="True">
                    <Button Grid.Column="0" Classes="clink" MaxWidth="84" Content="{Binding OwnerLink.Label}"
                            Classes.on="{Binding OwnerLink.IsOn}" Command="{Binding OwnerLink.ToggleCommand}"
                            ToolTip.Tip="Show only this person's collections" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding TileTagLinks}" Margin="6,0,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommunityToken">
                          <Button Classes="clink" Content="{Binding Label}" Classes.on="{Binding IsOn}"
                                  Command="{Binding ToggleCommand}" ToolTip.Tip="Show only this tag" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <TextBlock Classes="cmeta" Text="{Binding FactsText}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel IsVisible="{Binding IsEmpty}" Spacing="10" HorizontalAlignment="Center"
                  VerticalAlignment="Center" MaxWidth="360">
        <Path Classes="ico lg" Data="{StaticResource IconSearch}" HorizontalAlignment="Center" Opacity="0.4" />
        <TextBlock Text="{Binding EmptyText}" Classes="zp" TextWrapping="Wrap" HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <Button Content="{Binding EmptyActionText}" Command="{Binding EmptyActionCommand}" Classes="tbtn"
                HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>

    <!-- The pager band, which also carries the reserved status line: when the list was fetched and what is
         new, or a notice in warning ink (its whole sentence on the tooltip). A fixed band, so the grid above is
         one height whatever the page; Mark all seen only loses its ink when there is nothing to mark. -->
    <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Height="36"
          Margin="0,0,14,0">
      <Button Grid.Column="0" x:Name="PrevButton" Classes="tbtn" Command="{Binding PrevPageCommand}"
              VerticalAlignment="Center" ToolTip.Tip="Previous page  ·  PgUp">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Path Classes="ico sm" Data="{StaticResource IconChevronLeft}" />
          <TextBlock Text="Previous" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="1" Classes="cstatus" Classes.warn="{Binding StatusIsWarning}"
                 Text="{Binding StatusLine}" ToolTip.Tip="{Binding StatusLine}" />
      <Button Grid.Column="2" Classes="cmarkall" Classes.cgone="{Binding !HasMarks}"
              Command="{Binding MarkAllSeenCommand}" ToolTip.Tip="Count every collection in the list as seen.">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Path Classes="ico xs cink" Data="{StaticResource IconSeen}" />
          <TextBlock Text="Mark all seen" />
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="3" Classes="cstatus" Text="{Binding PageText}" />
      <Button Grid.Column="4" x:Name="NextButton" Classes="tbtn" Command="{Binding NextPageCommand}"
              VerticalAlignment="Center" ToolTip.Tip="Next page  ·  PgDn">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Next" />
          <Path Classes="ico sm" Data="{StaticResource IconChevronRight}" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- The rail. Nothing selected: one sentence saying how to pick. Otherwise the picture with its
         cells, then the words (scrolling, because a description is the sharer's to length), then the
         actions pinned so they never move. -->
    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Classes="rules-panel" Padding="0">
      <Panel>
        <TextBlock Classes="zp" Text="Pick a collection to see it here." TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Margin="24" IsVisible="{Binding !HasSelection}" />

        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" Classes.cgone="{Binding !HasSelection}">
          <StackPanel Grid.Row="0" Spacing="3">
            <Border x:Name="RailShot" Classes="cshot"
                    ToolTip.Tip="Scroll the wheel to step through the preview's cells.">
              <Panel>
                <Border Classes="tload" IsVisible="{Binding RailLoading}" />
                <Border Classes="tmissing" IsVisible="{Binding RailMissing}"
                        ToolTip.Tip="This preview couldn't be fetched" />
                <Image Source="{Binding RailPreview}" Stretch="Uniform" />
              </Panel>
            </Border>
            <TextBlock Classes="derived" Height="14" Text="{Binding CellText}" />
          </StackPanel>

          <!-- The identity, pinned: nothing here scrolls, so the owner and tag links are always in view. The
               facts run together on wrapped lines to keep the block short. -->
          <StackPanel x:Name="RailIdentity" Grid.Row="1" Spacing="4" Margin="0,4,0,0">
            <TextBlock Text="{Binding Selected.Name}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding Selected.Name}" />
            <Button Classes="clink" HorizontalAlignment="Left" Content="{Binding Selected.OwnerLink.Label}"
                    Classes.on="{Binding Selected.OwnerLink.IsOn}" Command="{Binding Selected.OwnerLink.ToggleCommand}"
                    ToolTip.Tip="Show only this person's collections" />
            <TextBlock Classes="cmeta" Text="{Binding DatesText}" TextTrimming="None" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding RailFacts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="cmeta" Text="{Binding}" Margin="0,0,10,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Selected.TagLinks}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CommunityToken">
                  <Button Classes="clink" Margin="0,0,8,3" Content="{Binding Label}" Classes.on="{Binding IsOn}"
                          Command="{Binding ToggleCommand}" ToolTip.Tip="Show only this tag" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="cmeta" Text="No tags." IsVisible="{Binding Selected.HasNoTags}" />
          </StackPanel>

          <!-- The description takes whatever height is left and wraps to it; what does not fit ends in an
               ellipsis, and the whole text is on the tooltip. No scroller, so no bar. -->
          <Border x:Name="RailDescription" Grid.Row="2" ClipToBounds="True" Margin="0,2,0,6" Background="Transparent"
                  ToolTip.Tip="{Binding DescriptionText}">
            <StackPanel Spacing="1">
              <TextBlock Classes="zp" Text="{Binding DescriptionText}" TextWrapping="Wrap" TextAlignment="Left"
                         TextTrimming="WordEllipsis" MaxLines="2" FontSize="11" LineHeight="14" />
              <!-- Wrapping does not draw an ellipsis, so a long description says it goes on. Reserved, inked only when long. -->
              <TextBlock x:Name="RailMore" Classes="cmeta" Height="14" Text="... hover for the full text"
                         Opacity="{Binding DescriptionMoreOpacity}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="3" Spacing="6">
            <!-- Why Download is off. Reserved two lines, so the buttons never move. -->
            <TextBlock Classes="cwarn" Height="30" Text="{Binding DownloadNote}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding DownloadNote}" />
            <!-- The download's progress and its Stop. Always laid out; inked only while the selected
                 collection is the one downloading, so starting one moves nothing. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Height="26"
                  Classes.cgone="{Binding !ShowsDownloadProgress}">
              <ProgressBar Grid.Column="0" Minimum="0" Maximum="1" Value="{Binding DownloadFraction}"
                           VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="tbtn cellbtn" Command="{Binding StopDownloadCommand}"
                      ToolTip.Tip="Stop the download. Nothing is kept.">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path Classes="ico xs" Data="{StaticResource IconStop}" />
                  <TextBlock Text="Stop" />
                </StackPanel>
              </Button>
            </Grid>
            <Button x:Name="DownloadButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding DownloadCommand}"
                    ToolTip.Tip="Download this collection and open it in the Set browser  ·  Enter">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="ico sm" Data="{StaticResource IconDownload}" />
                <TextBlock Text="Download" />
              </StackPanel>
            </Button>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
              <Button Grid.Column="0" Classes="tbtn" HorizontalAlignment="Stretch" Command="{Binding ReportCommand}"
                      ToolTip.Tip="Open the gallery's report form for this collection. Only its id is sent.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="ico sm" Data="{StaticResource IconReport}" />
                  <TextBlock Text="Report" />
                </StackPanel>
              </Button>
              <!-- One slot, two buttons that are never both inked: Unshare for a live collection of yours, Dismiss for a request
                   the gallery turned away. -->
              <Panel Grid.Column="1">
                <Button Classes="tbtn" HorizontalAlignment="Stretch"
                        Classes.cgone="{Binding !CanUnshareSelected}" Command="{Binding UnshareCommand}"
                        ToolTip.Tip="Take your collection out of the gallery.">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="ico sm" Data="{StaticResource IconUnshare}" />
                    <TextBlock Text="Unshare" />
                  </StackPanel>
                </Button>
                <Button Classes="tbtn" HorizontalAlignment="Stretch"
                        Classes.cgone="{Binding !CanDismissSelected}" Command="{Binding DismissPendingCommand}"
                        ToolTip.Tip="Forget this request and its reasons.">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="ico sm" Data="{StaticResource IconClose}" />
                    <TextBlock Text="Dismiss" />
                  </StackPanel>
                </Button>
              </Panel>
            </Grid>
          </StackPanel>
        </Grid>
      </Panel>
    </Border>
  </Grid>
</UserControl>
