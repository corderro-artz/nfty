<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:models="using:Nfty.App.Models"
             x:Class="Nfty.App.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="12">
      <Button Content="🔍" Command="{Binding SearchCommand}" Classes="tbtn" ToolTip.Tip="Search" />
      <Button Content="{Binding AddLabel}" Command="{Binding AddCommand}" Classes="accent" />
      <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Classes="tbtn" />
      <Button Content="Import" Command="{Binding ImportCommand}" Classes="tbtn" />
      <Button Content="🔒" Command="{Binding ToggleLockCommand}" Classes="tbtn" ToolTip.Tip="Toggle lock" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="260,*">
      <TreeView Grid.Column="0" Name="Tree" ItemsSource="{Binding Roots}"
                Background="{DynamicResource PanelBrush}" Margin="12,0,12,12">
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="models:ExplorerNode" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <ContentControl Grid.Column="1" Content="{Binding CurrentDetail}" Margin="0,0,12,12" />
    </Grid>
  </Grid>
</UserControl>
