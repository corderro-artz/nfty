<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:models="using:Nfty.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Nfty.App.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel"
             Focusable="True">
  <Grid RowDefinitions="Auto,*">
    <!-- Context toolbar (.exp-toolbar): gap 10, padding 10/14, bottom hairline. Crumbs live in the
         titlebar now (ShellChromeView, bound through ShellViewModel.CurrentExplorer) rather than as
         a row here, so the page host is flush under the titlebar instead of double-chromed. -->
    <Border Grid.Row="0" Background="{DynamicResource BgAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <!-- A Grid, not a StackPanel: the search pill flexes into the free space and the lock is
           right-aligned against the far edge (mockup .exp-toolbar is a flex row whose .search takes
           `flex:1`). A StackPanel would size the search to its content and leave the lock adrift
           in the middle of the bar. -->
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <Border Grid.Column="0" Classes="search" HorizontalAlignment="Stretch" Margin="0,0,10,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0" Classes="ico sm" Data="{StaticResource IconSearch}" VerticalAlignment="Center" />
            <!-- Borderless: the pill's own Border draws the chrome, so the TextBox must not draw a
                 second one inside it. -->
            <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchQuery}" Classes="bare"
                     Margin="8,0" VerticalAlignment="Center"
                     PlaceholderText="Find recipe, ingredient, variant…" ToolTip.Tip="Search (Ctrl+K)" />
            <Border Grid.Column="2" Classes="kbd"><TextBlock Text="⌘K" /></Border>
          </Grid>
        </Border>

        <Button Grid.Column="1" Command="{Binding AddCommand}" Classes="accent" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="ico sm" Data="{StaticResource IconPlus}" />
            <TextBlock Text="{Binding AddLabel}" />
          </StackPanel>
        </Button>
        <!-- The mockup's toolbar buttons all carry a leading 14px glyph, not text alone. -->
        <Button Grid.Column="2" Command="{Binding DeleteSelectedCommand}" Classes="tbtn" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="ico sm" Data="{StaticResource IconTrash}" />
            <TextBlock Text="Delete" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Command="{Binding ImportCommand}" Classes="tbtn" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="ico sm" Data="{StaticResource IconImport}" />
            <TextBlock Text="Import" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" Command="{Binding ToggleLockCommand}" Classes="icon" Classes.unlocked="{Binding IsEditing}"
                ToolTip.Tip="{Binding LockTip}">
          <Panel>
            <Path Classes="ico" Data="{StaticResource IconLock}" IsVisible="{Binding !IsEditing}" />
            <Path Classes="ico" Data="{StaticResource IconUnlock}" IsVisible="{Binding IsEditing}" />
          </Panel>
        </Button>
      </Grid>
    </Border>

    <!-- Mockup pane track: 286px contents / flexible detail / 336px rail. Panes are full-bleed
         regions on the page background divided by 1px rules — no floating cards, no inter-pane margin. -->
    <Grid Grid.Row="1" ColumnDefinitions="286,*">
      <Border Grid.Column="0" Classes="pane">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="pane-hrow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="CONTENTS" Classes="pane-h" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding TreeCountText}" Classes="hcount" />
            </Grid>
          </Border>

          <TreeView Grid.Row="1" Name="Tree" ItemsSource="{Binding Roots}"
                    SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                    Background="Transparent" Padding="10,4,10,14">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="models:ExplorerNode" ItemsSource="{Binding Children}">
                <!-- Grid, not StackPanel: the guide must stretch the row's FULL height so successive
                     rows' segments abut into one continuous line (the row's vertical padding was
                     moved off the TreeViewItem for the same reason — see Controls.axaml). Only the
                     content carries the 6px inset. -->
                <Grid ColumnDefinitions="Auto,*">
                  <Border Grid.Column="0" Classes="guide" IsVisible="{Binding !IsRoot}" />
                  <!-- The node box, and only it, takes the hover/selected wash - so the highlight
                       starts after the guide rather than behind the indent. -->
                  <Border Grid.Column="1" Classes="node" Margin="12,0,0,0"
                          Classes.sel="{Binding $parent[TreeViewItem].IsSelected}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- .ti type mark, on every node -->
                    <Path Classes="ico ti" Data="{StaticResource IconTypeCookBook}" IsVisible="{Binding IsRoot}" />
                    <Path Classes="ico ti" Data="{StaticResource IconTypeRecipe}" IsVisible="{Binding IsRecipe}" />
                    <Path Classes="ico ti" Data="{StaticResource IconTypeIngredient}" IsVisible="{Binding IsIngredient}" />
                    <TextBlock Classes="kmark"
                               Classes.kdyn="{Binding IsDynamic}"
                               Classes.kstat="{Binding IsStatic}"
                               Classes.kcust="{Binding IsCustom}"
                               Text="{Binding KindMark}"
                               IsVisible="{Binding LayerKind, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Name}" Classes.root="{Binding IsRoot}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  </Border>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="pane last">
        <Grid RowDefinitions="Auto,*">
          <!-- .pane-h.detail-h: the same 41px band the Contents pane carries, so the two panes'
               content starts on the same line. Without it the detail body began 25px higher and the
               paired panes visibly failed to align. Type glyph, title, item count, then the view tag
               pushed right by the star column. -->
          <Border Grid.Row="0" Classes="pane-hrow"
                  IsVisible="{Binding DetailKind, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
              <Panel Grid.Column="0" VerticalAlignment="Center">
                <Path Classes="ico sm" Data="{StaticResource IconTypeCookBook}"
                      IsVisible="{Binding IsDetailCookBook}" />
                <Path Classes="ico sm" Data="{StaticResource IconTypeRecipe}"
                      IsVisible="{Binding IsDetailRecipe}" />
                <Path Classes="ico sm" Data="{StaticResource IconTypeIngredient}"
                      IsVisible="{Binding IsDetailIngredient}" />
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding DetailTitle}" Classes="pane-h"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding DetailCount}" Classes="hcount"
                         HorizontalAlignment="Left" />
              <Border Grid.Column="4" Classes="vtag" VerticalAlignment="Center">
                <TextBlock Text="{Binding DetailTag}" />
              </Border>
            </Grid>
          </Border>

          <ContentControl Grid.Row="1" Content="{Binding CurrentDetail}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
