<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Nfty.App.ViewModels"
             xmlns:models="using:Nfty.App.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Nfty.App.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel"
             Focusable="True">
  <Grid RowDefinitions="Auto,*">
    <!-- Context toolbar (.exp-toolbar): gap 10, padding 10/14, bottom hairline. Crumbs live in the
         titlebar now (MainWindow.axaml, bound through ShellViewModel.CurrentExplorer) rather than as
         a row here, so the page host is flush under the titlebar instead of double-chromed. -->
    <Border Grid.Row="0" Background="{DynamicResource BgAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox x:Name="SearchBox" Width="220" Text="{Binding SearchQuery}"
                 Watermark="Find recipe, ingredient, variant…" ToolTip.Tip="Search (Ctrl+K)" />
        <TextBlock Text="{Binding SearchSummary}" Classes="muted" VerticalAlignment="Center" />
        <Button Content="{Binding AddLabel}" Command="{Binding AddCommand}" Classes="accent" />
        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}" Classes="tbtn" />
        <Button Content="Import" Command="{Binding ImportCommand}" Classes="tbtn" />
        <Button Command="{Binding ToggleLockCommand}" Classes="icon" Classes.unlocked="{Binding IsEditing}"
                ToolTip.Tip="{Binding LockTip}">
          <Panel>
            <Path Classes="ico" Data="{StaticResource IconLock}" IsVisible="{Binding !IsEditing}" />
            <Path Classes="ico" Data="{StaticResource IconUnlock}" IsVisible="{Binding IsEditing}" />
          </Panel>
        </Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="260,*">
      <TreeView Grid.Column="0" Name="Tree" ItemsSource="{Binding Roots}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                Background="{DynamicResource PanelBrush}" Margin="12,10,12,12">
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="models:ExplorerNode" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="guide" IsVisible="{Binding !IsRoot}" />
              <TextBlock Classes="kmark"
                         Classes.kdyn="{Binding IsDynamic}"
                         Classes.kstat="{Binding IsStatic}"
                         Classes.kcust="{Binding IsCustom}"
                         Text="{Binding KindMark}"
                         IsVisible="{Binding LayerKind, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              <TextBlock Text="{Binding Name}" Classes.root="{Binding IsRoot}" VerticalAlignment="Center" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <ContentControl Grid.Column="1" Content="{Binding CurrentDetail}" Margin="0,0,12,12" />
    </Grid>
  </Grid>
</UserControl>
