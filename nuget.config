<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore from nuget.org and nothing else.

    `<clear />` is the point: without it this file ADDS to whatever sources the machine's global
    NuGet.config already defines, so a restore would depend on the developer's personal
    configuration — and central package management refuses to run against multiple unmapped sources
    at all. Pinning the source here makes a restore reproducible on a clean machine and on CI, and
    means a package can only come from where this file says.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
