# Frozen test fixtures — hashed byte-for-byte by FixtureFreezeTests. Never convert
# line endings on checkout: with core.autocrlf=true, git would otherwise smudge
# README.md's LF to CRLF on a fresh Windows clone and break its pinned SHA-256,
# failing the suite out of the box. Treat the whole directory as opaque/binary.
tests/fixtures/** -text

# nfty archives are renamed ZIPs. Git's auto-detection gets this right today because a zip
# contains NUL bytes, but "right by accident" is how the fixture SHAs above were nearly lost:
# one line-ending conversion turns the embedded demo CookBook into a file the app cannot open,
# and the only symptom is a user clicking "Open the demo CookBook" and getting an error.
*.cbk -text
*.rcp -text
*.igt -text
*.set -text
*.ktn -text
*.tin -text

# Generated API pages: tools/api-docs/build.py --check compares bytes, so they must stay LF on every platform.
docs/manual/reference/api/** text eol=lf

# The expected index is compared byte-for-byte (no trailing newline, LF) by IndexFixtureTests and test_gallery.py.
tools/tests/gallery_fixtures/index.expected.json -text
