# .NET
bin/
obj/
*.user
.vs/
[Dd]ebug/
[Rr]elease/
# ...but not the folder that BUILDS a release. The two patterns above are the stock .NET ones and
# are unanchored, so `tools/release/` matched one of them and the script that produces every
# downloadable artifact was never in the repository at all - a fresh clone could not cut a release
# and nothing said why. A negation has to name the DIRECTORY: git does not look inside an excluded
# folder, so `!tools/release/build.py` alone would still be ignored.
!tools/release/
artifacts/
*.nupkg
TestResults/

# OS / editor
.DS_Store
.idea/

# Claude Code local worktrees (transient)
.claude/worktrees/

# Superpowers brainstorm companion (transient session files)
.superpowers/

# Six Labors license (account-specific; never commit)
sixlabors.lic
build-output.txt

# Built user manual (Material for MkDocs); the source is docs/manual/
.mkdocs-site/
.demo/

# VisualCapture's output (NFTY_CAPTURE_DIR); frames are regenerated, never committed
.capture/

# Python bytecode from the mkdocs hooks.
__pycache__/
*.pyc

# Local publish output from packaging experiments.
.pub/

# Built release artifacts.
.release/
